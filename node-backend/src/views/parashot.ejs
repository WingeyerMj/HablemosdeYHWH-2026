<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

    <body class="parashot-page">

        <%- include('partials/header') %>

            <main class="main">

                <!-- Page Title -->
                <div class="page-title accent-background">
                    <div class="container d-lg-flex justify-content-between align-items-center">
                        <h1 class="mb-2 mb-lg-0">Parashot</h1>
                        <nav class="breadcrumbs">
                            <ol>
                                <li><a href="/">Inicio</a></li>
                                <li class="current">Parashot</li>
                            </ol>
                        </nav>
                    </div>
                </div><!-- End Page Title -->

                <section class="section">
                    <div class="container">

                        <% if (typeof selectedCycle !== 'undefined' && selectedCycle) { %>
                            <div class="alert alert-warning border-warning d-flex flex-wrap align-items-center justify-content-between p-3 rounded-4 mb-4 shadow-sm" style="background: linear-gradient(135deg, rgba(212,184,149,0.2), rgba(212,184,149,0.05)); border-color: #d4b895 !important;">
                                <div class="d-flex align-items-center gap-3">
                                    <i class="bi bi-archive-fill fs-3 text-warning"></i>
                                    <div>
                                        <strong class="text-dark">Estás visualizando el Ciclo Histórico: <%= selectedCycle.name %></strong>
                                        <div class="small text-muted">Contenido resguardado tras la fiesta de Sucot.</div>
                                    </div>
                                </div>
                                <a href="/parashot" class="btn btn-sm btn-dark mt-2 mt-md-0 fw-bold">
                                    <i class="bi bi-arrow-left me-1"></i> Volver al Ciclo Actual
                                </a>
                            </div>
                        <% } %>

                        <% if (typeof cycles !== 'undefined' && cycles && cycles.length > 0) { %>
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 p-3 rounded-4" style="background: #fdfbf7; border: 1px solid #ebdccb;">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold small text-muted"><i class="bi bi-clock-history me-1" style="color: var(--primary-color);"></i> Ciclo de Lectura:</span>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-dark dropdown-toggle px-3 py-1 fw-semibold" type="button" data-bs-toggle="dropdown">
                                            <% if (typeof selectedCycle !== 'undefined' && selectedCycle) { %>
                                                📁 <%= selectedCycle.name %>
                                            <% } else if (typeof currentCycle !== 'undefined' && currentCycle) { %>
                                                ⭐ <%= currentCycle.name %> (Activo)
                                            <% } else { %>
                                                Ciclo Actual (Activo)
                                            <% } %>
                                        </button>
                                        <ul class="dropdown-menu shadow">
                                            <li>
                                                <a class="dropdown-item <%= (typeof selectedCycle === 'undefined' || !selectedCycle) ? 'active' : '' %>" href="/parashot">
                                                    ⭐ <%= (typeof currentCycle !== 'undefined' && currentCycle) ? currentCycle.name : 'Ciclo Actual' %> (Activo)
                                                </a>
                                            </li>
                                            <% if (typeof cycles !== 'undefined' && cycles && cycles.length > 0) { %>
                                                <li><hr class="dropdown-divider"></li>
                                                <li class="dropdown-header small text-muted text-uppercase" style="font-size: 0.72rem;">Ciclos Anteriores Archivados</li>
                                                <% cycles.filter(c => !currentCycle || c.id !== currentCycle.id).forEach(c => { %>
                                                    <li>
                                                        <a class="dropdown-item <%= (typeof selectedCycle !== 'undefined' && selectedCycle && selectedCycle.id === c.id) ? 'active' : '' %>" href="/parashot?cycle=<%= c.id %>">
                                                            📁 <%= c.name %> <%= c.year_label ? '(' + c.year_label + ')' : '' %>
                                                        </a>
                                                    </li>
                                                <% }) %>
                                            <% } %>
                                        </ul>
                                    </div>
                                </div>
                                <div>
                                    <a href="/archivo-historico" class="btn btn-sm btn-link text-decoration-none" style="color: var(--primary-color); font-weight: 600; font-size: 0.85rem;">
                                        <i class="bi bi-collection me-1"></i> Archivo Histórico Completo &rarr;
                                    </a>
                                </div>
                            </div>
                        <% } %>

                        <div class="row gy-4">
                            <% if (typeof parashot !== 'undefined' && parashot && parashot.length > 0) { %>
                                <% parashot.forEach((service, index) => { %>
                                <div class="col-lg-6" data-aos="fade-up" data-aos-delay="<%= (index + 1) * 50 %>">
                                    <div class="service-item d-flex align-items-center justify-content-center py-2 px-3 shadow-sm" style="position: relative; background: #ffffff; border-radius: 15px; border: 1px solid #f0f0f0; min-height: 120px;">
                                        <div class="row g-2 align-items-center w-100 flex-nowrap">
                                            <!-- Icono -->
                                            <div class="col-auto d-none d-md-flex">
                                                <div class="icon flex-shrink-0" style="width: 50px; height: 50px; background: #f8f9fa; color: var(--primary-color); border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 1px solid #eee;">
                                                    <i class="bi <%= service.icon || 'bi-journal-text' %>" style="font-size: 1.2rem;"></i>
                                                </div>
                                            </div>
                                            
                                            <!-- Texto -->
                                            <div class="col text-start ps-2 overflow-hidden">
                                                <div class="d-flex align-items-center justify-content-between gap-1 mb-1">
                                                    <h4 class="title mb-0" style="font-size: 1.3rem; font-weight: 700;">
                                                        <a href="/parashot/<%= service.id %><%= (typeof selectedCycle !== 'undefined' && selectedCycle) ? '?cycle=' + selectedCycle.id : '' %>" class="stretched-link" style="color: #222;">
                                                            <%= service.parasha_number ? service.parasha_number + '. ' : '' %><%= service.title %>
                                                        </a>
                                                    </h4>
                                                    <div class="d-flex align-items-center gap-1" style="z-index: 2; position: relative;">
                                                        <span class="badge rounded-pill px-2 py-1 shadow-sm d-inline-flex align-items-center" style="background: rgba(212, 168, 83, 0.12); color: #8c6a2d; font-size: 0.72rem; font-weight: 600; border: 1px solid rgba(212, 168, 83, 0.3);">
                                                            <i class="bi bi-clock-history me-1 text-warning"></i><%= service.cycle_name || (selectedCycle ? selectedCycle.name : (typeof currentCycle !== 'undefined' && currentCycle ? currentCycle.name : 'Ciclo Activo')) %>
                                                        </span>
                                                        <span class="badge rounded-pill px-2 py-1 shadow-sm d-inline-flex align-items-center" style="background: #fdf6e7; color: #8c6a2d; font-size: 0.75rem; font-weight: 600; border: 1px solid #ebdccb;">
                                                            <i class="bi bi-eye-fill me-1 text-info"></i><%= service.views || 0 %>
                                                        </span>
                                                    </div>
                                                </div>
                                                <% if (service.subtitle) { %>
                                                    <div class="subtitle mb-2" style="color: var(--primary-color); font-size: 0.9rem; font-weight: 600; line-height: 1.2;">
                                                        <%= service.subtitle %>
                                                    </div>
                                                <% } %>
                                                <!-- Resumen de 2 líneas -->
                                                <p class="description mb-0" style="color: #666; font-size: 0.9rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 3em;">
                                                    <%= service.description %>
                                                </p>
                                            </div>

                                            <!-- Imagen o Proximamente -->
                                            <div class="col-auto">
                                                <% if (service.image_url && service.image_url.trim() !== '') { %>
                                                    <div class="parasha-cover-mini" style="width: 140px; height: 95px; border-radius: 10px; overflow: hidden; background: #f8f9fa; border: 1px solid #ddd; box-shadow: inset 0 0 5px rgba(0,0,0,0.1);">
                                                        <img src="<%= service.image_url %>" alt="<%= service.title %>" style="width: 100%; height: 100%; object-fit: contain;"
                                                             onerror="this.onerror=null; this.closest('.parasha-cover-mini').outerHTML='<div class=\'parasha-cover-placeholder position-relative d-flex flex-column align-items-center justify-content-center text-center p-2\' style=\'width: 135px; height: 95px; border-radius: 10px; background: linear-gradient(135deg, #fdfbf7 0%, #f5ece0 100%); border: 1.5px dashed #d4a853; box-shadow: inset 0 0 8px rgba(212,168,83,0.1);\'><i class=\'bi bi-hourglass-split mb-1\' style=\'font-size: 1.25rem; color: #b8860b;\'></i><span class=\'badge px-2 py-1 shadow-sm\' style=\'font-size: 0.72rem; font-weight: 700; background: linear-gradient(135deg, #d4a853, #b8860b); color: #ffffff; letter-spacing: 0.3px;\'>Próximamente...</span></div>';">
                                                    </div>
                                                <% } else { %>
                                                    <!-- Badge Próximamente si no hay imagen -->
                                                    <div class="parasha-cover-placeholder position-relative d-flex flex-column align-items-center justify-content-center text-center p-2" 
                                                         style="width: 135px; height: 95px; border-radius: 10px; background: linear-gradient(135deg, #fdfbf7 0%, #f5ece0 100%); border: 1.5px dashed #d4a853; box-shadow: inset 0 0 8px rgba(212,168,83,0.1);">
                                                        <i class="bi bi-hourglass-split mb-1" style="font-size: 1.25rem; color: #b8860b;"></i>
                                                        <span class="badge px-2 py-1 shadow-sm" style="font-size: 0.72rem; font-weight: 700; background: linear-gradient(135deg, #d4a853, #b8860b); color: #ffffff; letter-spacing: 0.3px;">
                                                            Próximamente...
                                                        </span>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="col-12 text-center">
                                <p class="text-muted">No hay parashot disponibles en este momento.</p>
                            </div>
                        <% } %>
                        </div>
                    </div>
                </section>

            </main>

            <%- include('partials/footer') %>

    </body>

</html>