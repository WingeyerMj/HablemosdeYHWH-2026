<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

    <body class="noticia-detail-page">

        <%- include('partials/header') %>

            <main class="main">
                <!-- Header del Artículo -->
                <div class="page-title dark-background" style="background: linear-gradient(135deg, #18120c 0%, #291e13 100%); border-bottom: 2px solid #d4a853;">
                    <div class="container d-lg-flex justify-content-between align-items-center py-4">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge px-3 py-1 rounded-pill" style="background: rgba(212,168,83,0.25); color: #f5cf7c; border: 1px solid rgba(212,168,83,0.4); font-size: 0.78rem;">
                                    <%= item.category || 'Mundial' %>
                                </span>
                                <% if (item.is_breaking) { %>
                                    <span class="badge bg-danger rounded-pill px-2 py-1"><i class="bi bi-lightning-fill"></i> Urgente</span>
                                <% } %>
                            </div>
                            <h1 class="mb-2" style="font-size: 2.1rem; font-weight: 800; color: #ffffff; line-height: 1.3;"><%= item.title %></h1>
                            <% if (item.subtitle) { %>
                                <p class="lead text-white-50 mb-0" style="font-size: 1.05rem;"><%= item.subtitle %></p>
                            <% } %>
                        </div>
                        <nav class="breadcrumbs mt-3 mt-lg-0">
                            <ol>
                                <li><a href="/">Inicio</a></li>
                                <li><a href="/noticias">Noticias</a></li>
                                <li class="current">Acontecimiento</li>
                            </ol>
                        </nav>
                    </div>
                </div>

                <section class="section py-5" style="background-color: #faf9f6;">
                    <div class="container">
                        <div class="row gy-5">
                            
                            <!-- Columna Principal: Contenido de la Noticia -->
                            <div class="col-lg-8">
                                <article class="p-4 p-md-5 bg-white rounded-4 shadow-sm border" style="border-color: #ebe5dc !important;">
                                    
                                    <!-- Meta informativa -->
                                    <div class="d-flex flex-wrap align-items-center justify-content-between pb-3 mb-4 border-bottom text-muted" style="font-size: 0.88rem;">
                                        <div class="d-flex align-items-center gap-3">
                                            <span><i class="bi bi-calendar3 me-1" style="color: #d4a853;"></i> <%= item.published_at ? new Date(item.published_at).toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }) : '-' %></span>
                                            <span><i class="bi bi-pencil-square me-1" style="color: #d4a853;"></i> <%= item.author || 'Redacción YHWH' %></span>
                                        </div>
                                        <div>
                                            <span class="badge bg-light text-dark border"><i class="bi bi-eye me-1"></i> <%= item.views || 1 %> vistas</span>
                                        </div>
                                    </div>

                                    <!-- Imagen Destacada -->
                                    <% if (item.image_url) { %>
                                        <div class="rounded-4 overflow-hidden mb-4 shadow-sm" style="max-height: 480px;">
                                            <img src="<%= item.image_url %>" alt="<%= item.title %>" class="w-100 h-100 object-fit-cover">
                                        </div>
                                    <% } %>

                                    <!-- Resumen Destacado -->
                                    <% if (item.summary) { %>
                                        <div class="p-4 rounded-3 mb-4" style="background: #fcf9f4; border-left: 4px solid #d4a853; font-size: 1.1rem; line-height: 1.7; color: #3a2e26; font-weight: 500;">
                                            <%= item.summary %>
                                        </div>
                                    <% } %>

                                    <!-- Cuerpo Principal -->
                                    <% if (item.content && item.content.trim() !== '') { %>
                                        <div class="article-content" style="font-size: 1.05rem; line-height: 1.85; color: #2d2620;">
                                            <%- item.content %>
                                        </div>
                                    <% } %>

                                    <!-- Enlace a Fuente Original -->
                                    <% if (item.source_url) { %>
                                        <div class="mt-4 pt-3 border-top">
                                            <a href="<%= item.source_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                                <i class="bi bi-link-45deg me-1"></i> Fuente Original / Más información
                                            </a>
                                        </div>
                                    <% } %>

                                    <!-- Botones de Compartir -->
                                    <div class="share-box mt-5 pt-4 border-top">
                                        <h6 class="fw-bold mb-3"><i class="bi bi-share-fill me-2" style="color: #d4a853;"></i>Compartir esta noticia:</h6>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(item.title + '\n\n' + (item.summary || '') + '\n\nLee más en: ' + (typeof fullUrl !== 'undefined' ? fullUrl : '')) %>" target="_blank" class="btn btn-sm text-white rounded-pill px-3" style="background: #25D366;">
                                                <i class="bi bi-whatsapp me-1"></i> WhatsApp
                                            </a>
                                            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(typeof fullUrl !== 'undefined' ? fullUrl : '') %>" target="_blank" class="btn btn-sm text-white rounded-pill px-3" style="background: #1877F2;">
                                                <i class="bi bi-facebook me-1"></i> Facebook
                                            </a>
                                            <a href="https://t.me/share/url?url=<%= encodeURIComponent(typeof fullUrl !== 'undefined' ? fullUrl : '') %>&text=<%= encodeURIComponent(item.title) %>" target="_blank" class="btn btn-sm text-white rounded-pill px-3" style="background: #229ED9;">
                                                <i class="bi bi-telegram me-1"></i> Telegram
                                            </a>
                                            <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(item.title) %>&url=<%= encodeURIComponent(typeof fullUrl !== 'undefined' ? fullUrl : '') %>" target="_blank" class="btn btn-sm text-white rounded-pill px-3" style="background: #000000;">
                                                <i class="bi bi-twitter-x me-1"></i> X
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            </div>

                            <!-- Columna Lateral: Otras Noticias & Shorts -->
                            <div class="col-lg-4">
                                
                                <!-- Noticias Relacionadas -->
                                <div class="bg-white p-4 rounded-4 shadow-sm border mb-4" style="border-color: #ebe5dc !important;">
                                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                                        <i class="bi bi-newspaper" style="color: #d4a853;"></i> Otras Noticias
                                    </h5>
                                    <% if (typeof relatedNews !== 'undefined' && relatedNews && relatedNews.length > 0) { %>
                                        <div class="d-flex flex-column gap-3">
                                            <% relatedNews.forEach(rel => { %>
                                                <a href="/noticias/<%= rel.id %>" class="text-decoration-none d-flex gap-3 align-items-center group-hover-news">
                                                    <% if (rel.image_url) { %>
                                                        <img src="<%= rel.image_url %>" alt="<%= rel.title %>" class="rounded-3 flex-shrink-0" style="width: 70px; height: 60px; object-fit: cover;">
                                                    <% } %>
                                                    <div>
                                                        <span class="badge bg-light text-muted border mb-1" style="font-size: 0.68rem;"><%= rel.category || 'Mundial' %></span>
                                                        <h6 class="mb-0 text-dark fw-bold" style="font-size: 0.88rem; line-height: 1.35;"><%= rel.title %></h6>
                                                    </div>
                                                </a>
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <p class="text-muted small mb-0">No hay otras noticias en esta categoría.</p>
                                    <% } %>
                                </div>

                                <!-- Cápsulas en Video / Shorts -->
                                <% if (typeof shorts !== 'undefined' && shorts && shorts.length > 0) { %>
                                    <div class="p-4 rounded-4 shadow-sm border text-white" style="background: #19120c; border-color: rgba(212,168,83,0.3) !important;">
                                        <h5 class="fw-bold mb-3 d-flex align-items-center gap-2 text-warning">
                                            <i class="bi bi-camera-reels-fill"></i> Cápsulas en Video
                                        </h5>
                                        <div class="d-flex flex-column gap-3">
                                            <% shorts.slice(0, 3).forEach(s => { %>
                                                <div class="d-flex gap-3 align-items-center p-2 rounded-3" style="background: rgba(255,255,255,0.05); cursor: pointer;"
                                                     onclick="openShortModal('<%= s.title.replace(/'/g, "\\'") %>', '<%= s.youtube_short_url || s.youtube_url || s.video_url %>', '<%= !!s.video_url && !s.youtube_short_url %>')">
                                                    <div class="position-relative rounded-2 overflow-hidden flex-shrink-0" style="width: 55px; height: 75px;">
                                                        <img src="<%= s.thumbnail_url || '/assets/img/blog/blog-1.jpg' %>" alt="<%= s.title %>" class="w-100 h-100 object-fit-cover">
                                                        <div class="position-absolute top-50 start-50 translate-middle text-warning">
                                                            <i class="bi bi-play-circle-fill fs-5"></i>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <span class="badge px-2 py-0 rounded-pill mb-1" style="background: rgba(212,168,83,0.2); color: #f5cf7c; font-size: 0.65rem;"><%= s.category || 'Actualidad' %></span>
                                                        <h6 class="mb-0 text-white small fw-semibold" style="line-height: 1.3;"><%= s.title %></h6>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        </div>
                                    </div>
                                <% } %>

                            </div>
                        </div>
                    </div>
                </section>
            </main>

            <!-- MODAL REPRODUCTOR DE VIDEO SHORT -->
            <div class="modal fade" id="shortVideoModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                    <div class="modal-content bg-black text-white border border-secondary rounded-4 overflow-hidden">
                        <div class="modal-header border-0 p-3 pb-0">
                            <h6 class="modal-title text-truncate fw-bold pe-2" id="shortModalTitle"></h6>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-2 text-center">
                            <div id="shortPlayerContainer" class="rounded-3 overflow-hidden bg-dark" style="aspect-ratio: 9/16; width: 100%;">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('partials/footer') %>

            <script>
                function openShortModal(title, url, isDirect) {
                    document.getElementById('shortModalTitle').textContent = title || 'Video Short';
                    const container = document.getElementById('shortPlayerContainer');
                    container.innerHTML = '';

                    const isDirectFile = (isDirect === 'true' || isDirect === true || (url && (url.endsWith('.mp4') || url.endsWith('.webm') || url.endsWith('.mov') || url.startsWith('/uploads/'))));

                    if (isDirectFile && !url.includes('youtube') && !url.includes('tiktok') && !url.includes('instagram') && !url.includes('facebook') && !url.includes('fb.watch') && !url.includes('vimeo')) {
                        const video = document.createElement('video');
                        video.src = url;
                        video.controls = true;
                        video.autoplay = true;
                        video.playsInline = true;
                        video.style.width = '100%';
                        video.style.height = '100%';
                        video.style.objectFit = 'cover';
                        container.appendChild(video);
                    } else {
                        let embedUrl = url;
                        if (url.includes('youtube.com/shorts/')) {
                            const videoId = url.split('/shorts/')[1].split('?')[0].split('&')[0].split('/')[0];
                            embedUrl = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0&playsinline=1';
                        } else if (url.includes('youtu.be/')) {
                            const videoId = url.split('youtu.be/')[1].split('?')[0].split('&')[0];
                            embedUrl = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0&playsinline=1';
                        } else if (url.includes('watch?v=')) {
                            const videoId = url.split('watch?v=')[1].split('&')[0];
                            embedUrl = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0&playsinline=1';
                        } else if (url.includes('tiktok.com/')) {
                            const match = url.match(/\/video\/(\d+)/);
                            const videoId = match ? match[1] : '';
                            if (videoId) embedUrl = 'https://www.tiktok.com/embed/v2/' + videoId;
                        } else if (url.includes('instagram.com/reel/') || url.includes('instagram.com/p/')) {
                            const cleanUrl = url.split('?')[0].replace(/\/+$/, '');
                            embedUrl = cleanUrl + '/embed';
                        } else if (url.includes('facebook.com') || url.includes('fb.watch')) {
                            embedUrl = 'https://www.facebook.com/plugins/video.php?href=' + encodeURIComponent(url) + '&show_text=false&autoplay=true';
                        } else if (url.includes('vimeo.com/')) {
                            const match = url.match(/vimeo\.com\/(\d+)/);
                            const videoId = match ? match[1] : '';
                            if (videoId) embedUrl = 'https://player.vimeo.com/video/' + videoId + '?autoplay=1';
                        }

                        const iframe = document.createElement('iframe');
                        iframe.src = embedUrl;
                        iframe.width = '100%';
                        iframe.height = '100%';
                        iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
                        iframe.allowFullscreen = true;
                        iframe.style.border = 'none';
                        container.appendChild(iframe);
                    }

                    const modal = new bootstrap.Modal(document.getElementById('shortVideoModal'));
                    modal.show();

                    document.getElementById('shortVideoModal').addEventListener('hidden.bs.modal', function () {
                        container.innerHTML = '';
                    }, { once: true });
                }
            </script>
    </body>
</html>
