<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

    <body class="noticias-page">

        <%- include('partials/header') %>

            <main class="main">
                <!-- Page Title -->
                <div class="page-title dark-background" style="background: linear-gradient(135deg, #18120c 0%, #291e13 100%); border-bottom: 2px solid #d4a853;">
                    <div class="container d-lg-flex justify-content-between align-items-center py-4">
                        <div>
                            <span class="badge px-3 py-1 rounded-pill mb-2" style="background: rgba(212,168,83,0.2); color: #f5cf7c; border: 1px solid rgba(212,168,83,0.4); font-size: 0.8rem; letter-spacing: 1px;">
                                <i class="bi bi-broadcast me-1"></i> ACTUALIDAD & ACONTECIMIENTOS
                            </span>
                            <h1 class="mb-2" style="font-size: 2.4rem; font-weight: 800; color: #ffffff;">Noticias Mundiales</h1>
                            <p class="text-white-50 mb-0" style="font-size: 1.05rem;">Acontecimientos globales, análisis bíblico-profético y cápsulas informativas en video</p>
                        </div>
                        <nav class="breadcrumbs mt-3 mt-lg-0">
                            <ol>
                                <li><a href="/">Inicio</a></li>
                                <li class="current">Noticias</li>
                            </ol>
                        </nav>
                    </div>
                </div>

                <!-- SECCIÓN SHORTS DE NOTICIAS (Videos Verticales) -->
                <% if (typeof shorts !== 'undefined' && shorts && shorts.length > 0) { %>
                <section class="noticias-shorts-section py-4" style="background: #120d09; border-bottom: 1px solid rgba(212,168,83,0.2);">
                    <div class="container">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-danger rounded-pill px-2 py-1"><i class="bi bi-camera-reels-fill me-1"></i> SHORTS</span>
                                <h4 class="mb-0 text-white fw-bold" style="font-size: 1.25rem;">Cápsulas en Video</h4>
                            </div>
                            <span class="text-white-50 small">Resúmenes rápidos de acontecimientos</span>
                        </div>

                        <div class="shorts-scroll-container d-flex gap-3 pb-2" style="overflow-x: auto; scrollbar-width: thin; scroll-snap-type: x mandatory;">
                            <% shorts.forEach((s) => { %>
                                <% 
                                    let videoLink = s.youtube_short_url || s.youtube_url || s.video_url || '#';
                                    let isDirectVideo = !!s.video_url && !s.youtube_short_url && !s.youtube_url;
                                %>
                                <div class="short-card flex-shrink-0 position-relative rounded-4 overflow-hidden shadow" 
                                     style="width: 180px; height: 280px; background: #221912; border: 1px solid rgba(212,168,83,0.3); scroll-snap-align: start; cursor: pointer;"
                                     onclick="openShortModal('<%= s.title.replace(/'/g, "\\'") %>', '<%= videoLink %>', '<%= isDirectVideo %>')">
                                    <img src="<%= s.thumbnail_url || '/assets/img/blog/blog-1.jpg' %>" alt="<%= s.title %>" class="w-100 h-100 object-fit-cover" style="filter: brightness(0.85); transition: transform 0.4s ease;">
                                    
                                    <div class="position-absolute top-0 start-0 m-2">
                                        <span class="badge px-2 py-1 rounded-pill" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); font-size: 0.68rem; color: #f5cf7c; border: 1px solid rgba(212,168,83,0.3);">
                                            <%= s.category || 'Actualidad' %>
                                        </span>
                                    </div>

                                    <div class="position-absolute top-50 start-50 translate-middle">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 44px; height: 44px; background: rgba(212,168,83,0.9); color: #1a1208;">
                                            <i class="bi bi-play-fill fs-4 ms-1"></i>
                                        </div>
                                    </div>

                                    <div class="position-absolute bottom-0 start-0 w-100 p-2 text-white" style="background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, transparent 100%);">
                                        <p class="mb-0 fw-semibold text-truncate-2" style="font-size: 0.8rem; line-height: 1.3;">
                                            <%= s.title %>
                                        </p>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </section>
                <% } %>

                <!-- SECCIÓN CATÁLOGO DE NOTICIAS -->
                <section id="noticias-posts" class="noticias-posts section py-5" style="background-color: #faf9f6;">
                    <div class="container">
                        
                        <!-- Barra de Búsqueda y Filtros de Categoría -->
                        <div class="row align-items-center mb-5 gy-3">
                            <div class="col-lg-7 col-12">
                                <div class="blog-filter-pills d-flex flex-wrap gap-2">
                                    <a href="/noticias" class="badge-filter <%= activeCategory === 'all' ? 'active' : '' %>">
                                        <i class="bi bi-grid-fill me-1"></i> Todas
                                        <span class="count-pill ms-1"><%= totalCount %></span>
                                    </a>
                                    <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
                                        <% categories.forEach(cat => { %>
                                            <a href="/noticias?category=<%= encodeURIComponent(cat.category) %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" 
                                               class="badge-filter <%= activeCategory === cat.category ? 'active' : '' %>">
                                                <%= cat.category %>
                                                <span class="count-pill ms-1"><%= cat.count %></span>
                                            </a>
                                        <% }) %>
                                    <% } %>
                                </div>
                            </div>
                            <div class="col-lg-5 col-12">
                                <form action="/noticias" method="GET" class="d-flex search-blog-form">
                                    <% if (activeCategory && activeCategory !== 'all') { %>
                                        <input type="hidden" name="category" value="<%= activeCategory %>">
                                    <% } %>
                                    <div class="input-group shadow-sm" style="border-radius: 30px; overflow: hidden; border: 1px solid #ebdccb;">
                                        <span class="input-group-text bg-white border-0 text-muted ps-3"><i class="bi bi-search"></i></span>
                                        <input type="text" name="q" class="form-control border-0 py-2" placeholder="Buscar acontecimientos o noticias..." value="<%= searchQuery || '' %>">
                                        <button class="btn btn-gold px-4 fw-semibold" type="submit">Buscar</button>
                                        <% if (searchQuery) { %>
                                            <a href="/noticias<%= activeCategory !== 'all' ? '?category=' + encodeURIComponent(activeCategory) : '' %>" class="btn btn-outline-secondary d-flex align-items-center" title="Limpiar">✕</a>
                                        <% } %>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Grid de Noticias Cortas -->
                        <div class="row gy-4">
                            <% if (typeof newsList !== 'undefined' && newsList && newsList.length > 0) { %>
                                <% newsList.forEach((item, index) => { %>
                                    <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-delay="<%= (index % 3 + 1) * 100 %>">
                                        <article class="news-card h-100 shadow-sm" style="background: #ffffff; border-radius: 18px; overflow: hidden; border: 1px solid #ebe5dc; display: flex; flex-direction: column; transition: all 0.35s ease;">
                                            <div class="news-img-box position-relative" style="width: 100%; height: 210px; overflow: hidden; background: #1a1a1a;">
                                                <a href="/noticias/<%= item.id %>" class="d-block w-100 h-100">
                                                    <% if (item.image_url && item.image_url.trim() !== '') { %>
                                                        <img src="<%= item.image_url %>" alt="<%= item.title %>" class="w-100 h-100 object-fit-cover news-zoom-img">
                                                    <% } else { %>
                                                        <div class="d-flex align-items-center justify-content-center h-100 w-100" style="background: linear-gradient(135deg, #efe8db, #dfd4bf);">
                                                            <i class="bi bi-globe-americas text-muted" style="font-size: 3.5rem; color: #d4a853 !important;"></i>
                                                        </div>
                                                    <% } %>
                                                </a>
                                                <span class="position-absolute top-0 start-0 m-3 px-3 py-1 rounded-pill text-white fw-bold shadow-sm" 
                                                      style="background: linear-gradient(135deg, #d4a853, #b8860b); font-size: 0.72rem; letter-spacing: 0.5px; text-transform: uppercase;">
                                                    <%= item.category || 'Mundial' %>
                                                </span>
                                                <% if (item.is_breaking) { %>
                                                    <span class="position-absolute top-0 end-0 m-3 px-2 py-1 rounded-pill text-white fw-bold shadow-sm bg-danger" style="font-size: 0.7rem;">
                                                        <i class="bi bi-lightning-fill"></i> Urgente
                                                    </span>
                                                <% } %>
                                            </div>

                                            <div class="p-4 d-flex flex-column flex-grow-1">
                                                <div class="d-flex align-items-center gap-3 mb-2 text-muted" style="font-size: 0.8rem;">
                                                    <span><i class="bi bi-calendar3 me-1" style="color: #d4a853;"></i> <%= item.published_at ? new Date(item.published_at).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }) : '-' %></span>
                                                    <span><i class="bi bi-pencil-square me-1" style="color: #d4a853;"></i> <%= item.author || 'Redacción' %></span>
                                                </div>

                                                <h4 class="fw-bold mb-2" style="font-size: 1.18rem; line-height: 1.35;">
                                                    <a href="/noticias/<%= item.id %>" class="text-decoration-none text-dark hover-gold-title">
                                                        <%= item.title %>
                                                    </a>
                                                </h4>

                                                <% if (item.subtitle) { %>
                                                    <p class="text-muted small mb-2 fst-italic" style="color: #8c7b6c !important;"><%= item.subtitle %></p>
                                                <% } %>

                                                <% if (item.summary) { %>
                                                    <p class="text-muted mb-3" style="font-size: 0.88rem; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                                        <%= item.summary %>
                                                    </p>
                                                <% } %>

                                                <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                                    <a href="/noticias/<%= item.id %>" class="btn-read-more text-decoration-none fw-bold" style="color: #d4a853; font-size: 0.88rem;">
                                                        Leer noticia <i class="bi bi-arrow-right"></i>
                                                    </a>
                                                    <span class="text-muted small"><i class="bi bi-eye me-1"></i><%= item.views || 0 %></span>
                                                </div>
                                            </div>
                                        </article>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="col-12 text-center py-5">
                                    <div class="p-5 rounded-4 shadow-sm bg-white border mx-auto" style="max-width: 600px;">
                                        <i class="bi bi-globe-americas text-muted mb-3 d-block" style="font-size: 3rem; color: #d4a853 !important;"></i>
                                        <h4 class="fw-bold">No se encontraron noticias</h4>
                                        <p class="text-muted mb-4">Pronto estaremos publicando nuevos acontecimientos y cápsulas informativas.</p>
                                        <a href="/noticias" class="btn btn-gold rounded-pill px-4">Ver todas las noticias</a>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </section>
            </main>

            <!-- MODAL REPRODUCTOR DE VIDEO SHORT -->
            <div class="modal fade" id="shortVideoModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                    <div class="modal-content bg-black text-white border border-secondary rounded-4 overflow-hidden">
                        <div class="modal-header border-0 p-3 pb-0">
                            <h6 class="modal-title text-truncate fw-bold pe-2" id="shortModalTitle"></h6>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-2 text-center">
                            <div id="shortPlayerContainer" class="rounded-3 overflow-hidden bg-dark" style="aspect-ratio: 9/16; width: 100%;">
                                <!-- Dinámico iframe o video -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('partials/footer') %>

            <style>
                .badge-filter {
                    display: inline-flex;
                    align-items: center;
                    background: #ffffff;
                    color: #4a3e35;
                    border: 1px solid #e2d7c7;
                    padding: 8px 18px;
                    border-radius: 30px;
                    font-size: 0.88rem;
                    font-weight: 600;
                    text-decoration: none;
                    transition: all 0.25s ease;
                }
                .badge-filter:hover, .badge-filter.active {
                    background: linear-gradient(135deg, #d4a853, #b8860b);
                    color: #ffffff;
                    border-color: #b8860b;
                    box-shadow: 0 4px 12px rgba(212,168,83,0.3);
                }
                .count-pill {
                    background: rgba(0,0,0,0.08);
                    padding: 2px 7px;
                    border-radius: 12px;
                    font-size: 0.75rem;
                }
                .badge-filter.active .count-pill {
                    background: rgba(255,255,255,0.25);
                }
                .btn-gold {
                    background: linear-gradient(135deg, #d4a853, #b8860b);
                    color: #ffffff;
                    border: none;
                }
                .btn-gold:hover {
                    background: linear-gradient(135deg, #b8860b, #976e07);
                    color: #ffffff;
                }
                .news-card:hover {
                    transform: translateY(-6px);
                    box-shadow: 0 12px 28px rgba(0,0,0,0.1) !important;
                    border-color: #d4a853 !important;
                }
                .news-card:hover .news-zoom-img {
                    transform: scale(1.06);
                }
                .news-zoom-img {
                    transition: transform 0.5s ease;
                }
                .hover-gold-title:hover {
                    color: #b8860b !important;
                }
                .short-card:hover img {
                    transform: scale(1.08);
                }
                .text-truncate-2 {
                    display: -webkit-box;
                    -webkit-line-clamp: 2;
                    -webkit-box-orient: vertical;
                    overflow: hidden;
                }
            </style>

            <script>
                function openShortModal(title, url, isDirect) {
                    document.getElementById('shortModalTitle').textContent = title;
                    const container = document.getElementById('shortPlayerContainer');
                    container.innerHTML = '';

                    if (isDirect === 'true') {
                        const video = document.createElement('video');
                        video.src = url;
                        video.controls = true;
                        video.autoplay = true;
                        video.style.width = '100%';
                        video.style.height = '100%';
                        video.style.objectFit = 'cover';
                        container.appendChild(video);
                    } else {
                        let embedUrl = url;
                        if (url.includes('/shorts/')) {
                            const videoId = url.split('/shorts/')[1].split('?')[0];
                            embedUrl = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0';
                        } else if (url.includes('watch?v='')) {
                            const videoId = url.split('watch?v=')[1].split('&')[0];
                            embedUrl = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0';
                        }
                        const iframe = document.createElement('iframe');
                        iframe.src = embedUrl;
                        iframe.width = '100%';
                        iframe.height = '100%';
                        iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
                        iframe.allowFullscreen = true;
                        iframe.style.border = 'none';
                        container.appendChild(iframe);
                    }

                    const modal = new bootstrap.Modal(document.getElementById('shortVideoModal'));
                    modal.show();

                    document.getElementById('shortVideoModal').addEventListener('hidden.bs.modal', function () {
                        container.innerHTML = '';
                    }, { once: true });
                }
            </script>
    </body>
</html>
