<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

    <body class="index-page">

        <%- include('partials/header') %>

            <main class="main">

                <!-- Hero Section -->
                <section id="hero" class="hero section dark-background" style="<%= (sections.Hero && sections.Hero.image_url) ? `background: url('${sections.Hero.image_url}') center center / cover no-repeat !important;` : '' %>">
                    <div class="container text-center">
                        <div class="row justify-content-center" data-aos="zoom-out">
                            <div class="col-lg-8">
                                <img src="/assets/img/pagina/logo.svg" alt="YHWH Hero Logo" class="img-fluid mb-3 logo-spin"
                                    style="max-height: 350px; border-radius: 50%; object-fit: cover; aspect-ratio: 1/1;">
                                <h2>
                                    <%= (sections.Hero && sections.Hero.title) || 'Hablemos de YHWH' %>
                                </h2>
                                <p>
                                    <%= (sections.Hero && sections.Hero.subtitle)
                                        || 'Somos un grupo de personas dedicados al estudio de las Sagradas escrituras, desde una perspectiva Hebrea'
                                        %>
                                </p>
                                <a href="#about" class="btn-get-started">Comencemos!!!</a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Sobre Nosotros / Quiénes Somos Section -->
                <section id="about" class="about section" style="background: linear-gradient(180deg, #fbfaf8 0%, #f4f0e8 100%); position: relative; padding: 80px 0;">
                    
                    <!-- Decoración de fondo sutil -->
                    <div style="position: absolute; top: -50px; right: -50px; width: 300px; height: 300px; background: radial-gradient(circle, rgba(212,168,83,0.12) 0%, transparent 70%); pointer-events: none;"></div>
                    <div style="position: absolute; bottom: -50px; left: -50px; width: 350px; height: 350px; background: radial-gradient(circle, rgba(212,168,83,0.08) 0%, transparent 70%); pointer-events: none;"></div>

                    <div class="container position-relative" data-aos="fade-up">
                        
                        <!-- Encabezado Central con Badge Editorial -->
                        <div class="text-center mb-5">
                            <span class="badge px-3 py-2 rounded-pill mb-3 shadow-sm" style="background: rgba(212,168,83,0.15); color: #b8860b; border: 1px solid rgba(212,168,83,0.35); font-weight: 700; font-size: 0.85rem; letter-spacing: 1.5px; text-transform: uppercase;">
                                <i class="bi bi-stars me-1 text-warning"></i> Nuestro Propósito
                            </span>
                            <h2 class="fw-bold mb-3" style="color: #1a1410; font-size: 2.6rem; letter-spacing: -0.5px;">
                                <%= siteSettings.site_name || 'Hablemos de YHWH' %>
                            </h2>
                            <div class="d-flex justify-content-center align-items-center gap-2 mb-4">
                                <span style="width: 40px; height: 2px; background: #d4a853;"></span>
                                <i class="bi bi-book-half" style="color: #d4a853;"></i>
                                <span style="width: 40px; height: 2px; background: #d4a853;"></span>
                            </div>

                            <!-- Manifiesto Principal en Tarjeta Editorial -->
                            <% if (sections.About && sections.About.subtitle) { %>
                                <div class="mx-auto text-start p-4 p-md-5 rounded-4 shadow-sm position-relative" style="max-width: 960px; background: #ffffff; border: 1px solid #ede8df; border-left: 5px solid #d4a853;">
                                    <i class="bi bi-quote position-absolute text-muted" style="top: 15px; right: 25px; font-size: 3.5rem; opacity: 0.15; pointer-events: none;"></i>
                                    <p class="mb-0" style="font-size: 1.12rem; line-height: 1.85; color: #4a3e35; font-weight: 400;">
                                        <%= sections.About.subtitle %>
                                    </p>
                                </div>
                            <% } %>
                        </div>

                        <!-- Sección Dos Columnas: Imagen Histórica + Quiénes Somos -->
                        <div class="row gy-4 align-items-center mt-3">
                            
                            <!-- Columna Izquierda: Imagen en Marco Premium -->
                            <div class="col-lg-5" data-aos="fade-right" data-aos-delay="150">
                                <div class="position-relative p-2 rounded-4 shadow-lg" style="background: #ffffff; border: 1px solid #ede8df;">
                                    <div class="overflow-hidden rounded-4 position-relative" style="aspect-ratio: 4/3; max-height: 420px;">
                                        <img src="<%= (sections.About && sections.About.image_url) || '/assets/img/about.png' %>"
                                            class="img-fluid w-100 h-100 object-fit-cover" 
                                            alt="<%= (sections.About && sections.About.title) || 'Quiénes somos' %>"
                                            style="transition: transform 0.6s ease; object-position: center;"
                                            onmouseover="this.style.transform='scale(1.05)'"
                                            onmouseout="this.style.transform='scale(1)'">
                                        
                                        <!-- Insignia flotante sobre la imagen -->
                                        <div class="position-absolute bottom-0 start-0 m-3 px-3 py-2 rounded-3 shadow-lg" style="background: rgba(26,20,16,0.88); backdrop-filter: blur(8px); border: 1px solid rgba(212,168,83,0.4);">
                                            <div class="fw-bold text-warning small d-flex align-items-center gap-1">
                                                <i class="bi bi-journal-bookmark-fill"></i> Raíces Hebreas
                                            </div>
                                            <div class="text-white-50" style="font-size: 0.75rem;">Fieles a las Sagradas Escrituras</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Columna Derecha: Quiénes somos y Pilares -->
                            <div class="col-lg-7 ps-lg-4" data-aos="fade-left" data-aos-delay="200">
                                <div class="ps-lg-2">
                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <span class="badge rounded-pill px-3 py-1" style="background: #fdf6e7; color: #b8860b; border: 1px solid #f2e3be; font-size: 0.8rem; font-weight: 700;">
                                            <i class="bi bi-people-fill me-1"></i> Nuestra Identidad
                                        </span>
                                    </div>
                                    <h3 class="fw-bold mb-3" style="color: #1a1410; font-size: 2.2rem; letter-spacing: -0.5px;">
                                        <%= (sections.About && sections.About.title) || 'Quiénes somos' %>
                                    </h3>

                                    <% 
                                        const rawContent = (sections.About && sections.About.content) || '';
                                        const paragraphs = rawContent.split(/\r?\n+/).map(p => p.trim()).filter(p => p.length > 0);
                                    %>

                                    <% if (paragraphs.length > 0) { %>
                                        <div class="about-paragraphs">
                                            <% paragraphs.forEach((para, idx) => { %>
                                                <% if (para.toLowerCase().startsWith('creemos')) { %>
                                                    <!-- Tarjeta destacada para declaraciones de fe / propósito -->
                                                    <div class="d-flex align-items-start gap-3 p-3 mb-2 rounded-3 shadow-sm" style="background: #ffffff; border: 1px solid #ede8df; border-left: 4px solid #d4a853;">
                                                        <i class="bi bi-check-circle-fill text-warning fs-5 flex-shrink-0 mt-1"></i>
                                                        <p class="mb-0" style="color: #4a3e35; font-size: 1.02rem; line-height: 1.6;">
                                                            <strong><%= para.split('.')[0] %></strong><%= para.includes('.') ? para.substring(para.indexOf('.')) : '' %>
                                                        </p>
                                                    </div>
                                                <% } else if (idx === 0) { %>
                                                    <p class="lead mb-3" style="color: #2b231d; font-size: 1.15rem; line-height: 1.8; font-weight: 500;">
                                                        <%= para %>
                                                    </p>
                                                <% } else { %>
                                                    <p class="mb-3" style="color: #55483d; font-size: 1.02rem; line-height: 1.75;">
                                                        <%= para %>
                                                    </p>
                                                <% } %>
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <p class="lead" style="color: #4a3e35; line-height: 1.8;">
                                            Somos un grupo de personas dedicados al estudio de las Sagradas escrituras, desde una perspectiva Hebrea.
                                        </p>
                                    <% } %>
                                </div>
                            </div>

                        </div>
                    </div>
                </section>

                <!-- Torah Viviente Slider Section -->
                <section id="torah-viviente" class="torah-viviente section dark-background" style="position: relative; overflow: hidden; padding: 60px 0;">
                    <style>
                        #torah-viviente .swiper-slide {
                            width: 85%; /* Anchura de la diapositiva central */
                            max-width: 1200px;
                            opacity: 0.3; /* Diapositivas inactivas se ven más oscuras */
                            transition: opacity 0.5s ease, transform 1.5s ease;
                            -webkit-box-reflect: below 5px linear-gradient(transparent, transparent 80%, rgba(0,0,0,0.3));
                        }
                        #torah-viviente .swiper-slide-active {
                            opacity: 1; /* Diapositiva central totalmente visible */
                        }
                    </style>
                    <div class="container" data-aos="fade-up">
                        <div class="section-title text-center mb-4">
                            <h2 style="color: #d4a853; font-weight: 700;">Torah Viviente</h2>
                            <p style="color: #ccc;">Biblia de Estudio Hebreo — Disponible para descargar</p>
                        </div>
                        <div class="swiper init-swiper" style="padding-bottom: 60px;">
                            <script type="application/json" class="swiper-config">
                            {
                                "loop": true,
                                "speed": 1000,
                                "autoplay": { "delay": 3000, "disableOnInteraction": false },
                                "effect": "coverflow",
                                "grabCursor": true,
                                "centeredSlides": true,
                                "slidesPerView": "auto",
                                "coverflowEffect": {
                                    "rotate": 0,
                                    "stretch": -20,
                                    "depth": 300,
                                    "modifier": 1.5,
                                    "slideShadows": true
                                },
                                "pagination": { "el": ".swiper-pagination-tv", "type": "bullets", "clickable": true }
                            }
                            </script>
                            <div class="swiper-wrapper">
                                <div class="swiper-slide" style="border-radius: 16px; overflow: hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.6);">
                                    <img src="/assets/img/toraviviente/slide1.png" alt="Torah Viviente - Fuentes Textuales" style="width: 100%; height: auto; display: block;">
                                </div>
                                <div class="swiper-slide" style="border-radius: 16px; overflow: hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.6);">
                                    <img src="/assets/img/toraviviente/slide2.png" alt="Torah Viviente - Brit Hadasha" style="width: 100%; height: auto; display: block;">
                                </div>
                                <div class="swiper-slide" style="border-radius: 16px; overflow: hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.6);">
                                    <img src="/assets/img/toraviviente/slide3.png" alt="Torah Viviente - Bereshit" style="width: 100%; height: auto; display: block;">
                                </div>
                            </div>
                            <div class="swiper-pagination swiper-pagination-tv" style="bottom: 0;"></div>
                        </div>

                        <!-- Download Button -->
                        <div class="text-center mt-4" data-aos="zoom-in" data-aos-delay="200">
                            <p style="color: #e0d6c2; font-size: 1.1rem; margin-bottom: 16px;">
                                <i class="bi bi-download" style="margin-right: 6px;"></i>
                                ¿Deseas descargar la aplicación Torah Viviente?
                            </p>
                            <a href="http://torahviviente.com" target="_blank" rel="noopener noreferrer"
                               class="torah-viviente-btn"
                               onclick="if(typeof gtag === 'function') gtag('event', 'click_descargar_torah', { 'event_category': 'Botones', 'event_label': 'Descargar Torah Viviente' });"
                               style="display: inline-block; transition: transform 0.3s ease, box-shadow 0.3s ease; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(212,168,83,0.4);">
                                <img src="/assets/img/toraviviente/boton.png" alt="Descargar Torah Viviente"
                                     style="height: 70px; display: block;">
                            </a>
                        </div>
                    </div>
                </section>

                <section id="services" class="services section">
                    <div class="container section-title" data-aos="fade-up">
                        <h2><%= (sections.Parashot && sections.Parashot.title) || 'Parashot' %></h2>
                        <p><%= (sections.Parashot && sections.Parashot.subtitle) || 'Lo que ofrecemos' %></p>
                    </div>
                    <div class="container">
                        <div class="row gy-4">
                            <% services.forEach((service, index)=> { %>
                                <div class="col-lg-6 " data-aos="fade-up" data-aos-delay="<%= (index + 1) * 100 %>">
                                    <div class="service-item d-flex align-items-center justify-content-center py-2 px-3 shadow-sm" style="position: relative; background: #ffffff; border-radius: 15px; border: 1px solid #f0f0f0;">
                                        <div class="row g-2 align-items-center w-100 flex-nowrap">
                                            <!-- Columna 1: Icono -->
                                            <div class="col-auto d-none d-md-flex">
                                                <div class="icon flex-shrink-0" style="width: 50px; height: 50px; background: #f8f9fa; color: var(--primary-color); border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 1px solid #eee;">
                                                    <i class="bi <%= service.icon || 'bi-journal-text' %>" style="font-size: 1.2rem;"></i>
                                                </div>
                                            </div>
                                            
                                            <!-- Columna 2: Texto (Título + Subtítulo + Descripción + Vistas) -->
                                            <div class="col text-start ps-2 overflow-hidden">
                                                <div class="d-flex align-items-center justify-content-between gap-1">
                                                    <h4 class="title mb-0" style="font-size: 1.2rem; font-weight: 700; white-space: nowrap;">
                                                        <a href="/parashot/<%= service.id %>" class="stretched-link" style="color: #222;">
                                                            <%= service.parasha_number ? service.parasha_number + '. ' : '' %><%= service.title %>
                                                        </a>
                                                    </h4>
                                                    <span class="badge rounded-pill px-2 py-1 shadow-sm d-inline-flex align-items-center" style="background: #fdf6e7; color: #8c6a2d; font-size: 0.72rem; font-weight: 600; border: 1px solid #ebdccb; z-index: 2; position: relative;">
                                                        <i class="bi bi-eye-fill me-1 text-info"></i><%= service.views || 0 %>
                                                    </span>
                                                </div>
                                                <% if (service.subtitle) { %>
                                                    <div class="subtitle mb-0" style="color: var(--primary-color); font-size: 0.85rem; font-weight: 600; line-height: 1.2;">
                                                        <%= service.subtitle %>
                                                    </div>
                                                <% } %>
                                                <p class="description mb-0 text-truncate" style="color: #666; font-size: 0.8rem; opacity: 0.8;">
                                                    <%= service.description %>
                                                </p>
                                            </div>

                                            <!-- Columna 3: Imagen o Proximamente -->
                                            <div class="col-auto">
                                                <% if (service.image_url && service.image_url.trim() !== '') { %>
                                                    <div class="parasha-cover-mini" style="width: 150px; height: 100px; border-radius: 10px; overflow: hidden; background: #f8f9fa; border: 1px solid #ddd; display: flex; align-items: center; justify-content: center;">
                                                        <img src="<%= service.image_url %>" alt="<%= service.title %>" style="width: 100%; height: 100%; object-fit: contain;"
                                                             onerror="this.onerror=null; this.closest('.parasha-cover-mini').outerHTML='<div class=\'parasha-cover-placeholder position-relative d-flex flex-column align-items-center justify-content-center text-center p-2\' style=\'width: 145px; height: 95px; border-radius: 10px; background: linear-gradient(135deg, #fdfbf7 0%, #f5ece0 100%); border: 1.5px dashed #d4a853; box-shadow: inset 0 0 8px rgba(212,168,83,0.1);\'><i class=\'bi bi-hourglass-split mb-1\' style=\'font-size: 1.25rem; color: #b8860b;\'></i><span class=\'badge px-2 py-1 shadow-sm\' style=\'font-size: 0.72rem; font-weight: 700; background: linear-gradient(135deg, #d4a853, #b8860b); color: #ffffff; letter-spacing: 0.3px;\'>Próximamente...</span></div>';">
                                                    </div>
                                                <% } else { %>
                                                    <div class="parasha-cover-placeholder position-relative d-flex flex-column align-items-center justify-content-center text-center p-2" 
                                                         style="width: 145px; height: 95px; border-radius: 10px; background: linear-gradient(135deg, #fdfbf7 0%, #f5ece0 100%); border: 1.5px dashed #d4a853; box-shadow: inset 0 0 8px rgba(212,168,83,0.1);">
                                                        <i class="bi bi-hourglass-split mb-1" style="font-size: 1.25rem; color: #b8860b;"></i>
                                                        <span class="badge px-2 py-1 shadow-sm" style="font-size: 0.72rem; font-weight: 700; background: linear-gradient(135deg, #d4a853, #b8860b); color: #ffffff; letter-spacing: 0.3px;">
                                                            Próximamente...
                                                        </span>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                        <div class="text-center mt-4" data-aos="fade-up">
                            <a href="/parashot"
                                style="background-color: #d4b895; color: #fff; padding: 12px 40px; border-radius: 50px; display: inline-block; text-decoration: none; font-weight: 600;">Ver
                                todas</a>
                        </div>
                    </div>
                </section>

                <!-- Sección de Haftará (Lecturas Proféticas) - Justo después de Parashot -->
                <section id="haftara" class="haftara section" style="background-color: #faf8f5; padding: 70px 0;">
                    <div class="container section-title" data-aos="fade-up">
                        <h2>Haftará</h2>
                        <p>Lecturas y reflexiones de los Profetas (Nevi'im) conectadas a la porción de la Toráh</p>
                    </div>
                    <div class="container" data-aos="fade-up" data-aos-delay="100">
                        <% if (typeof haftarot !== 'undefined' && haftarot && haftarot.length > 0) { %>
                            <div class="row gy-4 justify-content-center">
                                <% haftarot.forEach((item, index) => { %>
                                    <div class="col-lg-3 col-md-6 col-12" data-aos="fade-up" data-aos-delay="<%= (index + 1) * 100 %>">
                                        <a href="/haftara/<%= item.id %>" class="text-decoration-none text-reset d-block h-100">
                                            <div class="haftara-card h-100 shadow-sm" style="background: #ffffff; border-radius: 16px; overflow: hidden; border: 1px solid #ebdccb; transition: all 0.35s ease; display: flex; flex-direction: column;">
                                                <div class="haftara-img-box" style="position: relative; width: 100%; height: 200px; overflow: hidden; background: #1a1a1a;">
                                                    <% 
                                                        const hDisplayImg = item.display_image || item.image_url || item.youtube_thumbnail || item.parasha_image_url || '';
                                                        const hYtThumb = item.youtube_thumbnail || (item.youtube_id ? `https://img.youtube.com/vi/${item.youtube_id}/hqdefault.jpg` : '');
                                                    %>
                                                    <% if (hDisplayImg) { %>
                                                        <img src="<%= hDisplayImg %>" alt="<%= item.title %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;"
                                                             onerror="if(this.src !== '<%= hYtThumb %>' && '<%= hYtThumb %>') { this.src = '<%= hYtThumb %>'; } else { this.style.display = 'none'; const ph = this.parentElement.querySelector('.haftara-home-fallback'); if (ph) { ph.classList.remove('d-none'); ph.classList.add('d-flex'); } }">
                                                        <div class="haftara-home-fallback d-none align-items-center justify-content-center h-100 w-100 position-absolute top-0 start-0" style="background: linear-gradient(135deg, #2b231d, #1a1614); color: #fff;">
                                                            <div class="text-center p-2">
                                                                <i class="bi bi-scroll text-warning" style="font-size: 2.8rem;"></i>
                                                                <div><span class="badge rounded-pill mt-2 px-2 py-1" style="background: rgba(212,168,83,0.25); color: #d4a853; font-size: 0.72rem;">Nevi'im</span></div>
                                                            </div>
                                                        </div>
                                                    <% } else { %>
                                                        <div class="d-flex flex-column align-items-center justify-content-center h-100 w-100 position-absolute top-0 start-0" style="background: linear-gradient(135deg, #2b231d, #1a1614); color: #fff;">
                                                            <i class="bi bi-scroll text-warning" style="font-size: 2.8rem;"></i>
                                                            <span class="badge rounded-pill mt-2 px-2 py-1" style="background: rgba(212,168,83,0.25); color: #d4a853; font-size: 0.72rem;">Nevi'im</span>
                                                        </div>
                                                    <% } %>
                                                    <% if (item.youtube_link) { %>
                                                        <span class="badge bg-danger position-absolute top-0 start-0 m-2 px-2 py-1" style="font-size: 0.7rem;"><i class="bi bi-youtube me-1"></i>Video</span>
                                                    <% } %>
                                                </div>
                                                <div class="p-3 d-flex flex-column flex-grow-1">
                                                    <h5 class="fw-bold mb-1" style="font-size: 1.05rem; color: #222; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                                        <%= item.title %>
                                                    </h5>
                                                    <div class="d-flex align-items-center justify-content-between mb-2 gap-1 flex-wrap">
                                                        <% if (item.subtitle || item.parasha_reference) { %>
                                                            <div class="text-truncate" style="color: #b8860b; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; max-width: 60%;">
                                                                <%= item.subtitle || item.parasha_reference %>
                                                            </div>
                                                        <% } else { %>
                                                            <span></span>
                                                        <% } %>
                                                        <% if (item.parasha_title) { %>
                                                            <span class="badge rounded-pill px-2 py-1" style="background: #fdf6e7; color: #8c6a2d; font-size: 0.72rem; font-weight: 600;">
                                                                <i class="bi bi-book me-1 text-warning"></i>Torá: <%= item.parasha_number ? '#' + item.parasha_number + ' ' : '' %><%= item.parasha_title %>
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                    <% if (item.description) { %>
                                                        <p class="text-muted mb-3" style="font-size: 0.85rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                                            <%= item.description %>
                                                        </p>
                                                    <% } %>
                                                    <div class="mt-auto pt-2 border-top d-flex align-items-center justify-content-between">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <img src="<%= item.author_img || '/assets/img/team/kaleb.jpg' %>" alt="<%= item.author || 'Moréh Kaleb' %>" style="width: 30px; height: 30px; border-radius: 50%; object-fit: cover; border: 2px solid #d4a853;">
                                                            <div class="min-width-0">
                                                                <div class="fw-bold text-truncate" style="font-size: 0.82rem; color: #222;"><%= item.author || 'Moréh Kaleb' %></div>
                                                                <div class="text-muted" style="font-size: 0.72rem; line-height: 1;"><%= item.author_role || 'Moréh' %></div>
                                                            </div>
                                                        </div>
                                                        <span class="text-muted small ms-2 flex-shrink-0"><i class="bi bi-eye me-1"></i><%= item.views || 0 %></span>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                <% }) %>
                            </div>
                            <div class="text-center mt-5" data-aos="fade-up">
                                <a href="/haftara"
                                    style="background: linear-gradient(135deg, #d4a853, #b8860b); color: #fff; padding: 12px 40px; border-radius: 50px; display: inline-block; text-decoration: none; font-weight: 600; box-shadow: 0 4px 15px rgba(212,168,83,0.35); transition: all 0.3s ease;">
                                    Ver todas las Haftarot <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        <% } else { %>
                            <div class="text-center py-4">
