                            <button type="button" class="btn btn-dark rounded-circle position-absolute top-50 start-0 translate-middle-y ms-2 z-3 d-flex align-items-center justify-content-center text-white shadow" 
                                    id="shortPrevBtnHome" onclick="prevShortHome()" style="width: 42px; height: 42px; background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.2);">
                                <i class="bi bi-chevron-left"></i>
                            </button>
