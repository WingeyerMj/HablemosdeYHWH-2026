                        <!-- Video / Player Container (9:16) -->
                        <div class="modal-body p-0 position-relative" style="height: 640px; max-height: 80vh; background: #000; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                            
                            <!-- HTML5 Video Player -->
