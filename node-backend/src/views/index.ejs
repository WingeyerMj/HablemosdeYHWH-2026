                                            <i class="bi bi-arrows-expand-vertical me-1" style="transform: rotate(90deg); display: inline-block;"></i> Desliza para explorar
                                        </span>
                                        <div class="btn-group shadow-sm rounded-pill p-1" style="background: rgba(2, 132, 199, 0.08); border: 1px solid rgba(2, 132, 199, 0.2);">
                                            <button type="button" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center" id="navAliyotHomePrev" onclick="slideTrackHome('aliyotHomeShortsTrack', 'prev')" title="Anterior" style="width: 36px; height: 36px; background: #fff; color: #0284c7; border: 1px solid #bae6fd; transition: all 0.2s;">
                                                <i class="bi bi-chevron-left fw-bold"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center ms-1" id="navAliyotHomeNext" onclick="slideTrackHome('aliyotHomeShortsTrack', 'next')" title="Siguiente" style="width: 36px; height: 36px; background: #0284c7; color: #fff; border: 1px solid #0284c7; transition: all 0.2s;">
                                                <i class="bi bi-chevron-right fw-bold"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Slider Container -->
                                <div class="shorts-carousel-container position-relative">
                                    <button type="button" class="shorts-float-arrow shorts-float-left shadow-lg float-arrow-blue" onclick="slideTrackHome('aliyotHomeShortsTrack', 'prev')" id="floatAliyotHomePrev" title="Anterior">
                                        <i class="bi bi-chevron-left"></i>
                                    </button>

                                    <div class="shorts-slider-track" id="aliyotHomeShortsTrack">
                                        <% displayShortsHome.forEach((short) => { %>
                                            <% const globalIdx = allShortsHome.indexOf(short); %>
                                            <div class="frontend-short-item">
                                                <div class="card border-0 shadow-sm rounded-4 overflow-hidden short-card position-relative h-100" 
                                                     onclick="openShortModalHome(<%= globalIdx %>)" 
                                                     style="cursor: pointer; background: #000; border: 2px solid transparent; transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1); aspect-ratio: 9 / 16; max-height: 480px;">
                                                    
                                                    <img src="<%= short.thumbnail_url || '/assets/img/pagina/semillas_torah_banner.png' %>" 
                                                         alt="<%= short.title %>" 
                                                         class="short-thumb w-100 h-100" 
                                                         style="object-fit: cover; transition: transform 0.5s ease;">

                                                    <div class="position-absolute top-0 start-0 w-100 h-100 short-overlay" 
                                                         style="background: linear-gradient(180deg, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.1) 40%, rgba(0,0,0,0.88) 100%); pointer-events: none;">
                                                    </div>

                                                    <!-- Top Badges -->
                                                    <div class="position-absolute top-0 start-0 w-100 p-3 d-flex justify-content-between align-items-center z-2">
                                                        <div class="d-flex gap-1 flex-wrap">
                                                            <% if (short.is_highlight) { %>
                                                                <span class="badge rounded-pill px-2 py-1 shadow-sm" style="background: linear-gradient(135deg, #f59e0b, #d97706); font-size: 0.72rem; color: #fff;">
                                                                    <i class="bi bi-star-fill me-1"></i> Destacado
                                                                </span>
                                                            <% } %>
                                                            <span class="badge rounded-pill px-2 py-1 shadow-sm" style="background: rgba(2,132,199,0.9); backdrop-filter: blur(4px); font-size: 0.72rem; color: #fff;">
                                                                <i class="bi bi-camera-reels me-1"></i> Aliyá
                                                            </span>
                                                            <% if (short.aliyah_number) { %>
                                                                <span class="badge bg-success bg-opacity-90 rounded-pill px-2 py-1 shadow-sm" style="font-size: 0.72rem;">
                                                                    <%= short.aliyah_number %>ª Aliyá
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-1">
                                                            <span class="badge rounded-pill px-2 py-1 shadow-sm d-inline-flex align-items-center" style="background: rgba(0,0,0,0.72); color: #38bdf8; border: 1px solid rgba(56,189,248,0.4); font-size: 0.72rem; font-weight: 700; backdrop-filter: blur(4px);">
                                                                <i class="bi bi-eye-fill me-1"></i><%= short.views_count || 0 %>
                                                            </span>
                                                            <% if (short.video_url || short.youtube_short_url) { %>
                                                                <span class="badge bg-dark bg-opacity-75 rounded-circle p-2 shadow-sm text-white" title="Video disponible">
                                                                    <i class="bi bi-play-fill fs-6"></i>
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                    </div>

                                                    <!-- Play Button Overlay -->
                                                    <div class="position-absolute top-50 start-50 translate-middle play-btn-overlay z-2 text-center" style="transition: all 0.3s ease;">
                                                        <div class="rounded-circle d-flex align-items-center justify-content-center shadow-lg" 
                                                             style="width: 58px; height: 58px; background: rgba(255,255,255,0.92); color: #0284c7; font-size: 1.6rem; backdrop-filter: blur(4px); transition: transform 0.3s ease;">
                                                            <i class="bi bi-play-fill ms-1"></i>
                                                        </div>
                                                    </div>

                                                    <!-- Bottom Info -->
                                                    <div class="position-absolute bottom-0 start-0 w-100 p-3 z-2 text-white">
                                                        <% if (short.parasha_name) { %>
                                                            <div class="d-inline-flex align-items-center gap-1 px-2 py-1 mb-2 rounded-pill shadow-sm" style="background: rgba(107,33,168,0.85); backdrop-filter: blur(4px); font-size: 0.72rem; font-weight: 600;">
                                                                <i class="bi bi-journal-bookmark"></i> <%= short.parasha_name %>
                                                            </div>
                                                        <% } %>

                                                        <h6 class="fw-bold mb-1 text-white text-truncate-2" style="font-size: 0.95rem; line-height: 1.35; text-shadow: 0 2px 4px rgba(0,0,0,0.8);">
                                                            <%= short.title %>
                                                        </h6>

                                                        <% if (short.child_name) { %>
                                                            <div class="small d-flex align-items-center gap-1 text-info fw-semibold mb-1" style="font-size: 0.82rem; text-shadow: 0 1px 3px rgba(0,0,0,0.8);">
                                                                <i class="bi bi-person-heart text-danger"></i> <%= short.child_name %>
                                                            </div>
                                                        <% } %>

                                                        <div class="d-flex align-items-center justify-content-between mt-1 text-white-50" style="font-size: 0.74rem;">
                                                            <% if (short.verses_reference) { %>
                                                                <span class="text-truncate me-2"><i class="bi bi-book me-1"></i><%= short.verses_reference %></span>
                                                            <% } else { %>
                                                                <span></span>
                                                            <% } %>
                                                            <span class="badge bg-black bg-opacity-50 text-light px-2 py-1 rounded-pill"><i class="bi bi-eye me-1 text-info"></i><%= short.views_count || 0 %> vistas</span>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>

                                    <button type="button" class="shorts-float-arrow shorts-float-right shadow-lg float-arrow-blue" onclick="slideTrackHome('aliyotHomeShortsTrack', 'next')" id="floatAliyotHomeNext" title="Siguiente">
                                        <i class="bi bi-chevron-right"></i>
                                    </button>
                                </div>

                                <div class="text-center mt-4">
                                    <a href="/semillas-de-torah" class="btn px-4 py-2 rounded-pill fw-bold text-white shadow-sm d-inline-flex align-items-center gap-2" style="background: linear-gradient(135deg, #0284c7, #0369a1); border: none;">
                                        <i class="bi bi-collection-play me-1"></i> Ver todas las Aliyot y Novedades en Semillas de Torah <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </section>

                <!-- Testimonials Section -->
                <section id="testimonials" class="testimonials section dark-background">
                    <img src="/assets/img/testimonials-bg.jpg" class="testimonials-bg" alt="">
                    <div class="container" data-aos="fade-up" data-aos-delay="100">
                        <div class="swiper init-swiper">
                            <script type="application/json" class="swiper-config">
            {
              "loop": true,
              "speed": 600,
              "autoplay": { "delay": 5000 },
              "slidesPerView": "auto",
              "pagination": { "el": ".swiper-pagination", "type": "bullets", "clickable": true }
            }
          </script>
                            <div class="swiper-wrapper">
                                <% testimonials.forEach(t=> { %>
                                    <div class="swiper-slide">
                                        <div class="testimonial-item">
                                            <img src="<%= t.img %>" class="testimonial-img" alt="">
                                            <h3>
                                                <%= t.name %>
                                            </h3>
                                            <h4>
                                                <%= t.role %>
                                            </h4>
                                            <div class="stars">
                                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i
                                                    class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i
                                                    class="bi bi-star-fill"></i>
                                            </div>
                                            <p>
                                                <i class="bi bi-quote quote-icon-left"></i>
                                                <span>
                                                    <%= t.text %>
                                                </span>
                                                <i class="bi bi-quote quote-icon-right"></i>
                                            </p>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                            <div class="swiper-pagination"></div>
                        </div>
                    </div>
                </section>



                <section id="team" class="team section">
                    <div class="container section-title" data-aos="fade-up">
                        <h2><%= (sections.Equipo && sections.Equipo.title) || 'Equipo' %></h2>
                        <p><%= (sections.Equipo && sections.Equipo.subtitle) || 'Conoce a los encargados' %></p>
                    </div>
                    <div class="container" data-aos="fade-up" data-aos-delay="100">
                        <div class="row gy-4 justify-content-center">
                            <% team.forEach(member => { %>
                                <div class="col-6 col-md-4 col-lg-3 col-xl-2 text-center d-flex justify-content-center">
                                    <div class="team-member-card" style="padding: 10px; width: 100%;">
                                        <div style="width: 100%; max-width: 180px; aspect-ratio: 1/1; margin: 0 auto 12px; border-radius: 50%; overflow: hidden; border: 3px solid #d4b895; box-shadow: 0 4px 15px rgba(212,184,149,0.3);">
                                            <img src="<%= member.img || '/assets/img/team/default.png' %>" alt="<%= member.name %>"
                                                style="width: 100%; height: 100%; object-fit: cover;">
                                        </div>
                                        <h4 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 2px; color: #222;"><%= member.name %></h4>
                                        <span style="font-size: 0.8rem; color: #d4b895; font-weight: 600;"><%= member.role %></span>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </section>

                <!-- Blog & Noticias Section -->
                <section id="blog" class="blog-home section" style="background-color: #faf9f6; padding: 70px 0;">
                    <div class="container section-title" data-aos="fade-up">
                        <h2><%= (sections.Blog && sections.Blog.title) || 'Blog & Noticias' %></h2>
                        <p><%= (sections.Blog && sections.Blog.subtitle) || 'Reflexiones, artículos y novedades de nuestra comunidad' %></p>
                    </div>
                    <div class="container" data-aos="fade-up" data-aos-delay="100">
                        <% if (typeof blogPosts !== 'undefined' && blogPosts && blogPosts.length > 0) { %>
                            <div class="row gy-4 justify-content-center">
                                <% blogPosts.forEach((post, index) => { %>
                                    <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-delay="<%= (index + 1) * 100 %>">
                                        <article class="blog-card h-100 shadow-sm" style="background: #ffffff; border-radius: 18px; overflow: hidden; border: 1px solid #ebe5dc; transition: all 0.35s ease; display: flex; flex-direction: column;">
                                            <div class="blog-img-box" style="position: relative; width: 100%; height: 220px; overflow: hidden; background: #1a1a1a;">
                                                <a href="/blog/<%= post.id %>" class="d-block w-100 h-100">
                                                    <% if (post.image_url && post.image_url.trim() !== '') { %>
                                                        <img src="<%= post.image_url %>" alt="<%= post.title %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;">
                                                    <% } else { %>
                                                        <div class="d-flex align-items-center justify-content-center h-100 w-100" style="background: linear-gradient(135deg, #efe8db, #dfd4bf);">
                                                            <i class="bi bi-newspaper text-muted" style="font-size: 3.5rem; color: #d4a853 !important;"></i>
                                                        </div>
                                                    <% } %>
                                                </a>
                                                <span class="blog-category-badge position-absolute top-0 start-0 m-3 px-3 py-1 rounded-pill text-white fw-bold shadow-sm" 
                                                      style="background: linear-gradient(135deg, #d4a853, #b8860b); font-size: 0.75rem; letter-spacing: 0.5px; text-transform: uppercase;">
                                                    <%= post.category || 'General' %>
                                                </span>
                                            </div>
                                            
                                            <div class="p-4 d-flex flex-column flex-grow-1">
                                                <div class="blog-meta d-flex align-items-center gap-3 mb-2 text-muted" style="font-size: 0.82rem;">
                                                    <span><i class="bi bi-calendar3 me-1" style="color: #d4a853;"></i> <%= post.published_at ? new Date(post.published_at).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }) : '-' %></span>
                                                    <span><i class="bi bi-person me-1" style="color: #d4a853;"></i> <%= post.author || 'Editorial' %></span>
                                                </div>

                                                <h4 class="fw-bold mb-2" style="font-size: 1.15rem; line-height: 1.4;">
                                                    <a href="/blog/<%= post.id %>" class="text-decoration-none text-dark hover-gold-title">
                                                        <%= post.title %>
                                                    </a>
                                                </h4>

                                                <% if (post.subtitle) { %>
                                                    <p class="text-muted small mb-2 fst-italic" style="color: #8c7b6c !important;"><%= post.subtitle %></p>
                                                <% } %>

                                                <% if (post.summary) { %>
                                                    <p class="text-muted mb-3" style="font-size: 0.88rem; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                                        <%= post.summary %>
                                                    </p>
                                                <% } %>

                                                <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                                    <a href="/blog/<%= post.id %>" class="btn-read-more text-decoration-none fw-bold" style="color: #d4a853; font-size: 0.9rem; transition: transform 0.2s ease; display: inline-flex; align-items: center; gap: 4px;">
                                                        Leer artículo <i class="bi bi-arrow-right"></i>
                                                    </a>
                                                    <span class="text-muted small"><i class="bi bi-eye me-1"></i><%= post.views || 0 %></span>
                                                </div>
                                            </div>
                                        </article>
                                    </div>
                                <% }) %>
                            </div>

                            <div class="text-center mt-5" data-aos="fade-up">
                                <a href="/blog"
                                    style="background: linear-gradient(135deg, #d4a853, #b8860b); color: #fff; padding: 13px 42px; border-radius: 50px; display: inline-block; text-decoration: none; font-weight: 700; box-shadow: 0 4px 18px rgba(212,168,83,0.35); transition: all 0.3s ease;">
                                    <i class="bi bi-newspaper me-2"></i>Ver todas las publicaciones
                                </a>
                            </div>
                        <% } else { %>
                            <div class="text-center py-4">
                                <p class="text-muted">Próximamente compartiremos nuevas publicaciones y noticias.</p>
                                <a href="/blog" class="btn btn-outline-dark btn-sm rounded-pill px-4">Ir a la sección de Blog</a>
                            </div>
                        <% } %>
                    </div>
                </section>
                <style>
                    .blog-card:hover {
                        transform: translateY(-8px);
                        box-shadow: 0 16px 35px rgba(0, 0, 0, 0.12) !important;
                        border-color: #d4a853 !important;
                    }
                    .blog-card:hover .blog-img-box img {
                        transform: scale(1.08);
                    }
                    .hover-gold-title:hover {
                        color: #d4a853 !important;
                    }
                    .btn-read-more:hover {
                        transform: translateX(4px);
                    }
                </style>

                <!-- Secciones Dinámicas Inline -->
                <% if (typeof dynamicInline !=='undefined' && dynamicInline.length> 0) { %>
                    <% dynamicInline.forEach((ds, idx)=> { %>
                        <section id="section-<%= ds.slug %>"
                            class="section <%= idx % 2 === 0 ? '' : 'dark-background' %>">
                            <div class="container section-title" data-aos="fade-up">
                                <h2><i class="bi <%= ds.icon %>"></i>
                                    <%= ds.title %>
                                </h2>
                                <% if (ds.summary) { %>
                                    <p><%= ds.summary %></p>
                                <% } %>
                            </div>
                            <div class="container" data-aos="fade-up" data-aos-delay="100">
                                <% if (ds.content) { %>
                                    <div class="row mb-4">
                                        <div class="col-12">
                                            <%- ds.content %>
                                        </div>
                                    </div>
                                <% } %>

                                <% if (ds.items && ds.items.length > 0) { %>
                                    <div class="row gy-4">
                                        <% ds.items.forEach((item, i) => { %>
                                            <div class="col-lg-3 col-md-6 col-6" data-aos="fade-up" data-aos-delay="<%= (i+1)*100 %>">
                                                <a href="/s/<%= ds.slug %>" class="text-decoration-none" style="display: block;">
                                                    <div class="card h-100 shadow-sm border-0 dynamic-card-hover" style="border-radius: 15px; overflow: hidden; transition: transform 0.3s ease, box-shadow 0.3s ease; cursor: pointer;">
                                                        <% 
                                                            // Intentar encontrar una imagen o video en los campos
                                                            const imgField = Object.keys(item).find(k => (k.includes('imagen') || k.includes('img') || k.includes('url')) && !k.includes('youtube') && !k.includes('video'));
                                                            const videoField = Object.keys(item).find(k => k.includes('video') || k.includes('youtube'));
                                                            const titleField = Object.keys(item).find(k => k.includes('titulo') || k.includes('nombre') || k.includes('title') || k.includes('name')) || 'id';
                                                            const descField = Object.keys(item).find(k => k.includes('desc') || k.includes('resumen') || k.includes('content')) || '';
                                                            const viewsField = Object.keys(item).find(k => k.includes('view') || k.includes('vista') || k.includes('visualiza'));
                                                            const viewsVal = viewsField && typeof item[viewsField] !== 'undefined' ? item[viewsField] : (typeof item.views !== 'undefined' ? item.views : (typeof item.vistas !== 'undefined' ? item.vistas : (typeof item.visualizaciones !== 'undefined' ? item.visualizaciones : 0)));
                                                            
                                                            let finalImgUrl = null;
                                                            if (imgField && item[imgField]) {
                                                                finalImgUrl = item[imgField];
                                                            } else if (videoField && item[videoField]) {
                                                                let embedUrl = item[videoField];
                                                                let videoId = '';
                                                                if (embedUrl.includes('watch?v=')) {
                                                                    videoId = embedUrl.split('watch?v=')[1].split('&')[0];
                                                                } else if (embedUrl.includes('youtu.be/')) {
                                                                    videoId = embedUrl.split('youtu.be/')[1].split('?')[0];
                                                                } else if (embedUrl.includes('embed/')) {
                                                                    videoId = embedUrl.split('embed/')[1].split('?')[0];
                                                                }
                                                                if (videoId) {
                                                                    finalImgUrl = `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`;
                                                                }
                                                            }
                                                        %>
                                                        <% if (finalImgUrl) { %>
                                                            <div style="height: 200px; overflow: hidden; position: relative;">
                                                                <img src="<%= finalImgUrl %>" class="card-img-top" alt="<%= item[titleField] %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;">
                                                                <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 60%); opacity: 0; transition: opacity 0.3s ease;" class="card-overlay"></div>
                                                                <div style="position: absolute; bottom: 12px; left: 0; right: 0; text-align: center; opacity: 0; transition: opacity 0.3s ease; transform: translateY(5px); transition: opacity 0.3s ease, transform 0.3s ease;" class="card-play-icon">
                                                                    <i class="bi bi-play-circle-fill" style="font-size: 2.5rem; color: #fff; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5));"></i>
                                                                </div>
                                                                <span class="position-absolute top-0 end-0 m-2 badge px-2 py-1 shadow-sm d-inline-flex align-items-center" style="background: rgba(0,0,0,0.72); color: #38bdf8; border: 1px solid rgba(56,189,248,0.4); font-size: 0.72rem; font-weight: 700; border-radius: 20px; backdrop-filter: blur(4px); z-index: 2;">
                                                                    <i class="bi bi-eye-fill me-1"></i><%= viewsVal %>
                                                                </span>
                                                            </div>
                                                        <% } else { %>
                                                            <div class="bg-light d-flex align-items-center justify-content-center position-relative" style="height: 200px; color: #ddd;">
                                                                <i class="bi <%= ds.icon %>" style="font-size: 3rem;"></i>
                                                                <span class="position-absolute top-0 end-0 m-2 badge px-2 py-1 shadow-sm d-inline-flex align-items-center" style="background: rgba(0,0,0,0.72); color: #38bdf8; border: 1px solid rgba(56,189,248,0.4); font-size: 0.72rem; font-weight: 700; border-radius: 20px; backdrop-filter: blur(4px); z-index: 2;">
                                                                    <i class="bi bi-eye-fill me-1"></i><%= viewsVal %>
                                                                </span>
                                                            </div>
                                                        <% } %>
                                                        <div class="card-body p-3 d-flex flex-column">
                                                            <h6 class="card-title fw-bold mb-1" style="color: #222; font-size: 0.95rem; line-height: 1.3;"><%= item[titleField] %></h6>
                                                            <% if (descField && item[descField]) { %>
                                                                <p class="card-text text-muted mb-2" style="font-size: 0.8rem; line-height: 1.4;"><%= item[descField].length > 60 ? item[descField].substring(0, 60) + '...' : item[descField] %></p>
                                                            <% } %>
                                                            <div class="mt-auto pt-2 border-top d-flex align-items-center justify-content-between text-muted" style="font-size: 0.75rem;">
                                                                <span class="text-truncate" style="max-width: 55%;"><i class="bi <%= ds.icon || 'bi-collection-play' %> text-warning me-1"></i><%= ds.title %></span>
                                                                <span class="badge rounded-pill px-2 py-1" style="background: #fdf6e7; color: #8c6a2d; font-size: 0.72rem; font-weight: 600; border: 1px solid #ebdccb;">
                                                                    <i class="bi bi-eye-fill me-1 text-info"></i><%= viewsVal %> <%= viewsVal == 1 ? 'vista' : 'vistas' %>
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                        <% }) %>
                                    </div>
                                    <style>
                                        .dynamic-card-hover:hover {
                                            transform: translateY(-6px) !important;
                                            box-shadow: 0 12px 30px rgba(0,0,0,0.15) !important;
                                        }
                                        .dynamic-card-hover:hover img {
                                            transform: scale(1.08);
                                        }
                                        .dynamic-card-hover:hover .card-overlay {
                                            opacity: 1 !important;
                                        }
                                        .dynamic-card-hover:hover .card-play-icon {
                                            opacity: 1 !important;
                                            transform: translateY(0) !important;
                                        }
                                    </style>
                                <% } %>

                                <div class="text-center mt-5">
                                    <a href="/s/<%= ds.slug %>" class="btn-get-started"
