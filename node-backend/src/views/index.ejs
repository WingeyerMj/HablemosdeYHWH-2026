                .frontend-short-item {
                    flex: 0 0 calc((100% - 3.75rem) / 4);
                    min-width: calc((100% - 3.75rem) / 4);
                    max-width: calc((100% - 3.75rem) / 4);
                    scroll-snap-align: start;
                    transition: transform 0.3s ease, opacity 0.3s ease;
