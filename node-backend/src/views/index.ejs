                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge rounded-pill px-2 py-1" id="shortModalParashaHome" style="font-size: 0.72rem; background: #6b21a8;"></span>
                                    <span class="text-info small fw-bold" id="shortModalChildHome"></span>
                                </div>
                                <h5 class="fw-bold mb-1" id="shortModalTitleHome" style="font-size: 1.05rem; line-height: 1.3;"></h5>
                                <p class="text-white-50 small mb-0" id="shortModalVersesHome" style="font-size: 0.8rem;"></p>
