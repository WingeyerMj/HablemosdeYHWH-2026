            <!-- Data Injection for JS Shorts Viewer on Homepage -->
            <script>
                const SHORTS_DATA_HOME = <%- JSON.stringify(typeof semillasShorts !== 'undefined' ? semillasShorts : []) %>;
                let currentShortIndexHome = 0;
                let shortsModalInstanceHome = null;

                function getEmbedUrlHome(url) {
                    if (!url) return '';
                    let match = url.match(/shorts\/([a-zA-Z0-9_-]+)/);
                    if (match && match[1]) {
                        return `https://www.youtube.com/embed/${match[1]}?autoplay=1&rel=0`;
                    }
                    match = url.match(/(?:youtu\.be\/|v\/|u\/\w\/|embed\/|watch\?v=)([^#\&\?]*)/);
                    if (match && match[1] && match[1].length === 11) {
                        return `https://www.youtube.com/embed/${match[1]}?autoplay=1&rel=0`;
                    }
                    return url;
                }

                function openShortModalHome(index) {
                    if (!SHORTS_DATA_HOME || SHORTS_DATA_HOME.length === 0) return;
                    currentShortIndexHome = index;
                    renderCurrentShortHome();
                    
                    const modalEl = document.getElementById('shortsModalViewerHome');
                    if (!shortsModalInstanceHome && modalEl) {
                        shortsModalInstanceHome = new bootstrap.Modal(modalEl);
                    }
                    if (shortsModalInstanceHome) {
                        shortsModalInstanceHome.show();
                    }
                }

                function renderCurrentShortHome() {
                    const short = SHORTS_DATA_HOME[currentShortIndexHome];
                    if (!short) return;

                    const videoEl = document.getElementById('shortModalVideoHome');
                    const iframeEl = document.getElementById('shortModalIframeHome');
                    const fallbackEl = document.getElementById('shortModalFallbackHome');

                    if (videoEl) { videoEl.pause(); videoEl.src = ''; videoEl.style.display = 'none'; }
                    if (iframeEl) { iframeEl.src = ''; iframeEl.style.display = 'none'; }
                    if (fallbackEl) { fallbackEl.style.display = 'none'; }

                    // Fill text metadata
                    const titleEl = document.getElementById('shortModalTitleHome');
                    const parashaEl = document.getElementById('shortModalParashaHome');
                    const badgeEl = document.getElementById('shortModalBadgeHome');
                    const childEl = document.getElementById('shortModalChildHome');
                    const versesEl = document.getElementById('shortModalVersesHome');
                    const descEl = document.getElementById('shortModalDescriptionHome');

                    if (titleEl) titleEl.textContent = short.title || '';
                    if (short.short_type === 'general') {
                        if (parashaEl) {
                            parashaEl.textContent = short.category ? ('🌟 ' + short.category) : '🌟 Tema Diverso';
                            parashaEl.style.display = 'inline-block';
                        }
                        if (badgeEl) badgeEl.textContent = short.category ? `🌟 ${short.category}` : `🌟 Short General`;
                    } else {
                        if (parashaEl) {
                            parashaEl.textContent = short.parasha_name ? ('📖 ' + short.parasha_name) : '';
                            parashaEl.style.display = short.parasha_name ? 'inline-block' : 'none';
                        }
                        if (badgeEl) {
                            if (short.aliyah_number) {
                                badgeEl.textContent = `${short.aliyah_number}ª Aliyá Infantil`;
                            } else {
                                badgeEl.textContent = `📖 Aliyá con Niños`;
                            }
                        }
                    }

                    if (childEl) childEl.textContent = short.child_name ? ('👧 ' + short.child_name) : '';
                    if (versesEl) versesEl.textContent = short.verses_reference ? ('📜 ' + short.verses_reference) : '';
                    if (descEl) descEl.textContent = short.description || '';

                    // Decide video source
                    if (short.video_url && short.video_url.trim() !== '') {
                        if (videoEl) {
                            videoEl.src = short.video_url;
                            videoEl.style.display = 'block';
                            videoEl.play().catch(e => console.log('Autoplay prevent:', e));
                        }
                    } else if (short.youtube_short_url && short.youtube_short_url.trim() !== '') {
                        if (iframeEl) {
                            iframeEl.src = getEmbedUrlHome(short.youtube_short_url);
                            iframeEl.style.display = 'block';
                        }
                    } else {
                        if (fallbackEl) {
                            fallbackEl.style.display = 'block';
                            const fbTitle = document.getElementById('shortFallbackTitleHome');
                            const fbDesc = document.getElementById('shortFallbackDescHome');
                            if (fbTitle) fbTitle.textContent = short.title;
                            if (fbDesc) fbDesc.textContent = short.description || 'Este video estará disponible muy pronto.';
                        }
                    }

                    const prevBtn = document.getElementById('shortPrevBtnHome');
                    const nextBtn = document.getElementById('shortNextBtnHome');
                    if (prevBtn) prevBtn.style.opacity = currentShortIndexHome > 0 ? '1' : '0.35';
                    if (nextBtn) nextBtn.style.opacity = currentShortIndexHome < SHORTS_DATA_HOME.length - 1 ? '1' : '0.35';
                }

                function nextShortHome() {
                    if (currentShortIndexHome < SHORTS_DATA_HOME.length - 1) {
                        currentShortIndexHome++;
                        renderCurrentShortHome();
                    }
                }

                function prevShortHome() {
                    if (currentShortIndexHome > 0) {
                        currentShortIndexHome--;
                        renderCurrentShortHome();
                    }
                }

                function slideTrackHome(trackId, direction) {
                    const track = document.getElementById(trackId);
                    if (!track) return;

                    const item = track.querySelector('.frontend-short-item');
                    const step = item ? (item.offsetWidth + 20) : 300;
                    
                    if (direction === 'next') {
                        track.scrollBy({ left: step, behavior: 'smooth' });
                    } else {
                        track.scrollBy({ left: -step, behavior: 'smooth' });
                    }

                    setTimeout(() => updateTrackArrowStatesHome(trackId), 350);
                }

                function updateTrackArrowStatesHome(trackId) {
                    const track = document.getElementById(trackId);
                    if (!track) return;

                    const atStart = track.scrollLeft <= 5;
                    const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 5;

                    const prevBtn = document.getElementById('navAliyotHomePrev');
                    const nextBtn = document.getElementById('navAliyotHomeNext');
                    const floatPrev = document.getElementById('floatAliyotHomePrev');
                    const floatNext = document.getElementById('floatAliyotHomeNext');

                    [prevBtn, floatPrev].forEach(b => {
                        if (b) {
                            b.style.opacity = atStart ? '0.35' : '1';
                            b.style.pointerEvents = atStart ? 'none' : 'auto';
                        }
                    });

                    [nextBtn, floatNext].forEach(b => {
                        if (b) {
                            b.style.opacity = atEnd ? '0.35' : '1';
                            b.style.pointerEvents = atEnd ? 'none' : 'auto';
                        }
                    });
                }

                function setupTrackInteractionsHome(trackId) {
                    const track = document.getElementById(trackId);
                    if (!track) return;

                    track.addEventListener('scroll', () => updateTrackArrowStatesHome(trackId));
                    updateTrackArrowStatesHome(trackId);

                    // Mouse Drag-to-scroll
                    let isDown = false;
                    let startX;
                    let scrollLeft;

                    track.addEventListener('mousedown', (e) => {
                        isDown = true;
                        startX = e.pageX - track.offsetLeft;
                        scrollLeft = track.scrollLeft;
                        track.style.cursor = 'grabbing';
                        track.style.userSelect = 'none';
                    });

                    track.addEventListener('mouseleave', () => {
                        isDown = false;
                        track.style.cursor = 'default';
                    });

                    track.addEventListener('mouseup', () => {
                        isDown = false;
                        track.style.cursor = 'default';
                    });

                    track.addEventListener('mousemove', (e) => {
                        if (!isDown) return;
                        e.preventDefault();
                        const x = e.pageX - track.offsetLeft;
                        const walk = (x - startX) * 1.5;
                        track.scrollLeft = scrollLeft - walk;
                    });
                }

                document.addEventListener('DOMContentLoaded', () => {
                    setupTrackInteractionsHome('aliyotHomeShortsTrack');

                    const modalEl = document.getElementById('shortsModalViewerHome');
                    if (modalEl) {
                        modalEl.addEventListener('hidden.bs.modal', () => {
                            const videoEl = document.getElementById('shortModalVideoHome');
                            const iframeEl = document.getElementById('shortModalIframeHome');
                            if (videoEl) { videoEl.pause(); videoEl.src = ''; }
                            if (iframeEl) { iframeEl.src = ''; }
                        });
                    }

                    document.addEventListener('keydown', (e) => {
                        const modal = document.getElementById('shortsModalViewerHome');
                        if (modal && modal.classList.contains('show')) {
                            if (e.key === 'ArrowRight' || e.key === 'ArrowDown') nextShortHome();
                            if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') prevShortHome();
                        }
                    });
                });
            </script>

            <style>
                .shorts-carousel-container {
                    position: relative;
                    width: 100%;
                }

                .shorts-slider-track {
                    display: flex;
                    gap: 1.25rem;
                    overflow-x: auto;
                    scroll-behavior: smooth;
                    scroll-snap-type: x mandatory;
                    padding: 0.5rem 0.25rem 1.25rem 0.25rem;
                    -webkit-overflow-scrolling: touch;
                    scrollbar-width: thin;
                    scrollbar-color: #38bdf8 #f0f9ff;
                }

                .shorts-slider-track::-webkit-scrollbar {
                    height: 6px;
                }

                .shorts-slider-track::-webkit-scrollbar-track {
                    background: #f0f9ff;
                    border-radius: 10px;
                }

                .shorts-slider-track::-webkit-scrollbar-thumb {
                    background: linear-gradient(90deg, #0284c7, #38bdf8);
                    border-radius: 10px;
