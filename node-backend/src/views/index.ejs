                @media (max-width: 1199.98px) {
                    .frontend-short-item {
                        flex: 0 0 calc((100% - 2.5rem) / 3);
                        min-width: calc((100% - 2.5rem) / 3);
                        max-width: calc((100% - 2.5rem) / 3);
                    }
                }

                @media (max-width: 991.98px) {
                    .frontend-short-item {
                        flex: 0 0 calc((100% - 1.25rem) / 2);
                        min-width: calc((100% - 1.25rem) / 2);
                        max-width: calc((100% - 1.25rem) / 2);
                    }
                }

                @media (max-width: 575.98px) {
                    .frontend-short-item {
                        flex: 0 0 85%;
                        min-width: 85%;
                        max-width: 85%;
                    }
                }

                .shorts-float-arrow {
                    position: absolute;
                    top: 48%;
                    transform: translateY(-50%);
                    width: 48px;
                    height: 48px;
                    border-radius: 50%;
                    background: #ffffff;
                    color: #0284c7;
                    border: 2px solid #bae6fd;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    z-index: 10;
                    font-size: 1.3rem;
                    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
                    cursor: pointer;
                }

                .shorts-float-arrow:hover {
                    transform: translateY(-50%) scale(1.12);
                }

                .float-arrow-blue {
                    color: #0284c7;
                    border-color: #bae6fd;
                }
                .float-arrow-blue:hover {
                    background: #0284c7;
                    color: #ffffff;
                    border-color: #0284c7;
                    box-shadow: 0 10px 25px rgba(2, 132, 199, 0.4) !important;
                }

                .shorts-float-left {
                    left: -20px;
                }

                .shorts-float-right {
                    right: -20px;
                }

                @media (max-width: 767.98px) {
                    .shorts-float-arrow {
                        display: none;
                    }
                }

                .short-card:hover {
                    transform: translateY(-8px) scale(1.02);
                    box-shadow: 0 20px 40px rgba(2, 132, 199, 0.28) !important;
                    border-color: #38bdf8 !important;
                }
                .short-card:hover .short-thumb {
                    transform: scale(1.08);
                }
                .short-card:hover .play-btn-overlay div {
                    transform: scale(1.15);
                    background: #ffffff !important;
                    color: #0284c7 !important;
                }
                .text-truncate-2 {
                    display: -webkit-box;
                    -webkit-line-clamp: 2;
                    -webkit-box-orient: vertical;
                    overflow: hidden;
                }
            </style>

