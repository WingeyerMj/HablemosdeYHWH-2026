                    </div>
                    <div class="container">
                        <%
                            // Helper para normalizar la categoría y su slug
                            function getCatDetails(rawCat) {
                                if (!rawCat || rawCat.trim() === '' || rawCat === 'filter-app' || rawCat.toLowerCase() === 'moedin' || rawCat.toLowerCase() === 'moedim') {
                                    return { slug: 'moedim', name: 'Moedim' };
                                }
                                if (rawCat === 'filter-product' || rawCat.toLowerCase() === 'especiales') {
                                    return { slug: 'especiales', name: 'Especiales' };
                                }
                                const name = rawCat.trim();
                                const slug = name.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
                                return { slug: slug || 'general', name: name };
                            }

                            // Construir mapa de categorías presentes en los eventos
                            const availableCategories = new Map();
                            if (typeof portfolio !== 'undefined' && portfolio && portfolio.length > 0) {
                                portfolio.forEach(item => {
                                    const cat = getCatDetails(item.category);
                                    if (!availableCategories.has(cat.slug)) {
                                        availableCategories.set(cat.slug, { name: cat.name, count: 1 });
                                    } else {
                                        availableCategories.get(cat.slug).count++;
                                    }
                                });
                            }
                        %>

                        <!-- Botones de Filtro por Categoría -->
