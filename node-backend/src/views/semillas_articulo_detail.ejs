<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

<body class="semillas-detail-page" style="background-color: #faf7f2;">

    <%- include('partials/header') %>

    <main class="main">

        <!-- Page Title Header -->
        <div class="page-title accent-background" style="background: linear-gradient(135deg, #14532d 0%, #15803d 40%, #6b21a8 100%); padding: 130px 0 50px 0;">
            <div class="container d-lg-flex justify-content-between align-items-center">
                <div data-aos="fade-right">
                    <span class="badge mb-2 px-3 py-2 text-uppercase" style="background: rgba(255,255,255,0.25); backdrop-filter: blur(5px); font-size: 0.82rem; letter-spacing: 1px; color: #fff; border-radius: 20px;">
                        🌱 Semillas de Torah • <%= item.category || 'Resumen Semanal de Parashá' %>
                    </span>
                    <h1 class="mb-2 text-white fw-bold" style="font-size: 2.2rem; line-height: 1.3;"><%= item.title %></h1>
                    <% if (item.biblical_reference) { %>
                        <p class="text-white-50 mb-0" style="font-size: 1.1rem;"><i class="bi bi-book me-1 text-warning"></i> Cita Bíblica: <strong><%= item.biblical_reference %></strong></p>
                    <% } %>
                </div>
                <nav class="breadcrumbs mt-3 mt-lg-0" data-aos="fade-left">
                    <ol class="d-flex list-unstyled gap-2 m-0 p-0 text-white-50">
                        <li><a href="/" class="text-white text-decoration-none">Inicio</a></li>
                        <li class="text-white-50">/</li>
                        <li><a href="/semillas-de-torah" class="text-white text-decoration-none">Semillas de Torah</a></li>
                        <li class="text-white-50">/</li>
                        <li class="current text-white fw-semibold text-truncate" style="max-width: 220px;"><%= item.title %></li>
                    </ol>
                </nav>
            </div>
        </div><!-- End Page Title -->

        <%
            let galleryList = [];
            if (item.gallery_images) {
                try {
                    galleryList = typeof item.gallery_images === 'string' ? JSON.parse(item.gallery_images) : item.gallery_images;
                    if (!Array.isArray(galleryList)) galleryList = [];
                } catch(e) {
                    galleryList = [];
                }
            }
        %>

        <!-- Main Content Area -->
        <section class="section py-5">
            <div class="container">
                <div class="row g-5">
                    
                    <!-- Left Column: Main Article -->
                    <div class="col-lg-8" data-aos="fade-up">
                        <article class="bg-white p-4 p-md-5 rounded-4 shadow-sm" style="border: 2px solid #e2e8f0;">
                            
                            <!-- Author & Meta bar -->
                            <div class="d-flex flex-wrap align-items-center justify-content-between pb-3 mb-4 border-bottom gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="/assets/img/pagina/semillas_torah_logo.png" alt="Elva Avila" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover; border: 2px solid #6b21a8;">
                                    <div>
                                        <div class="fw-bold fs-6" style="color: #2e1065;"><%= item.author || 'Elva Avila' %></div>
                                        <div class="text-muted small">Semillas de Torah • Ministerio Infantil</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-3 flex-wrap">
                                    <% if (item.parasha_name) { %>
                                        <span class="badge rounded-pill px-3 py-2 shadow-sm" style="background: linear-gradient(135deg, #6b21a8, #9333ea); color: #fff; font-size: 0.85rem;">
                                            <i class="bi bi-journal-bookmark me-1"></i> Parashá <%= item.parasha_name %>
                                        </span>
                                    <% } %>
                                    <div class="text-muted small d-flex align-items-center gap-2">
                                        <i class="bi bi-calendar3" style="color: #15803d;"></i>
                                        <span><%= item.created_at ? new Date(item.created_at).toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }) : '' %></span>
                                    </div>
                                    <span class="badge rounded-pill px-3 py-1 shadow-sm" style="background: #f0fdf4; color: #15803d; font-size: 0.8rem; font-weight: 600; border: 1px solid #bbf7d0;">
                                        <i class="bi bi-eye-fill me-1 text-success"></i> <%= (item.views_count || 0) + 1 %> vistas
                                    </span>
                                </div>
                            </div>

                            <!-- Versículo Clave Destacado -->
                            <% if (item.key_verse) { %>
                                <div class="p-4 mb-4 rounded-4 shadow-sm position-relative" style="background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%); border-left: 5px solid #6b21a8;">
                                    <div class="d-flex align-items-start gap-3">
                                        <i class="bi bi-quote fs-1 text-purple opacity-50 flex-shrink-0"></i>
                                        <div>
                                            <div class="fw-bold mb-1" style="color: #4c1d95; font-size: 1.15rem; line-height: 1.6;">
                                                <%= item.key_verse %>
                                            </div>
                                            <% if (item.biblical_reference) { %>
                                                <div class="small text-muted fw-semibold">— <%= item.biblical_reference %></div>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% } %>

                            <!-- Resumen Principal de la Enseñanza (Con Formato y Emojis) -->
                            <% if (item.summary) { %>
                                <div class="article-summary-box mb-4 p-4 rounded-4" style="background: #fafaf9; border: 1px solid #e7e5e4; font-size: 1.15rem; line-height: 1.9; color: #292524; white-space: pre-line;">
                                    <%= item.summary %>
                                </div>
                            <% } %>

                            <!-- Hashtags -->
                            <% if (item.tags) { %>
                                <div class="d-flex flex-wrap gap-2 mb-4 pb-2 border-bottom">
                                    <% item.tags.split(' ').filter(t => t.trim() !== '').forEach(tag => { %>
                                        <span class="badge bg-light text-primary border px-3 py-2" style="font-size: 0.85rem; font-weight: 600;"><%= tag %></span>
                                    <% }) %>
                                </div>
                            <% } %>

                            <!-- INFOGRAFÍA PRINCIPAL EN ALTA RESOLUCIÓN -->
                            <% if (item.main_image) { %>
                                <div class="mb-5 rounded-4 overflow-hidden shadow-sm" style="background: #000; border: 3px solid #16a34a;">
                                    <div class="p-3 bg-dark text-white d-flex align-items-center justify-content-between flex-wrap gap-2 px-4 border-bottom border-secondary">
                                        <span class="fw-bold small text-success d-flex align-items-center gap-2">
                                            <i class="bi bi-palette-fill fs-5"></i> Infografía Oficial de la Parashá
                                        </span>
                                        <div class="d-flex align-items-center gap-2">
                                            <button type="button" onclick="openDetailLightbox('<%= item.main_image %>', '<%= item.title.replace(/'/g, "\\'") %>')" class="btn btn-sm btn-outline-light rounded-pill px-3">
                                                <i class="bi bi-arrows-fullscreen me-1"></i> Pantalla Completa
                                            </button>
                                            <a href="<%= item.main_image %>" download="<%= (item.title || 'infografia') + '.png' %>" class="btn btn-sm btn-success rounded-pill px-3 fw-bold">
                                                <i class="bi bi-download me-1"></i> Descargar Imagen
                                            </a>
                                        </div>
                                    </div>
                                    <div class="p-2 text-center" style="background: #111; cursor: zoom-in;" onclick="openDetailLightbox('<%= item.main_image %>', '<%= item.title.replace(/'/g, "\\'") %>')">
                                        <img src="<%= item.main_image %>" alt="<%= item.title %>" class="img-fluid w-100" style="max-height: 800px; object-fit: contain; border-radius: 4px;">
                                    </div>
                                </div>
                            <% } %>

                            <!-- GALERÍA DE ALIYOT / FICHAS ILUSTRADAS ADICIONALES -->
                            <% if (galleryList && galleryList.length > 0) { %>
                                <div class="mb-5">
                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center text-white" style="width: 40px; height: 40px; background: linear-gradient(135deg, #0284c7, #0369a1);">
                                            <i class="bi bi-images fs-5"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-0" style="color: #0369a1;">Lecturas de las Aliyot & Fichas Ilustradas</h5>
                                            <p class="text-muted small mb-0">Haz clic en cada imagen para ampliarla en alta resolución.</p>
                                        </div>
                                    </div>

                                    <div class="row g-3">
                                        <% galleryList.forEach((gImg, idx) => { %>
                                            <div class="col-md-6">
                                                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative" style="border: 2px solid #e2e8f0; background: #000; cursor: zoom-in;" onclick="openDetailLightbox('<%= gImg %>', '<%= item.title.replace(/'/g, "\\'") %> - Aliyá <%= idx + 1 %>')">
                                                    <div class="position-absolute top-0 start-0 m-3 z-2">
                                                        <span class="badge bg-dark bg-opacity-75 text-white rounded-pill px-3 py-1 fw-bold shadow-sm" style="backdrop-filter: blur(4px);">
                                                            <i class="bi bi-bookmark-star-fill text-warning me-1"></i> Ficha / Aliyá #<%= idx + 1 %>
                                                        </span>
                                                    </div>
                                                    <div style="height: 320px; display: flex; align-items: center; justify-content: center; background: #111;">
                                                        <img src="<%= gImg %>" alt="" class="img-fluid w-100 h-100" style="object-fit: cover; transition: transform 0.4s ease;">
                                                    </div>
                                                    <div class="p-2 bg-dark text-white text-center small">
                                                        <i class="bi bi-arrows-fullscreen me-1 text-info"></i> Clic para ver en tamaño completo
                                                    </div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>
                            <% } %>

                            <!-- PDF Download / Hoja de Actividad Imprimible -->
                            <% if (item.pdf_file) { %>
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 p-4 mb-4 rounded-4 shadow-sm" style="background: linear-gradient(135deg, #fdfbf7, #f0fdf4); border: 2px dashed #22c55e;">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="d-flex align-items-center justify-content-center text-white rounded-circle shadow-sm" style="width: 56px; height: 56px; background: #22c55e; font-size: 1.7rem;">
                                            <i class="bi bi-file-earmark-pdf"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1" style="color: #14532d;">Hoja de Estudio / Actividad en PDF para Descargar</h6>
                                            <p class="text-muted small mb-0">Imprime esta ficha para colorear o repasar las enseñanzas en familia.</p>
                                        </div>
                                    </div>
                                    <a href="<%= item.pdf_file %>" target="_blank" download class="btn btn-success px-4 py-2 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center gap-2">
                                        <i class="bi bi-download"></i> Descargar PDF
                                    </a>
                                </div>
                            <% } %>

                            <!-- Formatted HTML Extended Notes if Present -->
                            <% if (item.content && item.content.trim() !== '') { %>
                                <div class="article-body-content my-4 pt-3 border-top" style="font-size: 1.12rem; line-height: 1.9; color: #334155;">
                                    <h5 class="fw-bold mb-3" style="color: #2e1065;"><i class="bi bi-card-text me-2 text-purple"></i>Notas Complementarias</h5>
                                    <%- item.content %>
                                </div>
                            <% } %>

                            <!-- Bottom Share & Social Buttons -->
                            <div class="mt-5 pt-4 border-top d-flex flex-wrap align-items-center justify-content-between gap-3">
                                <a href="/semillas-de-torah" class="btn btn-outline-dark rounded-pill px-4">
                                    <i class="bi bi-arrow-left me-1"></i> Volver a Semillas de Torah
                                </a>

                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="text-muted small me-2 fw-semibold">Compartir con familias:</span>
                                    <% 
                                        const pageFullUrl = "https://hablemosdeyahweh.com/semillas-de-torah/articulo/" + item.id;
                                        const shareMsg = encodeURIComponent(item.title + "\n\n" + (item.key_verse || '') + "\n\n" + pageFullUrl);
                                    %>
                                    <a href="https://api.whatsapp.com/send?text=<%= shareMsg %>" target="_blank" class="btn btn-success rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="background: #25D366; border: none;">
                                        <i class="bi bi-whatsapp"></i> WhatsApp
                                    </a>
                                    <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(pageFullUrl) %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="background: #1877F2; border: none;">
                                        <i class="bi bi-facebook"></i> Facebook
                                    </a>
                                </div>
                            </div>

                        </article>
                    </div>

                    <!-- Right Column: Sidebar & Related Items -->
                    <div class="col-lg-4" data-aos="fade-left">
                        <div class="sticky-top" style="top: 100px;">
                            
                            <!-- Ministry Card -->
                            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 p-4 text-center bg-white" style="border-top: 5px solid #22c55e !important;">
                                <img src="/assets/img/pagina/semillas_torah_logo.png" alt="Semillas de Torah" style="width: 110px; height: 110px; border-radius: 50%; object-fit: cover; margin: 0 auto 15px; border: 3px solid #22c55e;">
                                <h5 class="fw-bold mb-1" style="color: #2e1065;">Semillas de Torah</h5>
                                <p class="text-muted small mb-3">Ministerio de enseñanza bíblica infantil coordinado por <strong>Elva Avila</strong>.</p>
                                <a href="https://www.facebook.com/profile.php?id=61592294939779" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary rounded-pill w-100 fw-bold" style="border-color: #1877F2; color: #1877F2;">
                                    <i class="bi bi-facebook me-1"></i> Seguir en Facebook
                                </a>
                            </div>

                            <!-- Related Articles / Summaries -->
                            <% if (typeof otherArticulos !== 'undefined' && otherArticulos && otherArticulos.length > 0) { %>
                                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                                    <h5 class="fw-bold mb-3" style="color: #2e1065;">
                                        <i class="bi bi-journal-richtext me-2 text-success"></i>Más Resúmenes de Parashá
                                    </h5>
                                    <div class="d-flex flex-column gap-3">
                                        <% otherArticulos.forEach(rel => { %>
                                            <a href="/semillas-de-torah/articulo/<%= rel.id %>" class="d-flex align-items-center gap-3 text-decoration-none p-2 rounded-3 hover-item-box" style="transition: all 0.2s ease;">
                                                <% if (rel.main_image) { %>
                                                    <img src="<%= rel.main_image %>" alt="" style="width: 65px; height: 65px; border-radius: 10px; object-fit: cover; flex-shrink: 0; border: 1px solid #bbf7d0;">
                                                <% } else { %>
                                                    <div class="d-flex align-items-center justify-content-center rounded-3 text-white flex-shrink-0" style="width: 65px; height: 65px; background: linear-gradient(135deg, #16a34a, #6b21a8); font-size: 1.3rem;">
                                                        <i class="bi bi-book"></i>
                                                    </div>
                                                <% } %>
                                                <div>
                                                    <span class="badge px-2 py-0 mb-1" style="background: #f0fdf4; color: #15803d; font-size: 0.72rem; border: 1px solid #bbf7d0;">
                                                        <%= rel.parasha_name ? ('Parashá ' + rel.parasha_name) : (rel.category || 'Resumen') %>
                                                    </span>
                                                    <div class="fw-semibold text-dark text-truncate-2" style="font-size: 0.92rem; line-height: 1.35;"><%= rel.title %></div>
                                                </div>
                                            </a>
                                        <% }) %>
                                    </div>
                                </div>
                            <% } %>

                        </div>
                    </div>

                </div>
            </div>
        </section>

    </main>

    <!-- MODAL LIGHTBOX FULLSCREEN -->
    <div class="modal fade" id="detailImageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-0 shadow-lg rounded-4 overflow-hidden" style="background: rgba(15, 23, 42, 0.96) !important; backdrop-filter: blur(12px);">
                <div class="modal-header border-0 py-3 px-4 d-flex align-items-center justify-content-between">
                    <h6 class="modal-title text-white fw-bold mb-0" id="detailImageModalTitle"></h6>
                    <div class="d-flex align-items-center gap-2">
                        <a href="#" id="detailImageModalDownload" download class="btn btn-sm btn-outline-light rounded-pill px-3 fw-semibold">
                            <i class="bi bi-download me-1"></i> Descargar
                        </a>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                </div>
                <div class="modal-body p-2 text-center" style="min-height: 350px; display: flex; align-items: center; justify-content: center; background: #000;">
                    <img id="detailImageModalImg" src="" alt="Infografía" class="img-fluid" style="max-height: 85vh; width: auto; object-fit: contain; border-radius: 8px;">
                </div>
            </div>
        </div>
    </div>

    <script>
    function openDetailLightbox(imgUrl, title) {
        if (!imgUrl) return;
        const imgEl = document.getElementById('detailImageModalImg');
        const titleEl = document.getElementById('detailImageModalTitle');
        const downloadEl = document.getElementById('detailImageModalDownload');
        
        if (imgEl) imgEl.src = imgUrl;
        if (titleEl) titleEl.innerText = title || 'Infografía';
        if (downloadEl) {
            downloadEl.href = imgUrl;
            downloadEl.setAttribute('download', (title || 'infografia_semillas') + '.png');
        }

        const modalEl = document.getElementById('detailImageModal');
        if (modalEl && typeof bootstrap !== 'undefined') {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    }
    </script>

    <style>
        .hover-item-box:hover {
            background-color: #f0fdf4;
            transform: translateX(4px);
        }
        .text-truncate-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>

    <%- include('partials/footer') %>

</body>
</html>
