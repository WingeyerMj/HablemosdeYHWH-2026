<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

<style>
.cycle-card {
    background: #1e1e24;
    border: 1px solid rgba(212, 184, 149, 0.25);
    border-radius: 16px;
    transition: all 0.3s ease;
}
.cycle-card:hover {
    transform: translateY(-4px);
    border-color: #d4b895;
    box-shadow: 0 10px 25px rgba(0,0,0,0.4);
}
.active-cycle-badge {
    background: linear-gradient(135deg, #d4a853, #b8860b);
    color: #fff;
}
.pill-tab-btn {
    background: #25252d;
    color: #e0e0e0;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 30px;
    padding: 8px 20px;
    font-weight: 600;
    transition: all 0.2s ease;
}
.pill-tab-btn.active, .pill-tab-btn:hover {
    background: #d4b895;
    color: #111;
    border-color: #d4b895;
}
.content-item-card {
    background: #18181f;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    transition: all 0.25s ease;
}
.content-item-card:hover {
    border-color: rgba(212, 184, 149, 0.4);
    background: #1f1f28;
}
</style>

<body class="archivo-historico-page bg-dark text-white">

    <%- include('partials/header') %>

    <main class="main" style="padding-top: 100px; min-height: 85vh;">

        <!-- Page Header -->
        <div class="page-title accent-background py-5 mb-4" style="background: linear-gradient(135deg, #16161c 0%, #201a14 100%); border-bottom: 1px solid rgba(212, 184, 149, 0.2);">
            <div class="container text-center">
                <span class="badge rounded-pill px-3 py-2 mb-2" style="background: rgba(212, 184, 149, 0.15); color: #d4b895; border: 1px solid rgba(212, 184, 149, 0.3);">
                    <i class="bi bi-clock-history me-1"></i> Resguardo de Ciclos Anuales de Torá
                </span>
                <h1 class="display-5 fw-bold mb-2 text-white">Archivo Histórico</h1>
                <p class="lead text-white-50 mx-auto mb-0" style="max-width: 750px;">
                    Consulta las enseñanzas, lecturas de Aliyot con audios grabados, videos de Parashot y comentarios de Haftará de ciclos anteriores completados al término de Sucot.
                </p>
            </div>
        </div>

        <div class="container pb-5">

            <% if (!cycles || cycles.length === 0) { %>
                <!-- Sin ciclos archivados -->
                <div class="text-center py-5">
                    <div class="p-5 rounded-4 mx-auto" style="max-width: 600px; background: rgba(255,255,255,0.03); border: 1px dashed rgba(212, 184, 149, 0.3);">
                        <i class="bi bi-archive-fill text-warning display-3 mb-3 d-block"></i>
                        <h3 class="fw-bold text-white mb-2">Ciclo Actual en Curso</h3>
                        <p class="text-white-50 mb-4">
                            Actualmente te encuentras en el primer ciclo registrado. Cuando concluya la fiesta de Sucot y se realice el pasaje histórico, todo el material anual anterior estará disponible aquí para consulta permanente.
                        </p>
                        <div class="d-flex justify-content-center gap-3">
                            <a href="/parashot" class="btn btn-outline-warning"><i class="bi bi-journal-text me-1"></i> Ver Parashot Actuales</a>
                            <a href="/aliyot" class="btn btn-outline-info"><i class="bi bi-mic me-1"></i> Ver Aliyot</a>
                        </div>
                    </div>
                </div>
            <% } else { %>

                <!-- Selector de Ciclos -->
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-50">
                    <div>
                        <span class="text-white-50 small d-block mb-1">Selecciona el ciclo a consultar:</span>
                        <div class="d-flex flex-wrap gap-2">
                            <% cycles.forEach(c => { %>
                                <a href="/archivo-historico?cycle=<%= c.id %>" 
                                   class="btn pill-tab-btn <%= (selectedCycle && selectedCycle.id === c.id) ? 'active' : '' %>">
                                    <i class="bi bi-journal-bookmark me-1"></i> <%= c.name %>
                                    <% if (c.year_label) { %>
                                        <span class="badge bg-dark bg-opacity-50 ms-1" style="font-size: 0.75rem;"><%= c.year_label %></span>
                                    <% } %>
                                </a>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Buscador Instantáneo -->
                    <div style="min-width: 280px; max-width: 380px;" class="w-100 w-md-auto">
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-search"></i></span>
                            <input type="text" id="historicalSearchInput" class="form-control bg-dark text-white border-secondary" placeholder="Buscar por parashá o cita...">
                        </div>
                    </div>
                </div>

                <% if (selectedCycle) { %>
                    <!-- Banner del Ciclo Seleccionado -->
                    <div class="card cycle-card mb-5 p-4 shadow">
                        <div class="row align-items-center">
                            <div class="col-lg-8">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <h2 class="text-warning fw-bold mb-0"><%= selectedCycle.name %></h2>
                                    <% if (selectedCycle.year_label) { %>
                                        <span class="badge bg-warning text-dark fw-bold px-3 py-2"><%= selectedCycle.year_label %></span>
                                    <% } %>
                                </div>
                                <p class="text-white-50 mb-0">
                                    <%= selectedCycle.notes || 'Ciclo de lectura anual completado y archivado de forma histórica.' %>
                                </p>
                            </div>
                            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                                <div class="d-inline-flex gap-2">
                                    <div class="text-center px-3 py-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-50">
                                        <div class="fw-bold text-info fs-5"><%= historicalParashot.length %></div>
                                        <div class="small text-white-50" style="font-size: 0.72rem;">Parashot</div>
                                    </div>
                                    <div class="text-center px-3 py-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-50">
                                        <div class="fw-bold text-warning fs-5"><%= historicalAliyot.length %></div>
                                        <div class="small text-white-50" style="font-size: 0.72rem;">Aliyot</div>
                                    </div>
                                    <div class="text-center px-3 py-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-50">
                                        <div class="fw-bold text-success fs-5"><%= historicalHaftarot.length %></div>
                                        <div class="small text-white-50" style="font-size: 0.72rem;">Haftarot</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Pestañas de Contenido del Ciclo: Parashot / Aliyot / Haftarot -->
                    <ul class="nav nav-pills mb-4 gap-2" id="historicalContentTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active pill-tab-btn" id="tab-parashot" data-bs-toggle="pill" data-bs-target="#content-parashot" type="button" role="tab">
                                <i class="bi bi-journal-text me-1"></i> Parashot (<%= historicalParashot.length %>)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link pill-tab-btn" id="tab-aliyot" data-bs-toggle="pill" data-bs-target="#content-aliyot" type="button" role="tab">
                                <i class="bi bi-mic me-1"></i> Aliyot con Audios (<%= historicalAliyot.length %>)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link pill-tab-btn" id="tab-haftarot" data-bs-toggle="pill" data-bs-target="#content-haftarot" type="button" role="tab">
                                <i class="bi bi-scroll me-1"></i> Haftará (<%= historicalHaftarot.length %>)
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="historicalContentTabContent">

                        <!-- TAB PARASHOT HISTÓRICAS -->
                        <div class="tab-pane fade show active" id="content-parashot" role="tabpanel">
                            <div class="row g-4" id="historicalParashotGrid">
                                <% if (historicalParashot && historicalParashot.length > 0) { %>
                                    <% historicalParashot.forEach((p, idx) => { %>
                                        <div class="col-md-6 col-lg-4 historical-item-parasha" data-title="<%= p.title.toLowerCase() %>" data-sub="<%= (p.subtitle || '').toLowerCase() %>" data-desc="<%= (p.description || '').toLowerCase() %>">
                                            <div class="content-item-card h-100 p-3 d-flex flex-column">
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span class="badge bg-warning text-dark fw-bold">
                                                        Parashá #<%= p.parasha_number || (idx + 1) %>
                                                    </span>
                                                    <% if (p.youtube_link) { %>
                                                        <span class="badge bg-danger"><i class="bi bi-youtube me-1"></i>Video</span>
                                                    <% } %>
                                                </div>

                                                <h4 class="text-white fw-bold mb-1"><%= p.title %></h4>
                                                <% if (p.subtitle) { %>
                                                    <div class="text-warning small mb-2"><%= p.subtitle %></div>
                                                <% } %>

                                                <p class="text-white-50 small mb-3 flex-grow-1" style="line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                                    <%= p.description || 'Lectura de la porción semanal de la Torá.' %>
                                                </p>

                                                <div class="pt-2 border-top border-secondary border-opacity-50 d-flex justify-content-between align-items-center">
                                                    <a href="/parashot/<%= p.id %>?cycle=<%= selectedCycle.id %>" class="btn btn-sm btn-outline-warning">
                                                        <i class="bi bi-book me-1"></i> Ver Porción
                                                    </a>
                                                    <% if (p.youtube_link) { %>
                                                        <a href="<%= p.youtube_link %>" target="_blank" class="btn btn-sm btn-danger">
                                                            <i class="bi bi-play-circle me-1"></i> Video
                                                        </a>
                                                    <% } %>
                                                    <% if (p.pdf_file) { %>
                                                        <a href="<%= p.pdf_file %>" target="_blank" class="btn btn-sm btn-success">
                                                            <i class="bi bi-file-pdf me-1"></i> PDF
                                                        </a>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="col-12 text-center py-4 text-white-50">
                                        No hay registros de Parashot en este ciclo.
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- TAB ALIYOT HISTÓRICAS -->
                        <div class="tab-pane fade" id="content-aliyot" role="tabpanel">
                            <div class="row g-3" id="historicalAliyotGrid">
                                <% if (historicalAliyot && historicalAliyot.length > 0) { %>
                                    <% historicalAliyot.forEach(a => { %>
                                        <div class="col-md-6 historical-item-aliyah" data-title="<%= a.title.toLowerCase() %>" data-ref="<%= (a.verses_reference || '').toLowerCase() %>" data-parasha="<%= (a.parasha_title || '').toLowerCase() %>">
                                            <div class="content-item-card p-3 h-100">
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span class="badge bg-info text-dark fw-bold">
                                                        <%= a.parasha_title ? a.parasha_title + ' - ' : '' %>Aliyá <%= a.aliyah_number %>°
                                                    </span>
                                                    <% if (a.reading_date) { %>
                                                        <small class="text-white-50"><%= new Date(a.reading_date).toLocaleDateString('es-ES') %></small>
                                                    <% } %>
                                                </div>

                                                <h5 class="text-white fw-bold mb-1"><%= a.title %></h5>
                                                <% if (a.verses_reference) { %>
                                                    <div class="text-warning small mb-2"><i class="bi bi-bookmark me-1"></i><%= a.verses_reference %></div>
                                                <% } %>

                                                <% if (a.audios && a.audios.length > 0) { %>
                                                    <div class="mt-3 p-2 rounded bg-black bg-opacity-40 border border-secondary border-opacity-50">
                                                        <div class="small text-white-50 mb-1"><i class="bi bi-volume-up me-1 text-info"></i>Audios Grabados:</div>
                                                        <% a.audios.forEach((aud, audIdx) => { %>
                                                            <div class="mb-2">
                                                                <small class="text-white-50 d-block mb-1"><%= aud.title || ('Audio ' + (audIdx + 1)) %></small>
                                                                <audio controls class="w-100" style="height: 34px;">
                                                                    <source src="<%= aud.url %>" type="audio/ogg">
                                                                    <source src="<%= aud.url %>" type="audio/mpeg">
                                                                    Tu navegador no soporta el audio.
                                                                </audio>
                                                            </div>
                                                        <% }) %>
                                                    </div>
                                                <% } else { %>
                                                    <small class="text-white-50 d-block mt-2"><em>Sin archivo de audio adjunto</em></small>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="col-12 text-center py-4 text-white-50">
                                        No hay registros de Aliyot con audios en este ciclo histórico.
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- TAB HAFTAROT HISTÓRICAS -->
                        <div class="tab-pane fade" id="content-haftarot" role="tabpanel">
                            <div class="row g-4" id="historicalHaftarotGrid">
                                <% if (historicalHaftarot && historicalHaftarot.length > 0) { %>
                                    <% historicalHaftarot.forEach(h => { %>
                                        <div class="col-md-6 col-lg-4 historical-item-haftara" data-title="<%= h.title.toLowerCase() %>" data-sub="<%= (h.subtitle || '').toLowerCase() %>" data-ref="<%= (h.parasha_reference || '').toLowerCase() %>">
                                            <div class="content-item-card h-100 p-3 d-flex flex-column">
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span class="badge bg-success fw-bold">
                                                        <i class="bi bi-scroll me-1"></i>Haftará
                                                    </span>
                                                    <% if (h.youtube_link) { %>
                                                        <span class="badge bg-danger"><i class="bi bi-youtube me-1"></i>Video</span>
                                                    <% } %>
                                                </div>

                                                <h4 class="text-white fw-bold mb-1"><%= h.title %></h4>
                                                <% if (h.subtitle) { %>
                                                    <div class="text-warning small mb-1"><%= h.subtitle %></div>
                                                <% } %>
                                                <% if (h.parasha_reference) { %>
                                                    <div class="text-info small mb-2"><i class="bi bi-link-45deg"></i><%= h.parasha_reference %></div>
                                                <% } %>

                                                <p class="text-white-50 small mb-3 flex-grow-1" style="line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                                    <%= h.description || 'Lectura profética vinculada a la porción de la Torá.' %>
                                                </p>

                                                <div class="pt-2 border-top border-secondary border-opacity-50 d-flex justify-content-between align-items-center">
                                                    <a href="/haftara/<%= h.id %>?cycle=<%= selectedCycle.id %>" class="btn btn-sm btn-outline-success">
                                                        <i class="bi bi-book me-1"></i> Ver Haftará
                                                    </a>
                                                    <% if (h.youtube_link) { %>
                                                        <a href="<%= h.youtube_link %>" target="_blank" class="btn btn-sm btn-danger">
                                                            <i class="bi bi-play-circle me-1"></i> Video
                                                        </a>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="col-12 text-center py-4 text-white-50">
                                        No hay lecturas de Haftará en este ciclo histórico.
                                    </div>
                                <% } %>
                            </div>
                        </div>

                    </div>

                <% } %>

            <% } %>

        </div>

    </main>

    <%- include('partials/footer') %>

    <script>
    // Buscador interactivo en vivo
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('historicalSearchInput');
        if (!searchInput) return;

        searchInput.addEventListener('input', function() {
            const query = this.value.trim().toLowerCase();

            // Filtrar Parashot
            document.querySelectorAll('.historical-item-parasha').forEach(el => {
                const title = el.getAttribute('data-title') || '';
                const sub = el.getAttribute('data-sub') || '';
                const desc = el.getAttribute('data-desc') || '';
                const match = title.includes(query) || sub.includes(query) || desc.includes(query);
                el.style.display = match ? '' : 'none';
            });

            // Filtrar Aliyot
            document.querySelectorAll('.historical-item-aliyah').forEach(el => {
                const title = el.getAttribute('data-title') || '';
                const ref = el.getAttribute('data-ref') || '';
                const parasha = el.getAttribute('data-parasha') || '';
                const match = title.includes(query) || ref.includes(query) || parasha.includes(query);
                el.style.display = match ? '' : 'none';
            });

            // Filtrar Haftarot
            document.querySelectorAll('.historical-item-haftara').forEach(el => {
                const title = el.getAttribute('data-title') || '';
                const sub = el.getAttribute('data-sub') || '';
                const ref = el.getAttribute('data-ref') || '';
                const match = title.includes(query) || sub.includes(query) || ref.includes(query);
                el.style.display = match ? '' : 'none';
            });
        });
    });
    </script>

</body>
</html>
