<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

<body class="semillas-page" style="background-color: #faf7f2;">

    <%- include('partials/header') %>

    <main class="main">

        <!-- Page Title Banner -->
        <div class="page-title accent-background" style="background: linear-gradient(135deg, #4a154b 0%, #6b21a8 50%, #2e7d32 100%); padding: 130px 0 60px 0;">
            <div class="container">
                <div class="row align-items-center gy-3">
                    <div class="col-lg-8" data-aos="fade-right">
                        <span class="badge mb-2 px-3 py-2 text-uppercase" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(5px); font-size: 0.85rem; letter-spacing: 1px; color: #fff; border-radius: 20px;">
                            🌱 Ministerio Infantil • By Elva Avila
                        </span>
                        <h1 class="mb-2 text-white fw-bold" style="font-size: 2.6rem;">Semillas de Torah</h1>
                        <p class="text-white-50 mb-0" style="font-size: 1.15rem;">Sembrando la Palabra, cosechando vida 💚</p>
                    </div>
                    <div class="col-lg-4 text-lg-end" data-aos="fade-left">
                        <nav class="breadcrumbs">
                            <ol class="d-inline-flex list-unstyled gap-2 m-0 p-0 text-white-50 flex-wrap justify-content-lg-end align-items-center">
                                <li><a href="/" class="text-white text-decoration-none">Inicio</a></li>
                                <li class="text-white-50">/</li>
                                <li class="current text-white fw-semibold">Semillas de Torah</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div><!-- End Page Title -->

        <!-- Hero Section with Official Banner -->
        <section class="section py-5 position-relative overflow-hidden">
            <div class="container">
                <div class="row align-items-center gy-5">
                    <div class="col-lg-6" data-aos="fade-right">
                        <div class="pe-lg-4">
                            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3 rounded-pill" style="background: #f3e8ff; color: #6b21a8; font-weight: 700; font-size: 0.88rem; border: 1px solid #e9d5ff;">
                                <i class="bi bi-balloon-heart-fill text-danger"></i> Por Elva Avila
                            </div>
                            <h2 class="display-6 fw-bold mb-3" style="color: #2e1065; line-height: 1.3;">
                                Sembrando la Palabra en el corazón de las <span style="color: #6b21a8; border-bottom: 3px solid #22c55e;">nuevas generaciones</span>
                            </h2>
                            <p class="lead text-muted mb-4" style="font-size: 1.12rem; line-height: 1.8;">
                                <strong>Semillas de Torah</strong> es un espacio creado para que los niños y familias conozcan las riquezas de la Toráh, los valores bíblicos y las fiestas del Creador de una manera alegre, visual y pedagógica. <em>¡Abba sea glorificado!</em>
                            </p>

                            <div class="d-flex flex-wrap gap-3 mt-4">
                                <a href="https://www.facebook.com/profile.php?id=61592294939779" target="_blank" rel="noopener noreferrer" class="btn btn-lg px-4 py-3 shadow-sm rounded-pill fw-bold text-white d-inline-flex align-items-center gap-2" style="background: #1877F2; border: none; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                                    <i class="bi bi-facebook fs-5"></i> Seguir en Facebook Oficial
                                </a>
                                <a href="#actividades-seccion" class="btn btn-lg px-4 py-3 rounded-pill fw-bold d-inline-flex align-items-center gap-2" style="background: #ffffff; border: 2px solid #6b21a8; color: #6b21a8; transition: all 0.3s ease;">
                                    <i class="bi bi-camera-reels me-1"></i> Ver Novedades & Shorts (<%= (typeof shorts !== 'undefined' && shorts) ? shorts.length : 0 %>)
                                </a>
                            </div>

                            <div class="mt-4 pt-3 border-top d-flex align-items-center gap-4 text-muted small">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <span>Aliyot con Niños</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <span>Material Didáctico</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <span>100% Gratuito</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 text-center" data-aos="fade-left">
                        <div class="position-relative d-inline-block w-100" style="max-width: 540px;">
                            <!-- Video Card Presentación Oficial -->
                            <div class="card border-0 shadow-lg position-relative" style="border-radius: 24px; overflow: hidden; background: #000; border: 4px solid #fff;">
                                <div class="position-relative" style="width: 100%; aspect-ratio: 16/9; max-height: 420px; background: #000; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                    <video id="semillasIntroVideo" 
                                           src="/assets/video/semillas_torah_intro.mp4" 
                                           poster="/assets/img/pagina/semillas_torah_banner.png"
                                           class="w-100 h-100" 
                                           style="object-fit: contain; background: #000;" 
                                           controls 
                                           autoplay 
                                           muted 
                                           loop 
                                           playsinline 
                                           preload="auto">
                                        <source src="/assets/video/semillas_torah_intro.mp4" type="video/mp4">
                                        Tu navegador no soporta el formato de video.
                                    </video>
                                </div>
                                <div class="p-3 text-center" style="background: linear-gradient(135deg, #581c87, #3b0764); color: #fff;">
                                    <p class="mb-0 fw-semibold" style="font-size: 0.95rem;">
                                        🌱 <em>"Instruye al niño en su camino, y aun cuando fuere viejo no se apartará de él."</em> — Proverbios 22:6
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN PRINCIPAL CON PESTAÑAS: SHORTS / ENSEÑANZAS / ALIYOT -->
        <section id="actividades-seccion" class="section py-5" style="background-color: #ffffff;">
            <div class="container">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 pb-3 border-bottom" data-aos="fade-up">
                    <div>
                        <span class="badge px-3 py-2 rounded-pill text-uppercase mb-2" style="background: #f3e8ff; color: #6b21a8; font-weight: 700; font-size: 0.8rem; letter-spacing: 1px;">
                            Contenido & Recursos
                        </span>
                        <h2 class="fw-bold mb-1" style="color: #2e1065;">Novedades y Enseñanzas Infantiles</h2>
                        <p class="text-muted mb-0">Videos de Aliyot con los niños en formato Shorts, historias y recursos para toda la familia.</p>
                    </div>
                </div>

                <!-- Pestañas de Navegación -->
                <ul class="nav nav-pills gap-2 mb-4 flex-wrap" id="semillasTabs" role="tablist" data-aos="fade-up" data-aos-delay="100">
                    <!-- Tab 1: Parashá Semanal Infantil (PDF) -->
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active px-4 py-3 fw-bold d-flex align-items-center gap-2 shadow-sm semillas-tab-btn" 
                                id="tab-parasha-infantil" data-bs-toggle="pill" data-bs-target="#pane-parasha-infantil" type="button" role="tab"
                                style="border-radius: 16px; border: 2px solid #fde047; font-size: 1rem; transition: all 0.3s ease;">
                            <i class="bi bi-file-earmark-pdf-fill fs-5 text-warning"></i> 
                            Parashá Semanal Infantil (PDF)
                            <span class="badge rounded-pill" style="background: linear-gradient(135deg, #d97706, #b45309); color: #fff; font-size: 0.75rem;">
                                <%= (typeof parashotInfantiles !== 'undefined' && parashotInfantiles) ? parashotInfantiles.length : 0 %> ✨ Fichas PDF
                            </span>
                        </button>
                    </li>
                    <!-- Tab 2: Alef-Bet Hebreo Infantil -->
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-4 py-3 fw-bold d-flex align-items-center gap-2 shadow-sm semillas-tab-btn" 
                                id="tab-alefbet" data-bs-toggle="pill" data-bs-target="#pane-alefbet" type="button" role="tab"
                                style="border-radius: 16px; border: 2px solid #38bdf8; font-size: 1rem; transition: all 0.3s ease;">
                            <i class="bi bi-translate fs-5 text-primary"></i> 
                            Alef-Bet Hebreo Infantil
                            <span class="badge rounded-pill" style="background: linear-gradient(135deg, #0284c7, #0369a1); color: #fff; font-size: 0.75rem;">
                                ✨ 22 Letras · Cantos · Juegos
                            </span>
                        </button>
                    </li>
                    <!-- Tab 3: Dibujos y Manualidades -->
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-4 py-3 fw-bold d-flex align-items-center gap-2 shadow-sm semillas-tab-btn" 
                                id="tab-manualidades" data-bs-toggle="pill" data-bs-target="#pane-manualidades" type="button" role="tab"
                                style="border-radius: 16px; border: 2px solid #c084fc; font-size: 1rem; transition: all 0.3s ease;">
                            <i class="bi bi-palette-fill fs-5" style="color: #9333ea;"></i> 
                            Dibujos y Manualidades
                            <span class="badge rounded-pill" style="background: linear-gradient(135deg, #9333ea, #7e22ce); color: #fff; font-size: 0.75rem;">
                                <%= (typeof manualidades !== 'undefined' && manualidades) ? manualidades.length : 0 %> 🎨 Actividades
                            </span>
                        </button>
                    </li>
                    <!-- Tab 2: Shorts / Novedades -->
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-4 py-3 fw-bold d-flex align-items-center gap-2 shadow-sm semillas-tab-btn" 
                                id="tab-shorts" data-bs-toggle="pill" data-bs-target="#pane-shorts" type="button" role="tab"
                                style="border-radius: 16px; border: 2px solid #bae6fd; font-size: 1rem; transition: all 0.3s ease;">
                            <i class="bi bi-camera-reels-fill fs-5 text-info"></i> 
                            Aliyot con Niños · Shorts
                            <span class="badge rounded-pill" style="background: linear-gradient(135deg, #0284c7, #0369a1); color: #fff; font-size: 0.75rem;">
                                <%= (typeof shorts !== 'undefined' && shorts) ? shorts.length : 0 %>
                            </span>
                        </button>
                    </li>
                    <!-- Tab 3: Enseñanzas Infantiles -->
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-4 py-3 fw-bold d-flex align-items-center gap-2 shadow-sm semillas-tab-btn" 
                                id="tab-ensenanzas" data-bs-toggle="pill" data-bs-target="#pane-ensenanzas" type="button" role="tab"
                                style="border-radius: 16px; border: 2px solid #e9d5ff; font-size: 1rem; transition: all 0.3s ease;">
                            <i class="bi bi-collection-play fs-5"></i> 
                            Enseñanzas Infantiles
                            <span class="badge rounded-pill" style="background: rgba(107,33,168,0.15); color: #6b21a8; font-size: 0.75rem;">
                                <%= (typeof items !== 'undefined' && items) ? items.length : 0 %>
                            </span>
                        </button>
                    </li>
                    <!-- Tab 4: Noticias & Resúmenes de Parashá con Imágenes -->
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-4 py-3 fw-bold d-flex align-items-center gap-2 shadow-sm semillas-tab-btn" 
                                id="tab-articulos" data-bs-toggle="pill" data-bs-target="#pane-articulos" type="button" role="tab"
                                style="border-radius: 16px; border: 2px solid #86efac; font-size: 1rem; transition: all 0.3s ease;">
                            <i class="bi bi-newspaper fs-5 text-success"></i> 
                            Noticias & Resúmenes Ilustrados
                            <span class="badge rounded-pill" style="background: linear-gradient(135deg, #16a34a, #15803d); color: #fff; font-size: 0.75rem;">
                                <%= (typeof articulos !== 'undefined' && articulos) ? articulos.length : 0 %>
                            </span>
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="semillasTabContent">

                    <!-- ============================================================ -->
                    <!-- PESTAÑA: PARASHÁ SEMANAL INFANTIL (PDFs DESCARGABLES)       -->
                    <!-- ============================================================ -->
                    <div class="tab-pane fade show active" id="pane-parasha-infantil" role="tabpanel">
                        
                        <!-- Banner Explicativo Parashá Infantil -->
                        <div class="p-4 mb-4 rounded-4 shadow-sm border-0 d-flex align-items-start gap-3" style="background: linear-gradient(135deg, #fefce8 0%, #fef08a 40%, #fdf4ff 100%); border-left: 5px solid #eab308 !important;">
                            <div class="rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="background: rgba(234,179,8,0.25); width: 54px; height: 54px; color: #a16207;">
                                <i class="bi bi-file-earmark-pdf-fill fs-2"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                    <h4 class="fw-bold mb-0" style="color: #713f12;">Parashá Semanal Infantil en PDF</h4>
                                    <span class="badge bg-warning text-dark rounded-pill px-2 py-1 small fw-bold">
                                        <i class="bi bi-cloud-arrow-down-fill me-1"></i>Material para Descargar e Imprimir
                                    </span>
                                </div>
                                <p class="mb-0 text-muted" style="font-size: 0.98rem; line-height: 1.6;">
                                    Descarga semanalmente las fichas y resúmenes de la Torá adaptadas en formato <strong>PDF</strong> con historias, versículos y dibujos para que los niños puedan estudiar, pintar y aprender en familia o en la congregación.
                                </p>
                            </div>
                        </div>

                        <% const allParashotInfantiles = (typeof parashotInfantiles !== 'undefined' && parashotInfantiles) ? parashotInfantiles : []; %>

                        <% if (allParashotInfantiles.length > 0) { %>
                            <% const destacada = allParashotInfantiles[0]; %>
                            
                            <!-- TARJETA DESTACADA: PARASHÁ DE LA SEMANA -->
                            <div class="card border-0 rounded-4 shadow-sm mb-5 overflow-hidden" style="background: #ffffff; border: 2px solid #fef08a !important; box-shadow: 0 10px 30px rgba(234,179,8,0.12) !important;">
                                <div class="card-header border-0 py-3 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background: linear-gradient(135deg, #fef9c3 0%, #fef08a 100%);">
                                    <span class="badge rounded-pill px-3 py-1 shadow-sm" style="background: linear-gradient(135deg, #d97706, #b45309); color: #fff; font-size: 0.82rem; font-weight: 700;">
                                        <i class="bi bi-star-fill me-1 text-warning"></i> PORCIÓN DE LA SEMANA DESTACADA
                                    </span>
                                    <span class="badge bg-black bg-opacity-75 text-warning rounded-pill px-3 py-1">
                                        <i class="bi bi-calendar-check me-1"></i> <%= destacada.cycle_name || 'Ciclo Anual de Torá' %>
                                    </span>
                                </div>
                                <div class="card-body p-4 p-md-5">
                                    <div class="row g-4 align-items-center">
                                        <!-- Portada Ilustrada -->
                                        <div class="col-lg-5 text-center">
                                            <div class="position-relative d-inline-block rounded-4 overflow-hidden shadow" style="max-width: 340px; background: #000; border: 4px solid #fef08a;">
                                                <% if (destacada.cover_image) { %>
                                                    <img src="<%= destacada.cover_image %>" alt="<%= destacada.title %>" class="img-fluid w-100" style="object-fit: cover; max-height: 420px;">
                                                <% } else { %>
                                                    <div class="p-5 text-center text-warning" style="background: linear-gradient(135deg, #2e1065, #581c87); min-height: 320px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                                        <i class="bi bi-file-earmark-pdf fs-1 mb-2"></i>
                                                        <span class="fw-bold fs-5 text-white">Parashá Semanal Infantil</span>
                                                        <small class="text-white-50 mt-1">Hablemos de YHWH</small>
                                                    </div>
                                                <% } %>
                                                <div class="position-absolute top-0 start-0 m-3">
                                                    <span class="badge bg-dark text-warning rounded-pill px-3 py-1 fw-bold fs-6 shadow">
                                                        #<%= destacada.parasha_number || 'Semana' %>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Información y Botones de Descarga -->
                                        <div class="col-lg-7">
                                            <span class="badge rounded-pill px-3 py-1 mb-2" style="background: #ede9fe; color: #6b21a8; font-weight: 700;">
                                                <i class="bi bi-book me-1"></i> <%= destacada.book || 'Torah' %>
                                            </span>
                                            <h2 class="fw-bold mb-2" style="color: #2e1065; font-size: 2.1rem; line-height: 1.25;">
                                                <%= destacada.title %>
                                            </h2>
                                            
                                            <% if (destacada.biblical_reference) { %>
                                                <div class="d-inline-flex align-items-center gap-1 text-muted small fw-semibold mb-3 px-3 py-1 rounded-pill" style="background: #f1f5f9;">
                                                    <i class="bi bi-bookmark-fill text-warning"></i>
                                                    <span>Porción Bíblica: <strong><%= destacada.biblical_reference %></strong></span>
                                                </div>
                                            <% } %>

                                            <% if (destacada.key_verse) { %>
                                                <div class="p-3 mb-3 rounded-3 shadow-xs" style="background: #faf5ff; border-left: 4px solid #6b21a8; color: #4c1d95; font-size: 1.05rem; font-weight: 500;">
                                                    <i class="bi bi-quote fs-4 text-purple opacity-50 me-1"></i>
                                                    <%= destacada.key_verse %>
                                                </div>
                                            <% } %>

                                            <% if (destacada.summary) { %>
                                                <p class="text-muted mb-4" style="font-size: 1.05rem; line-height: 1.8; white-space: pre-line;">
                                                    <%= destacada.summary %>
                                                </p>
                                            <% } %>

                                            <!-- BOTONES DE ACCIÓN PARA EL NIÑO Y LA FAMILIA -->
                                            <div class="d-flex flex-wrap gap-3 align-items-center pt-2">
                                                <a href="/semillas-de-torah/parasha-infantil/<%= destacada.id %>/descargar" download class="btn btn-lg px-4 py-3 rounded-pill fw-bold text-dark d-inline-flex align-items-center gap-2 shadow" style="background: linear-gradient(135deg, #facc15, #eab308); border: none; font-size: 1.05rem;">
                                                    <i class="bi bi-cloud-arrow-down-fill fs-4"></i>
                                                    <span>Descargar PDF para Estudiar</span>
                                                </a>
                                                <button type="button" onclick="openPdfViewerModal('<%= destacada.pdf_file %>', '<%= destacada.title.replace(/'/g, "\\'") %>')" class="btn btn-lg btn-outline-dark px-4 py-3 rounded-pill fw-bold d-inline-flex align-items-center gap-2" style="font-size: 1.02rem;">
                                                    <i class="bi bi-eye-fill"></i>
                                                    <span>Leer / Ver PDF en Pantalla</span>
                                                </button>
                                                <% if (destacada.parasha_id) { %>
                                                    <a href="/parashot/<%= destacada.parasha_id %>" class="btn btn-lg btn-outline-secondary px-4 py-3 rounded-pill fw-bold d-inline-flex align-items-center gap-2" style="font-size: 1.02rem;" title="Ver estudio de adultos y Aliyot">
                                                        <i class="bi bi-journal-text text-warning"></i>
                                                        <span>Ver Parashá y Aliyot</span>
                                                    </a>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- OTRAS PARASHOT INFANTILES DISPONIBLES EN PDF -->
                            <% if (allParashotInfantiles.length > 1) { %>
                                <div class="mt-4 mb-4">
                                    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                                        <div>
                                            <h4 class="fw-bold mb-1" style="color: #2e1065;">
                                                <i class="bi bi-folder2-open me-2 text-warning"></i>Archivo de Parashot Infantiles en PDF
                                            </h4>
                                            <p class="text-muted small mb-0">Estudia o repasa las porciones anteriores de la Torá en formato imprimible.</p>
                                        </div>
                                    </div>

                                    <div class="row g-4">
                                        <% allParashotInfantiles.slice(1).forEach((pi, idx) => { %>
                                            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="<%= (idx % 3 + 1) * 100 %>">
                                                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white" style="border: 1px solid #f1f5f9; transition: transform 0.25s ease, box-shadow 0.25s ease;">
                                                    <div class="position-relative" style="height: 180px; background: #2e1065; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                                        <% if (pi.cover_image) { %>
                                                            <img src="<%= pi.cover_image %>" alt="<%= pi.title %>" class="w-100 h-100" style="object-fit: cover;">
                                                        <% } else { %>
                                                            <div class="text-center text-warning p-3">
                                                                <i class="bi bi-file-earmark-pdf fs-1 mb-1"></i>
                                                                <div class="fw-bold text-white"><%= pi.parasha_name ? ('Parashá ' + pi.parasha_name) : pi.title %></div>
                                                            </div>
                                                        <% } %>
                                                        <span class="position-absolute top-0 start-0 m-2 badge bg-black bg-opacity-75 text-warning rounded-pill px-3 py-1 fw-bold">
                                                            #<%= pi.parasha_number || '-' %>
                                                        </span>
                                                        <span class="position-absolute top-0 end-0 m-2 badge bg-warning text-dark rounded-pill px-2 py-1 small fw-bold">
                                                            <i class="bi bi-file-pdf"></i> PDF
                                                        </span>
                                                    </div>
                                                    <div class="p-3 d-flex flex-column flex-grow-1">
                                                        <div class="text-muted small mb-1 fw-semibold">
                                                            <i class="bi bi-book text-warning me-1"></i><%= pi.book || 'Torah' %>
                                                        </div>
                                                        <h5 class="fw-bold mb-2" style="color: #2e1065; font-size: 1.15rem;">
                                                            <%= pi.title %>
                                                        </h5>
                                                        <% if (pi.biblical_reference) { %>
                                                            <p class="text-muted small mb-3">
                                                                <%= pi.biblical_reference %>
                                                            </p>
                                                        <% } %>
                                                        <div class="mt-auto pt-3 border-top d-flex gap-2 flex-wrap">
                                                            <a href="/semillas-de-torah/parasha-infantil/<%= pi.id %>/descargar" download class="btn btn-sm btn-warning text-dark fw-bold rounded-pill flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1">
                                                                <i class="bi bi-download"></i> Descargar PDF
                                                            </a>
                                                            <button type="button" onclick="openPdfViewerModal('<%= pi.pdf_file %>', '<%= pi.title.replace(/'/g, "\\'") %>')" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Leer en pantalla">
                                                                <i class="bi bi-eye"></i>
                                                            </button>
                                                            <% if (pi.parasha_id) { %>
                                                                <a href="/parashot/<%= pi.parasha_id %>" class="btn btn-sm btn-outline-dark rounded-pill px-3" title="Ver Parashá y Aliyot">
                                                                    <i class="bi bi-journal-text text-warning"></i>
                                                                </a>
                                                            <% } %>
