    <script>
    function openImageLightbox(imgUrl, title) {
        if (!imgUrl) return;
        const imgEl = document.getElementById('semillasImageModalImg');
        const titleEl = document.getElementById('semillasImageModalTitle');
        const downloadEl = document.getElementById('semillasImageModalDownload');
        
        if (imgEl) imgEl.src = imgUrl;
        if (titleEl) titleEl.innerText = title || 'Infografía de Parashá';
        if (downloadEl) {
            downloadEl.href = imgUrl;
            downloadEl.setAttribute('download', (title || 'infografia_semillas') + '.png');
        }

        const modalEl = document.getElementById('semillasImageModal');
        if (modalEl && typeof bootstrap !== 'undefined') {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    }

    function openPdfViewerModal(pdfUrl, title) {
        if (!pdfUrl) return;
        const iframe = document.getElementById('pdfViewerIframe');
        const titleEl = document.getElementById('pdfViewerModalTitle');
        const downloadEl = document.getElementById('pdfViewerModalDownload');

        if (titleEl) titleEl.textContent = title || 'Parashá Semanal Infantil en PDF';
        if (downloadEl) downloadEl.href = pdfUrl;
        if (iframe) iframe.src = pdfUrl;

        const modalEl = document.getElementById('pdfViewerModal');
        if (modalEl && typeof bootstrap !== 'undefined') {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();

            modalEl.addEventListener('hidden.bs.modal', function () {
                if (iframe) iframe.src = '';
            }, { once: true });
        }
    }

    function activarTabParashaInfantil() {
        const tabBtn = document.getElementById('tab-parasha-infantil');
        if (tabBtn) {
            tabBtn.click();
            const targetSection = document.getElementById('actividades-seccion');
            if (targetSection) {
                targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }
    }

    function activarTabAlefBet() {
        const tabBtn = document.getElementById('tab-alefbet');
        if (tabBtn) {
            tabBtn.click();
            const targetSection = document.getElementById('actividades-seccion');
            if (targetSection) {
                targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }
    }

    function activarTabManualidades() {
        const tabBtn = document.getElementById('tab-manualidades');
        if (tabBtn) {
            tabBtn.click();
            const targetSection = document.getElementById('actividades-seccion');
            if (targetSection) {
                targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }
    }

    function filtrarManualidadesPublica(cat, btn) {
        const buttons = document.querySelectorAll('#filterPillsManualidades .btn-filter-man');
        buttons.forEach(b => {
            b.classList.remove('active');
            b.style.background = '';
            b.style.color = '';
            b.classList.add('btn-light');
        });
        if (btn) {
            btn.classList.add('active');
            btn.classList.remove('btn-light');
            btn.style.background = '#9333ea';
            btn.style.color = '#fff';
        }

        const cards = document.querySelectorAll('#pane-manualidades .item-manualidad-card');
        const sections = document.querySelectorAll('#pane-manualidades .seccion-bloque-manualidad');

        if (cat === 'all') {
            cards.forEach(c => c.style.display = '');
            sections.forEach(s => s.style.display = '');
        } else {
            cards.forEach(c => {
                const cCat = c.getAttribute('data-cat');
                c.style.display = (cCat === cat) ? '' : 'none';
            });
            sections.forEach(s => {
                const sGrupo = s.getAttribute('data-grupo');
                s.style.display = (sGrupo === cat) ? '' : 'none';
            });
        }
    }

    function abrirModalDetalleManualidad(item) {
        if (!item) return;
        const modalEl = document.getElementById('modalDetalleManualidad');
        if (!modalEl) return;

        document.getElementById('mDetalleTitulo').innerText = item.title || 'Actividad Bíblica Infantil';
        document.getElementById('mDetalleCat').innerText = item.category || 'Manualidad';
        
        const catBadge = document.getElementById('mDetalleCat');
        if (item.category === 'Porción Semanal') {
            catBadge.className = 'badge rounded-pill bg-warning text-dark';
        } else if (item.category === 'Santas Convocaciones') {
            catBadge.className = 'badge rounded-pill bg-success';
        } else {
            catBadge.className = 'badge rounded-pill text-white';
            catBadge.style.background = '#9333ea';
        }

        const refWrap = document.getElementById('mDetalleRefWrap');
        let refText = '';
        if (item.parasha_number || item.parasha_name || item.canonical_parasha_title) {
            refText = 'Parashá ' + (item.parasha_number ? '#' + item.parasha_number + ' ' : '') + (item.canonical_parasha_title || item.parasha_name || '');
        } else if (item.moed_name) {
            refText = 'Santa Convocación: ' + item.moed_name;
        }
        if (refText) {
            refWrap.style.display = 'block';
            document.getElementById('mDetalleRef').innerText = refText;
        } else {
            refWrap.style.display = 'none';
        }

        document.getElementById('mDetalleEdad').innerText = item.age_range || 'Todas las edades';
        document.getElementById('mDetalleDesc').innerText = item.description || 'Sin descripción adicional.';
        
        const matBox = document.getElementById('mDetalleMaterialesBox');
        if (item.materials) {
            matBox.style.display = 'block';
            document.getElementById('mDetalleMateriales').innerText = item.materials;
        } else {
            matBox.style.display = 'none';
        }

        const instBox = document.getElementById('mDetalleInstruccionesBox');
        if (item.instructions) {
            instBox.style.display = 'block';
            document.getElementById('mDetalleInstrucciones').innerText = item.instructions;
        } else {
            instBox.style.display = 'none';
        }

        document.getElementById('mDetalleAutora').innerText = (item.author_name || 'Semillas de Toráh') + (item.author_role ? ' (' + item.author_role + ')' : '');

        const imgEl = document.getElementById('mDetalleImg');
        const imgWrap = document.getElementById('mDetalleImgWrap');
        if (item.image_url) {
            imgEl.src = item.image_url;
            imgWrap.style.display = 'block';
        } else {
            imgWrap.style.display = 'none';
        }

        const downBtn = document.getElementById('mDetalleDownloadBtn');
        const prevBnBtn = document.getElementById('mDetallePreviewBnBtn');
        if (item.pdf_file || item.image_url) {
            downBtn.href = '/semillas-de-torah/manualidad/' + item.id + '/descargar';
            downBtn.style.display = 'inline-flex';
            if (prevBnBtn) {
                prevBnBtn.href = item.pdf_file || item.image_url;
                prevBnBtn.style.display = 'inline-flex';
            }
        } else {
            downBtn.style.display = 'none';
            if (prevBnBtn) prevBnBtn.style.display = 'none';
        }

        if (typeof bootstrap !== 'undefined') {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    }

