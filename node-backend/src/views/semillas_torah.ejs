                                    <span class="badge bg-danger rounded-pill px-2 py-1 small"><i class="bi bi-play-circle-fill me-1"></i>Shorts Verticales</span>
                                </div>
                                <p class="mb-0 text-muted" style="font-size: 0.95rem; line-height: 1.6;">
                                    ¡Nuestros pequeños se deleitan en la Palabra! Disfruta de los videos de las <strong>Aliyot semanales</strong> y de <strong>temas diversos</strong> con historias bíblicas, valores y reflexiones infantiles en pantalla interactiva.
                                </p>
                            </div>
                        </div>

                        <% 
                            const allShorts = (typeof shorts !== 'undefined' && shorts) ? shorts : [];
                            const generalShorts = allShorts.filter(s => s.short_type === 'general');
                            const aliyotShorts = allShorts.filter(s => s.short_type !== 'general').sort((a, b) => {
                                const parashaA = (a.parasha_name || '').trim().toLowerCase();
                                const parashaB = (b.parasha_name || '').trim().toLowerCase();
                                if (parashaA && parashaB && parashaA === parashaB) {
                                    const numA = parseInt(a.aliyah_number) || 0;
                                    const numB = parseInt(b.aliyah_number) || 0;
                                    if (numA !== numB) return numB - numA; // DESC: 2 antes que 1
                                }
                                const dateA = a.reading_date ? new Date(a.reading_date).toISOString().slice(0, 10) : (a.created_at ? new Date(a.created_at).toISOString().slice(0, 10) : '');
                                const dateB = b.reading_date ? new Date(b.reading_date).toISOString().slice(0, 10) : (b.created_at ? new Date(b.created_at).toISOString().slice(0, 10) : '');
                                if (dateA !== dateB) return dateB.localeCompare(dateA);
                                const numA = parseInt(a.aliyah_number) || 0;
                                const numB = parseInt(b.aliyah_number) || 0;
                                if (numA !== numB) return numB - numA;
                                return (b.id || 0) - (a.id || 0);
                            });
                        %>

