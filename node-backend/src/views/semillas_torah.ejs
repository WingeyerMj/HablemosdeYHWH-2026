                        <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-palette-fill me-1"></i>Infografía / Ficha Semillas de Torah</span>
                        <h6 class="modal-title text-white fw-bold mb-0 text-truncate" id="semillasImageModalTitle" style="max-width: 500px;"></h6>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="#" id="semillasImageModalDownload" download class="btn btn-sm btn-outline-light rounded-pill px-3 fw-semibold">
