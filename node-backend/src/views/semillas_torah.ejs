    // PRONUNCIACIÓN DE LETRA CON SÍNTESIS DE VOZ Y TONOS
    function reproducirSonidoLetra(hebrewChar, letterName) {
        tocarTonoAlegre(440, 0.15);
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
            const utter = new SpeechSynthesisUtterance(letterName);
            utter.lang = 'es-ES';
            utter.rate = 0.9;
            utter.pitch = 1.1;
            window.speechSynthesis.speak(utter);
        }
    }

    // AUDIO WEB API SINTETIZADO (TONO ALEGRE SEGURO)
    function tocarTonoAlegre(freq = 520, duration = 0.2) {
        try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            const ctx = new AudioContext();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, ctx.currentTime);
            gain.gain.setValueAtTime(0.2, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + duration);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + duration);
        } catch(e) {}
    }

