                <script>
                    window.onload = function() { window.print(); };
                <\/script>
            </body>
            </html>
        `);
        w.document.close();
    }

    function imprimirFichaIndividualLetra() {
        const l = alefbetLetras[letraActivaModal];
        if (!l) return;
        const w = window.open('', '_blank');
        w.document.write(`
            <!DOCTYPE html>
            <html lang="es">
            <head>
                <meta charset="UTF-8">
                <title>Lámina Letra ${l.name} - Semillas de Torah</title>
                <style>
                    @page { size: A4 portrait; margin: 15mm; }
                    body { font-family: 'Segoe UI', Arial, sans-serif; color: #111; margin: 0; padding: 0; }
                    .hoja-lamina { border: 3px dashed #0284c7; border-radius: 20px; padding: 25px; box-sizing: border-box; min-height: 90vh; display: flex; flex-direction: column; justify-content: space-between; }
                    .encabezado { display: flex; justify-content: space-between; border-bottom: 2px solid #0284c7; padding-bottom: 8px; font-size: 12pt; font-weight: bold; color: #0284c7; }
                    .letra-box { display: flex; align-items: center; justify-content: space-around; margin: 30px 0; }
                    .letra-hebrea-delineada { font-size: 130pt; font-family: 'David', 'Times New Roman', serif; line-height: 1; color: #fff; -webkit-text-stroke: 3.5px #111; text-align: center; }
                    .letra-info h1 { font-size: 28pt; margin: 0 0 10px 0; color: #0c4a6e; }
                    .letra-info p { margin: 5px 0; font-size: 13pt; }
                    .ejemplo-box { background: #f0fdf4; border: 2px solid #22c55e; border-radius: 12px; padding: 20px; text-align: center; margin: 20px 0; }
                    .palabra-hebrea { font-size: 38pt; font-family: serif; color: #15803d; font-weight: bold; }
                    .palabra-translit { font-size: 16pt; color: #333; margin-top: 5px; }
                    .lineas-trazado { border: 2px solid #cbd5e1; border-radius: 12px; padding: 15px; margin: 15px 0; }
                    .trazos-punteados { font-size: 36pt; font-family: serif; color: #94a3b8; letter-spacing: 20px; text-align: center; }
                    .historia-box { background: #fefce8; border-left: 5px solid #eab308; padding: 15px; border-radius: 8px; font-size: 12pt; }
                    .pie-pagina { text-align: center; font-size: 10pt; color: #777; border-top: 1px solid #ddd; padding-top: 8px; }
                </style>
            </head>
            <body>
                <div class="hoja-lamina">
                    <div class="encabezado">
                        <span>Ministerio Semillas de Torah</span>
                        <span>Ficha Individual • Letra ${l.name} (#${l.num})</span>
                    </div>

                    <div class="letra-box">
                        <div class="letra-hebrea-delineada">${l.hebrew}</div>
                        <div class="letra-info">
                            <h1>Letra ${l.name}</h1>
                            <p><strong>Sonido:</strong> ${l.sound}</p>
                            <p><strong>Pictograma Antiguo:</strong> ${l.paleo}</p>
                            <p><strong>Significado:</strong> ${l.meaning}</p>
                        </div>
                    </div>

                    <div class="ejemplo-box">
                        <div class="palabra-hebrea">${l.exampleWord}</div>
                        <div class="palabra-translit">${l.translit} = ${l.meaningWord}</div>
                    </div>

                    <div class="lineas-trazado">
                        <div style="font-weight: bold; margin-bottom: 8px;">✍️ Delinea y practica el trazo de la letra ${l.name}:</div>
                        <div class="trazos-punteados">${l.hebrew} • ${l.hebrew} • ${l.hebrew} • ${l.hebrew} • ${l.hebrew}</div>
                    </div>

                    <div class="historia-box">
                        <p><strong>Para aprender:</strong> ${l.kidStory}</p>
                        <p><em>${l.verse}</em></p>
                    </div>

                    <div class="pie-pagina">
                        Hablemos de YHWH • www.hablemosdeyhwh.com/semillas-de-torah
                    </div>
                </div>
                <script>
                    window.onload = function() { window.print(); };
                <\/script>
            </body>
            </html>
        `);
        w.document.close();
    }

    // Inicializar grid y juego al cargar la página
    document.addEventListener('DOMContentLoaded', function() {
        renderizarAlefBetGrid();
        cargarPreguntaJuego();
        inicializarReproductorAlefBet();

        if (window.location.hash === '#parasha-infantil' || window.location.hash === '#pane-parasha-infantil') {
            activarTabParashaInfantil();
        } else if (window.location.hash === '#alef-bet' || window.location.hash === '#alefbet' || window.location.hash === '#pane-alefbet') {
            activarTabAlefBet();
        } else if (window.location.hash === '#manualidades' || window.location.hash === '#dibujos' || window.location.hash === '#pane-manualidades') {
            activarTabManualidades();
        }
    });
    </script>

    <!-- MODAL: DETALLE Y PRÁCTICA DE LETRA DEL ALEF-BET -->
    <div class="modal fade" id="letterDetailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; overflow: hidden;">
                <div class="modal-header border-0 py-3 px-4 text-white" id="modalLetraHeader" style="background: #0284c7;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-white text-dark rounded-pill px-2 py-1 fw-bold" id="modalLetraNumero">#1</span>
                        <h5 class="modal-title fw-bold mb-0" id="modalLetraTitulo">Letra Alef (א)</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center" style="background: #ffffff;">
                    <div class="display-1 fw-bold mb-1" id="modalLetraHebreo" style="font-family: 'David', 'Times New Roman', serif; color: #0284c7; line-height: 1;">א</div>
                    <div class="fs-4 fw-bold text-dark mb-1" id="modalLetraNombre">Alef</div>
                    <div class="badge rounded-pill bg-light text-dark border px-3 py-1 mb-3" id="modalLetraSonido">Sonido: Muda / Vocal</div>
                    
                    <div class="p-3 rounded-4 mb-3 text-start" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                        <div class="small fw-bold text-muted mb-1"><i class="bi bi-clock-history me-1"></i>Pictograma Antiguo:</div>
                        <div class="fw-bold text-dark fs-6 mb-2" id="modalLetraPaleo">🐮 Cabeza de Buey (Fuerza, Líder, Elohim)</div>
                        
                        <div class="small fw-bold text-muted mb-1"><i class="bi bi-book me-1"></i>Palabra de Ejemplo:</div>
                        <div class="fs-5 fw-bold text-primary mb-1" id="modalLetraPalabra">אָב (Av) = Padre / Papá</div>
                        
                        <div class="small text-muted fst-italic" id="modalLetraVerso">“En el principio creó Elohim...”</div>
                    </div>

                    <div class="p-3 rounded-3 mb-3 text-start small" style="background: #fefce8; border-left: 4px solid #eab308; color: #713f12;" id="modalLetraHistoria">
                        Alef nos enseña que el Creador es el primero en todo y nuestro Padre celestial.
                    </div>

                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-warning text-dark fw-bold rounded-pill px-4" id="modalLetraAudioBtn">
                            <i class="bi bi-volume-up-fill me-1"></i> Escuchar Sonido
                        </button>
                        <button type="button" class="btn btn-outline-dark rounded-pill px-3" onclick="imprimirFichaIndividualLetra()">
                            <i class="bi bi-printer me-1"></i> Imprimir Lámina
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: BUZÓN PARA SUBIR SUGERENCIA DE MANUALIDAD (ENCARGADAS Y MAESTRAS) -->
    <div class="modal fade" id="modalSugerirManualidad" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; overflow: hidden;">
                <div class="modal-header border-0 py-3 px-4 text-white" style="background: linear-gradient(135deg, #9333ea, #7e22ce);">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-heart-fill fs-5"></i>
                        <h5 class="modal-title fw-bold mb-0">Buzón de Encargadas: Subir Sugerencia de Manualidad</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/semillas-de-torah/sugerir-manualidad" method="POST" enctype="multipart/form-data">
                    <div class="modal-body p-4" style="background: #ffffff;">
                        <p class="text-muted small mb-4">
                            ¡Gracias por tu servicio a los niños! Comparte con todas las maestras los dibujos, plantillas o manualidades que realizas en tus clases para bendecir a más familias.
                        </p>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small">Tu Nombre y Apellido <span class="text-danger">*</span></label>
                                <input type="text" name="author_name" class="form-control rounded-3" placeholder="Ej: Maestra Sara / Hermana Débora" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small">Congregación / Rol / Ciudad</label>
                                <input type="text" name="author_role" class="form-control rounded-3" placeholder="Ej: Maestra de Niños - Madrid / Madre de Familia">
                            </div>

                            <div class="col-md-8">
                                <label class="form-label fw-bold text-dark small">Título de la Actividad o Manualidad <span class="text-danger">*</span></label>
                                <input type="text" name="title" class="form-control rounded-3" placeholder="Ej: Farolito de Janucá con papel reciclado" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark small">Categoría</label>
                                <select name="category" class="form-select rounded-3">
                                    <option value="Sugerencia de Encargadas">Sugerencia de Encargada</option>
                                    <option value="Porción Semanal">Porción Semanal (Dibujo)</option>
                                    <option value="Santas Convocaciones">Santas Convocaciones (Fiesta)</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small">Fiesta Bíblica o Parashá (Opcional)</label>
                                <input type="text" name="moed_name" class="form-control rounded-3" placeholder="Ej: Shabat / Sucot / Parashá Bereshit">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small">Edad Recomendada</label>
                                <input type="text" name="age_range" class="form-control rounded-3" placeholder="Ej: 3 a 7 años / Todas las edades" value="Todas las edades">
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold text-dark small">Breve Explicación / Objetivo de la Lección</label>
                                <textarea name="description" rows="2" class="form-control rounded-3" placeholder="¿Qué aprenden los niños con esta actividad?"></textarea>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small">Materiales Necesarios</label>
                                <textarea name="materials" rows="3" class="form-control rounded-3" placeholder="Ej: Cartón corrugado, témpera blanca, pegamento escolar, lana..."></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small">Instrucciones Paso a Paso</label>
                                <textarea name="instructions" rows="3" class="form-control rounded-3" placeholder="1. Recortar la figura... 2. Pegar los laterales... 3. Decorar con brillantina..."></textarea>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small">
                                    <i class="bi bi-camera text-primary me-1"></i> Foto de la Manualidad (Opcional)
                                </label>
                                <input type="file" name="image_file" class="form-control rounded-3" accept="image/*">
                                <small class="text-muted" style="font-size: 0.78rem;">Foto de la muestra terminada por los niños.</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small">
                                    <i class="bi bi-file-earmark-pdf text-danger me-1"></i> Archivo Imprimible o Molde (PDF)
                                </label>
                                <input type="file" name="pdf_file" class="form-control rounded-3" accept=".pdf,application/pdf">
                                <small class="text-muted" style="font-size: 0.78rem;">Plantilla en PDF para que otras maestras puedan imprimirla.</small>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-3 px-4" style="background: #f8fafc;">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn rounded-pill px-4 fw-bold text-white shadow-sm" style="background: linear-gradient(135deg, #9333ea, #7e22ce);">
                            <i class="bi bi-send-fill me-1"></i> Enviar Sugerencia
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL: DETALLE DE MANUALIDAD / DIBUJO -->
