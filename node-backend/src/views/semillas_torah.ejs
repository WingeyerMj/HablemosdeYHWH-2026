                    </div>
                </div>
                <div class="modal-footer border-0 p-3 px-4 flex-wrap gap-2" style="background: #f8fafc;">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cerrar</button>
                    <a href="#" id="mDetallePreviewBnBtn" target="_blank" class="btn btn-outline-dark fw-semibold rounded-pill px-3 d-inline-flex align-items-center gap-1">
                        <i class="bi bi-printer"></i> Ver en Blanco / Imprimir
                    </a>
                    <a href="#" id="mDetalleDownloadBtn" download class="btn btn-warning text-dark fw-bold rounded-pill px-4 shadow-sm d-inline-flex align-items-center gap-2">
