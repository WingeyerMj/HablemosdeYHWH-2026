    function inicializarReproductorAlefBet() {
        const audio = document.getElementById('audioAlefBetServer');
        const icon = document.getElementById('iconPlayAlefBetAudio');
        const txt = document.getElementById('txtPlayAlefBetAudio');
        const container = document.getElementById('letraAlefBetContainer');
        if (!audio) return;

        function actualizarEstadoBoton(reproduciendo) {
            if (icon) {
                icon.className = reproduciendo
                    ? 'bi bi-pause-circle-fill fs-5 text-dark'
                    : 'bi bi-play-circle-fill fs-5 text-dark';
            }
            if (txt) {
                txt.textContent = reproduciendo
                    ? 'Pausar Canto del Alef-Bet'
                    : 'Escuchar Canto del Alef-Bet';
            }
        }

        audio.addEventListener('play', function() {
            actualizarEstadoBoton(true);
        });
        audio.addEventListener('pause', function() {
            actualizarEstadoBoton(false);
        });
        audio.addEventListener('ended', function() {
            actualizarEstadoBoton(false);
        });
        audio.addEventListener('timeupdate', function() {
            if (!container) return;
            const t = audio.currentTime;
            const estrofas = container.querySelectorAll('.estrofa-alefbet');
            estrofas.forEach(function(el) {
                const start = parseFloat(el.getAttribute('data-start') || '0');
                const end = parseFloat(el.getAttribute('data-end') || '999');
                const activa = t >= start && t < end;
                if (activa) {
                    if (!el.classList.contains('estrofa-activa')) {
                        el.classList.add('estrofa-activa', 'shadow-sm');
                        el.style.outline = '2px solid #0284c7';
                        el.style.borderRadius = '8px';
                        el.style.padding = '8px';
                        el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }
                } else if (el.classList.contains('estrofa-activa')) {
                    el.classList.remove('estrofa-activa', 'shadow-sm');
                    el.style.outline = '';
                }
            });
        });
    }

