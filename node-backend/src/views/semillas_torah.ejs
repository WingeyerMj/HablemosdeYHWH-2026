                    <!-- YouTube Iframe Embed -->
                    <iframe id="shortModalIframe" class="w-100 h-100" style="border: none; display: none;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>

                    <!-- Fallback / Poster Screen -->
