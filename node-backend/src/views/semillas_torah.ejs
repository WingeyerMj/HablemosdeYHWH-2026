    function cargarPreguntaJuego() {
        const p = preguntasJuego[juegoPreguntaActual];
        if (!p) {
            document.getElementById('juegoContenedor').innerHTML = `
                <div class="py-4">
                    <div class="display-1 mb-2">🎉🏆🌟</div>
                    <h3 class="fw-bold text-success mb-2">¡Felicitaciones, Pequeño Campeón!</h3>
                    <p class="text-muted mb-4 fs-5">Has completado el juego del Alef-Bet con <strong>${juegoScore} puntos</strong>. ¡Adonai bendiga tu aprendizaje!</p>
                    <button type="button" class="btn btn-warning text-dark fw-bold px-4 py-3 rounded-pill shadow-sm" onclick="reiniciarJuegoAlefBet()">
                        <i class="bi bi-arrow-clockwise me-1"></i> Jugar de Nuevo
                    </button>
                </div>
            `;
            return;
        }

        const pistaTit = document.getElementById('juegoPistaTitulo');
        const pistaEmo = document.getElementById('juegoPistaEmoji');
        const pregTxt = document.getElementById('juegoPreguntaTexto');
        const palTxt = document.getElementById('juegoPalabraPista');
        const opcCont = document.getElementById('juegoOpcionesContenedor');
        const feedback = document.getElementById('juegoFeedback');

        if (pistaTit) pistaTit.textContent = `PREGUNTA ${juegoPreguntaActual + 1} DE ${preguntasJuego.length}`;
        if (pistaEmo) pistaEmo.textContent = p.emoji;
        if (pregTxt) pregTxt.textContent = p.pista;
        if (palTxt) palTxt.textContent = 'Palabra clave: ' + p.palabra;
        if (feedback) feedback.innerHTML = '';

        if (opcCont) {
            opcCont.innerHTML = '';
            p.opciones.forEach(letra => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn btn-outline-primary btn-lg rounded-4 px-4 py-3 fw-bold fs-1 shadow-sm';
                btn.style.fontFamily = 'serif';
                btn.style.minWidth = '90px';
                btn.textContent = letra;
                btn.onclick = function() { verificarRespuestaJuego(letra, p.correcta, btn); };
                opcCont.appendChild(btn);
            });
        }
    }

    function verificarRespuestaJuego(elegida, correcta, btnEl) {
        const feedback = document.getElementById('juegoFeedback');
        const scoreEl = document.getElementById('juegoScore');

        if (elegida === correcta) {
            tocarTonoAlegre(600, 0.15);
            setTimeout(() => tocarTonoAlegre(800, 0.25), 150);
            btnEl.classList.remove('btn-outline-primary');
            btnEl.classList.add('btn-success');
            juegoScore += 10;
            if (scoreEl) scoreEl.textContent = juegoScore;
            if (feedback) {
                feedback.innerHTML = '<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> ¡Excelente! ¡Esa es la letra correcta! ⭐⭐⭐</span>';
            }
            setTimeout(() => {
                juegoPreguntaActual++;
                cargarPreguntaJuego();
            }, 1200);
        } else {
            tocarTonoAlegre(250, 0.25);
            btnEl.classList.remove('btn-outline-primary');
            btnEl.classList.add('btn-danger');
            if (feedback) {
                feedback.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle-fill me-1"></i> ¡Casi! Inténtalo de nuevo, tú puedes.</span>';
            }
        }
    }

    function reiniciarJuegoAlefBet() {
        juegoScore = 0;
        juegoPreguntaActual = 0;
        const scoreEl = document.getElementById('juegoScore');
        if (scoreEl) scoreEl.textContent = '0';
        cargarPreguntaJuego();
    }

