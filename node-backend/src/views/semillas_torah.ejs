                                                            <span class="badge rounded-pill px-2 py-1 shadow-sm" style="background: rgba(107,33,168,0.9); backdrop-filter: blur(4px); font-size: 0.72rem; color: #fff;">
                                                                <i class="bi bi-star-fill me-1 text-warning"></i> <%= short.category || 'Tema Diverso' %>
                                                            </span>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-1" style="z-index: 3;">
                                                            <button type="button" class="btn btn-sm rounded-circle p-0 d-inline-flex align-items-center justify-content-center js-share-open" 
                                                                    style="width: 26px; height: 26px; background: rgba(0,0,0,0.72); color: #f5cf7c; border: 1px solid rgba(212,168,83,0.4);"
                                                                    data-share-url="/semillas-de-torah?short=<%= short.id %>"
