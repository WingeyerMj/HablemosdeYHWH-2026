    <!-- Data Injection for JS Shorts Viewer -->
    <script>
        const SHORTS_DATA = <%- JSON.stringify(typeof shorts !== 'undefined' ? shorts : []) %>;
        let currentShortIndex = 0;
        let shortsModalInstance = null;

        function getEmbedUrl(url) {
            if (!url) return '';
            // Detect YouTube Shorts URL: https://www.youtube.com/shorts/VIDEO_ID or youtube.com/watch?v=VIDEO_ID
            let match = url.match(/shorts\/([a-zA-Z0-9_-]+)/);
            if (match && match[1]) {
                return `https://www.youtube.com/embed/${match[1]}?autoplay=1&rel=0`;
            }
            match = url.match(/(?:youtu\.be\/|v\/|u\/\w\/|embed\/|watch\?v=)([^#\&\?]*)/);
            if (match && match[1] && match[1].length === 11) {
                return `https://www.youtube.com/embed/${match[1]}?autoplay=1&rel=0`;
            }
            return url;
        }

        function openShortModal(index) {
            if (!SHORTS_DATA || SHORTS_DATA.length === 0) return;
            currentShortIndex = index;
            renderCurrentShort();
            
            const modalEl = document.getElementById('shortsModalViewer');
            if (!shortsModalInstance) {
                shortsModalInstance = new bootstrap.Modal(modalEl);
            }
            shortsModalInstance.show();
        }

        const viewedShortsSession = new Set();

        function registerShortView(shortId) {
            if (!shortId || viewedShortsSession.has(shortId)) return;
            viewedShortsSession.add(shortId);

            const shortObj = SHORTS_DATA.find(s => s.id === shortId);
            if (shortObj) {
                shortObj.views_count = (parseInt(shortObj.views_count) || 0) + 1;
                updateShortViewsDOM(shortId, shortObj.views_count);
            }

            fetch(`/api/semillas-shorts/${shortId}/view`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(res => res.json())
            .then(data => {
                if (data && data.ok && data.views_count !== undefined) {
                    if (shortObj) shortObj.views_count = data.views_count;
                    updateShortViewsDOM(shortId, data.views_count);
                }
            })
            .catch(err => console.warn('Aviso registrando vista:', err));
        }

        function updateShortViewsDOM(shortId, count) {
            document.querySelectorAll(`[data-short-views="${shortId}"]`).forEach(el => {
                el.textContent = count;
            });
        }

        function renderCurrentShort() {
            const short = SHORTS_DATA[currentShortIndex];
            if (!short) return;

            // Registrar vista automáticamente
            if (short.id) {
                registerShortView(short.id);
            }

            const videoEl = document.getElementById('shortModalVideo');
            const iframeEl = document.getElementById('shortModalIframe');
            const fallbackEl = document.getElementById('shortModalFallback');

            // Reset video / iframe
            videoEl.pause();
            videoEl.src = '';
            videoEl.style.display = 'none';
            iframeEl.src = '';
            iframeEl.style.display = 'none';
            fallbackEl.style.display = 'none';

            // Fill text metadata
            document.getElementById('shortModalTitle').textContent = short.title || '';
            if (short.short_type === 'general') {
                document.getElementById('shortModalParasha').textContent = short.category ? ('🌟 ' + short.category) : '🌟 Tema Diverso';
                document.getElementById('shortModalParasha').style.display = 'inline-block';
                document.getElementById('shortModalBadge').textContent = short.category ? `🌟 ${short.category}` : `🌟 Short General`;
            } else {
                document.getElementById('shortModalParasha').textContent = short.parasha_name ? ('📖 ' + short.parasha_name) : '';
                document.getElementById('shortModalParasha').style.display = short.parasha_name ? 'inline-block' : 'none';
                if (short.aliyah_number) {
                    document.getElementById('shortModalBadge').textContent = `${short.aliyah_number}ª Aliyá Infantil`;
                } else {
                    document.getElementById('shortModalBadge').textContent = `📖 Aliyá con Niños`;
                }
            }

            document.getElementById('shortModalChild').textContent = short.child_name ? ('👧 ' + short.child_name) : '';
            document.getElementById('shortModalVerses').textContent = short.verses_reference ? ('📜 ' + short.verses_reference) : '';
            document.getElementById('shortModalDescription').textContent = short.description || '';

            // Configurar datos de compartir para el short activo
            const semShareBtn = document.getElementById('shortSemillasModalShareBtn');
            const semModalFooter = document.getElementById('shortSemillasModalFooter');
            const semShareUrl = '/semillas-de-torah?short=' + (short.id || '');
            const semShareTitle = short.title || 'Short Semillas de Torah';
            const semShareText = (short.short_type === 'general' ? (short.category || 'Tema Diverso') : (short.parasha_name ? 'Parashá ' + short.parasha_name : 'Aliyá Infantil')) + ' — ' + (short.verses_reference || short.description || '');
            const semShareImg = short.thumbnail_url || '';
            const semShareType = short.short_type === 'general' ? 'Short Semillas' : 'Aliyá Infantil';

            [semShareBtn, semModalFooter].forEach(el => {
                if (!el) return;
                el.setAttribute('data-share-url', semShareUrl);
                el.setAttribute('data-share-title', semShareTitle);
                el.setAttribute('data-share-text', semShareText);
                el.setAttribute('data-share-image', semShareImg);
                el.setAttribute('data-share-type', semShareType);
            });

            // Decide video source
            if (short.video_url && short.video_url.trim() !== '') {
                videoEl.src = short.video_url;
                videoEl.style.display = 'block';
                videoEl.play().catch(e => console.log('Autoplay prevent:', e));
            } else if (short.youtube_short_url && short.youtube_short_url.trim() !== '') {
                iframeEl.src = getEmbedUrl(short.youtube_short_url);
                iframeEl.style.display = 'block';
            } else {
                fallbackEl.style.display = 'block';
                document.getElementById('shortFallbackTitle').textContent = short.title;
                document.getElementById('shortFallbackDesc').textContent = short.description || 'Este video estará disponible muy pronto.';
            }

            // Update arrow states
            document.getElementById('shortPrevBtn').style.opacity = currentShortIndex > 0 ? '1' : '0.35';
            document.getElementById('shortNextBtn').style.opacity = currentShortIndex < SHORTS_DATA.length - 1 ? '1' : '0.35';
        }

        // ========================================================
        // SLIDER / CAROUSEL CONTROLLER PARA AMBOS SLIDERS DE SHORTS
        // ========================================================
        function slideTrack(trackId, direction) {
            const track = document.getElementById(trackId);
            if (!track) return;

            const item = track.querySelector('.frontend-short-item');
            const step = item ? (item.offsetWidth + 20) : 300;
            
            if (direction === 'next') {
                track.scrollBy({ left: step, behavior: 'smooth' });
            } else {
                track.scrollBy({ left: -step, behavior: 'smooth' });
            }

            setTimeout(() => updateTrackArrowStates(trackId), 350);
        }

        function updateTrackArrowStates(trackId) {
            const track = document.getElementById(trackId);
            if (!track) return;

            const atStart = track.scrollLeft <= 5;
            const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 5;

            let prevBtn, nextBtn, floatPrev, floatNext;
            if (trackId === 'generalShortsTrack') {
                prevBtn = document.getElementById('navGeneralPrev');
                nextBtn = document.getElementById('navGeneralNext');
                floatPrev = document.getElementById('floatGeneralPrev');
                floatNext = document.getElementById('floatGeneralNext');
            } else {
                prevBtn = document.getElementById('navAliyotPrev');
                nextBtn = document.getElementById('navAliyotNext');
                floatPrev = document.getElementById('floatAliyotPrev');
                floatNext = document.getElementById('floatAliyotNext');
            }

            [prevBtn, floatPrev].forEach(b => {
                if (b) {
                    b.style.opacity = atStart ? '0.35' : '1';
                    b.style.pointerEvents = atStart ? 'none' : 'auto';
                }
            });

            [nextBtn, floatNext].forEach(b => {
                if (b) {
                    b.style.opacity = atEnd ? '0.35' : '1';
                    b.style.pointerEvents = atEnd ? 'none' : 'auto';
                }
            });
        }

        function setupTrackInteractions(trackId) {
            const track = document.getElementById(trackId);
            if (!track) return;

            track.addEventListener('scroll', () => updateTrackArrowStates(trackId));
            updateTrackArrowStates(trackId);

            // Mouse Drag-to-scroll
            let isDown = false;
            let startX;
            let scrollLeft;

            track.addEventListener('mousedown', (e) => {
                isDown = true;
                startX = e.pageX - track.offsetLeft;
                scrollLeft = track.scrollLeft;
                track.style.cursor = 'grabbing';
                track.style.userSelect = 'none';
            });

            track.addEventListener('mouseleave', () => {
                isDown = false;
                track.style.cursor = 'default';
            });

            track.addEventListener('mouseup', () => {
                isDown = false;
                track.style.cursor = 'default';
            });

            track.addEventListener('mousemove', (e) => {
                if (!isDown) return;
                e.preventDefault();
                const x = e.pageX - track.offsetLeft;
                const walk = (x - startX) * 1.5;
                track.scrollLeft = scrollLeft - walk;
            });
        }

        function nextShort() {
            if (currentShortIndex < SHORTS_DATA.length - 1) {
                currentShortIndex++;
                renderCurrentShort();
            }
        }

        function prevShort() {
            if (currentShortIndex > 0) {
                currentShortIndex--;
                renderCurrentShort();
            }
        }

        // Setup Drag-to-scroll & Keyboard Navigation on DOM ready
        document.addEventListener('DOMContentLoaded', () => {
            setupTrackInteractions('generalShortsTrack');
            setupTrackInteractions('aliyotShortsTrack');

            const modalEl = document.getElementById('shortsModalViewer');
            if (modalEl) {
                modalEl.addEventListener('hidden.bs.modal', () => {
                    const videoEl = document.getElementById('shortModalVideo');
                    const iframeEl = document.getElementById('shortModalIframe');
                    if (videoEl) { videoEl.pause(); videoEl.src = ''; }
                    if (iframeEl) { iframeEl.src = ''; }
                });
            }

            // Keyboard navigation
            document.addEventListener('keydown', (e) => {
                const modal = document.getElementById('shortsModalViewer');
                if (modal && modal.classList.contains('show')) {
                    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') nextShort();
                    if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') prevShort();
                }
            });
        });
    </script>

    <style>
        /* ================================================= */
        /* ESTILOS DEL SLIDER / CARRUSEL DE SHORTS VERTICALES */
        /* ================================================= */
        .shorts-carousel-container {
            position: relative;
            width: 100%;
        }

        .shorts-slider-track {
            display: flex;
            gap: 1.25rem;
            overflow-x: auto;
            scroll-behavior: smooth;
            scroll-snap-type: x mandatory;
            padding: 0.5rem 0.25rem 1.25rem 0.25rem;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: thin;
            scrollbar-color: #38bdf8 #f0f9ff;
        }

        .shorts-slider-track::-webkit-scrollbar {
            height: 6px;
        }

        .shorts-slider-track::-webkit-scrollbar-track {
            background: #f0f9ff;
