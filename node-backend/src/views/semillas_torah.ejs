                                                                    </a>
                                                                <% } %>
                                                            </div>

                                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                                <%- include('partials/_share_buttons', {
                                                                    shareUrl: '/semillas-de-torah/articulo/' + art.id,
                                                                    shareTitle: art.title,
                                                                    shareText: (art.parasha_name ? 'Parashá ' + art.parasha_name + ' — ' : '') + (art.key_verse || art.summary || ''),
                                                                    shareImage: art.main_image || '',
