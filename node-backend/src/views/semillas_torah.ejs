<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

<body class="semillas-page" style="background-color: #faf7f2;">

    <%- include('partials/header') %>

    <main class="main">

        <!-- Page Title Banner -->
        <div class="page-title accent-background" style="background: linear-gradient(135deg, #4a154b 0%, #6b21a8 50%, #2e7d32 100%); padding: 130px 0 60px 0;">
            <div class="container d-lg-flex justify-content-between align-items-center">
                <div data-aos="fade-right">
                    <span class="badge mb-2 px-3 py-2 text-uppercase" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(5px); font-size: 0.85rem; letter-spacing: 1px; color: #fff; border-radius: 20px;">
                        🌱 Ministerio Infantil • By Elva Avila
                    </span>
                    <h1 class="mb-2 text-white fw-bold" style="font-size: 2.6rem;">Semillas de Torah</h1>
                    <p class="text-white-50 mb-0" style="font-size: 1.15rem;">Sembrando la Palabra, cosechando vida 💚</p>
                </div>
                <nav class="breadcrumbs mt-3 mt-lg-0" data-aos="fade-left">
                    <ol class="d-flex list-unstyled gap-2 m-0 p-0 text-white-50">
                        <li><a href="/" class="text-white text-decoration-none">Inicio</a></li>
                        <li class="text-white-50">/</li>
                        <li class="current text-white fw-semibold">Semillas de Torah</li>
                    </ol>
                </nav>
            </div>
        </div><!-- End Page Title -->

        <!-- Hero Section with Official Banner -->
        <section class="section py-5 position-relative overflow-hidden">
            <div class="container">
                <div class="row align-items-center gy-5">
                    <div class="col-lg-6" data-aos="fade-right">
                        <div class="pe-lg-4">
                            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3 rounded-pill" style="background: #f3e8ff; color: #6b21a8; font-weight: 700; font-size: 0.88rem; border: 1px solid #e9d5ff;">
                                <i class="bi bi-balloon-heart-fill text-danger"></i> Por Elva Avila
                            </div>
                            <h2 class="display-6 fw-bold mb-3" style="color: #2e1065; line-height: 1.3;">
                                Sembrando la Palabra en el corazón de las <span style="color: #6b21a8; border-bottom: 3px solid #22c55e;">nuevas generaciones</span>
                            </h2>
                            <p class="lead text-muted mb-4" style="font-size: 1.12rem; line-height: 1.8;">
                                <strong>Semillas de Torah</strong> es un espacio creado para que los niños y familias conozcan las riquezas de la Toráh, los valores bíblicos y las fiestas del Creador de una manera alegre, visual y pedagógica. <em>¡Abba sea glorificado!</em>
                            </p>

                            <div class="d-flex flex-wrap gap-3 mt-4">
                                <a href="https://www.facebook.com/profile.php?id=61592294939779" target="_blank" rel="noopener noreferrer" class="btn btn-lg px-4 py-3 shadow-sm rounded-pill fw-bold text-white d-inline-flex align-items-center gap-2" style="background: #1877F2; border: none; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                                    <i class="bi bi-facebook fs-5"></i> Seguir en Facebook Oficial
                                </a>
                                <a href="#actividades-seccion" class="btn btn-lg px-4 py-3 rounded-pill fw-bold d-inline-flex align-items-center gap-2" style="background: #ffffff; border: 2px solid #6b21a8; color: #6b21a8; transition: all 0.3s ease;">
                                    <i class="bi bi-camera-reels me-1"></i> Ver Novedades & Shorts (<%= (typeof shorts !== 'undefined' && shorts) ? shorts.length : 0 %>)
                                </a>
                            </div>

                            <div class="mt-4 pt-3 border-top d-flex align-items-center gap-4 text-muted small">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <span>Aliyot con Niños</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <span>Material Didáctico</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <span>100% Gratuito</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 text-center" data-aos="fade-left">
                        <div class="position-relative d-inline-block w-100" style="max-width: 540px;">
                            <!-- Video Card Presentación Oficial -->
                            <div class="card border-0 shadow-lg position-relative" style="border-radius: 24px; overflow: hidden; background: #000; border: 4px solid #fff;">
                                <div class="position-relative" style="width: 100%; aspect-ratio: 16/9; max-height: 420px; background: #000; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                    <video id="semillasIntroVideo" 
                                           src="/assets/video/semillas_torah_intro.mp4" 
                                           poster="/assets/img/pagina/semillas_torah_banner.png"
                                           class="w-100 h-100" 
                                           style="object-fit: contain; background: #000;" 
                                           controls 
                                           autoplay 
                                           muted 
                                           loop 
                                           playsinline 
                                           preload="auto">
                                        <source src="/assets/video/semillas_torah_intro.mp4" type="video/mp4">
                                        Tu navegador no soporta el formato de video.
                                    </video>
                                </div>
                                <div class="p-3 text-center" style="background: linear-gradient(135deg, #581c87, #3b0764); color: #fff;">
                                    <p class="mb-0 fw-semibold" style="font-size: 0.95rem;">
                                        🌱 <em>"Instruye al niño en su camino, y aun cuando fuere viejo no se apartará de él."</em> — Proverbios 22:6
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN PRINCIPAL CON PESTAÑAS: SHORTS / ENSEÑANZAS / ALIYOT -->
        <section id="actividades-seccion" class="section py-5" style="background-color: #ffffff;">
            <div class="container">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 pb-3 border-bottom" data-aos="fade-up">
                    <div>
                        <span class="badge px-3 py-2 rounded-pill text-uppercase mb-2" style="background: #f3e8ff; color: #6b21a8; font-weight: 700; font-size: 0.8rem; letter-spacing: 1px;">
                            Contenido & Recursos
                        </span>
                        <h2 class="fw-bold mb-1" style="color: #2e1065;">Novedades y Enseñanzas Infantiles</h2>
                        <p class="text-muted mb-0">Videos de Aliyot con los niños en formato Shorts, historias y recursos para toda la familia.</p>
                    </div>
                </div>

                <!-- Pestañas de Navegación -->
                <!-- Pestañas de Navegación -->
                <ul class="nav nav-pills gap-2 mb-4 flex-wrap" id="semillasTabs" role="tablist" data-aos="fade-up" data-aos-delay="100">
                    <!-- Tab 1: Shorts / Novedades -->
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active px-4 py-3 fw-bold d-flex align-items-center gap-2 shadow-sm semillas-tab-btn" 
                                id="tab-shorts" data-bs-toggle="pill" data-bs-target="#pane-shorts" type="button" role="tab"
                                style="border-radius: 16px; border: 2px solid #bae6fd; font-size: 1rem; transition: all 0.3s ease;">
                            <i class="bi bi-camera-reels-fill fs-5 text-info"></i> 
                            Aliyot con Niños · Shorts
                            <span class="badge rounded-pill" style="background: linear-gradient(135deg, #0284c7, #0369a1); color: #fff; font-size: 0.75rem;">
                                <%= (typeof shorts !== 'undefined' && shorts) ? shorts.length : 0 %>
                            </span>
                        </button>
                    </li>
                    <!-- Tab 2: Enseñanzas Infantiles -->
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-4 py-3 fw-bold d-flex align-items-center gap-2 shadow-sm semillas-tab-btn" 
                                id="tab-ensenanzas" data-bs-toggle="pill" data-bs-target="#pane-ensenanzas" type="button" role="tab"
                                style="border-radius: 16px; border: 2px solid #e9d5ff; font-size: 1rem; transition: all 0.3s ease;">
                            <i class="bi bi-collection-play fs-5"></i> 
                            Enseñanzas Infantiles
                            <span class="badge rounded-pill" style="background: rgba(107,33,168,0.15); color: #6b21a8; font-size: 0.75rem;">
                                <%= (typeof items !== 'undefined' && items) ? items.length : 0 %>
                            </span>
                        </button>
                    </li>
                    <!-- Tab 3: Noticias & Resúmenes de Parashá con Imágenes -->
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-4 py-3 fw-bold d-flex align-items-center gap-2 shadow-sm semillas-tab-btn" 
                                id="tab-articulos" data-bs-toggle="pill" data-bs-target="#pane-articulos" type="button" role="tab"
                                style="border-radius: 16px; border: 2px solid #86efac; font-size: 1rem; transition: all 0.3s ease;">
                            <i class="bi bi-newspaper fs-5 text-success"></i> 
                            Noticias & Resúmenes de Parashá
                            <span class="badge rounded-pill" style="background: linear-gradient(135deg, #16a34a, #15803d); color: #fff; font-size: 0.75rem;">
                                <%= (typeof articulos !== 'undefined' && articulos) ? articulos.length : 0 %> ✨ Novedad
                            </span>
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="semillasTabContent">

                    <!-- ============================================================ -->
                    <!-- PESTAÑA: NOTICIAS & RESÚMENES SEMANALES CON IMÁGENES         -->
                    <!-- ============================================================ -->
                    <div class="tab-pane fade" id="pane-articulos" role="tabpanel">
                        
                        <!-- Banner Explicativo Resúmenes -->
                        <div class="p-4 mb-4 rounded-4 shadow-sm border-0 d-flex align-items-start gap-3" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 50%, #f5f3ff 100%); border-left: 5px solid #22c55e !important;">
                            <div class="rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="background: rgba(34,197,94,0.2); width: 52px; height: 52px; color: #15803d;">
                                <i class="bi bi-journal-richtext fs-3"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                    <h5 class="fw-bold mb-0" style="color: #14532d;">Resúmenes de Parashá & Artículos Ilustrados</h5>
                                    <span class="badge bg-success rounded-pill px-2 py-1 small"><i class="bi bi-palette-fill me-1"></i>Material Visual & Pedagógico</span>
                                </div>
                                <p class="mb-0 text-muted" style="font-size: 0.96rem; line-height: 1.6;">
                                    Encuentra aquí el resumen de las porciones de la Torá enseñadas cada semana a nuestros niños, con infografías de las <strong>Aliyot ilustradas</strong>, versículos bíblicos clave, explicaciones sencillas y fichas de estudio para repasar en familia.
                                </p>
                            </div>
                        </div>

                        <% const allArticulos = (typeof articulos !== 'undefined' && articulos) ? articulos : []; %>

                        <% if (allArticulos && allArticulos.length > 0) { %>
                            <div class="row g-4">
                                <% allArticulos.forEach((art, index) => { %>
                                    <%
                                        let gallery = [];
                                        if (art.gallery_images) {
                                            try {
                                                gallery = typeof art.gallery_images === 'string' ? JSON.parse(art.gallery_images) : art.gallery_images;
                                                if (!Array.isArray(gallery)) gallery = [];
                                            } catch(e) {
                                                gallery = [];
                                            }
                                        }
                                    %>
                                    <div class="col-12" data-aos="fade-up" data-aos-delay="<%= (index % 3 + 1) * 100 %>">
                                        <article class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4 position-relative" style="border: 2px solid #e2e8f0; transition: transform 0.3s ease, box-shadow 0.3s ease;">
                                            
                                            <!-- Card Header: Autor & Metas -->
                                            <div class="p-4 p-md-4 pb-0 d-flex flex-wrap align-items-center justify-content-between gap-3 border-bottom pb-3" style="background: #faf7f2;">
                                                <div class="d-flex align-items-center gap-3">
                                                    <img src="/assets/img/pagina/semillas_torah_logo.png" alt="Elva Avila" style="width: 46px; height: 46px; border-radius: 50%; object-fit: cover; border: 2px solid #6b21a8;">
                                                    <div>
                                                        <div class="fw-bold" style="color: #2e1065;"><%= art.author || 'Elva Avila' %></div>
                                                        <div class="text-muted small">Semillas de Torah • Ministerio Infantil</div>
                                                    </div>
                                                </div>

                                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                                    <% if (art.parasha_name) { %>
                                                        <span class="badge rounded-pill px-3 py-1 shadow-sm" style="background: linear-gradient(135deg, #6b21a8, #9333ea); color: #fff; font-size: 0.8rem;">
                                                            <i class="bi bi-journal-bookmark me-1"></i> Parashá <%= art.parasha_name %>
                                                        </span>
                                                    <% } %>
                                                    <span class="badge rounded-pill px-3 py-1" style="background: rgba(34,197,94,0.15); color: #15803d; border: 1px solid rgba(34,197,94,0.3); font-size: 0.8rem; font-weight: 600;">
                                                        <%= art.category || 'Resumen Semanal' %>
                                                    </span>
                                                    <% if (art.created_at) { %>
                                                        <span class="text-muted small ms-2">
                                                            <i class="bi bi-calendar3 me-1 text-purple"></i>
                                                            <%= new Date(art.created_at).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                                        </span>
                                                    <% } %>
                                                </div>
                                            </div>

                                            <div class="card-body p-4 p-md-4">
                                                <div class="row g-4">
                                                    
                                                    <!-- Columna Izquierda: Texto del Resumen -->
                                                    <div class="col-lg-6 d-flex flex-column justify-content-between">
                                                        <div>
                                                            <h3 class="fw-bold mb-2" style="color: #2e1065; font-size: 1.6rem; line-height: 1.35;">
                                                                <a href="/semillas-de-torah/articulo/<%= art.id %>" class="text-decoration-none text-dark hover-purple">
                                                                    <%= art.title %>
                                                                </a>
                                                            </h3>

                                                            <% if (art.biblical_reference) { %>
                                                                <div class="d-inline-flex align-items-center gap-1 text-muted small fw-semibold mb-3 px-3 py-1 rounded-pill" style="background: #f1f5f9;">
                                                                    <i class="bi bi-book-half text-warning fs-6"></i>
                                                                    <span>Cita: <%= art.biblical_reference %></span>
                                                                </div>
                                                            <% } %>

                                                            <!-- Versículo Clave -->
                                                            <% if (art.key_verse) { %>
                                                                <div class="p-3 mb-3 rounded-3" style="background: #faf5ff; border-left: 4px solid #6b21a8; color: #4c1d95; font-size: 1.05rem; font-weight: 500;">
                                                                    <i class="bi bi-quote fs-4 text-purple opacity-50 me-1"></i>
                                                                    <%= art.key_verse %>
                                                                </div>
                                                            <% } %>

                                                            <!-- Texto del Resumen (Preserva Emojis y Párrafos) -->
                                                            <div class="article-summary-text mb-3" style="font-size: 1.03rem; line-height: 1.8; color: #334155; white-space: pre-line;">
                                                                <%= art.summary %>
                                                            </div>

                                                            <!-- Hashtags -->
                                                            <% if (art.tags) { %>
                                                                <div class="d-flex flex-wrap gap-1 mb-3">
                                                                    <% art.tags.split(' ').filter(t => t.trim() !== '').forEach(tag => { %>
                                                                        <span class="badge bg-light text-primary border" style="font-size: 0.78rem; font-weight: 600;"><%= tag %></span>
                                                                    <% }) %>
                                                                </div>
                                                            <% } %>
                                                        </div>

                                                        <!-- Botones de Acción -->
                                                        <div class="pt-3 border-top d-flex flex-wrap align-items-center justify-content-between gap-2 mt-auto">
                                                            <div class="d-flex gap-2 flex-wrap">
                                                                <a href="/semillas-de-torah/articulo/<%= art.id %>" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background: linear-gradient(135deg, #6b21a8, #22c55e); border: none;">
                                                                    <i class="bi bi-book-open me-1"></i> Ver Artículo Completo
                                                                </a>
                                                                <% if (art.pdf_file) { %>
                                                                    <a href="<%= art.pdf_file %>" target="_blank" download class="btn btn-outline-success rounded-pill px-3 fw-semibold">
                                                                        <i class="bi bi-file-earmark-pdf me-1"></i> Descargar PDF
                                                                    </a>
                                                                <% } %>
                                                            </div>

                                                            <div class="d-flex align-items-center gap-2">
                                                                <!-- Compartir en WhatsApp -->
                                                                <% 
                                                                    const shareUrl = "https://hablemosdeyahweh.com/semillas-de-torah/articulo/" + art.id;
                                                                    const shareText = encodeURIComponent(art.title + "\n\n" + (art.key_verse || '') + "\n\n" + shareUrl);
                                                                %>
                                                                <a href="https://api.whatsapp.com/send?text=<%= shareText %>" target="_blank" class="btn btn-sm btn-outline-success rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" title="Compartir por WhatsApp">
                                                                    <i class="bi bi-whatsapp"></i>
                                                                </a>
                                                                <!-- Compartir en Facebook -->
                                                                <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(shareUrl) %>" target="_blank" class="btn btn-sm btn-outline-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" title="Compartir en Facebook">
                                                                    <i class="bi bi-facebook"></i>
                                                                </a>
                                                                <span class="badge rounded-pill bg-light text-muted border px-2 py-1 small">
                                                                    <i class="bi bi-eye me-1 text-primary"></i><%= art.views_count || 0 %>
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Columna Derecha: Infografía Principal & Galería Aliyot -->
                                                    <div class="col-lg-6">
                                                        <div class="infographic-container position-relative rounded-4 overflow-hidden shadow-sm" style="background: #111; border: 2px solid #e2e8f0;">
                                                            
                                                            <% if (art.main_image) { %>
                                                                <div class="position-relative clickable-lightbox-img" onclick="openImageLightbox('<%= art.main_image %>', '<%= art.title.replace(/'/g, "\\'") %>')" style="cursor: zoom-in; overflow: hidden; max-height: 460px; display: flex; align-items: center; justify-content: center; background: #000;">
                                                                    <img src="<%= art.main_image %>" alt="<%= art.title %>" class="img-fluid w-100" style="object-fit: contain; max-height: 460px; transition: transform 0.4s ease;">
                                                                    <div class="position-absolute bottom-0 start-0 w-100 p-2 text-center text-white small" style="background: linear-gradient(180deg, transparent, rgba(0,0,0,0.85));">
                                                                        <span class="badge bg-dark bg-opacity-75 rounded-pill px-3 py-1"><i class="bi bi-arrows-fullscreen me-1 text-warning"></i> Clic para ver infografía en pantalla completa</span>
                                                                    </div>
                                                                </div>
                                                            <% } else { %>
                                                                <div class="p-5 text-center text-white-50">
                                                                    <i class="bi bi-image fs-1 d-block mb-2 text-muted"></i>
                                                                    <span>Resumen de Parashá</span>
                                                                </div>
                                                            <% } %>

                                                            <!-- Mini-Galería de Aliyot adicionales si existen -->
                                                            <% if (gallery && gallery.length > 0) { %>
                                                                <div class="p-3 bg-light border-top">
                                                                    <div class="small fw-bold text-muted mb-2 d-flex align-items-center justify-content-between">
                                                                        <span><i class="bi bi-images me-1 text-info"></i> Fichas / Aliyot adicionales (<%= gallery.length %>)</span>
                                                                        <span class="small text-muted fst-italic">Clic para ampliar</span>
                                                                    </div>
                                                                    <div class="d-flex gap-2 overflow-auto pb-1" style="scrollbar-width: thin;">
                                                                        <% gallery.forEach((gImg, gIdx) => { %>
                                                                            <div class="rounded-3 overflow-hidden shadow-sm border position-relative flex-shrink-0" style="width: 80px; height: 80px; cursor: zoom-in;" onclick="openImageLightbox('<%= gImg %>', '<%= art.title.replace(/'/g, "\\'") %> - Ficha <%= gIdx + 1 %>')">
                                                                                <img src="<%= gImg %>" alt="" style="width: 100%; height: 100%; object-fit: cover;">
                                                                                <span class="position-absolute bottom-0 start-0 w-100 text-center text-white" style="font-size: 0.65rem; background: rgba(0,0,0,0.6); font-weight: 700;">#<%= gIdx + 1 %></span>
                                                                            </div>
                                                                        <% }) %>
                                                                    </div>
                                                                </div>
                                                            <% } %>

                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </article>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-5 bg-white rounded-4 shadow-sm p-4 border">
                                <div class="d-inline-flex p-4 rounded-circle mb-3" style="background: #f0fdf4; color: #16a34a; font-size: 3.5rem;">
                                    <i class="bi bi-journal-richtext"></i>
                                </div>
                                <h4 class="fw-bold" style="color: #2e1065;">Pronto compartiremos los resúmenes ilustrados de las Parashot</h4>
                                <p class="text-muted max-w-600 mx-auto">Estamos preparando las infografías de cada porción bíblica para que los niños y familias puedan aprender juntos.</p>
                                <a href="https://www.facebook.com/profile.php?id=61592294939779" target="_blank" class="btn btn-primary rounded-pill px-4 mt-2" style="background: #1877F2; border: none;">
                                    <i class="bi bi-facebook me-1"></i> Seguir en Facebook Oficial
                                </a>
                            </div>
                        <% } %>

                    </div>

                    <!-- ============================================== -->
                    <!-- PESTAÑA 1: SHORTS · ALIYOT CON NIÑOS Y TEMAS DIVERSOS -->
                    <!-- ============================================== -->
                    <div class="tab-pane fade show active" id="pane-shorts" role="tabpanel">
                        
                        <!-- Banner Explicativo Novedades -->
                        <div class="p-4 mb-4 rounded-4 shadow-sm border-0 d-flex align-items-start gap-3" style="background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 50%, #f5f3ff 100%); border-left: 5px solid #0284c7 !important;">
                            <div class="rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="background: rgba(2,132,199,0.15); width: 50px; height: 50px; color: #0284c7;">
                                <i class="bi bi-camera-reels-fill fs-4"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                    <h5 class="fw-bold mb-0" style="color: #0369a1;">Videos Cortos · Aliyot Infantiles y Temas Diversos</h5>
                                    <span class="badge bg-danger rounded-pill px-2 py-1 small"><i class="bi bi-play-circle-fill me-1"></i>Shorts Verticales</span>
                                </div>
                                <p class="mb-0 text-muted" style="font-size: 0.95rem; line-height: 1.6;">
