<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

<body class="aliyot-page">

    <%- include('partials/header') %>

    <main class="main">

        <!-- Page Title -->
        <div class="page-title dark-background" data-aos="fade">
            <div class="container d-lg-flex justify-content-between align-items-center">
                <div>
                    <h1 class="mb-2 mb-lg-0">Aliyot: Lecturas Diarias de la Torá</h1>
                    <p class="text-white-50 mb-0">Escucha los audios de cada día y estudia los versículos correspondientes a cada porción semanal.</p>
                </div>
                <nav class="breadcrumbs">
                    <ol>
                        <li><a href="/">Inicio</a></li>
                        <li><a href="/parashot">Parashot</a></li>
                        <li class="current">Aliyot</li>
                    </ol>
                </nav>
            </div>
        </div>

        <section class="section" style="background-color: #faf9f6; min-height: 80vh;">
            <div class="container">

                <!-- Banner Explicativo del Ciclo Semanal -->
                <div class="alert p-3 p-md-4 mb-4 rounded-4 shadow-sm border-0 d-flex align-items-start gap-3" style="background: linear-gradient(135deg, #fdfbf7 0%, #f7f1e6 100%); border-left: 5px solid #d4a853 !important;">
                    <div class="rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="background: rgba(212, 168, 83, 0.2); width: 45px; height: 45px; color: #8c6a2d;">
                        <i class="bi bi-info-circle-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1" style="color: #4a3b22;">Lecturas Diarias de la Semana (Aliyot)</h5>
                        <p class="mb-0 text-muted" style="font-size: 0.95rem; line-height: 1.6;">
                            Las <strong>Aliyot</strong> son las porciones diarias que se van leyendo y subiendo a lo largo de la semana (del <strong>Día 1 / Domingo</strong> al <strong>Día 7 / Shabat</strong>). En Shabat culminamos la semana con la transmisión y estudio completo de la <strong>Parashá</strong>.
                        </p>
                    </div>
                </div>

                <!-- Selector de Parashá -->
                <div class="card p-3 p-md-4 mb-4 rounded-4 shadow-sm border-0" style="background: #ffffff;">
                    <div class="row align-items-center g-3">
                        <div class="col-lg-6">
                            <label class="form-label fw-bold text-dark mb-1">
                                <i class="bi bi-journal-bookmark-fill me-1" style="color: #d4a853;"></i> Selecciona la porción semanal:
                            </label>
                            <form action="/aliyot" method="GET" id="parashaSelectForm">
                                <select name="parasha" class="form-select form-select-lg" onchange="document.getElementById('parashaSelectForm').submit()" style="border-radius: 12px; border-color: #d4a853;">
                                    <% if (typeof parashot !== 'undefined' && parashot.length > 0) { %>
                                        <% parashot.forEach(p => { %>
                                            <option value="<%= p.id %>" <%= (selectedParasha && selectedParasha.id === p.id) ? 'selected' : '' %>>
                                                <%= p.parasha_number ? `Nº ${p.parasha_number} - ` : '' %><%= p.title %> <%= p.subtitle ? `(${p.subtitle})` : '' %>
                                            </option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </form>
                        </div>

                        <% if (selectedParasha) { %>
                            <div class="col-lg-6 d-flex align-items-center justify-content-lg-end gap-2">
                                <a href="/parashot/<%= selectedParasha.id %>" class="btn btn-outline-dark rounded-pill px-3 py-2 fw-semibold">
                                    <i class="bi bi-book me-1"></i> Ir al Estudio Completo de Shabat
                                </a>
                            </div>
                        <% } %>
                    </div>
                </div>

                <% if (selectedParasha) { %>
                    <div class="row gy-4">
                        <div class="col-lg-12">
                            <!-- Sección Interactiva de las 7 Aliyot -->
                            <% 
                                const daysNames = [
                                    { num: 1, name: '1ª Aliyá', day: 'Domingo (Día 1)' },
                                    { num: 2, name: '2ª Aliyá', day: 'Lunes (Día 2)' },
                                    { num: 3, name: '3ª Aliyá', day: 'Martes (Día 3)' },
                                    { num: 4, name: '4ª Aliyá', day: 'Miércoles (Día 4)' },
                                    { num: 5, name: '5ª Aliyá', day: 'Jueves (Día 5)' },
                                    { num: 6, name: '6ª Aliyá', day: 'Viernes (Día 6)' },
                                    { num: 7, name: '7ª Aliyá', day: 'Shabat (Día 7)' }
                                ];
                                const aliyotList = (typeof aliyot !== 'undefined' && aliyot) ? aliyot : [];
                            %>

                            <!-- Pestañas de Navegación -->
                            <div class="aliyot-tabs-nav mb-4">
                                <ul class="nav nav-pills gap-2 flex-wrap" id="aliyotPills" role="tablist">
                                    <% daysNames.forEach((d, idx) => { 
                                        const aliyahData = aliyotList.find(a => Number(a.aliyah_number) === d.num);
                                        const hasAudio = aliyahData && aliyahData.audio_url && aliyahData.audio_url.trim() !== '';
                                    %>
                                        <li class="nav-item flex-grow-1 text-center" role="presentation">
                                            <button class="nav-link w-100 <%= idx === 0 ? 'active' : '' %> py-2 px-3 position-relative" 
                                                    id="pills-aliyah-<%= d.num %>-tab" 
                                                    data-bs-toggle="pill" 
                                                    data-bs-target="#pills-aliyah-<%= d.num %>" 
                                                    type="button" 
                                                    role="tab"
                                                    style="border-radius: 12px; border: 1px solid #e0d6c2; transition: all 0.25s ease;">
                                                <div class="fw-bold fs-6"><%= d.name %></div>
                                                <div class="small text-muted day-subtitle" style="font-size: 0.78rem;"><%= d.day %></div>
                                                <% if (hasAudio) { %>
                                                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-success border border-light rounded-circle" title="Audio disponible"></span>
                                                <% } %>
                                            </button>
                                        </li>
                                    <% }) %>
                                </ul>
                            </div>

                            <!-- Contenido de cada Aliyá -->
                            <div class="tab-content" id="aliyotPillsContent">
                                <% daysNames.forEach((d, idx) => { 
                                    const aliyah = aliyotList.find(a => Number(a.aliyah_number) === d.num) || {};
                                    const hasAudio = aliyah.audio_url && aliyah.audio_url.trim() !== '';
                                    const hasContent = aliyah.content && aliyah.content.trim() !== '';
                                %>
                                    <div class="tab-pane fade <%= idx === 0 ? 'show active' : '' %>" id="pills-aliyah-<%= d.num %>" role="tabpanel">
                                        <div class="aliyah-card p-4 rounded-4 shadow-sm" style="background: #ffffff; border: 1px solid #e8e1d5;">
                                            <!-- Cabecera de la Aliyá -->
                                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 pb-3 mb-3 border-bottom">
                                                <div>
                                                    <span class="badge mb-2 px-2 py-1" style="background: #f4ece1; color: #8c6a2d; font-size: 0.8rem; font-weight: 600;">
                                                        <%= d.name %> &bull; <%= d.day %>
                                                    </span>
                                                    <h3 class="fw-bold mb-1" style="color: #222;">
                                                        <%= aliyah.title || `${d.name} (${d.day})` %>
                                                    </h3>
                                                    <% if (aliyah.verses_reference) { %>
                                                        <div class="text-muted fw-semibold small d-flex align-items-center gap-1" style="color: #d4a853 !important;">
                                                            <i class="bi bi-bookmark-fill"></i> <%= aliyah.verses_reference %>
                                                        </div>
                                                    <% } %>
                                                </div>

                                                <!-- Botones de Compartir -->
                                                <div class="d-flex gap-2 align-items-center">
                                                    <% 
                                                        const shareTitle = `Lectura de Toráh: ${selectedParasha.title} - ${d.name} (${d.day})`;
                                                        const shareRef = aliyah.verses_reference ? `\n📖 Versículos: ${aliyah.verses_reference}` : '';
                                                        const shareUrl = `https://www.hablemosdeyhwh.com/aliyot?parasha=${selectedParasha.id}`;
                                                        const waText = encodeURIComponent(`*${shareTitle}*${shareRef}\n\nEscucha y lee la porción completa aquí:\n${shareUrl}`);
                                                    %>
                                                    <a href="https://api.whatsapp.com/send?text=<%= waText %>" target="_blank" rel="noopener noreferrer" 
                                                       class="btn btn-sm btn-outline-success rounded-pill d-inline-flex align-items-center gap-1 px-3 py-1 fw-bold"
                                                       title="Compartir en WhatsApp">
                                                        <i class="bi bi-whatsapp"></i> Compartir
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 btn-copy-link" 
                                                            data-copy-url="<%= shareUrl %>" title="Copiar enlace">
                                                        <i class="bi bi-link-45deg"></i> Copiar
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- REPRODUCTOR DE AUDIO -->
                                            <% if (hasAudio) { %>
                                                <div class="audio-player-box p-3 mb-4 rounded-3 d-flex flex-column gap-2" 
                                                     style="background: linear-gradient(135deg, #1c1c1c 0%, #2a251f 100%); color: #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.15);">
                                                    <div class="d-flex align-items-center justify-content-between">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="pulse-icon text-warning"><i class="bi bi-soundwave fs-4"></i></span>
                                                            <span class="small text-white-50">Audio de la Lectura Diaria</span>
                                                        </div>
                                                        <a href="<%= aliyah.audio_url %>" download target="_blank" class="text-white-50 text-decoration-none small hover-white" title="Descargar Audio">
                                                            <i class="bi bi-download me-1"></i> Descargar
                                                        </a>
                                                    </div>
                                                    <audio controls class="w-100 mt-1" style="height: 40px; border-radius: 8px;">
                                                        <source src="<%= aliyah.audio_url %>" type="audio/mpeg">
                                                        Tu navegador no soporta el reproductor de audio HTML5.
                                                    </audio>
                                                </div>
                                            <% } %>

                                            <!-- LECTOR DE VERSÍCULOS / TEXTO -->
                                            <% if (hasContent) { %>
                                                <div class="aliyah-reading-content p-3 rounded-3" 
                                                     style="background: #faf8f5; border: 1px solid #efe8dd; font-size: 1.08rem; line-height: 1.9; color: #333; font-family: Georgia, serif;">
                                                    <%- aliyah.content %>
                                                </div>
                                            <% } else if (!hasAudio) { %>
                                                <div class="text-center py-4 text-muted">
                                                    <i class="bi bi-hourglass-split fs-2 d-block mb-2" style="color: #d4a853;"></i>
                                                    <p class="mb-0 small">El audio y los versículos de esta Aliyá se publicarán en el día correspondiente.</p>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>

                        </div>
                    </div>
                <% } else { %>
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-journal-x fs-1 d-block mb-2 text-warning"></i>
                        <h4>No hay Parashot disponibles</h4>
                    </div>
                <% } %>

            </div>
        </section>

    </main>

    <%- include('partials/footer') %>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.btn-copy-link').forEach(btn => {
            btn.addEventListener('click', function() {
                const url = this.getAttribute('data-copy-url') || window.location.href;
                navigator.clipboard.writeText(url).then(() => {
                    const originalText = this.innerHTML;
                    this.innerHTML = '<i class="bi bi-check-lg text-success"></i> ¡Copiado!';
                    setTimeout(() => {
                        this.innerHTML = originalText;
                    }, 2000);
                }).catch(err => {
                    prompt('Copia este enlace:', url);
                });
            });
        });
    });
    </script>

    <style>
        .aliyot-tabs-nav .nav-pills .nav-link {
            color: #555;
            background: #ffffff;
        }
        .aliyot-tabs-nav .nav-pills .nav-link:hover {
            background: #f0e9dc;
            color: #222;
        }
        .aliyot-tabs-nav .nav-pills .nav-link.active {
            background: linear-gradient(135deg, #d4a853, #b8860b) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 15px rgba(212,168,83,0.35);
            border-color: #d4a853 !important;
        }
        .aliyot-tabs-nav .nav-pills .nav-link.active .day-subtitle {
            color: rgba(255,255,255,0.85) !important;
        }
        .aliyah-reading-content p {
            margin-bottom: 1.2rem;
        }
        .aliyah-reading-content p:last-child {
            margin-bottom: 0;
        }
        .pulse-icon {
            animation: pulse-wave 1.5s infinite;
        }
        @keyframes pulse-wave {
            0% { transform: scale(1); opacity: 0.8; }
            50% { transform: scale(1.15); opacity: 1; }
            100% { transform: scale(1); opacity: 0.8; }
        }
    </style>

</body>
</html>
