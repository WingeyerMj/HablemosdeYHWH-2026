<%- include('partials/_sidebar', { activePage: 'aliyot' }) %>

<main class="col-md-10 main-content p-4">
    <div class="page-header d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
        <div>
            <h1 class="h2 text-white"><i class="bi bi-mic me-2" style="color: var(--primary-color);"></i>Gestión de Aliyot (Lecturas Diarias)</h1>
            <p class="text-white-50 mb-0">Administrá las 7 lecturas diarias de la Torá por cada Parashá, subí sus audios y editá los versículos.</p>
        </div>
        <div>
            <a href="/admin/dashboard#pills-services" class="btn btn-outline-secondary"><i class="bi bi-journal-text me-1"></i> Ir a Parashot</a>
        </div>
    </div>

    <!-- Buscador rápido -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-search"></i></span>
                <input type="text" id="searchParasha" class="form-control bg-dark text-white border-secondary" placeholder="Buscar Parashá por nombre, número o cita...">
            </div>
        </div>
        <div class="col-md-6 d-flex align-items-center justify-content-md-end mt-2 mt-md-0">
            <span class="badge bg-secondary p-2 fs-6">
                Total Parashot: <strong><%= parashot.length %></strong>
            </span>
        </div>
    </div>

    <!-- Grilla de Parashot -->
    <div class="row g-4" id="parashotGrid">
        <% if (typeof parashot !== 'undefined' && parashot.length > 0) { %>
            <% parashot.forEach(p => { %>
                <div class="col-lg-4 col-md-6 parasha-card-item" data-title="<%= (p.title + ' ' + (p.subtitle || '') + ' ' + (p.parasha_number || '')).toLowerCase() %>">
                    <div class="card bg-dark text-white border-secondary h-100 shadow-sm" style="border-radius: 12px; overflow: hidden; transition: transform 0.2s, box-shadow 0.2s;">
                        <div class="card-header border-secondary d-flex justify-content-between align-items-center bg-black bg-opacity-25 py-2">
                            <span class="badge" style="background: var(--primary-color, #d4b895); color: #000; font-weight: 700;">
                                <%= p.parasha_number ? `Nº ${p.parasha_number}` : 'Parashá' %>
                            </span>
                            <div class="d-flex gap-2">
                                <span class="badge bg-dark border border-secondary text-white-50" title="Aliyot cargadas">
                                    <i class="bi bi-book me-1"></i> <%= p.total_aliyot || 0 %>/7
                                </span>
                                <span class="badge <%= (p.audios_count && p.audios_count > 0) ? 'bg-success' : 'bg-secondary' %>" title="Audios subidos">
                                    <i class="bi bi-volume-up me-1"></i> <%= p.audios_count || 0 %>/7
                                </span>
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <% if (p.image_url) { %>
                                    <img src="<%= p.image_url %>" alt="<%= p.title %>" style="width: 55px; height: 55px; border-radius: 8px; object-fit: cover; border: 1px solid rgba(255,255,255,0.1);">
                                <% } else { %>
                                    <div class="d-flex align-items-center justify-content-center bg-black bg-opacity-50" style="width: 55px; height: 55px; border-radius: 8px; border: 1px dashed rgba(255,255,255,0.2);">
                                        <i class="bi bi-journal-text fs-4 text-white-50"></i>
                                    </div>
                                <% } %>
                                <div class="overflow-hidden">
                                    <h5 class="card-title mb-1 text-truncate" style="color: #fff; font-weight: 600;"><%= p.title %></h5>
                                    <% if (p.subtitle) { %>
                                        <p class="card-text text-white-50 small mb-0 text-truncate"><%= p.subtitle %></p>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Barra de progreso de 7 Aliyot -->
                            <div class="mt-2 mb-3">
                                <div class="d-flex justify-content-between small text-white-50 mb-1" style="font-size: 0.78rem;">
                                    <span>Completado:</span>
                                    <span><%= Math.round(((p.total_aliyot || 0) / 7) * 100) %>%</span>
                                </div>
                                <div class="progress" style="height: 6px; background-color: rgba(255,255,255,0.1);">
                                    <div class="progress-bar" role="progressbar" 
                                         style="width: <%= ((p.total_aliyot || 0) / 7) * 100 %>%; background-color: var(--primary-color, #d4b895);" 
                                         aria-valuenow="<%= p.total_aliyot || 0 %>" aria-valuemin="0" aria-valuemax="7"></div>
                                </div>
                            </div>

                            <div class="mt-auto pt-2 border-top border-secondary d-flex gap-2">
                                <a href="/admin/aliyot/edit/<%= p.id %>" class="btn btn-sm w-100 fw-bold d-flex align-items-center justify-content-center gap-1" style="background: var(--primary-color, #d4b895); color: #1a1a1a;">
                                    <i class="bi bi-pencil-square"></i> Cargar 7 Aliyot
                                </a>
                                <a href="/parashot/<%= p.id %>" target="_blank" class="btn btn-sm btn-outline-secondary" title="Ver en la Web">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12 text-center py-5 text-white-50">
                <i class="bi bi-journal-x fs-1 mb-2 d-block"></i>
                <p>No se encontraron Parashot registradas. Crea primero las Parashot en el Dashboard.</p>
            </div>
        <% } %>
    </div>
</main>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchParasha');
    const cards = document.querySelectorAll('.parasha-card-item');

    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const query = this.value.toLowerCase().trim();
            cards.forEach(card => {
                const title = card.getAttribute('data-title') || '';
                if (title.includes(query)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    }
});
</script>
