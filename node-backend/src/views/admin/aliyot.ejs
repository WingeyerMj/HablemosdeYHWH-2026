<!-- MODAL: VINCULAR ALIYÁ A UNA PARASHÁ -->
<!-- ============================================== -->
<div class="modal fade" id="linkParashaModal" tabindex="-1" aria-labelledby="linkParashaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary" style="border-radius: 14px;">
            <div class="modal-header border-secondary bg-black bg-opacity-25">
                <h5 class="modal-title" id="linkParashaModalLabel"><i class="bi bi-link-45deg text-warning me-2"></i>Vincular Aliyá a una Parashá</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form action="/admin/aliyot/link" method="POST" id="linkParashaForm">
                    <input type="hidden" name="aliyah_id" id="linkModalAliyahId">

                    <p class="text-white-50 small mb-3">
                        Asigna la lectura <strong class="text-white" id="linkModalAliyahTitle"></strong> a la Parashá correspondiente una vez que haya sido creada:
                    </p>

                    <div class="mb-3">
                        <label class="form-label small text-white-50 fw-bold">Seleccionar Parashá</label>
                        <select name="parasha_id" class="form-select bg-black bg-opacity-50 text-white border-secondary" id="linkModalParashaSelect" required>
                            <option value="">-- Seleccionar Parashá --</option>
                            <% if (typeof parashot !== 'undefined' && parashot.length > 0) { %>
                                <% parashot.forEach(p => { %>
                                    <option value="<%= p.id %>">
                                        <%= p.parasha_number ? `Nº ${p.parasha_number} - ` : '' %><%= p.title %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top border-secondary">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-warning fw-bold px-4">
                            <i class="bi bi-check-lg me-1"></i> Vincular Ahora
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. Inicializar Quill en el Modal de Creación
    const modalQuill = new Quill('#modal-quill-editor', {
        theme: 'snow',
        modules: { 
            toolbar: [
                [{ 'header': [1, 2, 3, false] }],
                ['bold', 'italic', 'underline'],
                [{ 'color': [] }],
                ['link', 'blockquote'],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                ['clean']
            ] 
        }
    });

    document.getElementById('createAliyahModalForm').onsubmit = function() {
        document.getElementById('modalAliyahContent').value = modalQuill.root.innerHTML;
        return true;
    };

    // Auto-Transliterar Hebreo a Fonética en Modal
    const btnAutoTrans = document.getElementById('btnAutoTransliterateModal');
    if (btnAutoTrans) {
        btnAutoTrans.addEventListener('click', async function() {
            const hebrewText = document.getElementById('modalHebrewContent').value.trim();
            if (!hebrewText) {
                alert('Por favor escribe o pega primero el texto en la pestaña Hebreo (עברית).');
                document.getElementById('modal-tab-he').click();
                return;
            }
            const originalBtnText = this.innerHTML;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Convirtiendo...';
            this.disabled = true;

            try {
                const res = await fetch('/admin/aliyot/api/transliterate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text: hebrewText })
                });
                const data = await res.json();
                if (data.success && data.phonetic) {
                    document.getElementById('modalPhoneticContent').value = data.phonetic;
                    document.getElementById('modal-tab-fo').click();
                } else {
                    alert('No se pudo generar la fonética.');
                }
            } catch(e) {
                alert('Error al convertir fonética: ' + e.message);
            } finally {
                this.innerHTML = originalBtnText;
                this.disabled = false;
            }
        });
    }

    // Auto-Obtener Versículos en Modal
    const btnAutoFetch = document.getElementById('btnAutoFetchVersesModal');
    if (btnAutoFetch) {
        btnAutoFetch.addEventListener('click', async function() {
            const ref = document.querySelector('#createAliyahModalForm input[name="verses_reference"]').value.trim();
            if (!ref) {
                alert('Por favor ingresa la Referencia de Versículos (Ej: Génesis 1:1-5) primero.');
                return;
            }
            const originalBtnText = this.innerHTML;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Buscando...';
            this.disabled = true;

            try {
                const res = await fetch('/admin/aliyot/api/fetch-verses', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ref })
                });
                const data = await res.json();
                if (data.success) {
                    if (data.hebrew) document.getElementById('modalHebrewContent').value = data.hebrew.replace(/<[^>]*>/g, '');
                    if (data.phonetic) document.getElementById('modalPhoneticContent').value = data.phonetic;
                    if (data.englishOrSpanish && modalQuill) modalQuill.root.innerHTML = data.englishOrSpanish;
                    alert('¡Versículos y Fonética cargados con éxito! Puedes revisarlos en las 3 pestañas.');
                } else {
                    alert(data.message || 'No se pudieron obtener los versículos automáticamente.');
                }
            } catch(e) {
                alert('Error de conexión al obtener versículos: ' + e.message);
            } finally {
                this.innerHTML = originalBtnText;
                this.disabled = false;
            }
        });
    }

    // 2. Filtro en vivo para la tabla
    const filterInput = document.getElementById('filterAliyotInput');
    if (filterInput) {
        filterInput.addEventListener('input', function() {
            const query = this.value.toLowerCase().trim();
            document.querySelectorAll('.aliyah-table-row').forEach(row => {
                const searchData = row.getAttribute('data-search') || '';
                if (searchData.includes(query)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    }

    // 3. Modal de Vinculación Rápida a Parashá
    document.querySelectorAll('.btn-quick-link').forEach(btn => {
        btn.addEventListener('click', function() {
            const aliyahId = this.getAttribute('data-aliyahid');
            const aliyahTitle = this.getAttribute('data-aliyahtitle');
            const currentParasha = this.getAttribute('data-currentparasha');

            document.getElementById('linkModalAliyahId').value = aliyahId;
            document.getElementById('linkModalAliyahTitle').innerText = aliyahTitle;
            
            if (currentParasha) {
                document.getElementById('linkModalParashaSelect').value = currentParasha;
            } else {
                document.getElementById('linkModalParashaSelect').value = '';
            }

            const linkModal = new bootstrap.Modal(document.getElementById('linkParashaModal'));
            linkModal.show();
        });
    });

    // 4. Modal de Compartir en Redes
    let currentShareUrl = '';
    let currentFullMsg = '';

    document.querySelectorAll('.btn-open-share').forEach(btn => {
        btn.addEventListener('click', function() {
            const title = this.getAttribute('data-title');
            const parasha = this.getAttribute('data-parasha');
            const ref = this.getAttribute('data-ref');
            const parashaId = this.getAttribute('data-parashaid');

            document.getElementById('modalShareTitle').innerText = title;
            document.getElementById('modalShareParasha').innerText = 'Parashá: ' + parasha;
            document.getElementById('modalShareRef').innerText = ref ? '📖 ' + ref : '';

            currentShareUrl = parashaId ? `https://www.hablemosdeyhwh.com/aliyot?parasha=${parashaId}` : `https://www.hablemosdeyhwh.com/aliyot`;
            currentFullMsg = `*Lectura de Toráh: ${parasha} - ${title}*` + (ref ? `\n📖 Versículos: ${ref}` : '') + `\n\nEscucha el audio y lee la porción aquí:\n${currentShareUrl}`;

            const waText = encodeURIComponent(currentFullMsg);
            const tgText = encodeURIComponent(`Lectura de Toráh: ${parasha} - ${title}\n` + (ref ? `📖 Versículos: ${ref}` : ''));
            const xText = encodeURIComponent(`Lectura de Toráh: ${parasha} - ${title} ${ref}`);

            document.getElementById('btnShareWhatsApp').href = `https://api.whatsapp.com/send?text=${waText}`;
            document.getElementById('btnShareTelegram').href = `https://t.me/share/url?url=${encodeURIComponent(currentShareUrl)}&text=${tgText}`;
            document.getElementById('btnShareFacebook').href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentShareUrl)}`;
            document.getElementById('btnShareTwitter').href = `https://twitter.com/intent/tweet?text=${xText}&url=${encodeURIComponent(currentShareUrl)}`;

            const shareModal = new bootstrap.Modal(document.getElementById('shareSocialModal'));
            shareModal.show();
        });
    });

    // Copiar enlace directo en el modal
    document.getElementById('btnCopyDirectLink').addEventListener('click', function() {
        navigator.clipboard.writeText(currentShareUrl).then(() => {
            const prev = this.innerHTML;
            this.innerHTML = '<i class="bi bi-check-lg text-success fs-5"></i> ¡Enlace Copiado!';
            setTimeout(() => { this.innerHTML = prev; }, 2000);
        });
    });

    // Copiar mensaje completo en el modal
    document.getElementById('btnCopyFormattedMsg').addEventListener('click', function() {
        navigator.clipboard.writeText(currentFullMsg).then(() => {
            const prev = this.innerHTML;
            this.innerHTML = '<i class="bi bi-check-lg text-success fs-5"></i> ¡Mensaje Copiado!';
            setTimeout(() => { this.innerHTML = prev; }, 2000);
        });
    });

    // 5. Agregar más filas de archivos de audio dinámicamente
    const btnAddAudioRow = document.getElementById('btnAddAudioInputRow');
    const audioContainer = document.getElementById('modalAudioRowsContainer');

    if (btnAddAudioRow && audioContainer) {
        btnAddAudioRow.addEventListener('click', function() {
            const rowsCount = audioContainer.querySelectorAll('.audio-input-row').length + 1;
            const newRow = document.createElement('div');
            newRow.className = 'audio-input-row p-2 rounded bg-black bg-opacity-50 border border-secondary';
            newRow.innerHTML = `
                <div class="row g-2 align-items-center">
                    <div class="col-md-6">
                        <label class="form-label small text-white-50 mb-1">Archivo ${rowsCount}</label>
                        <input type="file" name="audio_files" class="form-control form-control-sm bg-dark text-white border-secondary aliyah-file-input" accept="audio/*,.mp3,.ogg,.oga,.opus,.m4a,.wav,.aac" multiple>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small text-white-50 mb-1">Título / Nombre (opcional)</label>
                        <input type="text" name="audio_titles[]" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Ej: Audio ${rowsCount} / Comentario">
                    </div>
                    <div class="col-md-1 text-center pt-3">
                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row" title="Eliminar fila">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            `;
            audioContainer.appendChild(newRow);

            // Asignar evento eliminar fila
            newRow.querySelector('.btn-remove-row').addEventListener('click', function() {
                newRow.remove();
            });

            // Asignar auto-completar título si está vacío
            const fileInput = newRow.querySelector('.aliyah-file-input');
            const titleInput = newRow.querySelector('input[type="text"]');
            fileInput.addEventListener('change', function() {
                if (this.files && this.files[0] && !titleInput.value) {
                    titleInput.value = this.files[0].name.replace(/\.[^/.]+$/, '');
                }
            });
        });

        // Evento auto-completar título para la primera fila
        const initialFileInput = audioContainer.querySelector('.aliyah-file-input');
        const initialTitleInput = audioContainer.querySelector('input[name="audio_titles[]"]');
        if (initialFileInput && initialTitleInput) {
            initialFileInput.addEventListener('change', function() {
                if (this.files && this.files[0] && !initialTitleInput.value) {
                    initialTitleInput.value = this.files[0].name.replace(/\.[^/.]+$/, '');
                }
            });
        }
    }
});
</script>

