<%- include('partials/_sidebar', { activePage: 'aliyot' }) %>

<style>
select option, select optgroup {
    background-color: #212529 !important;
    color: #ffffff !important;
    padding: 8px 12px;
}
select option:checked, select option:hover {
    background-color: #0d6efd !important;
    color: #ffffff !important;
}
</style>

<main class="col-md-10 main-content p-4">
    <div class="page-header d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
        <div>
            <h1 class="h2 text-white"><i class="bi bi-mic me-2" style="color: var(--primary-color, #d4b895);"></i>Gestión de Aliyot (Lecturas Diarias)</h1>
            <p class="text-white-50 mb-0">Carga y administra los audios diarios, versículos y compártelos en redes sociales vinculadas.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-success fw-bold d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#createAliyahModal">
                <i class="bi bi-plus-circle fs-5"></i> Cargar Nueva Aliyá
            </button>
            <a href="/aliyot" target="_blank" class="btn btn-outline-info d-flex align-items-center gap-1">
                <i class="bi bi-eye"></i> Ver en la Web
            </a>
        </div>
    </div>

    <% if (typeof created !== 'undefined' && created) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> ¡Lectura de Aliyá creada exitosamente!
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (typeof updated !== 'undefined' && updated) { %>
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i> ¡Lectura de Aliyá actualizada correctamente!
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (typeof deleted !== 'undefined' && deleted) { %>
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-trash-fill me-2"></i> Lectura de Aliyá eliminada.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Pestañas de Vista: Listado General vs Por Parashá -->
    <ul class="nav nav-pills mb-4 gap-2" id="aliyotMainTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold border border-secondary" id="tab-all-aliyot" data-bs-toggle="pill" data-bs-target="#content-all-aliyot" type="button" role="tab">
                <i class="bi bi-list-task me-1"></i> Todas las Aliyot Cargadas (<%= (typeof allAliyot !== 'undefined' && allAliyot) ? allAliyot.length : 0 %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold border border-secondary" id="tab-by-parasha" data-bs-toggle="pill" data-bs-target="#content-by-parasha" type="button" role="tab">
                <i class="bi bi-journal-album me-1"></i> Organizar por Parashá (7 Días)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="aliyotMainTabContent">
        
        <!-- PESTAÑA 1: LISTADO GENERAL DE ALIYOT (CRUD COMPLETO) -->
        <div class="tab-pane fade show active" id="content-all-aliyot" role="tabpanel">
            <div class="card bg-dark text-white border-secondary shadow-sm mb-4" style="border-radius: 12px;">
                <div class="card-header border-secondary bg-black bg-opacity-25 d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
                    <h5 class="mb-0 text-white"><i class="bi bi-headphones me-2" style="color: var(--primary-color, #d4b895);"></i>Listado de Lecturas Diarias</h5>
                    <div class="d-flex gap-2">
                        <input type="text" id="filterAliyotInput" class="form-control form-control-sm bg-black bg-opacity-50 text-white border-secondary" placeholder="Filtrar por parashá o versículo..." style="min-width: 250px;">
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0" id="aliyotTable">
                            <thead class="table-black border-secondary" style="border-bottom: 2px solid rgba(255,255,255,0.1);">
                                <tr>
                                    <th style="width: 100px;">Día</th>
                                    <th>Parashá</th>
                                    <th>Título & Cita</th>
                                    <th>Audio</th>
                                    <th>Estado</th>
                                    <th class="text-end" style="min-width: 220px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof allAliyot !== 'undefined' && allAliyot.length > 0) { %>
                                    <% allAliyot.forEach(a => { 
                                        const defaultDays = ['1ª Aliyá (Dom)', '2ª Aliyá (Lun)', '3ª Aliyá (Mar)', '4ª Aliyá (Mié)', '5ª Aliyá (Jue)', '6ª Aliyá (Vie)', '7ª Aliyá (Shab)'];
                                    %>
                                        <tr class="aliyah-table-row" data-search="<%= (a.title + ' ' + (a.parasha_title || 'sin parashá') + ' ' + (a.verses_reference || '')).toLowerCase() %>">
                                            <td>
                                                <span class="badge" style="background: var(--primary-color, #d4b895); color: #000; font-weight: 700;">
                                                    <%= a.aliyah_number %>ª Aliyá
                                                </span>
                                            </td>
                                            <td>
                                                <% if (a.parasha_title) { %>
                                                    <div class="fw-bold text-white"><%= a.parasha_title %></div>
                                                    <small class="text-white-50"><%= a.parasha_subtitle || '' %></small>
                                                <% } else { %>
                                                    <button type="button" class="btn btn-sm btn-outline-warning rounded-pill py-0 px-2 fw-semibold btn-quick-link" 
                                                            data-aliyahid="<%= a.id %>" data-aliyahtitle="<%= a.title %>" title="Haz clic para vincular a una Parashá">
                                                        <i class="bi bi-link-45deg me-1"></i> Vincular a Parashá
                                                    </button>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div class="text-white fw-semibold"><%= a.title %></div>
                                                <% if (a.verses_reference) { %>
                                                    <small class="text-warning"><i class="bi bi-bookmark me-1"></i><%= a.verses_reference %></small>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (a.audios && a.audios.length > 0) { %>
                                                    <div class="d-flex flex-column gap-1">
                                                        <% a.audios.forEach((aud, idx) => { %>
                                                            <div class="d-flex align-items-center gap-1">
                                                                <audio controls style="height: 28px; max-width: 170px;">
                                                                    <source src="<%= aud.url %>" type="audio/mpeg">
                                                                </audio>
                                                                <% if (a.audios.length > 1) { %>
                                                                    <span class="badge bg-secondary" style="font-size: 0.65rem;" title="<%= aud.title %>">#<%= idx + 1 %></span>
                                                                <% } %>
                                                            </div>
                                                        <% }) %>
                                                    </div>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">Sin audio</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (a.is_published) { %>
                                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Publicado</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary"><i class="bi bi-clock me-1"></i> Borrador</span>
                                                <% } %>
                                            </td>
                                            <td class="text-end">
                                                <!-- Botón Vincular Rápido (si ya tiene, también se puede cambiar) -->
                                                <button type="button" class="btn btn-sm btn-outline-warning me-1 btn-quick-link"
                                                        data-aliyahid="<%= a.id %>"
                                                        data-aliyahtitle="<%= a.title %>"
                                                        data-currentparasha="<%= a.parasha_id || '' %>"
                                                        title="Cambiar/Vincular Parashá">
                                                    <i class="bi bi-link-45deg"></i>
                                                </button>

                                                <!-- Botón Compartir en Redes -->
                                                <button type="button" class="btn btn-sm btn-outline-success me-1 btn-open-share"
                                                        data-title="<%= a.title %>"
                                                        data-parasha="<%= a.parasha_title || 'Lectura Semanal' %>"
                                                        data-ref="<%= a.verses_reference || '' %>"
                                                        data-parashaid="<%= a.parasha_id || '' %>"
                                                        title="Compartir en Redes">
                                                    <i class="bi bi-share-fill"></i>
                                                </button>

                                                <!-- Editar -->
                                                <a href="/admin/aliyot/edit-item/<%= a.id %>" class="btn btn-sm btn-primary me-1" title="Editar Aliyá">
                                                    <i class="bi bi-pencil"></i>
                                                </a>

                                                <!-- Eliminar -->
                                                <a href="/admin/aliyot/delete-item/<%= a.id %>" class="btn btn-sm btn-danger" onclick="return confirm('¿Seguro que deseas eliminar esta Aliyá?');" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-white-50">
                                            <i class="bi bi-mic fs-1 d-block mb-2 text-warning"></i>
                                            <p class="mb-2">No hay Aliyot cargadas individualmente todavía.</p>
                                            <button type="button" class="btn btn-sm btn-success fw-bold" data-bs-toggle="modal" data-bs-target="#createAliyahModal">
                                                <i class="bi bi-plus-circle me-1"></i> Cargar Primera Aliyá
                                            </button>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- PESTAÑA 2: ORGANIZAR POR PARASHÁ (7 DÍAS) -->
        <div class="tab-pane fade" id="content-by-parasha" role="tabpanel">
            <div class="row g-4">
                <% if (typeof parashotOverview !== 'undefined' && parashotOverview.length > 0) { %>
                    <% parashotOverview.forEach(p => { %>
                        <div class="col-lg-4 col-md-6">
                            <div class="card bg-dark text-white border-secondary h-100 shadow-sm" style="border-radius: 12px; overflow: hidden;">
                                <div class="card-header border-secondary d-flex justify-content-between align-items-center bg-black bg-opacity-25 py-2">
                                    <span class="badge" style="background: var(--primary-color, #d4b895); color: #000; font-weight: 700;">
                                        <%= p.parasha_number ? `Nº ${p.parasha_number}` : 'Parashá' %>
                                    </span>
                                    <div class="d-flex gap-2">
                                        <span class="badge bg-dark border border-secondary text-white-50">
                                            <i class="bi bi-book me-1"></i> <%= p.total_aliyot || 0 %>/7
                                        </span>
                                        <span class="badge <%= (p.audios_count && p.audios_count > 0) ? 'bg-success' : 'bg-secondary' %>">
                                            <i class="bi bi-volume-up me-1"></i> <%= p.audios_count || 0 %>/7
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title mb-1 text-truncate" style="color: #fff; font-weight: 600;"><%= p.title %></h5>
                                    <% if (p.subtitle) { %>
                                        <p class="card-text text-white-50 small mb-2 text-truncate"><%= p.subtitle %></p>
                                    <% } %>

                                    <div class="mt-2 mb-3">
                                        <div class="d-flex justify-content-between small text-white-50 mb-1" style="font-size: 0.78rem;">
                                            <span>Completado:</span>
                                            <span><%= Math.round(((p.total_aliyot || 0) / 7) * 100) %>%</span>
                                        </div>
                                        <div class="progress" style="height: 6px; background-color: rgba(255,255,255,0.1);">
                                            <div class="progress-bar" role="progressbar" 
                                                 style="width: <%= ((p.total_aliyot || 0) / 7) * 100 %>%; background-color: var(--primary-color, #d4b895);" 
                                                 aria-valuenow="<%= p.total_aliyot || 0 %>" aria-valuemin="0" aria-valuemax="7"></div>
                                        </div>
                                    </div>

                                    <div class="mt-auto pt-2 border-top border-secondary d-flex gap-2">
                                        <a href="/admin/aliyot/edit/<%= p.id %>" class="btn btn-sm w-100 fw-bold d-flex align-items-center justify-content-center gap-1" style="background: var(--primary-color, #d4b895); color: #1a1a1a;">
                                            <i class="bi bi-pencil-square"></i> Cargar 7 Aliyot
                                        </a>
                                        <a href="/parashot/<%= p.id %>" target="_blank" class="btn btn-sm btn-outline-secondary" title="Ver en la Web">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>

    </div>
</main>

<!-- ============================================== -->
<!-- MODAL: CREAR NUEVA ALIYÁ (LECTURA DIARIA) -->
<!-- ============================================== -->
<div class="modal fade" id="createAliyahModal" tabindex="-1" aria-labelledby="createAliyahModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content bg-dark text-white border-secondary" style="border-radius: 14px;">
            <div class="modal-header border-secondary bg-black bg-opacity-25">
                <h5 class="modal-title" id="createAliyahModalLabel"><i class="bi bi-plus-circle text-success me-2"></i>Cargar Nueva Aliyá (Lectura Diaria)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form action="/admin/aliyot/create" method="POST" enctype="multipart/form-data" id="createAliyahModalForm">
                    <div class="row g-3">
                        <!-- Parashá Asociada -->
                        <div class="col-md-6">
                            <label class="form-label small text-white-50 fw-bold">Parashá Asociada</label>
                            <select name="parasha_id" class="form-select bg-black bg-opacity-50 text-white border-secondary">
                                <option value="">-- Sin vincular (Asignar cuando se suba la Parashá) --</option>
                                <% if (typeof parashot !== 'undefined' && parashot.length > 0) { %>
                                    <% parashot.forEach(p => { %>
                                        <option value="<%= p.id %>">
                                            <%= p.parasha_number ? `Nº ${p.parasha_number} - ` : '' %><%= p.title %>
                                        </option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>

                        <!-- Número de Aliyá / Día -->
                        <div class="col-md-6">
                            <label class="form-label small text-white-50 fw-bold">Día de la Lectura</label>
                            <select name="aliyah_number" class="form-select bg-black bg-opacity-50 text-white border-secondary" required>
                                <option value="1">1ª Aliyá (Domingo - Día 1)</option>
                                <option value="2">2ª Aliyá (Lunes - Día 2)</option>
                                <option value="3">3ª Aliyá (Martes - Día 3)</option>
                                <option value="4">4ª Aliyá (Miércoles - Día 4)</option>
                                <option value="5">5ª Aliyá (Jueves - Día 5)</option>
                                <option value="6">6ª Aliyá (Viernes - Día 6)</option>
                                <option value="7">7ª Aliyá (Shabat - Día 7)</option>
                            </select>
                        </div>

                        <!-- Título -->
                        <div class="col-md-6">
                            <label class="form-label small text-white-50 fw-bold">Título de la Aliyá</label>
                            <input type="text" name="title" class="form-control bg-black bg-opacity-50 text-white border-secondary" placeholder="Ej: 1ª Aliyá - Domingo" required>
                        </div>

                        <!-- Referencia de Versículos -->
                        <div class="col-md-6">
                            <label class="form-label small text-white-50 fw-bold">Referencia de Versículos (Cita Bíblica)</label>
                            <input type="text" name="verses_reference" class="form-control bg-black bg-opacity-50 text-white border-secondary" placeholder="Ej: Génesis 1:1 - 2:3">
                        </div>

                        <!-- SECCIÓN DE AUDIOS DINÁMICA (Múltiples archivos y notas de voz) -->
                        <div class="col-12">
                            <div class="p-3 rounded border border-secondary" style="background: rgba(255, 255, 255, 0.03);">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <label class="form-label fw-bold text-white d-flex align-items-center gap-2 mb-0">
                                        <i class="bi bi-soundwave" style="color: var(--primary-color, #d4b895); font-size: 1.2rem;"></i>
                                        Archivos de Audio de la Aliyá
                                    </label>
                                    <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-50">
                                        WhatsApp, MP3, OGG, M4A, WAV
                                    </span>
                                </div>
                                <p class="text-white-50 small mb-3">Puedes cargar uno o varios audios a la vez (lectura, comentarios, notas de voz de WhatsApp).</p>

                                <!-- Contenedor de filas de audios -->
                                <div id="modalAudioRowsContainer" class="d-flex flex-column gap-2">
                                    <div class="audio-input-row p-2 rounded bg-black bg-opacity-50 border border-secondary">
                                        <div class="row g-2 align-items-center">
                                            <div class="col-md-6">
                                                <label class="form-label small text-white-50 mb-1">Archivo 1</label>
                                                <input type="file" name="audio_files" class="form-control form-control-sm bg-dark text-white border-secondary aliyah-file-input" accept="audio/*,.mp3,.ogg,.oga,.opus,.m4a,.wav,.aac" multiple>
                                            </div>
                                            <div class="col-md-5">
                                                <label class="form-label small text-white-50 mb-1">Título / Nombre (opcional)</label>
                                                <input type="text" name="audio_titles[]" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Ej: Audio 1 / Lectura del día">
                                            </div>
                                            <div class="col-md-1 text-center pt-3">
                                                <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row d-none" title="Eliminar fila">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3 pt-2 border-top border-secondary">
                                    <button type="button" id="btnAddAudioInputRow" class="btn btn-sm btn-outline-warning d-flex align-items-center gap-1">
                                        <i class="bi bi-plus-circle-fill"></i> + Agregar otro archivo de audio
                                    </button>
                                    <small class="text-white-50">Puedes presionar el botón para añadir más audios por separado</small>
                                </div>

                                <!-- Audio externo opcional -->
                                <div class="mt-3 pt-2 border-top border-secondary">
                                    <label class="form-label small text-white-50 fw-bold mb-1">O enlace de audio externo (opcional)</label>
                                    <div class="input-group input-group-sm">
                                        <input type="text" name="custom_audio_title" class="form-control bg-black bg-opacity-50 text-white border-secondary" placeholder="Título (Ej: Reflexión)" style="max-width: 140px;">
                                        <input type="text" name="custom_audio_url" class="form-control bg-black bg-opacity-50 text-white border-secondary" placeholder="https://.../audio.mp3">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- EDITOR DE VERSÍCULOS EN 3 VERSIONES (Español, Hebreo, Fonética) -->
                        <div class="col-12">
                            <div class="p-3 rounded border border-secondary" style="background: rgba(255, 255, 255, 0.02);">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                    <label class="form-label small text-white fw-bold mb-0">
                                        <i class="bi bi-book me-1" style="color: var(--primary-color, #d4b895);"></i>
                                        Lectura en 3 Versiones: Español, Hebreo y Fonética
                                    </label>
                                    <div class="d-flex gap-2">
                                        <button type="button" id="btnAutoFetchVersesModal" class="btn btn-sm btn-outline-info d-flex align-items-center gap-1" title="Obtener texto en hebreo y traducción según la cita bíblica">
                                            <i class="bi bi-cloud-arrow-down"></i> Auto-Obtener Versículos
                                        </button>
                                        <button type="button" id="btnAutoTransliterateModal" class="btn btn-sm btn-outline-warning d-flex align-items-center gap-1" title="Convertir automáticamente el texto hebreo a fonética en español">
                                            <i class="bi bi-magic"></i> Hebreo ➔ Fonética
                                        </button>
                                    </div>
                                </div>

                                <!-- Pestañas de las 3 versiones -->
                                <ul class="nav nav-pills nav-fill mb-3 bg-black bg-opacity-50 p-1 rounded border border-secondary" id="modalLangTabs" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link active py-1 small fw-bold" id="modal-tab-es" data-bs-toggle="pill" data-bs-target="#modal-pane-es" type="button" role="tab">
                                            🇪🇸 1. Español (Traducción)
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link py-1 small fw-bold" id="modal-tab-he" data-bs-toggle="pill" data-bs-target="#modal-pane-he" type="button" role="tab">
                                            🇮🇱 2. Hebreo (עברית)
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link py-1 small fw-bold" id="modal-tab-fo" data-bs-toggle="pill" data-bs-target="#modal-pane-fo" type="button" role="tab">
                                            🗣️ 3. Fonética en Español
                                        </button>
                                    </li>
                                </ul>

                                <div class="tab-content" id="modalLangTabContent">
                                    <!-- Panel Español -->
                                    <div class="tab-pane fade show active" id="modal-pane-es" role="tabpanel">
                                        <label class="form-label small text-white-50">Texto o versículos en Español:</label>
                                        <div id="modal-quill-editor" style="height: 220px; background: #ffffff; color: #111; border-radius: 6px;"></div>
                                        <input type="hidden" name="content" id="modalAliyahContent">
                                    </div>

                                    <!-- Panel Hebreo -->
                                    <div class="tab-pane fade" id="modal-pane-he" role="tabpanel">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label class="form-label small text-white-50 mb-0">Texto bíblico en Hebreo (con o sin vocales):</label>
                                            <small class="text-warning">Dirección automática Derecha a Izquierda (RTL)</small>
                                        </div>
                                        <textarea name="content_hebrew" id="modalHebrewContent" class="form-control bg-black bg-opacity-50 text-white border-secondary" 
                                                  dir="rtl" style="height: 220px; font-size: 1.35rem; font-family: 'David Libre', 'Frank Ruhl Libre', 'Times New Roman', serif; line-height: 1.8;" 
                                                  placeholder="בְּרֵאשִׁית בָּרָא אֱלֹהִים אֵת הַשָּׁמַיִם וְאֵת הָאָרֶץ..."></textarea>
                                    </div>

                                    <!-- Panel Fonética -->
                                    <div class="tab-pane fade" id="modal-pane-fo" role="tabpanel">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label class="form-label small text-white-50 mb-0">Pronunciación / Transliteración Fonética en Español:</label>
                                            <small class="text-info">Puedes editarlo manualmente o pulsar "Hebreo ➔ Fonética"</small>
                                        </div>
                                        <textarea name="content_phonetic" id="modalPhoneticContent" class="form-control bg-black bg-opacity-50 text-white border-secondary" 
                                                  style="height: 220px; font-size: 1.1rem; font-family: 'Segoe UI', sans-serif; font-style: italic; line-height: 1.7;" 
                                                  placeholder="Bereshit bará Elohim et hashamayim ve'et ha'aretz..."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- FECHA Y ESTADO -->
                        <div class="col-md-6">
                            <label class="form-label small text-white-50">Fecha de lectura:</label>
                            <input type="date" name="reading_date" class="form-control bg-black bg-opacity-50 text-white border-secondary">
                        </div>
                        <div class="col-md-6 d-flex align-items-center mt-md-4 pt-md-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="is_published" value="1" id="modalPublish" checked>
                                <label class="form-check-label text-white small fw-bold" for="modalPublish">
                                    Publicar inmediatamente en la web
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end align-items-center gap-2 mt-4 pt-3 border-top border-secondary">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                        <button type="submit" class="btn btn-success fw-bold px-4">
                            <i class="bi bi-check-circle me-1"></i> Guardar Aliyá
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

