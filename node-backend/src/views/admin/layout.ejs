<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración - Hablemos de YHWH</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Montserrat:wght@300;400;600;700&display=swap"
        rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --primary-color: #d4b895;
            --primary-hover: #c4a47a;
            --dark-bg: #060606;
            --card-bg: #111111;
            --sidebar-width: 240px;
        }

        * {
            scrollbar-width: thin;
            scrollbar-color: rgba(212, 184, 149, 0.3) transparent;
        }

        body {
            background-color: var(--dark-bg);
            color: #ffffff;
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Ambient Background Effect */
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 20%, rgba(212, 184, 149, 0.04) 0%, transparent 50%),
                        radial-gradient(circle at 80% 80%, rgba(212, 184, 149, 0.02) 0%, transparent 50%);
            pointer-events: none;
            z-index: -1;
        }

        .admin-layout-wrapper {
            display: flex !important;
            flex-direction: row !important;
            width: 100% !important;
            min-height: 100vh !important;
            align-items: stretch !important;
            position: relative !important;
        }

        .sidebar {
            width: 255px !important;
            min-width: 255px !important;
            max-width: 255px !important;
            flex: 0 0 255px !important;
            height: 100vh !important;
            min-height: 100vh !important;
            max-height: 100vh !important;
            position: sticky !important;
            top: 0 !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            background: var(--card-bg) !important;
            border-right: 1px solid rgba(255, 255, 255, 0.08) !important;
            padding: 18px 12px !important;
            z-index: 100 !important;
        }

        .sidebar .brand {
            text-align: center;
            padding-bottom: 12px;
            margin-bottom: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .sidebar .brand img {
            max-height: 40px;
            border-radius: 50%;
        }

        .sidebar .brand h5 {
            color: var(--primary-color);
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 0;
        }

        .sidebar a {
            color: rgba(255, 255, 255, 0.65);
            text-decoration: none;
            display: flex;
            align-items: center;
            padding: 8px 12px;
            margin-bottom: 2px;
            border-radius: 8px;
            transition: all 0.2s ease;
            font-size: 0.82rem;
            font-weight: 500;
        }

        .sidebar a i {
            margin-right: 9px;
            font-size: 15px;
            width: 18px;
            text-align: center;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: rgba(212, 184, 149, 0.12);
            color: var(--primary-color);
            transform: translateX(2px);
        }

        .sidebar a.text-danger:hover {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }

        /* Accordion Menu Styles */
        .sidebar-accordion-group {
            margin-bottom: 8px;
        }
        .sidebar-accordion-btn {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 8px;
            color: rgba(255, 255, 255, 0.85);
            padding: 8px 10px;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            transition: all 0.25s ease;
            cursor: pointer;
        }
        .sidebar-accordion-btn:hover {
            background: rgba(212, 184, 149, 0.12);
            border-color: rgba(212, 184, 149, 0.3);
            color: var(--primary-color);
        }
        .sidebar-accordion-btn:not(.collapsed) {
            background: rgba(212, 184, 149, 0.1);
            border-color: rgba(212, 184, 149, 0.25);
            color: var(--primary-color);
        }
        .sidebar-accordion-btn .acc-arrow {
            font-size: 0.68rem;
            transition: transform 0.3s ease;
            color: rgba(255, 255, 255, 0.4);
        }
        .sidebar-accordion-btn:not(.collapsed) .acc-arrow {
            transform: rotate(180deg);
            color: var(--primary-color);
        }
        .sidebar-accordion-content {
            border-left: 2px solid rgba(212, 184, 149, 0.25);
            margin-left: 8px;
            padding-left: 6px;
            padding-top: 4px;
            padding-bottom: 4px;
        }
        .sidebar-accordion-content a {
            padding: 7px 10px;
            font-size: 0.8rem;
        }

        .main-content {
            flex: 1 1 0% !important;
            min-width: 0 !important;
            width: auto !important;
            max-width: 100% !important;
            padding: 25px 30px !important;
            min-height: 100vh !important;
            overflow-x: hidden !important;
        }

        .form-control, .form-select {
            background: rgba(255, 255, 255, 0.08) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            color: #ffffff !important;
            transition: all 0.3s ease;
        }

        .form-control:focus, .form-select:focus {
            background: rgba(255, 255, 255, 0.12) !important;
            border-color: var(--primary-color) !important;
            box-shadow: 0 0 0 0.2rem rgba(212, 184, 149, 0.2) !important;
            color: #ffffff !important;
        }

        /* Opciones desplegables visibles con fondo oscuro y texto claro legible */
        select option,
        select optgroup,
        .form-select option,
        .form-select optgroup,
        .form-control option {
            background-color: #181818 !important;
            color: #ffffff !important;
            padding: 8px 12px !important;
        }

        select option:checked,
        .form-select option:checked {
            background-color: #332a1e !important;
            color: #f0c987 !important;
            font-weight: bold;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.55) !important;
        }

        .btn-primary {
            background: var(--primary-color);
            border-color: var(--primary-color);
            color: #111;
            font-weight: 600;
        }
        .btn-primary:hover {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
            color: #111;
        }

        .table-dark {
            --bs-table-bg: rgba(255, 255, 255, 0.03);
            --bs-table-border-color: rgba(255, 255, 255, 0.06);
        }

        .table-dark thead th {
            background: rgba(212, 184, 149, 0.08);
            color: var(--primary-color);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid rgba(212, 184, 149, 0.15);
        }

        .modal-content.bg-dark {
            background: #1a1a1a !important;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Mantener todos los modales del backend dentro del viewport. Cuando
           un formulario envuelve el body (como en Semillas de Torah), también
           debe participar del layout flex para que Bootstrap pueda desplazarlo. */
        .modal-dialog {
            max-height: calc(100dvh - 2rem);
            margin-top: 1rem;
            margin-bottom: 1rem;
        }

        .modal-dialog > .modal-content {
            max-height: calc(100dvh - 2rem);
            overflow: hidden;
        }

        .modal-content > form {
            display: flex;
            flex-direction: column;
            min-height: 0;
            max-height: calc(100dvh - 2rem);
            overflow: hidden;
        }

        .modal-content > .modal-body,
        .modal-content > form > .modal-body {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: scroll !important;
            overflow-x: hidden;
            overscroll-behavior: contain;
            scrollbar-gutter: stable;
        }

        .modal-content > .modal-header,
        .modal-content > .modal-footer,
        .modal-content > form > .modal-header,
        .modal-content > form > .modal-footer {
            flex: 0 0 auto;
        }

        @media (max-width: 576px), (max-height: 640px) {
            .modal-dialog {
                max-height: calc(100dvh - 1rem);
                margin: 0.5rem;
            }

            .modal-dialog > .modal-content,
            .modal-content > form {
                max-height: calc(100dvh - 1rem);
            }
        }

        .card-stat {
            background: linear-gradient(135deg, rgba(212, 184, 149, 0.08), rgba(212, 184, 149, 0.02));
            border: 1px solid rgba(212, 184, 149, 0.1);
            border-radius: 12px;
            padding: 20px;
            transition: transform 0.3s ease;
        }
        .card-stat:hover {
            transform: translateY(-3px);
        }
        .card-stat .stat-icon {
            width: 45px;
            height: 45px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(212, 184, 149, 0.15);
            color: var(--primary-color);
            font-size: 1.2rem;
        }

        .page-header {
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            padding-bottom: 15px;
            margin-bottom: 25px;
        }

        .page-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .nav-pills .nav-link {
            color: rgba(255, 255, 255, 0.5);
            font-weight: 500;
            font-size: 0.85rem;
            border-radius: 8px;
            padding: 8px 16px;
            transition: all 0.3s ease;
        }
        .nav-pills .nav-link.active {
            background: var(--primary-color);
            color: #111;
        }
        .nav-pills .nav-link:hover:not(.active) {
            color: var(--primary-color);
        }
        .btn-open-share {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .btn-open-share:hover {
            transform: scale(1.08);
            box-shadow: 0 4px 12px rgba(25, 135, 84, 0.4) !important;
        }

        /* Mobile Header */
        .admin-mobile-header {
            min-height: 56px;
            background: #111111;
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        /* Backdrop */
        .sidebar-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(3px);
            z-index: 1040;
            opacity: 0;
            transition: opacity 0.25s ease;
        }
        .sidebar-backdrop.show {
            display: block;
            opacity: 1;
        }

        /* Responsive Sidebar Drawer for Mobile & Tablet */
        @media (max-width: 991.98px) {
            .admin-layout-wrapper {
                flex-direction: column !important;
                width: 100% !important;
                overflow-x: hidden !important;
            }
            .sidebar {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                width: min(320px, 90vw) !important;
                min-width: 0 !important;
                max-width: 90vw !important;
                height: 100vh !important;
                height: 100dvh !important;
                min-height: 0 !important;
                max-height: 100dvh !important;
                overscroll-behavior: contain;
                z-index: 1050 !important;
                transform: translateX(-105%) !important;
                visibility: hidden !important;
                pointer-events: none !important;
                transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.28s ease !important;
                box-shadow: none !important;
            }
            .sidebar.show {
                transform: translateX(0) !important;
                visibility: visible !important;
                pointer-events: auto !important;
                box-shadow: 6px 0 24px rgba(0, 0, 0, 0.85) !important;
            }
            .main-content {
                width: 100% !important;
                max-width: 100% !important;
                flex: 1 1 auto !important;
                padding: 16px 12px !important;
                min-height: calc(100vh - 56px) !important;
                min-height: calc(100dvh - 56px) !important;
            }
            .main-content .page-header,
            .main-content .tab-pane > .d-flex.justify-content-between,
            .main-content .alert.d-flex.justify-content-between {
                flex-wrap: wrap;
                gap: 1rem;
            }
            .main-content .tab-pane > .d-flex.justify-content-between > *,
            .main-content .alert.d-flex.justify-content-between > * {
                min-width: 0;
                max-width: 100%;
            }
            .main-content .tab-pane > .d-flex.justify-content-between > .d-flex,
            .main-content .alert > .d-flex.gap-2 {
                flex-wrap: wrap;
            }
            .main-content .table-responsive {
                max-width: 100%;
                overflow-x: auto;
            }
            .main-content .table-responsive table {
                min-width: 640px;
            }
            .main-content .nav-pills {
                flex-wrap: nowrap;
                overflow-x: auto;
                padding-bottom: 8px;
            }
            .main-content .nav-pills .nav-link {
                white-space: nowrap;
            }
            .sidebar a, #sidebarCloseBtn, #sidebarToggle {
                min-height: 44px;
            }
            .main-content { overflow-wrap: break-word; }
            .main-content .table-responsive th,
            .main-content .table-responsive td {
                overflow-wrap: normal;
                word-break: normal;
            }
            .main-content > .row:has(.card-stat) {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 12px;
                margin: 0 0 24px;
            }
            .main-content > .row:has(.card-stat) > .col-md {
                width: auto !important;
                padding: 0;
                margin: 0;
                min-width: 0;
            }
            .card-stat { height: 100%; }
            .card-stat .stat-icon { flex-shrink: 0; }
            .card-stat > div:last-child { min-width: 0; }
        }
        @media (max-width: 767.98px) {
            .main-content .table-responsive:has([data-mobile-cards]) { overflow: visible; }
            .main-content table[data-mobile-cards] {
                display: block;
                min-width: 0;
                width: 100%;
            }
            table[data-mobile-cards] > thead {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip-path: inset(50%);
            }
            table[data-mobile-cards] > tbody { display: grid; gap: 14px; }
            table[data-mobile-cards] > tbody > tr {
                display: grid;
                grid-template-columns: minmax(0, 1fr);
                padding: 8px 14px;
                border: 1px solid rgba(212, 184, 149, 0.2);
                border-radius: 12px;
                background: #111;
            }
            table[data-mobile-cards] > tbody > tr > td {
                display: block;
                width: auto !important;
                min-width: 0;
                max-width: 100%;
                padding: 10px 0;
                text-align: left !important;
                background: transparent !important;
                box-shadow: none !important;
                white-space: normal !important;
                overflow-wrap: break-word !important;
            }
            table[data-mobile-cards] > tbody > tr > td:last-child { border-bottom: 0; }
            table[data-mobile-cards] > tbody > tr > td.mobile-card-cover {
                width: calc(100% + 28px) !important;
                max-width: none;
                margin: -8px -14px 0;
                padding: 0;
                border: 0;
            }
            table[data-mobile-cards] td.mobile-card-cover::before { display: none; }
            table[data-mobile-cards] td.mobile-card-cover img {
                display: block;
                width: 100% !important;
                height: auto !important;
                aspect-ratio: 16 / 9;
                object-fit: cover;
                border-radius: 11px 11px 0 0 !important;
            }
            table[data-mobile-cards] td.mobile-card-cover img[src*="/rosh-jodes/salmos81.png"] {
                object-fit: contain;
                background: #111;
            }
            table[data-mobile-cards] td.mobile-card-cover > a,
            table[data-mobile-cards] td.mobile-card-cover > div {
                display: block;
                width: 100% !important;
                height: auto !important;
                max-width: none !important;
            }
            table[data-mobile-cards] td[data-label]::before {
                content: attr(data-label);
                display: block;
                margin-bottom: 5px;
                color: var(--primary-color);
                font-size: 0.7rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }
            table[data-mobile-cards] td .text-truncate {
                white-space: normal;
                max-width: 100% !important;
            }
            table[data-mobile-cards] td .badge {
                white-space: normal;
                text-align: left;
                line-height: 1.4;
            }
            table[data-mobile-cards] td > .btn,
            table[data-mobile-cards] td > a.btn { margin-bottom: 4px; }
            .main-content .tab-pane > .d-flex.justify-content-between { align-items: stretch !important; }
            .main-content .tab-pane > .d-flex.justify-content-between > .d-flex {
                width: 100%;
                gap: 8px;
            }
            .main-content .tab-pane > .d-flex.justify-content-between > .d-flex > .btn {
                flex: 1 1 auto;
                white-space: normal;
            }
        }
        @media (max-width: 575.98px) {
            .main-content .card-stat { padding: 14px; }
            .main-content .page-header h1 { font-size: 1.25rem; }
            .main-content .row > .col-md:has(> .card-stat) { width: 50%; }
        }
        @media (prefers-reduced-motion: reduce) {
            .sidebar { transition: none !important; }
        }
    </style>
</head>

<body>
    <!-- Top Mobile Navigation Bar (Visible only on < 992px) -->
    <header class="admin-mobile-header d-lg-none d-flex align-items-center justify-content-between px-3 py-2 border-bottom border-white border-opacity-10 shadow-sm">
        <a href="/admin/dashboard" class="text-decoration-none text-white d-flex align-items-center gap-2">
            <img src="/assets/img/pagina/logo.svg" alt="Logo" class="img-fluid" style="max-height: 36px; border-radius: 50%;">
            <span class="fw-bold fs-6" style="color: var(--primary-color); letter-spacing: 0.5px;">ADMIN PANEL</span>
        </a>
        <button type="button" class="btn btn-warning btn-sm d-flex align-items-center gap-2 px-3 py-1 fw-bold text-dark shadow-sm" id="sidebarToggle" aria-label="Abrir Menú" aria-controls="adminSidebar" aria-expanded="false">
            <i class="bi bi-list fs-5"></i> <span>Menú</span>
        </button>
    </header>

    <!-- Dark Backdrop for Mobile Sidebar -->
    <div id="sidebarBackdrop" class="sidebar-backdrop"></div>

    <div class="admin-layout-wrapper">
        <%- body %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <%- include('partials/_share_modal') %>

    <!-- Global Mobile Sidebar Toggle Script -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Reuse the same records and actions as readable cards on small screens.
        if (document.getElementById('pills-tab')) {
            document.querySelectorAll('.main-content .table-responsive table').forEach(table => {
                const headings = Array.from(table.querySelectorAll('thead th')).map(th => th.textContent.trim());
                if (!headings.length) return;
                table.setAttribute('data-mobile-cards', '');
                table.querySelectorAll('tbody > tr').forEach(row => {
                    let column = 0;
                    Array.from(row.children).forEach(cell => {
                        if (cell.colSpan === 1 && headings[column]) cell.dataset.label = headings[column];
                        if (column === 0 && /imagen|foto|portada|carátula|miniatura/i.test(headings[column] || '') && cell.querySelector('img')) {
                            cell.classList.add('mobile-card-cover');
                        }
                        column += cell.colSpan;
                    });
                });
            });
        }
        const sidebar = document.getElementById('adminSidebar') || document.querySelector('.sidebar');
        const toggleBtn = document.getElementById('sidebarToggle');
        const closeBtn = document.getElementById('sidebarCloseBtn');
        const backdrop = document.getElementById('sidebarBackdrop');
        const mobileViewport = window.matchMedia('(max-width: 991.98px)');
        const main = document.querySelector('.main-content');
        let previousOverflow = '';
        let isOpen = false;

        function syncSidebarAccessibility() {
            if (sidebar) sidebar.inert = mobileViewport.matches && !isOpen;
            if (main) main.inert = mobileViewport.matches && isOpen;
            if (toggleBtn) toggleBtn.setAttribute('aria-expanded', String(isOpen));
        }

        function openSidebar() {
            if (!sidebar || !mobileViewport.matches || isOpen) return;
            previousOverflow = document.body.style.overflow;
            isOpen = true;
            if (sidebar) sidebar.classList.add('show');
            if (backdrop) backdrop.classList.add('show');
            document.body.style.overflow = 'hidden';
            syncSidebarAccessibility();
            if (closeBtn) closeBtn.focus();
        }

        function closeSidebar() {
            const wasOpen = isOpen;
            isOpen = false;
            if (sidebar) sidebar.classList.remove('show');
            if (backdrop) backdrop.classList.remove('show');
            if (wasOpen) document.body.style.overflow = previousOverflow;
            syncSidebarAccessibility();
            if (wasOpen && mobileViewport.matches && toggleBtn) toggleBtn.focus();
        }

        syncSidebarAccessibility();
        mobileViewport.addEventListener('change', closeSidebar);
        document.addEventListener('keydown', function(event) {
            if (!isOpen) return;
            if (event.key === 'Escape') closeSidebar();
            if (event.key !== 'Tab') return;
            const focusable = Array.from(sidebar.querySelectorAll('a[href], button, input, select, textarea, [tabindex="0"]'))
                .filter(element => !element.disabled && element.getClientRects().length);
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
            }
        });

        // Expose globally so tabs, modals or links can invoke it
        window.closeAdminSidebar = closeSidebar;
        window.openAdminSidebar = openSidebar;

        if (toggleBtn) toggleBtn.addEventListener('click', openSidebar);
        if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
        if (backdrop) backdrop.addEventListener('click', closeSidebar);

        // Auto close sidebar when clicking any link inside it on mobile
        if (sidebar) {
            sidebar.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', function() {
                    if (window.innerWidth < 992) {
                        closeSidebar();
                        const main = document.querySelector('.main-content');
                        if (main) {
                            setTimeout(() => {
                                main.scrollIntoView({ behavior: 'smooth' });
                            }, 100);
                        }
                    }
                });
            });
        }

        // Auto-expand accordion that contains the active link
        function syncAccordionWithActive() {
            document.querySelectorAll('.sidebar-accordion-group').forEach(group => {
                if (group.querySelector('a.active')) {
                    const collapseEl = group.querySelector('.collapse');
                    if (collapseEl && !collapseEl.classList.contains('show')) {
                        const btn = group.querySelector('.sidebar-accordion-btn');
                        if (btn) btn.classList.remove('collapsed');
                        collapseEl.classList.add('show');
                    }
                }
            });
        }
        syncAccordionWithActive();
        window.addEventListener('hashchange', syncAccordionWithActive);
    });
    </script>
