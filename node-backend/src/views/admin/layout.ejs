<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración - Hablemos de YHWH</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Montserrat:wght@300;400;600;700&display=swap"
        rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --primary-color: #d4b895;
            --primary-hover: #c4a47a;
            --dark-bg: #060606;
            --card-bg: #111111;
            --sidebar-width: 240px;
        }

        * {
            scrollbar-width: thin;
            scrollbar-color: rgba(212, 184, 149, 0.3) transparent;
        }

        body {
            background-color: var(--dark-bg);
            color: #ffffff;
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Ambient Background Effect */
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 20%, rgba(212, 184, 149, 0.04) 0%, transparent 50%),
                        radial-gradient(circle at 80% 80%, rgba(212, 184, 149, 0.02) 0%, transparent 50%);
            pointer-events: none;
            z-index: -1;
        }

        .sidebar {
            background: var(--card-bg);
            min-height: 100vh;
            border-right: 1px solid rgba(255, 255, 255, 0.05);
            padding: 20px 15px;
            position: sticky;
            top: 0;
            max-height: 100vh;
            overflow-y: auto;
        }

        .sidebar .brand {
            text-align: center;
            padding-bottom: 15px;
            margin-bottom: 15px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .sidebar .brand img {
            max-height: 50px;
            border-radius: 50%;
            margin-bottom: 8px;
        }

        .sidebar .brand h5 {
            color: var(--primary-color);
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 0;
        }

        .sidebar .nav-label {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255, 255, 255, 0.3);
            padding: 15px 15px 5px;
            font-weight: 600;
        }

        .sidebar a {
            color: rgba(255, 255, 255, 0.55);
            text-decoration: none;
            display: flex;
            align-items: center;
            padding: 10px 15px;
            margin-bottom: 2px;
            border-radius: 8px;
            transition: all 0.25s ease;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .sidebar a i {
            margin-right: 10px;
            font-size: 16px;
            width: 20px;
            text-align: center;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: rgba(212, 184, 149, 0.1);
            color: var(--primary-color);
            transform: translateX(3px);
        }

        .sidebar a.text-danger:hover {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }

        .main-content {
            padding: 25px 30px;
            min-height: 100vh;
        }

        .form-control, .form-select {
            background: rgba(255, 255, 255, 0.08) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            color: #ffffff !important;
            transition: all 0.3s ease;
        }

        .form-control:focus, .form-select:focus {
            background: rgba(255, 255, 255, 0.12) !important;
            border-color: var(--primary-color) !important;
            box-shadow: 0 0 0 0.2rem rgba(212, 184, 149, 0.2) !important;
            color: #ffffff !important;
        }

        /* Opciones desplegables visibles con fondo oscuro y texto claro legible */
        select option,
        select optgroup,
        .form-select option,
        .form-select optgroup,
        .form-control option {
            background-color: #181818 !important;
            color: #ffffff !important;
            padding: 8px 12px !important;
        }

        select option:checked,
        .form-select option:checked {
            background-color: #332a1e !important;
            color: #f0c987 !important;
            font-weight: bold;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.55) !important;
        }

        .btn-primary {
            background: var(--primary-color);
            border-color: var(--primary-color);
            color: #111;
            font-weight: 600;
        }
        .btn-primary:hover {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
            color: #111;
        }

        .table-dark {
            --bs-table-bg: rgba(255, 255, 255, 0.03);
            --bs-table-border-color: rgba(255, 255, 255, 0.06);
        }

        .table-dark thead th {
            background: rgba(212, 184, 149, 0.08);
            color: var(--primary-color);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid rgba(212, 184, 149, 0.15);
        }

        .modal-content.bg-dark {
            background: #1a1a1a !important;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Mantener todos los modales del backend dentro del viewport. Cuando
           un formulario envuelve el body (como en Semillas de Torah), también
           debe participar del layout flex para que Bootstrap pueda desplazarlo. */
        .modal-dialog {
            max-height: calc(100dvh - 2rem);
            margin-top: 1rem;
            margin-bottom: 1rem;
        }

        .modal-dialog > .modal-content {
            max-height: calc(100dvh - 2rem);
            overflow: hidden;
        }

        .modal-content > form {
            display: flex;
            flex-direction: column;
            min-height: 0;
            max-height: calc(100dvh - 2rem);
            overflow: hidden;
        }

        .modal-content > .modal-body,
        .modal-content > form > .modal-body {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: scroll !important;
            overflow-x: hidden;
            overscroll-behavior: contain;
            scrollbar-gutter: stable;
        }

        .modal-content > .modal-header,
        .modal-content > .modal-footer,
        .modal-content > form > .modal-header,
        .modal-content > form > .modal-footer {
            flex: 0 0 auto;
        }

        @media (max-width: 576px), (max-height: 640px) {
            .modal-dialog {
                max-height: calc(100dvh - 1rem);
                margin: 0.5rem;
            }

            .modal-dialog > .modal-content,
            .modal-content > form {
                max-height: calc(100dvh - 1rem);
            }
        }

        .card-stat {
            background: linear-gradient(135deg, rgba(212, 184, 149, 0.08), rgba(212, 184, 149, 0.02));
            border: 1px solid rgba(212, 184, 149, 0.1);
            border-radius: 12px;
            padding: 20px;
            transition: transform 0.3s ease;
        }
        .card-stat:hover {
            transform: translateY(-3px);
        }
        .card-stat .stat-icon {
            width: 45px;
            height: 45px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(212, 184, 149, 0.15);
            color: var(--primary-color);
            font-size: 1.2rem;
        }

        .page-header {
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            padding-bottom: 15px;
            margin-bottom: 25px;
        }

        .page-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .nav-pills .nav-link {
            color: rgba(255, 255, 255, 0.5);
            font-weight: 500;
            font-size: 0.85rem;
            border-radius: 8px;
            padding: 8px 16px;
            transition: all 0.3s ease;
        }
        .nav-pills .nav-link.active {
            background: var(--primary-color);
            color: #111;
        }
        .nav-pills .nav-link:hover:not(.active) {
            color: var(--primary-color);
        }
        .btn-open-share {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .btn-open-share:hover {
            transform: scale(1.08);
            box-shadow: 0 4px 12px rgba(25, 135, 84, 0.4) !important;
        }

        /* Mobile Header */
        .admin-mobile-header {
            min-height: 56px;
            background: #111111;
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        /* Backdrop */
        .sidebar-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(3px);
            z-index: 1040;
            opacity: 0;
            transition: opacity 0.25s ease;
        }
        .sidebar-backdrop.show {
            display: block;
            opacity: 1;
        }

        /* Responsive Sidebar Drawer for Mobile & Tablet */
        @media (max-width: 991.98px) {
            .sidebar {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                width: 290px !important;
                max-width: 85vw !important;
                height: 100vh !important;
                min-height: 100vh !important;
                max-height: 100vh !important;
                z-index: 1050 !important;
                transform: translateX(-100%);
                transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                box-shadow: 6px 0 24px rgba(0, 0, 0, 0.85);
            }
            .sidebar.show {
                transform: translateX(0) !important;
            }
            .main-content {
                width: 100% !important;
                max-width: 100% !important;
                flex: 0 0 100% !important;
                padding: 16px 12px !important;
                min-height: calc(100vh - 56px);
            }
        }
    </style>
</head>

<body>
    <!-- Top Mobile Navigation Bar (Visible only on < 992px) -->
    <header class="admin-mobile-header d-lg-none d-flex align-items-center justify-content-between px-3 py-2 border-bottom border-white border-opacity-10 shadow-sm">
        <a href="/admin/dashboard" class="text-decoration-none text-white d-flex align-items-center gap-2">
            <img src="/assets/img/pagina/logo.svg" alt="Logo" class="img-fluid" style="max-height: 36px; border-radius: 50%;">
            <span class="fw-bold fs-6" style="color: var(--primary-color); letter-spacing: 0.5px;">ADMIN PANEL</span>
        </a>
        <button type="button" class="btn btn-outline-warning btn-sm d-flex align-items-center gap-2 px-3 py-1 fw-bold shadow-sm" id="sidebarToggle" aria-label="Abrir Menú">
            <i class="bi bi-list fs-5"></i> <span>Menú</span>
        </button>
    </header>

    <!-- Dark Backdrop for Mobile Sidebar -->
    <div id="sidebarBackdrop" class="sidebar-backdrop"></div>

    <div class="container-fluid">
        <div class="row">
            <%- body %>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <%- include('partials/_share_modal') %>

    <!-- Global Mobile Sidebar Toggle Script -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const sidebar = document.getElementById('adminSidebar') || document.querySelector('.sidebar');
        const toggleBtn = document.getElementById('sidebarToggle');
        const closeBtn = document.getElementById('sidebarCloseBtn');
        const backdrop = document.getElementById('sidebarBackdrop');

        function openSidebar() {
            if (sidebar) sidebar.classList.add('show');
            if (backdrop) backdrop.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeSidebar() {
            if (sidebar) sidebar.classList.remove('show');
            if (backdrop) backdrop.classList.remove('show');
            document.body.style.overflow = '';
        }

        if (toggleBtn) toggleBtn.addEventListener('click', openSidebar);
        if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
        if (backdrop) backdrop.addEventListener('click', closeSidebar);

        // Auto close sidebar when clicking any link inside it on mobile
        if (sidebar) {
            sidebar.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', function() {
                    if (window.innerWidth < 992) {
                        closeSidebar();
                        const main = document.querySelector('.main-content');
                        if (main) {
                            setTimeout(() => {
                                main.scrollIntoView({ behavior: 'smooth' });
                            }, 100);
                        }
                    }
                });
            });
        }
    });
    </script>
</body>

</html>
