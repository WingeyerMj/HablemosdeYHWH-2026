<!-- Sidebar -->
<%- include('partials/_sidebar') %>

<main class="col-md-10 main-content">
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-camera-reels-fill me-2" style="color: #38bdf8;"></i>Editar Short / Aliyá Infantil</h1>
            <p class="text-white-50 mb-0">Editando: <strong><%= item.title %></strong></p>
        </div>
        <a href="/admin/dashboard#admin-semillas-shorts" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>

    <form action="/admin/semillas-shorts/update" method="POST" enctype="multipart/form-data" id="editSemillasShortForm">
        <input type="hidden" name="id" value="<%= item.id %>">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small text-info fw-bold"><i class="bi bi-tags-fill me-1"></i>Tipo de Short *</label>
                <select name="short_type" id="edit_short_type" class="form-select bg-dark text-white border-info fw-semibold" onchange="const isG = this.value === 'general'; document.getElementById('edit_short_cat_box').style.display = isG ? 'block' : 'none'; document.getElementById('edit_short_parasha_box').style.display = isG ? 'none' : 'block'; document.getElementById('edit_short_aliya_box').style.display = isG ? 'none' : 'block';">
                    <option value="aliya" <%= (item.short_type === 'aliya' || !item.short_type) ? 'selected' : '' %>>📖 Aliyá con Niños (Lectura Semanal)</option>
                    <option value="general" <%= item.short_type === 'general' ? 'selected' : '' %>>🌟 Short General / Temas Diversos (Historias, Reflexión, Valores)</option>
                </select>
            </div>
            <div class="col-md-6" id="edit_short_cat_box" style="<%= item.short_type === 'general' ? '' : 'display: none;' %>">
                <label class="form-label small text-warning fw-semibold"><i class="bi bi-bookmark-star me-1"></i>Tema / Categoría</label>
                <input type="text" name="category" class="form-control" value="<%= item.category || 'Temas Diversos' %>" placeholder="Ej: Historia Bíblica, Valores, Canción, Reflexión">
            </div>
            <div class="col-md-6">
                <label class="form-label small text-white-50">Título del Short *</label>
                <input type="text" name="title" class="form-control" required value="<%= item.title %>">
            </div>
            <div class="col-md-6">
                <label class="form-label small text-white-50">Niño(s) Participante(s) (Opcional)</label>
                <input type="text" name="child_name" class="form-control" value="<%= item.child_name || '' %>" placeholder="Ej: Lucas (6 años)">
            </div>

            <div class="col-md-5" id="edit_short_parasha_box" style="<%= item.short_type === 'general' ? 'display: none;' : '' %>">
                <label class="form-label small text-warning fw-semibold"><i class="bi bi-book me-1"></i>Parashá Relacionada</label>
                <select name="parasha_name" class="form-select bg-dark text-white border-secondary">
                    <option value="">-- Seleccionar Parashá --</option>
                    <% if (typeof parashot !== 'undefined' && parashot && parashot.length > 0) { %>
                        <% 
                            const sortedParashot = [...parashot].sort((a, b) => (Number(a.parasha_number) || 999) - (Number(b.parasha_number) || 999));
                            sortedParashot.forEach(p => { 
                                const isSelected = item.parasha_name && (item.parasha_name.trim().toLowerCase() === p.title.trim().toLowerCase() || item.parasha_name.toLowerCase().includes(p.title.toLowerCase()));
                        %>
                            <option value="<%= p.title %>" <%= isSelected ? 'selected' : '' %>>
                                #<%= p.parasha_number || '' %> <%= p.title %> <%= p.subtitle ? `(${p.subtitle})` : '' %>
                            </option>
                        <% }) %>
                    <% } %>
                </select>
            </div>
            <div class="col-md-3" id="edit_short_aliya_box" style="<%= item.short_type === 'general' ? 'display: none;' : '' %>">
                <label class="form-label small text-white-50">Nº de Aliyá (1-7)</label>
                <select name="aliyah_number" class="form-select bg-dark text-white border-secondary">
                    <% for(let i = 1; i <= 7; i++) { %>
                        <option value="<%= i %>" <%= item.aliyah_number == i ? 'selected' : '' %>><%= i %>ª Aliyá</option>
                    <% } %>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small text-white-50">Cita Bíblica / Versículos</label>
                <input type="text" name="verses_reference" class="form-control" value="<%= item.verses_reference || '' %>" placeholder="Ej: Génesis 1:1 - 1:5">
            </div>

            <!-- Video Section -->
            <div class="col-md-6">
                <label class="form-label small text-white-50">Subir Video (MP4 / WebM / Video Vertical)</label>
                <input type="file" name="video_upload" class="form-control bg-dark text-white border-secondary" accept="video/*">
                <% if (item.video_url) { %>
                    <div class="mt-2 p-2 rounded bg-black bg-opacity-50 border border-secondary">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-info text-dark"><i class="bi bi-camera-video me-1"></i>Video subido actual</span>
                            <a href="<%= item.video_url %>" target="_blank" class="small text-info text-decoration-none"><i class="bi bi-box-arrow-up-right me-1"></i>Ver video</a>
                        </div>
                        <video src="<%= item.video_url %>" controls style="max-height: 180px; width: 100%; border-radius: 6px; background: #000;"></video>
                    </div>
                <% } %>
            </div>

            <div class="col-md-6">
                <label class="form-label small text-white-50">O Link de YouTube Shorts / Video</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-youtube text-danger"></i></span>
                    <input type="text" name="youtube_short_url" class="form-control" value="<%= item.youtube_short_url || '' %>" placeholder="https://youtube.com/shorts/...">
                </div>
                <% if (item.youtube_short_url) { %>
                    <div class="mt-2 small text-muted">
                        <i class="bi bi-link-45deg me-1"></i>Enlace actual: <a href="<%= item.youtube_short_url %>" target="_blank" class="text-info"><%= item.youtube_short_url %></a>
                    </div>
                <% } %>
            </div>

            <!-- Thumbnail Section -->
            <div class="col-md-6">
                <label class="form-label small text-white-50">Subir Miniatura / Portada (Foto Vertical)</label>
                <input type="file" name="thumbnail_file" id="edit_short_thumb_file" class="form-control" accept="image/*">
                <label class="form-label small text-white-50 mt-2">O URL de Miniatura</label>
                <input type="text" name="thumbnail_url" id="edit_short_thumb_url" class="form-control" value="<%= item.thumbnail_url || '' %>">
            </div>

            <div class="col-md-6 text-center">
                <label class="form-label small text-white-50 d-block">Vista previa de Miniatura</label>
                <div style="width: 140px; height: 200px; margin: 0 auto; border-radius: 12px; overflow: hidden; border: 2px dashed rgba(255,255,255,0.2); background: #111; display: flex; align-items: center; justify-content: center;">
                    <img id="editShortThumbPreview" src="<%= item.thumbnail_url || '/assets/img/pagina/semillas_torah_banner.png' %>" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
            </div>

            <div class="col-12">
                <label class="form-label small text-white-50">Descripción / Reflexión</label>
                <textarea name="description" class="form-control" rows="3"><%= item.description || '' %></textarea>
            </div>

            <div class="col-md-6">
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" name="is_highlight" value="1" id="edit_short_highlight" <%= item.is_highlight ? 'checked' : '' %>>
                    <label class="form-check-label text-warning small fw-bold" for="edit_short_highlight">
                        <i class="bi bi-star-fill me-1"></i> Destacado como Novedad Principal
                    </label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" name="is_published" value="1" id="edit_short_published" <%= item.is_published ? 'checked' : '' %>>
                    <label class="form-check-label text-white small" for="edit_short_published">Publicado en la Web</label>
                </div>
            </div>

            <div class="col-12 mt-4 pt-3 border-top border-secondary d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>Guardar Cambios</button>
                <a href="/admin/dashboard#pills-semillas" class="btn btn-outline-secondary px-4">Cancelar</a>
            </div>
        </div>
    </form>
</main>

<script>
    const thumbUrlInput = document.getElementById('edit_short_thumb_url');
    const thumbFileInput = document.getElementById('edit_short_thumb_file');
    const thumbPreview = document.getElementById('editShortThumbPreview');

    if (thumbUrlInput) {
        thumbUrlInput.addEventListener('input', (e) => {
            if (e.target.value) thumbPreview.src = e.target.value;
        });
    }

    if (thumbFileInput) {
        thumbFileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (ev) => {
                    thumbPreview.src = ev.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    }
</script>
