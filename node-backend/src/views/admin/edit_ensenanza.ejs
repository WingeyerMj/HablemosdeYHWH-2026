<!-- Sidebar -->
<%- include('partials/_sidebar') %>

<main class="col-md-10 main-content">
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-pencil-square me-2" style="color: var(--primary-color);"></i>Editar Enseñanza</h1>
            <p class="text-white-50 mb-0">Editando: <strong><%= ensenanza.title %></strong></p>
        </div>
        <a href="/admin/dashboard#pills-ensenanzas" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>

    <form action="/admin/ensenanzas/update" method="POST" enctype="multipart/form-data" id="editEnsenanzaPageForm">
        <input type="hidden" name="id" value="<%= ensenanza.id %>">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label small text-white-50">Título</label>
                <input type="text" name="title" class="form-control" required value="<%= ensenanza.title %>">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-white-50">Subtítulo / Tema</label>
                <input type="text" name="subtitle" class="form-control" value="<%= ensenanza.subtitle || '' %>">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-warning fw-bold"><i class="bi bi-calendar3 me-1"></i>Fecha en que se dictó</label>
                <% 
                    const curDate = ensenanza.teaching_date ? new Date(ensenanza.teaching_date).toISOString().split('T')[0] : (ensenanza.created_at ? new Date(ensenanza.created_at).toISOString().split('T')[0] : new Date().toISOString().split('T')[0]);
                %>
                <input type="date" name="teaching_date" class="form-control border-warning" required value="<%= curDate %>">
            </div>

            <!-- Expositor / Docente -->
            <div class="col-md-4">
                <label class="form-label small text-white-50">Expositor / Docente</label>
                <input type="text" name="author" id="page_edit_ens_author" class="form-control" value="<%= ensenanza.author || 'Moréh Kaleb' %>" required>
            </div>
            <div class="col-md-4">
                <label class="form-label small text-white-50">Rol del Expositor</label>
                <input type="text" name="author_role" id="page_edit_ens_author_role" class="form-control" value="<%= ensenanza.author_role || 'Moréh' %>">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-white-50">Foto del Expositor (URL)</label>
                <input type="text" name="author_img" id="page_edit_ens_author_img" class="form-control" value="<%= ensenanza.author_img || '/assets/img/team/kaleb.jpg' %>">
            </div>
            <% if (typeof team !== 'undefined' && team && team.length > 0) { %>
                <div class="col-12">
                    <span class="small text-white-50 me-2"><i class="bi bi-people me-1"></i>Seleccionar rápido del equipo:</span>
                    <div class="d-inline-flex gap-2 flex-wrap">
                        <% team.forEach(m => { %>
                            <button type="button" class="btn btn-sm btn-outline-warning rounded-pill py-0 px-2" style="font-size: 0.78rem;" 
                                    onclick="document.getElementById('page_edit_ens_author').value='<%= m.name %>'; document.getElementById('page_edit_ens_author_role').value='<%= m.role %>'; document.getElementById('page_edit_ens_author_img').value='<%= m.img %>';">
                                <%= m.name %> (<%= m.role %>)
                            </button>
                        <% }) %>
                    </div>
                </div>
            <% } %>

            <div class="col-md-12">
                <label class="form-label small text-white-50">Resumen Breve</label>
                <textarea name="description" class="form-control" rows="2"><%= ensenanza.description || '' %></textarea>
            </div>

            <div class="col-md-12">
                <label class="form-label small text-white-50">Link de YouTube (Video)</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-youtube text-danger"></i></span>
                    <input type="text" name="youtube_link" class="form-control" value="<%= ensenanza.youtube_link || '' %>" placeholder="https://www.youtube.com/watch?v=...">
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label small text-white-50">Subir Nueva Imagen</label>
                <input type="file" name="image_file" id="edit_page_image_file" class="form-control" accept="image/*">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-white-50">O URL de Imagen</label>
                <input type="text" name="image_url" id="edit_page_image_url" class="form-control" value="<%= ensenanza.image_url || '' %>">
            </div>
            <div class="col-md-4 text-center">
                <div class="border border-secondary rounded overflow-hidden" style="height:120px;background:rgba(0,0,0,0.2);display:flex;align-items:center;justify-content:center;">
                    <img id="editPageImgPreview" src="<%= ensenanza.image_url || '' %>" style="max-width:100%;max-height:100%;object-fit:contain;">
                </div>
            </div>

            <div class="col-12">
                <label class="form-label small text-white-50">Contenido Detallado del Estudio</label>
                <div id="edit-ensenanza-editor" style="height:400px;background:white;color:black;border-radius:5px;"></div>
                <input type="hidden" name="content" id="editEnsenanzaPageContent">
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4 mb-5 gap-3">
            <a href="/admin/dashboard#pills-ensenanzas" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-primary px-5"><i class="bi bi-check-lg me-2"></i>Guardar Cambios</button>
        </div>
    </form>
</main>

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const quill = new Quill('#edit-ensenanza-editor', {
        theme: 'snow',
        modules: { toolbar: [[{'header':[1,2,3,false]}],['bold','italic','underline','strike'],[{'color':[]},{'background':[]}],['link','blockquote','code-block','image'],[{'list':'ordered'},{'list':'bullet'}],[{'align':[]}],['clean']] }
    });
    quill.root.innerHTML = `<%- (ensenanza.content || ensenanza.description || '').replace(/`/g, '\\`').replace(/\\/g, '\\\\') %>`;
    
    // Image previews
    const urlInput = document.getElementById('edit_page_image_url');
    const fileInput = document.getElementById('edit_page_image_file');
    const previewImg = document.getElementById('editPageImgPreview');

    if (urlInput) {
        urlInput.addEventListener('input', e => {
            if (e.target.value) previewImg.src = e.target.value;
        });
    }

    if (fileInput) {
        fileInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = e => {
                    previewImg.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    }

    document.getElementById('editEnsenanzaPageForm').onsubmit = function() {
        document.getElementById('editEnsenanzaPageContent').value = quill.root.innerHTML;
        return true;
    };
});
</script>
