<!-- Sidebar -->
<%- include('partials/_sidebar') %>

<main class="col-md-10 main-content">
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-pencil-square me-2" style="color: var(--primary-color);"></i>Editar Enseñanza</h1>
            <p class="text-white-50 mb-0">Editando: <strong><%= ensenanza.title %></strong></p>
        </div>
        <a href="/admin/dashboard#pills-ensenanzas" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>

    <form action="/admin/ensenanzas/update" method="POST" enctype="multipart/form-data" id="editEnsenanzaPageForm">
        <input type="hidden" name="id" value="<%= ensenanza.id %>">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label small text-white-50">Título</label>
                <input type="text" name="title" class="form-control" required value="<%= ensenanza.title %>">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-white-50">Subtítulo / Tema</label>
                <input type="text" name="subtitle" class="form-control" value="<%= ensenanza.subtitle || '' %>">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-warning fw-bold"><i class="bi bi-calendar3 me-1"></i>Fecha en que se dictó</label>
                <% 
                    const curDate = ensenanza.teaching_date ? new Date(ensenanza.teaching_date).toISOString().split('T')[0] : (ensenanza.created_at ? new Date(ensenanza.created_at).toISOString().split('T')[0] : new Date().toISOString().split('T')[0]);
                %>
                <input type="date" name="teaching_date" class="form-control border-warning" required value="<%= curDate %>">
            </div>

            <!-- Expositores / Servidores -->
            <div class="col-12">
                <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.12);">
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                        <label class="form-label mb-0 small text-warning fw-bold">
                            <i class="bi bi-people-fill me-1"></i>Expositor(es) / Servidor(es)
                        </label>
                        <button type="button" class="btn btn-sm btn-outline-warning rounded-pill" id="page-btn-add-author">
                            <i class="bi bi-plus-circle me-1"></i>Añadir otro expositor
                        </button>
                    </div>

                    <% if (typeof team !== 'undefined' && team && team.length > 0) { %>
                        <div class="mb-2 d-flex align-items-center gap-1 flex-wrap">
                            <span class="small text-white-50 me-1" style="font-size: 0.75rem;">Añadir del equipo con 1 clic:</span>
                            <% team.forEach(m => { %>
                                <button type="button" class="btn btn-sm btn-dark border-secondary rounded-pill py-0 px-2 text-warning page-quick-add-team" 
                                        style="font-size: 0.75rem;" 
                                        data-name="<%= m.name %>" 
                                        data-role="<%= m.role %>" 
                                        data-img="<%= m.img %>">
                                    + <%= m.name %> (<%= m.role %>)
                                </button>
                            <% }) %>
                        </div>
                    <% } %>

                    <div id="page-authors-container" class="d-flex flex-column gap-2 mt-2">
                        <!-- Filas dinámicas de expositores -->
                    </div>
                    <input type="hidden" name="authors_json" id="page_edit_ens_authors_json">
                </div>
            </div>

            <div class="col-md-12">
                <label class="form-label small text-white-50">Resumen Breve</label>
                <textarea name="description" class="form-control" rows="2"><%= ensenanza.description || '' %></textarea>
            </div>

            <div class="col-md-12">
                <label class="form-label small text-white-50">Link de YouTube (Video)</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-youtube text-danger"></i></span>
                    <input type="text" name="youtube_link" class="form-control" value="<%= ensenanza.youtube_link || '' %>" placeholder="https://www.youtube.com/watch?v=...">
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label small text-white-50">Subir Nueva Imagen</label>
                <input type="file" name="image_file" id="edit_page_image_file" class="form-control" accept="image/*">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-white-50">O URL de Imagen</label>
                <input type="text" name="image_url" id="edit_page_image_url" class="form-control" value="<%= ensenanza.image_url || '' %>">
            </div>
            <div class="col-md-4 text-center">
                <div class="border border-secondary rounded overflow-hidden" style="height:120px;background:rgba(0,0,0,0.2);display:flex;align-items:center;justify-content:center;">
                    <img id="editPageImgPreview" src="<%= ensenanza.image_url || '' %>" style="max-width:100%;max-height:100%;object-fit:contain;">
                </div>
            </div>

            <div class="col-12">
                <label class="form-label small text-white-50">Contenido Detallado del Estudio</label>
                <div id="edit-ensenanza-editor" style="height:400px;background:white;color:black;border-radius:5px;"></div>
                <input type="hidden" name="content" id="editEnsenanzaPageContent">
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4 mb-5 gap-3">
            <a href="/admin/dashboard#pills-ensenanzas" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-primary px-5"><i class="bi bi-check-lg me-2"></i>Guardar Cambios</button>
        </div>
    </form>
</main>

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const quill = new Quill('#edit-ensenanza-editor', {
        theme: 'snow',
        modules: { toolbar: [[{'header':[1,2,3,false]}],['bold','italic','underline','strike'],[{'color':[]},{'background':[]}],['link','blockquote','code-block','image'],[{'list':'ordered'},{'list':'bullet'}],[{'align':[]}],['clean']] }
    });
    quill.root.innerHTML = `<%- (ensenanza.content || ensenanza.description || '').replace(/`/g, '\\`').replace(/\\/g, '\\\\') %>`;
    
    // Image previews
    const urlInput = document.getElementById('edit_page_image_url');
    const fileInput = document.getElementById('edit_page_image_file');
    const previewImg = document.getElementById('editPageImgPreview');

    if (urlInput) {
        urlInput.addEventListener('input', e => {
            if (e.target.value) previewImg.src = e.target.value;
        });
    }

    if (fileInput) {
        fileInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = e => {
                    previewImg.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    }

    // Dynamic Multi-Author Management for Edit Page
    const pageAuthorsContainer = document.getElementById('page-authors-container');

    function renderPageAuthorRow(author = { name: '', role: 'Moréh', img: '/assets/img/team/kaleb.jpg' }) {
        if (!pageAuthorsContainer) return;

        const row = document.createElement('div');
        row.className = 'author-row d-flex align-items-center gap-2 p-2 rounded bg-black bg-opacity-25 border border-secondary border-opacity-25';
        row.innerHTML = `
            <div class="d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; flex-shrink: 0;">
                <img src="${author.img || '/assets/img/team/kaleb.jpg'}" class="author-row-preview rounded-circle border border-warning" style="width: 34px; height: 34px; object-fit: cover;" onerror="this.src='/assets/img/team/kaleb.jpg'">
            </div>
            <div class="flex-grow-1">
                <div class="row g-2">
                    <div class="col-md-5">
                        <input type="text" class="form-control form-control-sm author-name" placeholder="Nombre del expositor" value="${author.name || ''}" required>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control form-control-sm author-role" placeholder="Rol (Ej: Moréh)" value="${author.role || 'Moréh'}">
                    </div>
                    <div class="col-md-4">
                        <input type="text" class="form-control form-control-sm author-img" placeholder="URL Foto" value="${author.img || '/assets/img/team/kaleb.jpg'}">
                    </div>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-author" title="Eliminar expositor" style="padding: 0.25rem 0.5rem;">
                <i class="bi bi-trash"></i>
            </button>
        `;

        const imgInput = row.querySelector('.author-img');
        const imgPreview = row.querySelector('.author-row-preview');
        if (imgInput && imgPreview) {
            imgInput.addEventListener('input', e => {
                imgPreview.src = e.target.value || '/assets/img/team/kaleb.jpg';
            });
        }

        row.querySelector('.btn-remove-author').addEventListener('click', () => {
            if (pageAuthorsContainer.querySelectorAll('.author-row').length > 1) {
                row.remove();
            } else {
                row.querySelector('.author-name').value = '';
                row.querySelector('.author-role').value = 'Moréh';
                row.querySelector('.author-img').value = '/assets/img/team/kaleb.jpg';
                if (imgPreview) imgPreview.src = '/assets/img/team/kaleb.jpg';
            }
        });

        pageAuthorsContainer.appendChild(row);
    }

    function serializePageAuthors() {
        const hiddenInput = document.getElementById('page_edit_ens_authors_json');
        if (!pageAuthorsContainer || !hiddenInput) return;

        const list = [];
        pageAuthorsContainer.querySelectorAll('.author-row').forEach(row => {
            const name = (row.querySelector('.author-name')?.value || '').trim();
            const role = (row.querySelector('.author-role')?.value || 'Moréh').trim();
            const img = (row.querySelector('.author-img')?.value || '/assets/img/team/kaleb.jpg').trim();
            if (name) {
                list.push({ name, role, img });
            }
        });

        if (list.length === 0) {
            list.push({ name: 'Moréh Kalev Aquerman', role: 'Moreh מורה', img: '/assets/img/team/kaleb.jpg' });
        }
        hiddenInput.value = JSON.stringify(list);
    }

    // Populate initial authors
    const initialAuthors = <%- JSON.stringify(ensenanza.authors_list && ensenanza.authors_list.length > 0 ? ensenanza.authors_list : [{ name: ensenanza.author || 'Moréh Kalev Aquerman', role: ensenanza.author_role || 'Moreh מורה', img: ensenanza.author_img || '/assets/img/team/kaleb.jpg' }]) %>;
    initialAuthors.forEach(a => renderPageAuthorRow(a));

    document.getElementById('page-btn-add-author')?.addEventListener('click', () => {
        renderPageAuthorRow({ name: '', role: 'Moréh', img: '/assets/img/team/kaleb.jpg' });
    });

    document.querySelectorAll('.page-quick-add-team').forEach(btn => {
        btn.onclick = function() {
            const name = this.dataset.name;
            const role = this.dataset.role;
            const img = this.dataset.img;

            const rows = pageAuthorsContainer.querySelectorAll('.author-row');
            let filled = false;
            for (let r of rows) {
                const nameInput = r.querySelector('.author-name');
                if (nameInput && !nameInput.value.trim()) {
                    nameInput.value = name;
                    if (r.querySelector('.author-role')) r.querySelector('.author-role').value = role;
                    if (r.querySelector('.author-img')) {
                        r.querySelector('.author-img').value = img;
                        const prev = r.querySelector('.author-row-preview');
                        if (prev) prev.src = img;
                    }
                    filled = true;
                    break;
                }
            }
            if (!filled) {
                renderPageAuthorRow({ name, role, img });
            }
        };
    });

    document.getElementById('editEnsenanzaPageForm').onsubmit = function() {
        serializePageAuthors();
        document.getElementById('editEnsenanzaPageContent').value = quill.root.innerHTML;
        return true;
    };
});
</script>
