<%- include('partials/_sidebar', { activePage: 'comentarios' }) %>

<main class="col-md-10 main-content">
    <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1><i class="bi bi-chat-heart text-danger me-2"></i>Moderación & Gestión de Comentarios</h1>
            <p class="text-white-50 mb-0">Revisa, aprueba, responde y gestiona los comentarios de los hermanos y visitantes en todas las publicaciones de la web.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3">
                <i class="bi bi-box-arrow-up-right me-1"></i> Ver Web Pública
            </a>
        </div>
    </div>

    <% if (typeof msg !== 'undefined' && msg) { %>
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert" style="background: rgba(16, 185, 129, 0.15); border-left: 4px solid #10b981 !important; color: #6ee7b7;">
            <i class="bi bi-check-circle-fill me-2"></i>
            <% if (msg === 'approved') { %>
                ¡El comentario ha sido <strong>aprobado y publicado</strong> con éxito!
            <% } else if (msg === 'unapproved') { %>
                ¡El comentario ha sido <strong>pausado / desaprobado</strong> y ya no es visible públicamente!
            <% } else if (msg === 'replied') { %>
                ¡Tu <strong>respuesta oficial</strong> ha sido guardada y publicada!
            <% } else if (msg === 'reply_deleted') { %>
                ¡La respuesta oficial ha sido eliminada!
            <% } else if (msg === 'deleted') { %>
                ¡El comentario ha sido eliminado permanentemente!
            <% } else { %>
                <%= msg %>
            <% } %>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert" style="background: rgba(239, 68, 68, 0.15); border-left: 4px solid #ef4444 !important; color: #fca5a5;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Estadísticas Principales -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <a href="/admin/comentarios?filter=pending" class="text-decoration-none">
                <div class="card-stat h-100" style="<%= currentFilter === 'pending' ? 'border: 1.5px solid #f59e0b; background: rgba(245, 158, 11, 0.1);' : '' %>">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="small text-white-50 text-uppercase fw-semibold mb-1" style="font-size: 0.75rem;">Pendientes de Revisión</div>
                            <h2 class="mb-0 fw-bold text-warning"><%= stats.pending %></h2>
                        </div>
                        <div class="stat-icon" style="background: rgba(245, 158, 11, 0.2); color: #f59e0b;">
                            <i class="bi bi-clock-history"></i>
                        </div>
                    </div>
                    <div class="mt-2 small text-warning opacity-75">
                        <i class="bi bi-arrow-right-short"></i> <%= stats.pending > 0 ? 'Requieren aprobación' : 'Todo al día' %>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a href="/admin/comentarios?filter=approved" class="text-decoration-none">
                <div class="card-stat h-100" style="<%= currentFilter === 'approved' ? 'border: 1.5px solid #10b981; background: rgba(16, 185, 129, 0.1);' : '' %>">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="small text-white-50 text-uppercase fw-semibold mb-1" style="font-size: 0.75rem;">Aprobados (Públicos)</div>
                            <h2 class="mb-0 fw-bold text-success"><%= stats.approved %></h2>
                        </div>
                        <div class="stat-icon" style="background: rgba(16, 185, 129, 0.2); color: #10b981;">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                    </div>
                    <div class="mt-2 small text-success opacity-75">
                        <i class="bi bi-eye"></i> Visibles en la página
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a href="/admin/comentarios?filter=all" class="text-decoration-none">
                <div class="card-stat h-100" style="<%= currentFilter === 'all' ? 'border: 1.5px solid var(--primary-color); background: rgba(212, 184, 149, 0.1);' : '' %>">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="small text-white-50 text-uppercase fw-semibold mb-1" style="font-size: 0.75rem;">Total de Comentarios</div>
                            <h2 class="mb-0 fw-bold text-white"><%= stats.total %></h2>
                        </div>
                        <div class="stat-icon">
                            <i class="bi bi-chat-square-text"></i>
                        </div>
                    </div>
                    <div class="mt-2 small text-white-50">
                        Histórico completo
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card-stat h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small text-white-50 text-uppercase fw-semibold mb-1" style="font-size: 0.75rem;">Con Respuesta Oficial</div>
                        <h2 class="mb-0 fw-bold" style="color: #60a5fa;"><%= stats.replied %></h2>
                    </div>
                    <div class="stat-icon" style="background: rgba(96, 165, 250, 0.2); color: #60a5fa;">
                        <i class="bi bi-reply-fill"></i>
                    </div>
                </div>
                <div class="mt-2 small text-info opacity-75">
                    Respuestas del Administrador
                </div>
            </div>
        </div>
    </div>

    <!-- Barra de Filtros y Búsqueda -->
    <div class="card bg-dark border-secondary shadow-sm mb-4" style="background: #141414 !important; border: 1px solid rgba(255,255,255,0.08) !important; border-radius: 12px;">
        <div class="card-body p-3">
            <form action="/admin/comentarios" method="GET" class="row g-2 align-items-center">
                <!-- Filtro por Estado -->
                <div class="col-lg-4 col-md-6">
                    <div class="btn-group w-100" role="group">
                        <a href="/admin/comentarios?filter=pending<%= currentEntity !== 'all' ? '&entity_type=' + currentEntity : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" 
                           class="btn btn-sm <%= currentFilter === 'pending' ? 'btn-warning text-dark fw-bold' : 'btn-outline-secondary text-white' %>">
                            <i class="bi bi-clock-history me-1"></i> Pendientes (<%= stats.pending %>)
                        </a>
                        <a href="/admin/comentarios?filter=approved<%= currentEntity !== 'all' ? '&entity_type=' + currentEntity : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" 
                           class="btn btn-sm <%= currentFilter === 'approved' ? 'btn-success fw-bold' : 'btn-outline-secondary text-white' %>">
                            <i class="bi bi-check2 me-1"></i> Aprobados (<%= stats.approved %>)
                        </a>
                        <a href="/admin/comentarios?filter=all<%= currentEntity !== 'all' ? '&entity_type=' + currentEntity : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" 
                           class="btn btn-sm <%= currentFilter === 'all' ? 'btn-primary fw-bold' : 'btn-outline-secondary text-white' %>">
                            Todos (<%= stats.total %>)
                        </a>
                    </div>
                </div>

                <!-- Filtro por Sección / Entidad -->
                <div class="col-lg-3 col-md-6">
                    <select name="entity_type" class="form-select form-select-sm" onchange="this.form.submit()" style="background: #212121; border-color: rgba(255,255,255,0.15); color: #fff;">
                        <option value="all" <%= currentEntity === 'all' ? 'selected' : '' %>>📁 Todas las Secciones</option>
                        <option value="blog" <%= currentEntity === 'blog' ? 'selected' : '' %>>📖 Blog y Artículos</option>
                        <option value="ensenanzas" <%= currentEntity === 'ensenanzas' ? 'selected' : '' %>>📜 Enseñanzas & Estudios</option>
                        <option value="noticias" <%= currentEntity === 'noticias' ? 'selected' : '' %>>📰 Noticias</option>
                        <option value="parashot" <%= currentEntity === 'parashot' ? 'selected' : '' %>>✡️ Parashot Semanales</option>
                        <option value="haftara" <%= currentEntity === 'haftara' ? 'selected' : '' %>>📜 Haftarot (Profetas)</option>
                        <option value="eventos" <%= currentEntity === 'eventos' ? 'selected' : '' %>>📅 Eventos</option>
                        <option value="seders" <%= currentEntity === 'seders' ? 'selected' : '' %>>🍇 Séderes / Sidurim</option>
                        <option value="semillas_articulos" <%= currentEntity === 'semillas_articulos' ? 'selected' : '' %>>🌱 Semillas Artículos</option>
                        <option value="semillas" <%= currentEntity === 'semillas' ? 'selected' : '' %>>🌱 Semillas de Torah</option>
                    </select>
                </div>

                <!-- Buscador -->
                <div class="col-lg-4 col-md-8">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-dark text-white-50 border-secondary"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control form-control-sm" placeholder="Buscar por usuario, email o texto..." value="<%= search %>" style="background: #212121; border-color: rgba(255,255,255,0.15); color: #fff;">
                        <% if (search) { %>
                            <a href="/admin/comentarios?filter=<%= currentFilter %>&entity_type=<%= currentEntity %>" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg"></i></a>
                        <% } %>
                    </div>
                </div>

                <input type="hidden" name="filter" value="<%= currentFilter %>">

                <div class="col-lg-1 col-md-4">
                    <button type="submit" class="btn btn-sm btn-primary w-100">Filtrar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Lista de Comentarios -->
    <% if (comments && comments.length > 0) { %>
        <div class="d-flex flex-column gap-3 mb-5">
            <% comments.forEach((c) => { %>
                <div class="card bg-dark border-secondary shadow-sm overflow-hidden" 
                     style="background: #141414 !important; border: 1px solid <%= !c.is_approved ? 'rgba(245, 158, 11, 0.4)' : 'rgba(255, 255, 255, 0.08)' %> !important; border-left: 5px solid <%= !c.is_approved ? '#f59e0b' : '#10b981' %> !important; border-radius: 12px;">
                    
                    <div class="card-header py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2" 
                         style="background: <%= !c.is_approved ? 'rgba(245, 158, 11, 0.06)' : 'rgba(255, 255, 255, 0.02)' %>; border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                        
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"
                                 style="width: 42px; height: 42px; background: <%= c.avatar_color || '#d4a853' %>; font-size: 1.1rem; flex-shrink: 0;">
                                <%= (c.user_name || 'U').charAt(0).toUpperCase() %>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <h6 class="mb-0 text-white fw-bold"><%= c.user_name %></h6>
                                    <% if (c.user_email) { %>
                                        <span class="text-white-50 small"><i class="bi bi-envelope me-1"></i><%= c.user_email %></span>
                                    <% } %>
                                </div>
                                <small class="text-white-50" style="font-size: 0.78rem;">
                                    <i class="bi bi-calendar3 me-1"></i><%= new Date(c.created_at).toLocaleString('es-ES', { dateStyle: 'medium', timeStyle: 'short' }) %>
                                </small>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <!-- Sección & Enlace al Artículo -->
                            <% if (c.entity_info) { %>
                                <a href="<%= c.entity_info.url %>" target="_blank" class="badge text-decoration-none px-3 py-2 rounded-pill shadow-sm" 
                                   style="background: rgba(212, 184, 149, 0.15); color: var(--primary-color); border: 1px solid rgba(212, 184, 149, 0.3); font-size: 0.8rem;">
                                    <i class="bi bi-link-45deg me-1"></i><%= c.entity_info.section_name %>: <strong><%= c.entity_info.title %></strong>
                                </a>
                            <% } %>

                            <!-- Estado de Aprobación -->
                            <% if (!c.is_approved) { %>
                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
                                    <i class="bi bi-hourglass-split me-1"></i> Pendiente de Aprobación
                                </span>
                            <% } else { %>
                                <span class="badge bg-success px-3 py-2 rounded-pill fw-bold">
                                    <i class="bi bi-check-circle me-1"></i> Aprobado & Público
                                </span>
                            <% } %>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <!-- Texto del Comentario del Usuario -->
                        <div class="p-3 rounded-3 mb-3" style="background: #1c1c1c; border-left: 3px solid <%= c.avatar_color || '#d4a853' %>; color: #f1f5f9; font-size: 1.02rem; line-height: 1.7; white-space: pre-wrap;">
                            <%= c.comment_text %>
                        </div>

                        <!-- Respuesta Oficial del Administrador (si existe) -->
                        <% if (c.admin_reply && c.admin_reply.trim() !== '') { %>
                            <div class="p-3 rounded-3 mb-3 ms-md-4 position-relative" style="background: linear-gradient(135deg, rgba(212, 184, 149, 0.12), rgba(212, 184, 149, 0.04)); border: 1.5px solid rgba(212, 184, 149, 0.3); border-radius: 10px;">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2 pb-2 border-bottom border-secondary border-opacity-25">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge rounded-pill px-2 py-1" style="background: var(--primary-color); color: #000; font-size: 0.72rem; font-weight: 700;">
                                            <i class="bi bi-shield-check me-1"></i> OFICIAL
                                        </span>
                                        <strong style="color: var(--primary-color); font-size: 0.9rem;">Respuesta de <%= c.admin_reply_by || 'Administración' %></strong>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <% if (c.admin_reply_at) { %>
                                            <small class="text-white-50" style="font-size: 0.75rem;"><%= new Date(c.admin_reply_at).toLocaleString('es-ES', { dateStyle: 'short', timeStyle: 'short' }) %></small>
                                        <% } %>
                                        <form action="/admin/comentarios/delete-reply/<%= c.id %>" method="POST" onsubmit="return confirm('¿Seguro de eliminar esta respuesta oficial?');" class="d-inline">
                                            <button type="submit" class="btn btn-link text-danger p-0 ms-2" title="Eliminar respuesta" style="font-size: 0.8rem; text-decoration: none;">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                                <p class="mb-0 text-white opacity-90" style="font-size: 0.96rem; line-height: 1.6; white-space: pre-wrap;"><%= c.admin_reply %></p>
                            </div>
                        <% } %>

                        <!-- Barra de Acciones del Comentario -->
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top border-secondary border-opacity-25">
                            <div class="d-flex align-items-center gap-2">
                                <!-- Botón Aprobar -->
                                <% if (!c.is_approved) { %>
                                    <form action="/admin/comentarios/approve/<%= c.id %>" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-bold d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-check2-circle fs-6"></i> Aprobar & Publicar
                                        </button>
                                    </form>
                                <% } else { %>
                                    <form action="/admin/comentarios/unapprove/<%= c.id %>" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-3 d-inline-flex align-items-center gap-1" title="Ocultar de la vista pública">
                                            <i class="bi bi-eye-slash"></i> Pausar / Ocultar
                                        </button>
                                    </form>
                                <% } %>

                                <!-- Botón Responder / Editar Respuesta -->
                                <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3 d-inline-flex align-items-center gap-1" 
                                        data-bs-toggle="modal" data-bs-target="#replyModal-<%= c.id %>">
                                    <i class="bi bi-reply-fill"></i> <%= c.admin_reply ? 'Editar Respuesta' : 'Responder' %>
                                </button>
                            </div>

                            <!-- Botón Eliminar Comentario -->
                            <form action="/admin/comentarios/delete/<%= c.id %>" method="POST" onsubmit="return confirm('¿Estás seguro de que deseas eliminar permanentemente este comentario de <%= c.user_name %>?');" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-trash3"></i> Eliminar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- MODAL PARA RESPONDER AL COMENTARIO -->
                <div class="modal fade" id="replyModal-<%= c.id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-dark text-white border-secondary shadow-lg" style="background: #1a1a1a !important; border: 1px solid rgba(212, 184, 149, 0.3) !important;">
                            <form action="/admin/comentarios/reply/<%= c.id %>" method="POST">
                                <div class="modal-header border-secondary">
                                    <h5 class="modal-title fs-6" style="color: var(--primary-color);">
                                        <i class="bi bi-reply-all-fill me-2"></i>Responder a <%= c.user_name %>
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <div class="mb-3 p-3 rounded-3" style="background: #111; border-left: 3px solid <%= c.avatar_color || '#d4a853' %>; font-size: 0.9rem; color: #cbd5e1;">
                                        <small class="text-muted d-block mb-1">Comentario original:</small>
                                        "<%= c.comment_text.substring(0, 200) %><%= c.comment_text.length > 200 ? '...' : '' %>"
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small text-white-50 fw-semibold">Tu Respuesta Oficial (se mostrará públicamente con tu insignia):</label>
                                        <textarea name="admin_reply" class="form-control" rows="4" placeholder="Escribe aquí la respuesta bíblica, pastoral o administrativa..." required
                                                  style="background: #242424 !important; color: #fff !important; border-color: rgba(255,255,255,0.2) !important;"><%= c.admin_reply || '' %></textarea>
                                    </div>

                                    <div class="small text-white-50">
                                        <i class="bi bi-info-circle me-1 text-warning"></i> Al guardar la respuesta, el comentario quedará automáticamente aprobado y visible para todos los visitantes.
                                    </div>
                                </div>
                                <div class="modal-footer border-secondary">
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold">
                                        <i class="bi bi-send-fill me-1"></i> Guardar y Publicar
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="card bg-dark border-secondary shadow-sm text-center py-5" style="background: #141414 !important; border-radius: 12px;">
            <div class="card-body">
                <i class="bi bi-chat-heart text-white-50" style="font-size: 3.5rem;"></i>
                <h5 class="fw-bold mt-3 text-white">No se encontraron comentarios</h5>
                <p class="text-white-50 mb-4">
                    <% if (currentFilter === 'pending') { %>
                        ¡Excelente! No hay comentarios pendientes de moderación en este momento.
                    <% } else { %>
                        No hay comentarios que coincidan con los filtros seleccionados.
                    <% } %>
                </p>
                <a href="/admin/comentarios?filter=all" class="btn btn-sm btn-outline-light rounded-pill px-4">
                    Ver todos los comentarios
                </a>
            </div>
        </div>
    <% } %>

</main>
