<%- include('partials/_sidebar') %>

<main class="col-md-10 main-content">
    <div class="page-header d-flex justify-content-between align-items-center">
        <h1><i class="bi bi-lamp me-2" style="color: #7c3aed;"></i>Editar Seder</h1>
        <a href="/admin/dashboard#pills-seder" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>

    <div class="card bg-dark border-secondary">
        <div class="card-body p-4">
            <form action="/admin/seder/update" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="id" value="<%= seder.id %>">
                
                <div class="row g-3">
                    <!-- Title -->
                    <div class="col-md-8">
                        <label class="form-label text-light">Título del Seder <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control bg-dark text-light border-secondary" value="<%= seder.title %>" required placeholder="Ej: Seder de Pesaj 5785">
                    </div>

                    <!-- Festival -->
                    <div class="col-md-4">
                        <label class="form-label text-light">Fiesta</label>
                        <select name="festival" class="form-select bg-dark text-light border-secondary">
                            <option value="">Seleccionar fiesta...</option>
                            <option value="Pesaj" <%= seder.festival === 'Pesaj' ? 'selected' : '' %>>Pesaj (Pascua)</option>
                            <option value="Shavuot" <%= seder.festival === 'Shavuot' ? 'selected' : '' %>>Shavuot (Pentecostés)</option>
                            <option value="Yom Teruah" <%= seder.festival === 'Yom Teruah' ? 'selected' : '' %>>Yom Teruah (Trompetas)</option>
                            <option value="Yom Kippur" <%= seder.festival === 'Yom Kippur' ? 'selected' : '' %>>Yom Kippur (Expiación)</option>
                            <option value="Sucot" <%= seder.festival === 'Sucot' ? 'selected' : '' %>>Sucot (Tabernáculos)</option>
                            <option value="Shemini Atzeret" <%= seder.festival === 'Shemini Atzeret' ? 'selected' : '' %>>Shemini Atzeret</option>
                            <option value="Janucá" <%= seder.festival === 'Janucá' ? 'selected' : '' %>>Janucá</option>
                            <option value="Purim" <%= seder.festival === 'Purim' ? 'selected' : '' %>>Purim</option>
                            <option value="Shabat" <%= seder.festival === 'Shabat' ? 'selected' : '' %>>Shabat</option>
                            <option value="Rosh Jodesh" <%= seder.festival === 'Rosh Jodesh' ? 'selected' : '' %>>Rosh Jodesh</option>
                            <option value="Otro" <%= seder.festival === 'Otro' ? 'selected' : '' %>>Otro</option>
                        </select>
                    </div>

                    <!-- Subtitle -->
                    <div class="col-md-8">
                        <label class="form-label text-light">Subtítulo</label>
                        <input type="text" name="subtitle" class="form-control bg-dark text-light border-secondary" value="<%= seder.subtitle || '' %>" placeholder="Ej: Orden de la celebración">
                    </div>

                    <!-- Date -->
                    <div class="col-md-4">
                        <label class="form-label text-light">Fecha de la Fiesta</label>
                        <input type="date" name="festival_date" class="form-control bg-dark text-light border-secondary" value="<%= seder.festival_date ? new Date(seder.festival_date).toISOString().split('T')[0] : '' %>">
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label class="form-label text-light">Descripción breve</label>
                        <textarea name="description" class="form-control bg-dark text-light border-secondary" rows="3" placeholder="Resumen del seder..."><%= seder.description || '' %></textarea>
                    </div>

                    <!-- Content (Rich) -->
                    <div class="col-12">
                        <label class="form-label text-light">Contenido completo del Seder (HTML permitido)</label>
                        <textarea name="content" class="form-control bg-dark text-light border-secondary" rows="10" placeholder="Contenido detallado del seder..."><%= seder.content || '' %></textarea>
                        <small class="text-muted">Puede usar HTML para formatear el contenido.</small>
                    </div>

                    <!-- Prayers -->
                    <div class="col-12">
                        <label class="form-label text-light"><i class="bi bi-chat-heart me-1" style="color: #ffd700;"></i> Oraciones y Bendiciones</label>
                        <textarea name="prayers" class="form-control bg-dark text-light border-secondary" rows="5" placeholder="Baruj Atá YHWH..."><%= seder.prayers || '' %></textarea>
                    </div>

                    <!-- Readings -->
                    <div class="col-12">
                        <label class="form-label text-light"><i class="bi bi-journal-text me-1" style="color: #ffd700;"></i> Lecturas Bíblicas</label>
                        <textarea name="readings" class="form-control bg-dark text-light border-secondary" rows="4" placeholder="Éxodo 12:1-14, Levítico 23..."><%= seder.readings || '' %></textarea>
                    </div>

                    <!-- Songs -->
                    <div class="col-12">
                        <label class="form-label text-light"><i class="bi bi-music-note-beamed me-1" style="color: #ffd700;"></i> Canciones y Alabanzas</label>
                        <textarea name="songs" class="form-control bg-dark text-light border-secondary" rows="4" placeholder="Canciones para la celebración..."><%= seder.songs || '' %></textarea>
                    </div>

                    <!-- Image -->
                    <div class="col-md-6">
                        <label class="form-label text-light">Imagen del Seder</label>
                        <input type="file" name="image_file" class="form-control bg-dark text-light border-secondary" accept="image/*">
                        <% if (seder.image_url) { %>
                            <div class="mt-2">
                                <img src="<%= seder.image_url %>" alt="Preview" style="max-height: 80px; border-radius: 8px; border: 1px solid #555;">
                                <input type="hidden" name="image_url" value="<%= seder.image_url %>">
                            </div>
                        <% } %>
                    </div>

                    <!-- PDF -->
                    <div class="col-md-6">
                        <label class="form-label text-light">Archivo PDF del Seder</label>
                        <input type="file" name="pdf_upload" class="form-control bg-dark text-light border-secondary" accept=".pdf">
                        <% if (seder.pdf_file) { %>
                            <div class="mt-2">
                                <a href="<%= seder.pdf_file %>" target="_blank" class="badge bg-success text-decoration-none">
                                    <i class="bi bi-file-pdf-fill me-1"></i> Ver PDF actual
                                </a>
                                <input type="hidden" name="pdf_file" value="<%= seder.pdf_file %>">
                            </div>
                        <% } %>
                    </div>

                    <!-- Author -->
                    <div class="col-md-4">
                        <label class="form-label text-light">Autor</label>
                        <input type="text" name="author" class="form-control bg-dark text-light border-secondary" value="<%= seder.author || 'Moréh Kalev Aquerman' %>">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label text-light">Rol del Autor</label>
                        <input type="text" name="author_role" class="form-control bg-dark text-light border-secondary" value="<%= seder.author_role || 'Moreh מורה' %>">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label text-light">Imagen del Autor (URL)</label>
                        <input type="text" name="author_img" class="form-control bg-dark text-light border-secondary" value="<%= seder.author_img || '/assets/img/team/kaleb.jpg' %>">
                    </div>

                    <!-- Checkboxes -->
                    <div class="col-md-6">
                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" name="is_published" value="1" id="is_published" <%= seder.is_published ? 'checked' : '' %>>
                            <label class="form-check-label text-light" for="is_published">
                                <i class="bi bi-globe me-1"></i> Publicado
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" name="is_featured" value="1" id="is_featured" <%= seder.is_featured ? 'checked' : '' %>>
                            <label class="form-check-label text-light" for="is_featured">
                                <i class="bi bi-award me-1" style="color: #ffd700;"></i> Destacado
                            </label>
                        </div>
                    </div>
                </div>

                <hr class="border-secondary my-4">
                
                <div class="d-flex justify-content-between">
                    <a href="/admin/dashboard#pills-seder" class="btn btn-outline-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn px-5 fw-bold" style="background: linear-gradient(135deg, #7c3aed, #a855f7); color: white; border: none;">
                        <i class="bi bi-check-lg me-1"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>
