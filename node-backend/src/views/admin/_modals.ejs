                        <div class="col-12">
                            <label class="form-label small text-white-50">Contenido Completo (Enseñanza)</label>
                            <div id="dyn-edit-editor-container" style="height:300px;background:white;color:black;border-radius:5px;"></div>
                            <input type="hidden" name="content" id="dynEditContentInput">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4">Actualizar Registro</button>
                </div>
            </form>
        </div>
    </div>
<!-- MODAL: AÑADIR SUSCRIPTOR MANUALMENTE -->
<div class="modal fade" id="createSubscriberModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title"><i class="bi bi-person-plus-fill text-info me-2"></i>Añadir Suscriptor al Boletín</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/subscribers/create" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small text-white-50">Correo Electrónico *</label>
                        <input type="email" name="email" class="form-control bg-dark text-white border-secondary" required placeholder="correo@ejemplo.com">
                    </div>
                    <p class="small text-white-50 mb-0">
                        <i class="bi bi-info-circle me-1 text-info"></i>
                        Este correo recibirá notificaciones automáticas cada vez que se publique una nueva Parashá, Enseñanza, Haftará, Semillas de Torah o Blog.
                    </p>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-info text-dark fw-bold px-4"><i class="bi bi-check-lg me-1"></i>Guardar Suscriptor</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: ENVIAR BOLETÍN / AVISO GENERAL A TODOS LOS SUSCRIPTORES -->
<div class="modal fade" id="broadcastNewsletterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title"><i class="bi bi-send-fill text-warning me-2"></i>Enviar Notificación / Boletín a Todos los Suscriptores</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/subscribers/broadcast" method="POST">
                <div class="modal-body">
                    <div class="alert alert-warning bg-warning bg-opacity-10 border-warning text-white small mb-3">
                        <i class="bi bi-broadcast me-1 text-warning fs-5"></i>
                        <strong>Atención:</strong> Este mensaje se enviará por correo electrónico a <strong>todos los usuarios registrados y activos</strong> en la lista de suscriptores.
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small text-white-50">Asunto del Correo *</label>
                            <input type="text" name="subject" class="form-control bg-dark text-white border-secondary" required placeholder="Ej: ✨ ¡Nueva Porción de la Torá y Noticias Importantes!">
                        </div>
                        <div class="col-12">
                            <label class="form-label small text-white-50">Mensaje / Contenido del Anuncio *</label>
                            <textarea name="message" class="form-control bg-dark text-white border-secondary" rows="5" required placeholder="Escribe aquí el mensaje, reflexión, aviso de Shabat o anuncio que deseas enviar a toda la congregación..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-white-50">Enlace / Botón de Acción (Opcional)</label>
                            <input type="text" name="actionUrl" class="form-control bg-dark text-white border-secondary" placeholder="Ej: /parashot o /ensenanzas">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-white-50">Texto del Botón</label>
                            <input type="text" name="actionText" class="form-control bg-dark text-white border-secondary" value="Ver en el Sitio Web" placeholder="Ej: Ver en el Sitio Web">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning text-dark fw-bold px-4" onclick="return confirm('¿Confirmas que deseas enviar este correo a todos los suscriptores?')">
                        <i class="bi bi-send-fill me-1"></i> Enviar a Todos los Suscriptores
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const qCfg = { theme:'snow', modules:{ toolbar:[[{'header':[1,2,3,false]}],['bold','italic','underline','strike'],[{'color':[]},{'background':[]}],['link','blockquote','code-block','image'],[{'list':'ordered'},{'list':'bullet'}],[{'align':[]}],['clean']] }};

    const qCreate = new Quill('#create-editor-container', qCfg);
    const qPort = new Quill('#port-editor-container', qCfg);
    const qEditPort = new Quill('#edit-port-editor-container', qCfg);
    const qEnsCreate = new Quill('#ensenanza-create-editor-container', qCfg);
    const qEnsEdit = new Quill('#ensenanza-edit-editor-container', qCfg);
    const qHafCreate = new Quill('#haftara-create-editor-container', qCfg);
    const qHafEdit = new Quill('#haftara-edit-editor-container', qCfg);
    const qBlogCreate = new Quill('#blog-create-editor-container', qCfg);
    const qBlogEdit = new Quill('#blog-edit-editor-container', qCfg);
    const qDynCreate = new Quill('#dyn-create-editor-container', qCfg);
    const qDynEdit = new Quill('#dyn-edit-editor-container', qCfg);

    // Image previews
    function setupPreview(urlId, fileId, prevId) {
        const u=document.getElementById(urlId), f=document.getElementById(fileId), p=document.getElementById(prevId);
        if(u) u.addEventListener('input',e=>{if(e.target.value)p.src=e.target.value;});
        if(f) f.addEventListener('change',function(){const file=this.files[0];if(file){const r=new FileReader();r.onload=e=>{p.src=e.target.result;};r.readAsDataURL(file);}});
    }
    setupPreview('create_image_url','create_image_file','createImgPreview');
    setupPreview('port_image_url','port_image_file','portImgPreview');
    setupPreview('edit_port_image_url','edit_port_image_file','editPortImgPreview');
    setupPreview('create_ens_image_url','create_ens_image_file','createEnsImgPreview');
    setupPreview('edit_ens_image_url','edit_ens_image_file','editEnsImgPreview');
    setupPreview('create_haf_image_url','create_haf_image_file','createHafImgPreview');
    setupPreview('edit_haf_image_url','edit_haf_image_file','editHafImgPreview');
    setupPreview('create_blog_image_url','create_blog_image_file','createBlogImgPreview');
    setupPreview('edit_blog_image_url','edit_blog_image_file','editBlogImgPreview');
    setupPreview('dyn_create_image_url','dyn_create_image_file','dynCreateImgPreview');
    setupPreview('dyn_edit_image_url','dyn_edit_image_file','dynEditImgPreview');

    // Edit Portfolio modal
    const editPortModal = new bootstrap.Modal(document.getElementById('editPortfolioModal'));
    document.querySelectorAll('.edit-portfolio-btn').forEach(btn=>{
        btn.onclick=function(){
            const d=this.dataset;
            document.getElementById('edit_port_id').value=d.id;
            document.getElementById('edit_port_title').value=d.title;
            var editCatSel=document.getElementById('edit_port_category');
            var catFound=false;
            for(var i=0;i<editCatSel.options.length;i++){if(editCatSel.options[i].value===d.category){catFound=true;break;}}
            if(!catFound && d.category){var opt=document.createElement('option');opt.value=d.category;opt.textContent=d.category;editCatSel.insertBefore(opt,editCatSel.querySelector('[value=__custom__]'));}
            editCatSel.value=d.category;
            document.getElementById('edit_port_category_custom_wrap').style.display='none';editCatSel.style.display='';
            document.getElementById('edit_port_date').value=d.date;
            document.getElementById('edit_port_subtitle').value=d.subtitle;
            document.getElementById('edit_port_description').value=d.description;
            document.getElementById('edit_port_image_url').value=d.image;
            document.getElementById('editPortImgPreview').src=d.image||'/assets/img/blog/blog-1.jpg';
            qEditPort.root.innerHTML=d.content;
            editPortModal.show();
        };
    });

    // Author Repeater Helpers for Ensenanzas
    function renderAuthorRow(containerId, author = { name: '', role: 'Moréh', img: '/assets/img/team/kaleb.jpg' }) {
        const container = document.getElementById(containerId);
        if (!container) return;

        const row = document.createElement('div');
        row.className = 'author-row d-flex align-items-center gap-2 p-2 rounded bg-black bg-opacity-25 border border-secondary border-opacity-25';
        row.innerHTML = `
            <div class="d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; flex-shrink: 0;">
                <img src="${author.img || '/assets/img/team/kaleb.jpg'}" class="author-row-preview rounded-circle border border-warning" style="width: 34px; height: 34px; object-fit: cover;" onerror="this.src='/assets/img/team/kaleb.jpg'">
            </div>
            <div class="flex-grow-1">
                <div class="row g-2">
                    <div class="col-md-5">
                        <input type="text" class="form-control form-control-sm author-name" placeholder="Nombre del expositor" value="${author.name || ''}" required>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control form-control-sm author-role" placeholder="Rol (Ej: Moréh)" value="${author.role || 'Moréh'}">
                    </div>
                    <div class="col-md-4">
                        <input type="text" class="form-control form-control-sm author-img" placeholder="URL Foto" value="${author.img || '/assets/img/team/kaleb.jpg'}">
                    </div>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-author" title="Eliminar expositor" style="padding: 0.25rem 0.5rem;">
                <i class="bi bi-trash"></i>
            </button>
        `;

        const imgInput = row.querySelector('.author-img');
        const imgPreview = row.querySelector('.author-row-preview');
        if (imgInput && imgPreview) {
            imgInput.addEventListener('input', e => {
                imgPreview.src = e.target.value || '/assets/img/team/kaleb.jpg';
            });
        }

        row.querySelector('.btn-remove-author').addEventListener('click', () => {
            if (container.querySelectorAll('.author-row').length > 1) {
                row.remove();
            } else {
                row.querySelector('.author-name').value = '';
                row.querySelector('.author-role').value = 'Moréh';
                row.querySelector('.author-img').value = '/assets/img/team/kaleb.jpg';
                if (imgPreview) imgPreview.src = '/assets/img/team/kaleb.jpg';
            }
        });

        container.appendChild(row);
        return row;
    }

    function serializeAuthors(containerId, hiddenInputId) {
        const container = document.getElementById(containerId);
        const hiddenInput = document.getElementById(hiddenInputId);
        if (!container || !hiddenInput) return;

        const list = [];
        container.querySelectorAll('.author-row').forEach(row => {
            const name = (row.querySelector('.author-name')?.value || '').trim();
            const role = (row.querySelector('.author-role')?.value || 'Moréh').trim();
            const img = (row.querySelector('.author-img')?.value || '/assets/img/team/kaleb.jpg').trim();
            if (name) {
                list.push({ name, role, img });
            }
        });

        if (list.length === 0) {
            list.push({ name: 'Moréh Kalev Aquerman', role: 'Moreh מורה', img: '/assets/img/team/kaleb.jpg' });
        }
        hiddenInput.value = JSON.stringify(list);
    }

    function setupQuickAddButtons(btnClass, containerId) {
        document.querySelectorAll('.' + btnClass).forEach(btn => {
            btn.onclick = function() {
                const name = this.dataset.name;
                const role = this.dataset.role;
                const img = this.dataset.img;
                const container = document.getElementById(containerId);
                if (!container) return;

                const rows = container.querySelectorAll('.author-row');
                let filled = false;
                for (let r of rows) {
                    const nameInput = r.querySelector('.author-name');
                    if (nameInput && !nameInput.value.trim()) {
                        nameInput.value = name;
                        if (r.querySelector('.author-role')) r.querySelector('.author-role').value = role;
                        if (r.querySelector('.author-img')) {
                            r.querySelector('.author-img').value = img;
                            const prev = r.querySelector('.author-row-preview');
                            if (prev) prev.src = img;
                        }
                        filled = true;
                        break;
                    }
                }
                if (!filled) {
                    renderAuthorRow(containerId, { name, role, img });
                }
            };
        });
    }

    // Init create authors container
    const createAuthorsCont = document.getElementById('create-authors-container');
    if (createAuthorsCont) {
        renderAuthorRow('create-authors-container', { name: 'Moréh Kalev Aquerman', role: 'Moreh מורה', img: '/assets/img/team/kaleb.jpg' });
        document.getElementById('btn-add-create-author')?.addEventListener('click', () => {
            renderAuthorRow('create-authors-container', { name: '', role: 'Moréh', img: '/assets/img/team/kaleb.jpg' });
        });
        setupQuickAddButtons('quick-add-team-create', 'create-authors-container');
    }

    // Init edit authors button
    document.getElementById('btn-add-edit-author')?.addEventListener('click', () => {
        renderAuthorRow('edit-authors-container', { name: '', role: 'Moréh', img: '/assets/img/team/kaleb.jpg' });
    });
    setupQuickAddButtons('quick-add-team-edit', 'edit-authors-container');

    // Edit Ensenanza modal
    const editEnsModal = new bootstrap.Modal(document.getElementById('editEnsenanzaModal'));
    document.querySelectorAll('.edit-ensenanza-btn').forEach(btn=>{
        btn.onclick=function(){
            const d=this.dataset;
            document.getElementById('edit_ens_id').value=d.id;
            document.getElementById('edit_ens_title').value=d.title;
            document.getElementById('edit_ens_subtitle').value=d.subtitle || '';
            document.getElementById('edit_ens_date').value=d.date || '';
            document.getElementById('edit_ens_description').value=d.description || '';
            document.getElementById('edit_ens_youtube').value=d.youtube || '';
            document.getElementById('edit_ens_image_url').value=d.image || '';
            document.getElementById('editEnsImgPreview').src=d.image || '';
            
            // Populate authors
            const editAuthorsCont = document.getElementById('edit-authors-container');
            if (editAuthorsCont) {
                editAuthorsCont.innerHTML = '';
                let authorsList = [];
                if (d.authors) {
                    try {
                        const parsed = JSON.parse(d.authors);
                        if (Array.isArray(parsed) && parsed.length > 0) authorsList = parsed;
                    } catch(e) {}
                }
                if (authorsList.length === 0) {
                    authorsList = [{
                        name: d.author || 'Moréh Kalev Aquerman',
                        role: d.author_role || 'Moreh מורה',
                        img: d.author_img || '/assets/img/team/kaleb.jpg'
                    }];
                }
                authorsList.forEach(a => renderAuthorRow('edit-authors-container', a));
            }

            qEnsEdit.root.innerHTML=d.content || '';
            editEnsModal.show();
        };
    });

    // Form submissions with Quill content & Authors
    const cEnsForm = document.getElementById('createEnsenanzaForm');
    if(cEnsForm) cEnsForm.onsubmit=function(){
        serializeAuthors('create-authors-container', 'create_ens_authors_json');
        document.getElementById('createEnsenanzaContentInput').value=qEnsCreate.root.innerHTML;
        return true;
    };
    const eEnsForm = document.getElementById('editEnsenanzaForm');
    if(eEnsForm) eEnsForm.onsubmit=function(){
        serializeAuthors('edit-authors-container', 'edit_ens_authors_json');
        document.getElementById('editEnsenanzaContentInput').value=qEnsEdit.root.innerHTML;
        return true;
    };

    // Init create haftara authors container
    const createHafAuthorsCont = document.getElementById('create-haf-authors-container');
    if (createHafAuthorsCont) {
        renderAuthorRow('create-haf-authors-container', { name: 'Moréh Kalev Aquerman', role: 'Moreh מורה', img: '/assets/img/team/kaleb.jpg' });
        document.getElementById('btn-add-create-haf-author')?.addEventListener('click', () => {
            renderAuthorRow('create-haf-authors-container', { name: '', role: 'Moréh', img: '/assets/img/team/kaleb.jpg' });
        });
        setupQuickAddButtons('quick-add-team-create-haf', 'create-haf-authors-container');
    }

    // Init edit haftara authors button
    document.getElementById('btn-add-edit-haf-author')?.addEventListener('click', () => {
        renderAuthorRow('edit-haf-authors-container', { name: '', role: 'Moréh', img: '/assets/img/team/kaleb.jpg' });
    });
    setupQuickAddButtons('quick-add-team-edit-haf', 'edit-haf-authors-container');

    // Edit Haftara modal
    const editHafModalEl = document.getElementById('editHaftaraModal');
    if (editHafModalEl) {
        const editHafModal = new bootstrap.Modal(editHafModalEl);
        document.querySelectorAll('.edit-haftara-btn').forEach(btn=>{
            btn.onclick=function(){
                const d=this.dataset;
                document.getElementById('edit_haf_id').value=d.id;
                document.getElementById('edit_haf_title').value=d.title;
                document.getElementById('edit_haf_subtitle').value=d.subtitle || '';
                document.getElementById('edit_haf_parasha_id').value=d.parasha_id || '';
                document.getElementById('edit_haf_reference').value=d.reference || '';
                document.getElementById('edit_haf_description').value=d.description || '';
                document.getElementById('edit_haf_youtube').value=d.youtube || '';
                document.getElementById('edit_haf_audio').value=d.audio || '';
                document.getElementById('edit_haf_image_url').value=d.image || '';
                document.getElementById('editHafImgPreview').src=d.image || '';

                // Populate authors for Haftara
                const editHafAuthorsCont = document.getElementById('edit-haf-authors-container');
                if (editHafAuthorsCont) {
                    editHafAuthorsCont.innerHTML = '';
                    let authorsList = [];
                    if (d.authors) {
                        try {
                            const parsed = JSON.parse(d.authors);
                            if (Array.isArray(parsed) && parsed.length > 0) authorsList = parsed;
                        } catch(e) {}
                    }
                    if (authorsList.length === 0) {
                        authorsList = [{
                            name: d.author || 'Moréh Kalev Aquerman',
                            role: d.author_role || 'Moreh מורה',
                            img: d.author_img || '/assets/img/team/kaleb.jpg'
                        }];
                    }
                    authorsList.forEach(a => renderAuthorRow('edit-haf-authors-container', a));
                }

                qHafEdit.root.innerHTML=d.content || '';
                editHafModal.show();
            };
        });
    }

    const cHafForm = document.getElementById('createHaftaraForm');
    if(cHafForm) cHafForm.onsubmit=function(){
        serializeAuthors('create-haf-authors-container', 'create_haf_authors_json');
        document.getElementById('createHaftaraContentInput').value=qHafCreate.root.innerHTML;
        return true;
    };
    const eHafForm = document.getElementById('editHaftaraForm');
    if(eHafForm) eHafForm.onsubmit=function(){
        serializeAuthors('edit-haf-authors-container', 'edit_haf_authors_json');
        document.getElementById('editHaftaraContentInput').value=qHafEdit.root.innerHTML;
        return true;
    };

    // Edit Blog modal
    const editBlogModalEl = document.getElementById('editBlogModal');
    if (editBlogModalEl) {
        const editBlogModal = new bootstrap.Modal(editBlogModalEl);
        document.querySelectorAll('.edit-blog-btn').forEach(btn=>{
            btn.onclick=function(){
                const d=this.dataset;
                document.getElementById('edit_blog_id').value=d.id;
                document.getElementById('edit_blog_title').value=d.title;
                document.getElementById('edit_blog_subtitle').value=d.subtitle || '';
                document.getElementById('edit_blog_author').value=d.author || 'Hablemos de YHWH';
                document.getElementById('edit_blog_summary').value=d.summary || '';
                document.getElementById('edit_blog_tags').value=d.tags || '';
                
                var editCatSel=document.getElementById('edit_blog_category');
                if (editCatSel) {
                    var catFound=false;
                    for(var i=0;i<editCatSel.options.length;i++){if(editCatSel.options[i].value===d.category){catFound=true;break;}}
                    if(!catFound && d.category){
                        var opt=document.createElement('option');opt.value=d.category;opt.textContent=d.category;
                        editCatSel.insertBefore(opt,editCatSel.querySelector('[value=__custom__]'));
                    }
                    editCatSel.value=d.category || 'Reflexiones';
                }
                
                document.getElementById('edit_blog_image_url').value=d.image || '';
                document.getElementById('editBlogImgPreview').src=d.image || '/assets/img/blog/blog-1.jpg';
                qBlogEdit.root.innerHTML=d.content || '';
                editBlogModal.show();
            };
        });
    }

    // Edit Team modal
    const editTeamModal = new bootstrap.Modal(document.getElementById('editTeamModal'));
    document.querySelectorAll('.edit-team-btn').forEach(btn=>{
        btn.onclick=function(){
            const d=this.dataset;
            document.getElementById('edit_team_id').value=d.id;
            document.getElementById('edit_team_name').value=d.name;
            document.getElementById('edit_team_role').value=d.role;
            document.getElementById('edit_team_description').value=d.description;
            document.getElementById('edit_team_image_url').value=d.img;
            editTeamModal.show();
        };
    });

    // Edit Testimonial modal
    const editTestModal = new bootstrap.Modal(document.getElementById('editTestimonialModal'));
    document.querySelectorAll('.edit-testimonial-btn').forEach(btn=>{
        btn.onclick=function(){
            const d=this.dataset;
            document.getElementById('edit_test_id').value=d.id;
            document.getElementById('edit_test_name').value=d.name;
            document.getElementById('edit_test_role').value=d.role;
            document.getElementById('edit_test_img').value=d.img;
            document.getElementById('edit_test_text').value=d.text;
            editTestModal.show();
        };
    });

    // Form submissions with Quill content
    document.getElementById('createParashaForm').onsubmit=function(){document.getElementById('createContentInput').value=qCreate.root.innerHTML;return true;};
    document.getElementById('createPortfolioForm').onsubmit=function(){document.getElementById('portContentInput').value=qPort.root.innerHTML;return true;};
    document.getElementById('editPortfolioForm').onsubmit=function(){document.getElementById('editPortContentInput').value=qEditPort.root.innerHTML;return true;};
    const cEnsForm = document.getElementById('createEnsenanzaForm');
    if(cEnsForm) cEnsForm.onsubmit=function(){document.getElementById('createEnsenanzaContentInput').value=qEnsCreate.root.innerHTML;return true;};
    const eEnsForm = document.getElementById('editEnsenanzaForm');
    if(eEnsForm) eEnsForm.onsubmit=function(){document.getElementById('editEnsenanzaContentInput').value=qEnsEdit.root.innerHTML;return true;};
    const cHafForm = document.getElementById('createHaftaraForm');
    if(cHafForm) cHafForm.onsubmit=function(){document.getElementById('createHaftaraContentInput').value=qHafCreate.root.innerHTML;return true;};
    const eHafForm = document.getElementById('editHaftaraForm');
    if(eHafForm) eHafForm.onsubmit=function(){document.getElementById('editHaftaraContentInput').value=qHafEdit.root.innerHTML;return true;};
    const cBlogForm = document.getElementById('createBlogForm');
    if(cBlogForm) cBlogForm.onsubmit=function(){document.getElementById('createBlogContentInput').value=qBlogCreate.root.innerHTML;return true;};
    const eBlogForm = document.getElementById('editBlogForm');
    if(eBlogForm) eBlogForm.onsubmit=function(){document.getElementById('editBlogContentInput').value=qBlogEdit.root.innerHTML;return true;};
    const cdf = document.getElementById('createDynamicForm');
    if(cdf) cdf.onsubmit=function(){document.getElementById('dynCreateContentInput').value=qDynCreate.root.innerHTML;return true;};
    const edf = document.getElementById('editDynamicForm');
    if(edf) edf.onsubmit=function(){document.getElementById('dynEditContentInput').value=qDynEdit.root.innerHTML;return true;};

    // Dynamic Modals Logic
    const createDynamicModalElement = document.getElementById('createDynamicModal');
    if (createDynamicModalElement) {
        const createDynamicModal = new bootstrap.Modal(createDynamicModalElement);
        document.querySelectorAll('.open-create-dynamic-modal').forEach(btn => {
            btn.onclick = function() {
                const table = this.dataset.table;
                const title = this.dataset.title;
                if (!table || table === 'null' || table === 'undefined') {
                    alert('Esta sección aún no tiene una tabla de datos asociada.');
                    return;
                }
                document.getElementById('createDynamicModalTitle').textContent = 'Añadir Nuevo Registro - ' + title;
                document.getElementById('createDynamicForm').action = '/admin/entity/' + table + '/add';
                qDynCreate.root.innerHTML = '';
                createDynamicModal.show();
            };
        });
    }

    const editDynamicModalElement = document.getElementById('editDynamicModal');
    if (editDynamicModalElement) {
        const editDynamicModal = new bootstrap.Modal(editDynamicModalElement);
        document.querySelectorAll('.edit-dynamic-btn').forEach(btn => {
            btn.onclick = function() {
                const table = this.dataset.table;
                const title = this.dataset.title;
                const id = this.dataset.id;
                const r = JSON.parse(this.dataset.record);

                document.getElementById('editDynamicModalTitle').textContent = 'Editar Registro - ' + title;
                document.getElementById('editDynamicForm').action = '/admin/entity/' + table + '/update/' + id;
                
                document.getElementById('edit_dyn_parasha_number').value = r.parasha_number || '';
                document.getElementById('edit_dyn_title').value = r.title || r.titulo || '';
                document.getElementById('edit_dyn_subtitle').value = r.subtitle || r.subtitulo || '';
                document.getElementById('edit_dyn_description').value = r.description || r.descripcion || '';
                document.getElementById('edit_dyn_youtube_link').value = r.youtube_link || r.video_url || '';
                document.getElementById('dyn_edit_image_url').value = r.image_url || r.imagen_url || '';
                document.getElementById('dynEditImgPreview').src = r.image_url || r.imagen_url || '';
                
                qDynEdit.root.innerHTML = r.content || r.contenido || '';
                
                editDynamicModal.show();
            };
        });
    }

    // Universal Tab & Hash Manager for Admin Panel
    function switchAdminTab(targetHash, updateUrl = true) {
        if (!targetHash) return;
        const hash = targetHash.startsWith('#') ? targetHash : '#' + targetHash;
        
        // Handle nested subtabs (Semillas Shorts / Enseñanzas)
        if (hash === '#admin-semillas-shorts' || hash === '#admin-semillas-ensenanzas') {
            const parentBtn = document.querySelector(`.nav-pills button[data-bs-target="#pills-semillas"]`);
            if (parentBtn) {
                bootstrap.Tab.getOrCreateInstance(parentBtn).show();
            }
            const subBtn = document.querySelector(`button[data-bs-target="${hash}"]`);
            if (subBtn) {
                setTimeout(() => {
                    bootstrap.Tab.getOrCreateInstance(subBtn).show();
                }, 30);
            }
        } else {
            const tabBtn = document.querySelector(`.nav-pills button[data-bs-target="${hash}"]`) || document.querySelector(`button[data-bs-target="${hash}"]`);
            if (tabBtn) {
                bootstrap.Tab.getOrCreateInstance(tabBtn).show();
            }
        }

        // Update active state in sidebar
        document.querySelectorAll('.sidebar a').forEach(a => {
            const href = a.getAttribute('href') || a.dataset.tabTarget || '';
            if (href.includes(hash)) {
                a.classList.add('active');
            } else if (href.includes('#pills-') || href.includes('#admin-')) {
                a.classList.remove('active');
            }
        });

        if (updateUrl && window.location.hash !== hash) {
            history.replaceState(null, null, hash);
        }
    }

    // Intercept clicks on sidebar links & stat cards
    document.addEventListener('click', function(e) {
        const target = e.target.closest('[data-tab-target], .sidebar a[href*="#"]');
        if (!target) return;
        
        const href = target.dataset.tabTarget || target.getAttribute('href') || '';
        if (href.includes('#')) {
            const hash = href.substring(href.indexOf('#'));
            if (window.location.pathname.includes('/admin/dashboard') || window.location.pathname === '/admin' || window.location.pathname === '/admin/') {
                e.preventDefault();
                switchAdminTab(hash, true);
            }
        }
    });

    // Run on initial load and back/forward navigation
    if (window.location.hash) {
        setTimeout(() => switchAdminTab(window.location.hash, false), 50);
    }
    window.addEventListener('hashchange', () => {
        if (window.location.hash) switchAdminTab(window.location.hash, false);
    });

    document.querySelectorAll('.nav-pills button, #semillasAdminTabs button').forEach(b => {
        b.addEventListener('shown.bs.tab', e => {
            const h = e.target.getAttribute('data-bs-target');
            if (h && window.location.hash !== h) history.replaceState(null, null, h);
            // Sync sidebar
            document.querySelectorAll('.sidebar a').forEach(a => {
                const href = a.getAttribute('href') || a.dataset.tabTarget || '';
                if (href.includes(h)) a.classList.add('active');
                else if (href.includes('#pills-') || href.includes('#admin-')) a.classList.remove('active');
            });
        });
    });
});

function filterAdminShorts(type, btn) {
    if (btn && btn.parentElement) {
        btn.parentElement.querySelectorAll('button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
    }
    const rows = document.querySelectorAll('#adminShortsTable tbody tr.short-row');
    rows.forEach(r => {
        if (type === 'all' || r.dataset.type === type) {
            r.style.display = '';
        } else {
            r.style.display = 'none';
        }
    });
}
</script>
