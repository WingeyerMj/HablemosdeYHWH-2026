            </form>
        </div>
    </div>
</div>

<!-- MODAL: NUEVA ENSEÑANZA -->
<div class="modal fade" id="createEnsenanzaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Añadir Nueva Enseñanza</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/ensenanzas/create" method="POST" enctype="multipart/form-data" id="createEnsenanzaForm">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small text-white-50">Título</label>
                            <input type="text" name="title" class="form-control" required placeholder="Ej: Las Raíces de la Fe">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-white-50">Subtítulo / Tema</label>
                            <input type="text" name="subtitle" class="form-control" placeholder="Ej: Estudio Bíblico Profundo">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-warning fw-bold"><i class="bi bi-calendar3 me-1"></i>Fecha en que se dictó</label>
                            <input type="date" name="teaching_date" class="form-control border-warning" required value="<%= new Date().toISOString().split('T')[0] %>">
                        </div>
                        <!-- Expositores Múltiples / Servidores -->
                        <div class="col-12">
                            <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.12);">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                    <label class="form-label mb-0 small text-warning fw-bold">
                                        <i class="bi bi-people-fill me-1"></i>Expositor(es) / Servidor(es)
                                    </label>
                                    <button type="button" class="btn btn-sm btn-outline-warning rounded-pill" id="btn-add-create-author">
                                        <i class="bi bi-plus-circle me-1"></i>Añadir otro expositor
                                    </button>
                                </div>

                                <% if (typeof team !== 'undefined' && team && team.length > 0) { %>
                                    <div class="mb-2 d-flex align-items-center gap-1 flex-wrap">
                                        <span class="small text-white-50 me-1" style="font-size: 0.75rem;">Añadir del equipo con 1 clic:</span>
                                        <% team.forEach(m => { %>
                                            <button type="button" class="btn btn-sm btn-dark border-secondary rounded-pill py-0 px-2 text-warning quick-add-team-create" 
                                                    style="font-size: 0.75rem;" 
                                                    data-name="<%= m.name %>" 
                                                    data-role="<%= m.role %>" 
                                                    data-img="<%= m.img %>">
                                                + <%= m.name %> (<%= m.role %>)
                                            </button>
                                        <% }) %>
                                    </div>
                                <% } %>

                                <div id="create-authors-container" class="d-flex flex-column gap-2 mt-2">
                                    <!-- Filas dinámicas de expositores -->
                                </div>
                                <input type="hidden" name="authors_json" id="create_ens_authors_json">
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small text-white-50">Resumen Breve (para tarjetas y listados)</label>
                            <textarea name="description" class="form-control" rows="2" placeholder="Breve introducción o descripción..."></textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small text-white-50">Link de YouTube (Video de la Enseñanza)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-youtube text-danger"></i></span>
                                <input type="text" name="youtube_link" class="form-control" placeholder="https://www.youtube.com/watch?v=... o https://youtu.be/...">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-white-50">Subir Imagen de Portada</label>
                            <input type="file" id="create_ens_image_file" name="image_file" class="form-control" accept="image/*">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-white-50">O URL de Imagen</label>
                            <input type="text" id="create_ens_image_url" name="image_url" class="form-control" placeholder="https://...">
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="border border-secondary rounded overflow-hidden d-flex align-items-center justify-content-center" style="height:100px;background:rgba(0,0,0,0.2);">
                                <img id="createEnsImgPreview" src="" style="max-width:100%;max-height:100%;object-fit:contain;">
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small text-white-50">Contenido Detallado del Estudio (Opcional)</label>
                            <div id="ensenanza-create-editor-container" style="height:250px;background:white;color:black;border-radius:5px;"></div>
                            <input type="hidden" name="content" id="createEnsenanzaContentInput">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success px-4">Guardar Enseñanza</button>
                </div>
            </form>
        </div>
    </div>
</div>

