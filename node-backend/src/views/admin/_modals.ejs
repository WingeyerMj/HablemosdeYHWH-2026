<!-- MODAL: CREAR HAFTARÁ -->
<div class="modal fade" id="createHaftaraModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title"><i class="bi bi-scroll me-2 text-warning"></i>Nueva Haftará (Lectura Profética)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/haftara/create" method="POST" enctype="multipart/form-data" id="createHaftaraForm">
                <div class="modal-body">
