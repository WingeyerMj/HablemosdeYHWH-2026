<!-- MODAL: NUEVO SHORT / ALIYÁ INFANTIL (NOVEDADES) -->
<div class="modal fade" id="createSemillasShortModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white">
                    <i class="bi bi-camera-reels-fill me-2" style="color: #38bdf8;"></i>Añadir Aliyá Infantil / Short (Novedades)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/semillas-shorts/create" method="POST" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-info fw-bold"><i class="bi bi-tags-fill me-1"></i>Tipo de Short *</label>
                            <select name="short_type" id="create_short_type" class="form-select bg-dark text-white border-info fw-semibold" onchange="const isG = this.value === 'general'; document.getElementById('create_short_cat_box').style.display = isG ? 'block' : 'none'; document.getElementById('create_short_parasha_box').style.display = isG ? 'none' : 'block'; document.getElementById('create_short_aliya_box').style.display = isG ? 'none' : 'block';">
                                <option value="aliya" selected>📖 Aliyá con Niños (Lectura Semanal)</option>
                                <option value="general">🌟 Short General / Temas Diversos (Historias, Reflexión, Valores)</option>
                            </select>
                        </div>
                        <div class="col-md-6" id="create_short_cat_box" style="display: none;">
                            <label class="form-label small text-warning fw-semibold"><i class="bi bi-bookmark-star me-1"></i>Tema / Categoría</label>
                            <input type="text" name="category" class="form-control" placeholder="Ej: Historia Bíblica, Valores, Canción, Reflexión" value="Temas Diversos">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-white-50">Título del Short *</label>
                            <input type="text" name="title" class="form-control" required placeholder="Ej: 1ª Aliyá de Bereshit con Lucas o Historia del Arca">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-white-50">Niño(s) Participante(s) (Opcional)</label>
                            <input type="text" name="child_name" class="form-control" placeholder="Ej: Lucas (6 años)">
                        </div>

                        <div class="col-md-5" id="create_short_parasha_box">
                            <label class="form-label small text-warning fw-semibold"><i class="bi bi-book me-1"></i>Parashá Relacionada</label>
                            <select name="parasha_name" class="form-select bg-dark text-white border-secondary">
                                <option value="">-- Seleccionar Parashá --</option>
                                <% if (typeof parashot !== 'undefined' && parashot && parashot.length > 0) { %>
                                    <% 
                                        const sortedParashot = [...parashot].sort((a, b) => (Number(a.parasha_number) || 999) - (Number(b.parasha_number) || 999));
                                        sortedParashot.forEach(p => { 
                                    %>
                                        <option value="<%= p.title %>">#<%= p.parasha_number || '' %> <%= p.title %> <%= p.subtitle ? `(${p.subtitle})` : '' %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-3" id="create_short_aliya_box">
                            <label class="form-label small text-white-50">Nº de Aliyá (1-7)</label>
                            <select name="aliyah_number" class="form-select bg-dark text-white border-secondary">
                                <option value="1">1ª Aliyá (Domingo)</option>
                                <option value="2">2ª Aliyá (Lunes)</option>
                                <option value="3">3ª Aliyá (Martes)</option>
                                <option value="4">4ª Aliyá (Miércoles)</option>
                                <option value="5">5ª Aliyá (Jueves)</option>
                                <option value="6">6ª Aliyá (Viernes)</option>
                                <option value="7">7ª Aliyá (Shabat)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-white-50">Cita Bíblica / Versículos</label>
                            <input type="text" name="verses_reference" class="form-control" placeholder="Ej: Génesis 1:1 - 1:5">
                        </div>

                        <!-- Video Source -->
                        <div class="col-md-6">
                            <label class="form-label small text-white-50">Subir Video (MP4 / WebM Vertical o Normal)</label>
                            <input type="file" name="video_upload" class="form-control bg-dark text-white border-secondary" accept="video/*">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-white-50">O Link de YouTube Short / Video</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-youtube text-danger"></i></span>
                                <input type="text" name="youtube_short_url" class="form-control" placeholder="https://youtube.com/shorts/... o video URL">
                            </div>
                        </div>

                        <!-- Thumbnail -->
                        <div class="col-md-6">
                            <label class="form-label small text-white-50">Subir Miniatura / Portada (Foto Vertical)</label>
                            <input type="file" name="thumbnail_file" class="form-control" accept="image/*">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-white-50">O URL de Miniatura</label>
                            <input type="text" name="thumbnail_url" class="form-control" placeholder="https://...">
                        </div>

                        <div class="col-12">
                            <label class="form-label small text-white-50">Descripción / Mensaje / Enseñanza</label>
                            <textarea name="description" class="form-control" rows="3" placeholder="Breve mensaje sobre la lectura del niño o reflexión..."></textarea>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="is_highlight" value="1" id="short_is_highlight">
                                <label class="form-check-label text-warning small fw-bold" for="short_is_highlight">
                                    <i class="bi bi-star-fill me-1"></i> Destacar como Novedad Principal
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="is_published" value="1" id="short_is_published" checked>
                                <label class="form-check-label text-white small" for="short_is_published">Publicar de inmediato</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 fw-bold"><i class="bi bi-cloud-arrow-up-fill me-1"></i> Guardar y Publicar Short</button>
                </div>
            </form>
        </div>
    </div>
</div>

