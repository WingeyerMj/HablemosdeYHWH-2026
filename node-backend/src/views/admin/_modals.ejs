<!-- MODAL: NUEVA PUBLICACIÓN DE BLOG -->
<div class="modal fade" id="createBlogModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title"><i class="bi bi-newspaper me-2 text-warning"></i>Nueva Publicación de Blog</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/blog/create" method="POST" enctype="multipart/form-data" id="createBlogForm">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-white-50">Título del Artículo</label>
                            <input type="text" name="title" class="form-control" required placeholder="Ej: Reflexiones sobre el Salmo 23">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-white-50">Categoría</label>
                            <select name="category" class="form-select" id="create_blog_category" onchange="if(this.value==='__custom__'){this.style.display='none';document.getElementById('create_blog_cat_wrap').style.display='flex';}">
                                <option value="Reflexiones">Reflexiones</option>
                                <option value="Estudios">Estudios</option>
                                <option value="Noticias">Noticias</option>
                                <option value="Comunidad">Comunidad</option>
                                <% if (typeof blogCategories !== 'undefined' && blogCategories.length > 0) { %>
                                    <% blogCategories.forEach(cat => { %>
                                        <% if (!['Reflexiones','Estudios','Noticias','Comunidad'].includes(cat.category)) { %>
                                            <option value="<%= cat.category %>"><%= cat.category %></option>
                                        <% } %>
                                    <% }) %>
                                <% } %>
                                <option value="__custom__">+ Nueva categoría...</option>
                            </select>
                            <div id="create_blog_cat_wrap" style="display:none;" class="input-group mt-1">
                                <input type="text" id="create_blog_cat_custom" class="form-control" placeholder="Nombre de la categoría">
                                <button type="button" class="btn btn-outline-light btn-sm" onclick="var inp=document.getElementById('create_blog_cat_custom');var sel=document.getElementById('create_blog_category');if(inp.value.trim()){var opt=document.createElement('option');opt.value=inp.value.trim();opt.textContent=inp.value.trim();sel.insertBefore(opt,sel.querySelector('[value=__custom__]'));sel.value=inp.value.trim();inp.value='';this.parentNode.style.display='none';sel.style.display='';}">✓</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="this.parentNode.style.display='none';document.getElementById('create_blog_category').style.display='';document.getElementById('create_blog_category').value='Reflexiones';">✕</button>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-white-50">Autor</label>
                            <input type="text" name="author" class="form-control" value="Hablemos de YHWH" placeholder="Nombre del autor">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small text-white-50">Subtítulo / Bajada</label>
                            <input type="text" name="subtitle" class="form-control" placeholder="Frase corta explicativa...">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-white-50">Etiquetas / Tags (separadas por coma)</label>
                            <input type="text" name="tags" class="form-control" placeholder="Ej: Fe, Torah, Shabat, Oración">
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small text-white-50">Resumen Breve (para tarjetas y listados)</label>
                            <textarea name="summary" class="form-control" rows="2" placeholder="Resumen conciso del artículo..."></textarea>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small text-white-50">Subir Imagen de Portada</label>
                            <input type="file" id="create_blog_image_file" name="image_file" class="form-control" accept="image/*">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-white-50">O URL de Imagen</label>
                            <input type="text" id="create_blog_image_url" name="image_url" class="form-control" placeholder="https://...">
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="border border-secondary rounded overflow-hidden d-flex align-items-center justify-content-center" style="height:100px;background:rgba(0,0,0,0.2);">
                                <img id="createBlogImgPreview" src="/assets/img/blog/blog-1.jpg" style="max-width:100%;max-height:100%;object-fit:contain;">
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label small text-white-50">Contenido Completo del Artículo</label>
                            <div id="blog-create-editor-container" style="height:280px;background:white;color:black;border-radius:5px;"></div>
                            <input type="hidden" name="content" id="createBlogContentInput">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success px-4"><i class="bi bi-check-lg me-1"></i>Publicar Artículo</button>
                </div>
            </form>
        </div>
    </div>
</div>

