                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-white-50">Categoría</label>
                            <select name="category" id="edit_blog_category" class="form-select" onchange="if(this.value==='__custom__'){this.style.display='none';document.getElementById('edit_blog_cat_wrap').style.display='flex';}">
                                <option value="Reflexiones">Reflexiones</option>
                                <option value="Estudios">Estudios</option>
                                <option value="Noticias">Noticias</option>
                                <option value="Comunidad">Comunidad</option>
                                <% if (typeof blogCategories !== 'undefined' && blogCategories.length > 0) { %>
                                    <% blogCategories.forEach(cat => { %>
                                        <% if (!['Reflexiones','Estudios','Noticias','Comunidad'].includes(cat.category)) { %>
                                            <option value="<%= cat.category %>"><%= cat.category %></option>
                                        <% } %>
                                    <% }) %>
                                <% } %>
                                <option value="__custom__">+ Nueva categoría...</option>
                            </select>
                            <div id="edit_blog_cat_wrap" style="display:none;" class="input-group mt-1">
                                <input type="text" id="edit_blog_cat_custom" class="form-control" placeholder="Nombre de la categoría">
                                <button type="button" class="btn btn-outline-light btn-sm" onclick="var inp=document.getElementById('edit_blog_cat_custom');var sel=document.getElementById('edit_blog_category');if(inp.value.trim()){var opt=document.createElement('option');opt.value=inp.value.trim();opt.textContent=inp.value.trim();sel.insertBefore(opt,sel.querySelector('[value=__custom__]'));sel.value=inp.value.trim();inp.value='';this.parentNode.style.display='none';sel.style.display='';}">✓</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="this.parentNode.style.display='none';document.getElementById('edit_blog_category').style.display='';">✕</button>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-white-50">Autor</label>
                            <input type="text" name="author" id="edit_blog_author" class="form-control">
                        </div>

                        <div class="col-md-6">
