<!-- Sidebar -->
<%- include('partials/_sidebar') %>

<main class="col-md-10 main-content">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-white"><i class="bi bi-journal-richtext me-2 text-success"></i>Editar Resumen de Parashá / Artículo Ilustrado</h1>
            <p class="text-white-50 mb-0">Ministerio Semillas de Torah • Editando: <strong class="text-success"><%= item.title %></strong></p>
        </div>
        <div class="d-flex gap-2">
            <a href="/semillas-de-torah/articulo/<%= item.id %>" target="_blank" class="btn btn-outline-info"><i class="bi bi-eye"></i> Ver en la Web</a>
            <a href="/admin/dashboard#admin-semillas-articulos" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
        </div>
    </div>

    <%
        let galleryList = [];
        if (item.gallery_images) {
            try {
                galleryList = typeof item.gallery_images === 'string' ? JSON.parse(item.gallery_images) : item.gallery_images;
                if (!Array.isArray(galleryList)) galleryList = [];
            } catch(e) {
                galleryList = [];
            }
        }
    %>

    <form action="/admin/semillas-articulos/update" method="POST" enctype="multipart/form-data" id="editSemillasArticuloForm">
        <input type="hidden" name="id" value="<%= item.id %>">
        
        <div class="row g-4">
            
            <!-- INFORMACIÓN PRINCIPAL -->
            <div class="col-lg-8">
                <div class="card bg-dark border-secondary p-4 rounded-4 shadow-sm mb-4">
                    <h5 class="text-white fw-bold mb-3 pb-2 border-bottom border-secondary">
                        <i class="bi bi-card-heading me-2 text-success"></i>Contenido del Resumen
                    </h5>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label text-success fw-bold">Título del Artículo / Resumen *</label>
                            <input type="text" name="title" class="form-control bg-dark text-white border-success" required value="<%= item.title %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-info fw-bold">Nombre de la Parashá</label>
                            <input type="text" name="parasha_name" class="form-control bg-dark text-white border-info" value="<%= item.parasha_name || '' %>">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-warning fw-bold">Cita Bíblica</label>
                            <input type="text" name="biblical_reference" class="form-control bg-dark text-white border-secondary" value="<%= item.biblical_reference || '' %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-light fw-bold">Categoría</label>
                            <select name="category" class="form-select bg-dark text-white border-secondary">
                                <option value="Resumen Semanal de Parashá" <%= item.category === 'Resumen Semanal de Parashá' ? 'selected' : '' %>>📖 Resumen Semanal de Parashá</option>
                                <option value="Infografía Infantil" <%= item.category === 'Infografía Infantil' ? 'selected' : '' %>>🎨 Infografía Infantil / Aliyot</option>
                                <option value="Historias Bíblicas Ilustradas" <%= item.category === 'Historias Bíblicas Ilustradas' ? 'selected' : '' %>>🌿 Historias Bíblicas Ilustradas</option>
                                <option value="Valores de la Torá" <%= item.category === 'Valores de la Torá' ? 'selected' : '' %>>💚 Valores de la Torá para Niños</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-warning fw-bold">Versículo Clave o Frase Destacada</label>
                            <input type="text" name="key_verse" class="form-control bg-dark text-white border-secondary" value="<%= item.key_verse || '' %>">
                        </div>

                        <div class="col-12">
                            <label class="form-label text-success fw-bold">
                                Resumen de la Enseñanza (Con Emojis y Formato) *
                            </label>
                            <textarea name="summary" class="form-control bg-dark text-white border-success" rows="7" required><%= item.summary || '' %></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-white-50 small">Notas o Explicación Extendida para Padres / Maestros (Opcional)</label>
                            <div id="edit-articulo-editor" style="height:220px;background:white;color:black;border-radius:5px;"></div>
                            <input type="hidden" name="content" id="editArticuloContent">
                        </div>
                    </div>
                </div>
            </div>

            <!-- LATERAL: IMÁGENES, GALERÍA, PDF Y PUBLICACIÓN -->
            <div class="col-lg-4">
                
                <!-- PORTADA / INFOGRAFÍA PRINCIPAL -->
                <div class="card bg-dark border-secondary p-4 rounded-4 shadow-sm mb-4">
                    <h5 class="text-white fw-bold mb-3 pb-2 border-bottom border-secondary">
                        <i class="bi bi-image me-2 text-success"></i>Infografía / Portada Principal
                    </h5>

                    <div class="mb-3 text-center rounded-3 p-2" style="background: rgba(0,0,0,0.3); border: 2px solid rgba(34,197,94,0.3); min-height: 180px; display: flex; align-items: center; justify-content: center;">
                        <img id="editArtMainPreview" src="<%= item.main_image || '/assets/img/pagina/semillas_torah_banner.png' %>" style="max-width: 100%; max-height: 200px; object-fit: contain; border-radius: 6px;">
                    </div>

                    <label class="form-label text-white-50 small">Subir Nueva Imagen Principal</label>
                    <input type="file" name="image_file" class="form-control bg-dark text-white border-secondary mb-2" accept="image/*" onchange="previewEditImage(this, 'editArtMainPreview')">

                    <label class="form-label text-white-50 small">O URL de Imagen</label>
                    <input type="text" name="main_image" id="edit_art_main_image_url" class="form-control form-control-sm bg-dark text-white border-secondary" value="<%= item.main_image || '' %>">
                </div>

                <!-- GALERÍA DE IMÁGENES / ALIYOT ILUSTRADAS -->
                <div class="card bg-dark border-secondary p-4 rounded-4 shadow-sm mb-4">
                    <h5 class="text-white fw-bold mb-3 pb-2 border-bottom border-secondary">
                        <i class="bi bi-images me-2 text-info"></i>Galería de Imágenes (<%= galleryList.length %>)
                    </h5>

                    <% if (galleryList.length > 0) { %>
                        <div class="mb-3">
                            <label class="form-label text-white-50 small">Imágenes actuales guardadas:</label>
                            <div class="d-flex flex-wrap gap-2" id="existingGalleryContainer">
                                <% galleryList.forEach((imgUrl, idx) => { %>
                                    <div class="position-relative gallery-thumb-item" id="gallery-item-<%= idx %>" style="width: 70px; height: 70px; border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,0.2);">
                                        <img src="<%= imgUrl %>" style="width: 100%; height: 100%; object-fit: cover;">
                                        <input type="hidden" name="existing_gallery_images" value="<%= imgUrl %>">
                                        <button type="button" class="btn btn-danger btn-sm p-0 position-absolute top-0 end-0 rounded-circle d-flex align-items-center justify-content-center" style="width: 20px; height: 20px; font-size: 10px;" onclick="removeGalleryItem(<%= idx %>)" title="Eliminar imagen">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>

                    <label class="form-label text-white-50 small">Añadir más imágenes a la galería</label>
                    <input type="file" name="gallery_images" class="form-control bg-dark text-white border-secondary" accept="image/*" multiple>
                    <div class="small text-white-50 mt-1">Selecciona varias imágenes (Aliyot, fichas o fotos).</div>
                </div>

                <!-- PDF, AUTOR Y PUBLICACIÓN -->
                <div class="card bg-dark border-secondary p-4 rounded-4 shadow-sm mb-4">
                    <h5 class="text-white fw-bold mb-3 pb-2 border-bottom border-secondary">
                        <i class="bi bi-gear me-2 text-warning"></i>Configuración & Extras
                    </h5>

                    <div class="mb-3">
                        <label class="form-label text-danger fw-bold"><i class="bi bi-file-pdf me-1"></i>Ficha / Hoja en PDF</label>
                        <input type="file" name="pdf_upload" class="form-control bg-dark text-white border-secondary" accept="application/pdf">
                        <% if (item.pdf_file) { %>
                            <div class="mt-2 d-flex align-items-center justify-content-between p-2 rounded bg-black bg-opacity-40">
                                <a href="<%= item.pdf_file %>" target="_blank" class="small text-success text-decoration-none fw-semibold"><i class="bi bi-file-earmark-pdf me-1"></i>Ver PDF actual</a>
                                <input type="hidden" name="pdf_file" value="<%= item.pdf_file %>">
                            </div>
                        <% } %>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-light fw-semibold">Autor(a)</label>
                        <input type="text" name="author" class="form-control bg-dark text-white border-secondary" value="<%= item.author || 'Elva Avila' %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-light fw-semibold">Hashtags / Etiquetas</label>
                        <input type="text" name="tags" class="form-control bg-dark text-white border-secondary" value="<%= item.tags || '' %>">
                    </div>

                    <div class="form-check form-switch mt-3 pt-2 border-top border-secondary">
                        <input class="form-check-input" type="checkbox" name="is_published" value="1" id="edit_art_published" <%= item.is_published ? 'checked' : '' %>>
                        <label class="form-check-label text-white fw-bold" for="edit_art_published">Publicado en la Web</label>
                    </div>
                </div>

                <!-- BOTONES DE ACCIÓN -->
                <div class="d-flex gap-2">
                    <a href="/admin/dashboard#admin-semillas-articulos" class="btn btn-outline-secondary w-50 py-2">Cancelar</a>
                    <button type="submit" class="btn btn-success w-50 py-2 fw-bold"><i class="bi bi-check-lg me-1"></i>Guardar</button>
                </div>

            </div>
        </div>
    </form>
</main>

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<script>
function previewEditImage(input, previewId) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const img = document.getElementById(previewId);
            if (img) img.src = e.target.result;
        };
        reader.readAsDataURL(input.files[0]);
    }
}

function removeGalleryItem(idx) {
    const el = document.getElementById('gallery-item-' + idx);
    if (el) el.remove();
}

document.addEventListener('DOMContentLoaded', function() {
    const quill = new Quill('#edit-articulo-editor', {
        theme: 'snow',
        modules: { toolbar: [[{'header':[1,2,3,false]}],['bold','italic','underline'],[{'color':[]},{'background':[]}],['link','blockquote'],[{'list':'ordered'},{'list':'bullet'}],['clean']] }
    });
    
    <% if (item.content) { %>
        quill.root.innerHTML = `<%- (item.content || '').replace(/`/g, '\\`').replace(/\\/g, '\\\\') %>`;
    <% } %>

    document.getElementById('editSemillasArticuloForm').onsubmit = function() {
        document.getElementById('editArticuloContent').value = quill.root.innerHTML;
    };
});
</script>
