<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-white">Editar Parasha: <%= parasha.title %></h1>
        <a href="/admin/dashboard" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card bg-dark text-white border-secondary shadow-sm">
        <div class="card-body">
            <form action="/admin/parashot/update" method="POST" id="parashaForm" enctype="multipart/form-data">
                <input type="hidden" name="id" value="<%= parasha.id %>">
                
                <div class="row g-4">
                    <!-- Título y Subtítulo -->
                    <div class="col-md-6">
                        <label class="form-label">Título de la Parasha</label>
                        <input type="text" name="title" class="form-control bg-secondary text-white border-0" 
                               value="<%= parasha.title %>" required placeholder="Bereshit, Noaj...">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Subtítulo / Versículo Clave</label>
                        <input type="text" name="subtitle" class="form-control bg-secondary text-white border-0" 
                               value="<%= parasha.subtitle || '' %>" placeholder="Génesis 1:1 - 6:8">
                    </div>

                    <!-- Resumen breve -->
                    <div class="col-md-12">
                        <label class="form-label">Resumen Breve (para listas)</label>
                        <input type="text" name="description" class="form-control bg-secondary text-white border-0" 
                               value="<%= parasha.description || '' %>" placeholder="Breve introducción...">
                    <div class="col-md-12">
                        <label class="form-label">Link de YouTube (Video de la enseñanza)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-secondary text-white border-0"><i class="bi bi-youtube" style="color: #ff0000;"></i></span>
                            <input type="text" name="youtube_link" class="form-control bg-secondary text-white border-0" 
                                   value="<%= parasha.youtube_link || '' %>" placeholder="https://www.youtube.com/watch?v=...">
                        </div>
                    </div>

                    <!-- Imagen de Carátula -->
                    <div class="col-md-4">
                        <label class="form-label">Subir nueva imagen (PC)</label>
                        <input type="file" name="image_file" class="form-control bg-secondary text-white border-0">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">O cambiar URL de Imagen</label>
                        <div class="input-group">
                            <span class="input-group-text bg-secondary text-white border-0"><i class="bi bi-link"></i></span>
                            <input type="text" name="image_url" id="image_url" class="form-control bg-secondary text-white border-0" 
                                   value="<%= parasha.image_url || '' %>" placeholder="https://ejemplo.com/imagen.jpg">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Previsualización Actual</label>
                        <div class="border border-secondary rounded overflow-hidden d-flex align-items-center justify-content-center" style="height: 150px; background: rgba(0,0,0,0.2);">
                            <img id="imgPreview" src="<%= parasha.image_url || '/assets/img/blog/blog-1.jpg' %>" 
                                 style="max-width: 100%; max-height: 100%; object-fit: contain;">
                        </div>
                    </div>

                    <!-- Editor de Texto Enriquecido -->
                    <div class="col-12">
                        <label class="form-label">Contenido de la Parasha</label>
                        <div id="editor-container" style="height: 400px; background: white; color: black; border-radius: 0 0 5px 5px;">
                            <%- parasha.content || '' %>
                        </div>
                        <input type="hidden" name="content" id="contentInput">
                    </div>

                    <div class="col-12 text-end mt-4">
                        <button type="submit" class="btn btn-primary px-5 py-2">
                             <i class="bi bi-save"></i> Guardar Cambios
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Incluir Quill CSS y JS -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

<script>
    // Inicializar el editor Quill
    const quill = new Quill('#editor-container', {
        theme: 'snow',
        modules: {
            toolbar: [
                [{ 'header': [1, 2, 3, false] }],
                ['bold', 'italic', 'underline', 'strike'],
                [{ 'color': [] }, { 'background': [] }],
                ['link', 'blockquote', 'code-block', 'image'],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                [{ 'align': [] }],
                ['clean']
            ]
        }
    });

    // Sincronizar previsualización de imagen desde URL
    const imageInput = document.getElementById('image_url');
    const fileInput = document.querySelector('input[name="image_file"]');
    const imgPreview = document.getElementById('imgPreview');

    imageInput.addEventListener('input', (e) => {
        if (e.target.value) imgPreview.src = e.target.value;
    });

    // Sincronizar previsualización desde archivo local
    fileInput.addEventListener('change', function() {
        const file = this.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                imgPreview.src = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    });

    // Antes de enviar el formulario, pasar el HTML del editor al input hidden
    const form = document.getElementById('parashaForm');
    form.onsubmit = function() {
        const contentInput = document.getElementById('contentInput');
        contentInput.value = quill.root.innerHTML;
        return true;
    };
</script>
