<!-- Sidebar -->
<%- include('partials/_sidebar') %>

<main class="col-md-10 main-content">
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-scroll me-2" style="color: var(--primary-color);"></i>Editar Haftará</h1>
            <p class="text-white-50 mb-0">Editando: <strong><%= haftara.title %></strong></p>
        </div>
        <a href="/admin/dashboard#pills-haftara" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>

    <form action="/admin/haftara/update" method="POST" enctype="multipart/form-data" id="editHaftaraPageForm">
        <input type="hidden" name="id" value="<%= haftara.id %>">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small text-white-50">Título</label>
                <input type="text" name="title" class="form-control" required value="<%= haftara.title %>">
            </div>
            <div class="col-md-6">
                <label class="form-label small text-warning fw-semibold"><i class="bi bi-link-45deg me-1"></i>Vincular a Parashá de la Torá</label>
                <select name="parasha_id" class="form-select">
                    <option value="">-- Sin vincular a Parashá (Opcional) --</option>
                    <% if (typeof parashot !== 'undefined' && parashot && parashot.length > 0) { %>
                        <% parashot.forEach(p => { %>
                            <option value="<%= p.id %>" <%= (haftara.parasha_id == p.id) ? 'selected' : '' %>>
                                #<%= p.parasha_number || '' %> <%= p.title %> <%= p.subtitle ? `(${p.subtitle})` : '' %>
                            </option>
                        <% }) %>
                    <% } %>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label small text-white-50">Texto / Referencia de la Parashá (ej: Correspondiente a Parashá Bereshit)</label>
                <input type="text" name="parasha_reference" class="form-control" value="<%= haftara.parasha_reference || '' %>">
            </div>

            <!-- Expositores / Lectores Múltiples -->
            <div class="col-12">
                <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.12);">
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                        <label class="form-label mb-0 small text-warning fw-bold">
                            <i class="bi bi-people-fill me-1"></i>Expositor(es) / Lector(es)
                        </label>
                        <button type="button" class="btn btn-sm btn-outline-warning rounded-pill" id="btn-add-page-haf-author">
                            <i class="bi bi-plus-circle me-1"></i>Añadir otro expositor/lector
                        </button>
                    </div>

                    <% if (typeof team !== 'undefined' && team && team.length > 0) { %>
                        <div class="mb-2 d-flex align-items-center gap-1 flex-wrap">
                            <span class="small text-white-50 me-1" style="font-size: 0.75rem;">Añadir del equipo con 1 clic:</span>
                            <% team.forEach(m => { %>
                                <button type="button" class="btn btn-sm btn-dark border-secondary rounded-pill py-0 px-2 text-warning quick-add-team-page-haf" 
                                        style="font-size: 0.75rem;" 
                                        data-name="<%= m.name %>" 
                                        data-role="<%= m.role %>" 
                                        data-img="<%= m.img %>">
                                    + <%= m.name %> (<%= m.role %>)
                                </button>
                            <% }) %>
                        </div>
                    <% } %>

                    <div id="page-haf-authors-container" class="d-flex flex-column gap-2 mt-2">
                        <!-- Filas de expositores -->
                    </div>
                    <input type="hidden" name="authors_json" id="page_edit_haf_authors_json">
                </div>
            </div>

            <div class="col-md-12">
                <label class="form-label small text-white-50">Resumen Breve</label>
                <textarea name="description" class="form-control" rows="2"><%= haftara.description || '' %></textarea>
            </div>

            <div class="col-md-6">
                <label class="form-label small text-white-50">Link de YouTube (Video)</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-youtube text-danger"></i></span>
                    <input type="text" name="youtube_link" class="form-control" value="<%= haftara.youtube_link || '' %>" placeholder="https://www.youtube.com/watch?v=...">
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label small text-white-50">URL de Audio (Opcional)</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-headphones text-warning"></i></span>
                    <input type="text" name="audio_url" class="form-control" value="<%= haftara.audio_url || '' %>" placeholder="https://... o /uploads/audios/...">
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label small text-white-50">Subir Nueva Imagen</label>
                <input type="file" name="image_file" id="edit_page_image_file" class="form-control" accept="image/*">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-white-50">O URL de Imagen</label>
                <input type="text" name="image_url" id="edit_page_image_url" class="form-control" value="<%= haftara.image_url || '' %>">
            </div>
            <div class="col-md-4 text-center">
                <div class="border border-secondary rounded overflow-hidden" style="height:120px;background:rgba(0,0,0,0.2);display:flex;align-items:center;justify-content:center;">
                    <img id="editPageImgPreview" src="<%= haftara.image_url || '' %>" style="max-width:100%;max-height:100%;object-fit:contain;">
                </div>
            </div>

            <div class="col-12">
                <label class="form-label small text-white-50">Contenido Detallado de la Lectura y Reflexión</label>
                <div id="edit-haftara-editor" style="height:400px;background:white;color:black;border-radius:5px;"></div>
                <input type="hidden" name="content" id="editHaftaraPageContent">
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4 mb-5 gap-3">
            <a href="/admin/dashboard#pills-haftara" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-primary px-5"><i class="bi bi-check-lg me-2"></i>Guardar Cambios</button>
        </div>
    </form>
</main>

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const quill = new Quill('#edit-haftara-editor', {
        theme: 'snow',
        modules: { toolbar: [[{'header':[1,2,3,false]}],['bold','italic','underline','strike'],[{'color':[]},{'background':[]}],['link','blockquote','code-block','image'],[{'list':'ordered'},{'list':'bullet'}],[{'align':[]}],['clean']] }
    });
    quill.root.innerHTML = `<%- (haftara.content || haftara.description || '').replace(/`/g, '\\`').replace(/\\/g, '\\\\') %>`;
    
    // Image previews
    const urlInput = document.getElementById('edit_page_image_url');
    const fileInput = document.getElementById('edit_page_image_file');
    const previewImg = document.getElementById('editPageImgPreview');

    if (urlInput) {
        urlInput.addEventListener('input', e => {
            if (e.target.value) previewImg.src = e.target.value;
        });
    }

    if (fileInput) {
        fileInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = e => {
                    previewImg.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    }

    // Multi-Author dynamic repeater
    function renderHafAuthorRow(containerId, author = {}) {
        const cont = document.getElementById(containerId);
        if (!cont) return;
        const row = document.createElement('div');
        row.className = 'author-row d-flex align-items-center gap-2 p-2 rounded-2 mb-1';
        row.style.background = 'rgba(255,255,255,0.06)';
        row.style.border = '1px solid rgba(255,255,255,0.1)';
        
        const avatarImg = author.img || '/assets/img/team/kaleb.jpg';
        const nameVal = author.name || '';
        const roleVal = author.role || 'Moréh';

        row.innerHTML = `
            <img src="${avatarImg}" class="author-row-preview rounded-circle border border-warning" style="width: 38px; height: 38px; object-fit: cover; flex-shrink: 0;" onerror="this.src='/assets/img/team/kaleb.jpg'">
            <div class="flex-grow-1">
                <input type="text" class="form-control form-control-sm author-name-input" placeholder="Nombre (ej: Moréh Kaleb)" value="${nameVal.replace(/"/g, '&quot;')}" required>
            </div>
            <div style="width: 140px;">
                <input type="text" class="form-control form-control-sm author-role-input" placeholder="Rol" value="${roleVal.replace(/"/g, '&quot;')}">
            </div>
            <div class="flex-grow-1 d-none d-md-block">
                <input type="text" class="form-control form-control-sm author-img-input" placeholder="URL Foto" value="${avatarImg.replace(/"/g, '&quot;')}">
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-author px-2" title="Eliminar"><i class="bi bi-trash"></i></button>
        `;

        const imgInput = row.querySelector('.author-img-input');
        const imgEl = row.querySelector('.author-row-preview');
        imgInput.addEventListener('input', e => {
            imgEl.src = e.target.value || '/assets/img/team/kaleb.jpg';
        });

        row.querySelector('.btn-remove-author').addEventListener('click', () => {
            if (cont.querySelectorAll('.author-row').length > 1) {
                row.remove();
            } else {
                row.querySelector('.author-name-input').value = '';
                row.querySelector('.author-role-input').value = 'Moréh';
                row.querySelector('.author-img-input').value = '/assets/img/team/kaleb.jpg';
                imgEl.src = '/assets/img/team/kaleb.jpg';
            }
        });

        cont.appendChild(row);
    }

    function serializeHafAuthors(containerId, hiddenInputId) {
        const cont = document.getElementById(containerId);
        const hiddenInput = document.getElementById(hiddenInputId);
        if (!cont || !hiddenInput) return;
        const rows = cont.querySelectorAll('.author-row');
        const list = [];
        rows.forEach(r => {
            const name = r.querySelector('.author-name-input')?.value.trim();
            const role = r.querySelector('.author-role-input')?.value.trim() || 'Moréh';
            const img = r.querySelector('.author-img-input')?.value.trim() || '/assets/img/team/kaleb.jpg';
            if (name) list.push({ name, role, img });
        });
        hiddenInput.value = JSON.stringify(list);
    }

    // Populate initial authors
    const initialAuthors = <%- JSON.stringify(haftara.authors_list || [{ name: haftara.author || 'Moréh Kalev Aquerman', role: haftara.author_role || 'Moreh מורה', img: haftara.author_img || '/assets/img/team/kaleb.jpg' }]) %>;
    if (initialAuthors && initialAuthors.length > 0) {
        initialAuthors.forEach(a => renderHafAuthorRow('page-haf-authors-container', a));
    } else {
        renderHafAuthorRow('page-haf-authors-container', { name: 'Moréh Kalev Aquerman', role: 'Moreh מורה', img: '/assets/img/team/kaleb.jpg' });
    }

    document.getElementById('btn-add-page-haf-author')?.addEventListener('click', () => {
        renderHafAuthorRow('page-haf-authors-container', { name: '', role: 'Moréh', img: '/assets/img/team/kaleb.jpg' });
    });

    document.querySelectorAll('.quick-add-team-page-haf').forEach(btn => {
        btn.addEventListener('click', () => {
            const { name, role, img } = btn.dataset;
            renderHafAuthorRow('page-haf-authors-container', { name, role, img });
        });
    });

    document.getElementById('editHaftaraPageForm').onsubmit = function() {
        serializeHafAuthors('page-haf-authors-container', 'page_edit_haf_authors_json');
        document.getElementById('editHaftaraPageContent').value = quill.root.innerHTML;
        return true;
    };
});
</script>
