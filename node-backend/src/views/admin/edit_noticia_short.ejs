<!-- Sidebar -->
<%- include('partials/_sidebar') %>

<main class="col-md-10 main-content">
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-camera-video me-2" style="color: var(--primary-color);"></i>Editar Short de Noticias</h1>
            <p class="text-white-50 mb-0">Editando: <strong><%= item.title %></strong></p>
        </div>
        <a href="/admin/dashboard#pills-noticias-shorts" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver al Dashboard</a>
    </div>

    <form action="/admin/noticias-shorts/update" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="id" value="<%= item.id %>">
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label small text-white-50">Título del Short / Video</label>
                <input type="text" name="title" class="form-control" required value="<%= item.title %>">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-white-50">Categoría</label>
                <input type="text" name="category" class="form-control" value="<%= item.category || 'Actualidad' %>" placeholder="Ej: Actualidad, Profecía, Arqueología">
            </div>

            <div class="col-md-6">
                <label class="form-label small text-white-50">Enlace a YouTube Short</label>
                <input type="url" name="youtube_short_url" class="form-control" value="<%= item.youtube_short_url || '' %>" placeholder="https://www.youtube.com/shorts/...">
            </div>
            <div class="col-md-6">
                <label class="form-label small text-white-50">O Enlace a YouTube Video</label>
                <input type="url" name="youtube_url" class="form-control" value="<%= item.youtube_url || '' %>" placeholder="https://www.youtube.com/watch?v=...">
            </div>

            <div class="col-md-6">
                <label class="form-label small text-white-50">Miniatura (Subir imagen vertical 9:16 o cuadrada)</label>
                <input type="file" name="thumbnail_file" class="form-control" accept="image/*">
            </div>
            <div class="col-md-6">
                <label class="form-label small text-white-50">O URL de Miniatura</label>
                <input type="text" name="thumbnail_url" class="form-control" value="<%= item.thumbnail_url || '' %>">
            </div>

            <div class="col-md-6">
                <label class="form-label small text-white-50">Subir Archivo de Video MP4 (Opcional si no es YouTube)</label>
                <input type="file" name="video_file" class="form-control" accept="video/mp4,video/webm">
            </div>
            <div class="col-md-6">
                <label class="form-label small text-white-50">O URL directa de Video MP4</label>
                <input type="text" name="video_url" class="form-control" value="<%= item.video_url || '' %>">
            </div>

            <div class="col-md-8">
                <label class="form-label small text-white-50">Descripción Breve</label>
                <textarea name="description" class="form-control" rows="3"><%= item.description || '' %></textarea>
            </div>
            <div class="col-md-4">
                <label class="form-label small text-white-50">Fuente / Crédito</label>
                <input type="text" name="source_name" class="form-control" value="<%= item.source_name || 'Hablemos de YHWH' %>">
            </div>

            <div class="col-md-6">
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" name="is_highlight" value="1" id="short_highlight" <%= item.is_highlight ? 'checked' : '' %>>
                    <label class="form-check-label text-warning fw-bold" for="short_highlight">⭐ Destacar en primera posición</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" name="is_published" value="1" id="short_published" <%= item.is_published ? 'checked' : '' %>>
                    <label class="form-check-label text-white" for="short_published">Publicado</label>
                </div>
            </div>
        </div>

        <div class="mt-4 pt-3 border-top border-secondary d-flex justify-content-end gap-2">
            <a href="/admin/dashboard#pills-noticias-shorts" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-primary px-5 fw-bold"><i class="bi bi-save me-2"></i>Guardar Cambios</button>
        </div>
    </form>
</main>
