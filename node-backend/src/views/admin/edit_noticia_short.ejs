<!-- Sidebar -->
<%- include('partials/_sidebar') %>

<main class="col-md-10 main-content">
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-camera-video me-2" style="color: var(--primary-color);"></i>Editar Short de Noticias</h1>
            <p class="text-white-50 mb-0">Editando: <strong><%= item.title %></strong></p>
        </div>
        <a href="/admin/dashboard#pills-noticias-shorts" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver al Dashboard</a>
    </div>

    <form action="/admin/noticias-shorts/update" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="id" value="<%= item.id %>">
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label small text-white-50">Título del Short / Video</label>
                <input type="text" name="title" class="form-control" required value="<%= item.title %>">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-white-50">Categoría</label>
                <input type="text" name="category" class="form-control" value="<%= item.category || 'Actualidad' %>" placeholder="Ej: Actualidad, Israel, Profecía">
            </div>

            <!-- ENLACE MULTI-PLATAFORMA -->
            <div class="col-12">
                <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(212,168,83,0.35);">
                    <label class="form-label fw-bold text-warning d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-link-45deg me-1 fs-5"></i> Enlace del Video o Short (Multi-Plataforma)</span>
                        <div class="d-flex gap-2" style="font-size: 0.82rem;">
                            <span class="badge bg-danger"><i class="bi bi-youtube me-1"></i>YouTube</span>
                            <span class="badge bg-dark border text-white"><i class="bi bi-tiktok me-1"></i>TikTok</span>
                            <span class="badge" style="background: #E1306C;"><i class="bi bi-instagram me-1"></i>Instagram</span>
                            <span class="badge bg-primary"><i class="bi bi-facebook me-1"></i>Facebook</span>
                            <span class="badge bg-info text-dark"><i class="bi bi-vimeo me-1"></i>Vimeo</span>
                        </div>
                    </label>
                    <input type="text" name="youtube_short_url" class="form-control form-control-lg" 
                           value="<%= item.youtube_short_url || item.youtube_url || item.video_url || '' %>" 
                           placeholder="Pega el enlace de YouTube Short, TikTok, Instagram Reel, Facebook Video, Vimeo o MP4...">
                    <small class="text-white-50 mt-1 d-block">
                        Acepta cualquier formato: <code>https://www.youtube.com/shorts/...</code>, <code>https://www.tiktok.com/@.../video/...</code>, <code>https://www.instagram.com/reel/...</code>, <code>https://fb.watch/...</code>, o enlaces <code>.mp4</code>.
                    </small>
                </div>
            </div>

            <!-- SUBIDA DE ARCHIVO DIRECTO (OPCIONAL) -->
            <div class="col-md-6">
                <label class="form-label small text-white-50">O Subir Archivo de Video desde tu Computadora (MP4, WebM)</label>
                <input type="file" name="video_file" class="form-control" accept="video/mp4,video/webm,video/quicktime">
                <% if (item.video_url && !item.video_url.includes('youtube') && !item.video_url.includes('tiktok') && !item.video_url.includes('instagram')) { %>
                    <small class="text-info mt-1 d-block"><i class="bi bi-check2-circle"></i> Video actual: <%= item.video_url %></small>
                <% } %>
            </div>
            <div class="col-md-6">
                <label class="form-label small text-white-50">O URL de Video MP4 Directo</label>
                <input type="text" name="video_url" class="form-control" value="<%= item.video_url || '' %>" placeholder="https://dominio.com/video.mp4">
            </div>

            <!-- MINIATURA -->
            <div class="col-md-6">
                <label class="form-label small text-white-50">Miniatura (Subir imagen vertical 9:16 o cuadrada)</label>
                <input type="file" name="thumbnail_file" class="form-control" accept="image/*">
            </div>
            <div class="col-md-6">
                <label class="form-label small text-white-50">O URL de Miniatura</label>
                <input type="text" name="thumbnail_url" class="form-control" value="<%= item.thumbnail_url || '' %>" placeholder="https://...">
            </div>

            <div class="col-md-8">
                <label class="form-label small text-white-50">Descripción Breve</label>
                <textarea name="description" class="form-control" rows="2"><%= item.description || '' %></textarea>
            </div>
            <div class="col-md-4">
                <label class="form-label small text-white-50">Fuente / Crédito</label>
                <input type="text" name="source_name" class="form-control" value="<%= item.source_name || 'Hablemos de YHWH' %>">
            </div>

            <div class="col-md-6">
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" name="is_highlight" value="1" id="short_highlight" <%= item.is_highlight ? 'checked' : '' %>>
                    <label class="form-check-label text-warning fw-bold" for="short_highlight">⭐ Destacar en primera posición</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" name="is_published" value="1" id="short_published" <%= item.is_published ? 'checked' : '' %>>
                    <label class="form-check-label text-white" for="short_published">Publicado</label>
                </div>
            </div>
        </div>

        <div class="mt-4 pt-3 border-top border-secondary d-flex justify-content-end gap-2">
            <a href="/admin/dashboard#pills-noticias-shorts" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-primary px-5 fw-bold"><i class="bi bi-save me-2"></i>Guardar Cambios</button>
        </div>
    </form>
</main>
