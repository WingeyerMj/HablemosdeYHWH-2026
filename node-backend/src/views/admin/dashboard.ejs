</div>
<div class="modal fade" id="createTestimonialModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Añadir Testimonio</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/testimonials/create" method="POST">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-white-50">Nombre</label>
                            <input type="text" name="name" class="form-control bg-secondary text-white border-0" required placeholder="Ej: Juan Pérez">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-white-50">Rol / Cargo</label>
                            <input type="text" name="role" class="form-control bg-secondary text-white border-0" required placeholder="Ej: Estudiante">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small text-white-50">URL de Imagen (Avatar)</label>
                            <input type="text" name="img" class="form-control bg-secondary text-white border-0" required placeholder="https://...">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small text-white-50">Testimonio</label>
                            <textarea name="text" class="form-control bg-secondary text-white border-0" rows="3" required placeholder="Escribe el testimonio aquí..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success px-4">Añadir Testimonio</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Quill -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // --- QUILL EDITORS ---
        const quillConfig = {
            theme: 'snow',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'color': [] }, { 'background': [] }],
                    ['link', 'blockquote', 'code-block', 'image'],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    [{ 'align': [] }],
                    ['clean']
                ]
            }
        };

        const quillParasha = new Quill('#create-editor-container', quillConfig);
        const quillPortfolio = new Quill('#port-editor-container', quillConfig);
        const quillEditPortfolio = new Quill('#edit-port-editor-container', quillConfig);

        // --- IMAGE PREVIEWS ---
        function setupPreview(inputId, fileId, previewId, defaultImg) {
            const textInput = document.getElementById(inputId);
            const fileInput = document.getElementById(fileId);
            const preview = document.getElementById(previewId);

            if (textInput) {
                textInput.addEventListener('input', (e) => {
                    if (e.target.value) preview.src = e.target.value;
                    else preview.src = defaultImg;
                });
            }

            if (fileInput) {
                fileInput.addEventListener('change', function() {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) { preview.src = e.target.result; }
                        reader.readAsDataURL(file);
                    }
                });
            }
        }

        setupPreview('create_image_url', 'create_image_file', 'createImgPreview', '/assets/img/blog/blog-1.jpg');
        setupPreview('port_image_url', 'port_image_file', 'portImgPreview', '/assets/img/blog/blog-1.jpg');
        setupPreview('edit_port_image_url', 'edit_port_image_file', 'editPortImgPreview', '/assets/img/blog/blog-1.jpg');
        setupPreview('team_image_url', 'team_image_file', 'teamImgPreview', '/assets/img/team/team-1.jpg');
        setupPreview('edit_team_image_url', 'edit_team_image_file', 'editTeamImgPreview', '/assets/img/team/team-1.jpg');

        // --- EDIT MODAL LOGIC ---
        const editPortfolioModal = new bootstrap.Modal(document.getElementById('editPortfolioModal'));
        document.querySelectorAll('.edit-portfolio-btn').forEach(btn => {
            btn.onclick = function() {
                const data = this.dataset;
                document.getElementById('edit_port_id').value = data.id;
                document.getElementById('edit_port_title').value = data.title;
                document.getElementById('edit_port_category').value = data.category;
                document.getElementById('edit_port_date').value = data.date;
                document.getElementById('edit_port_subtitle').value = data.subtitle;
                document.getElementById('edit_port_description').value = data.description;
                document.getElementById('edit_port_image_url').value = data.image;
                document.getElementById('editPortImgPreview').src = data.image || '/assets/img/blog/blog-1.jpg';
                quillEditPortfolio.root.innerHTML = data.content;
                editPortfolioModal.show();
            };
        });

        const editTeamModal = new bootstrap.Modal(document.getElementById('editTeamModal'));
        document.querySelectorAll('.edit-team-btn').forEach(btn => {
            btn.onclick = function() {
                const data = this.dataset;
                document.getElementById('edit_team_id').value = data.id;
                document.getElementById('edit_team_name').value = data.name;
                document.getElementById('edit_team_role').value = data.role;
                document.getElementById('edit_team_description').value = data.description;
                document.getElementById('edit_team_image_url').value = data.img;
                document.getElementById('editTeamImgPreview').src = data.img || '/assets/img/team/team-1.jpg';
                editTeamModal.show();
            };
        });

        const editTestimonialModal = new bootstrap.Modal(document.getElementById('editTestimonialModal'));
        document.querySelectorAll('.edit-testimonial-btn').forEach(btn => {
            btn.onclick = function() {
                const data = this.dataset;
                document.getElementById('edit_test_id').value = data.id;
                document.getElementById('edit_test_name').value = data.name;
                document.getElementById('edit_test_role').value = data.role;
                document.getElementById('edit_test_img').value = data.img;
                document.getElementById('edit_test_text').value = data.text;
                editTestimonialModal.show();
            };
        });

        // --- FORM SUBMISSIONS ---
        document.getElementById('createParashaForm').onsubmit = function() {
            document.getElementById('createContentInput').value = quillParasha.root.innerHTML;
            return true;
        };

        document.getElementById('createPortfolioForm').onsubmit = function() {
            document.getElementById('portContentInput').value = quillPortfolio.root.innerHTML;
            return true;
        };

        document.getElementById('editPortfolioForm').onsubmit = function() {
            document.getElementById('editPortContentInput').value = quillEditPortfolio.root.innerHTML;
            return true;
        };

        // --- TABS & HASH (MEJORADO) ---
        function activateTabFromHash() {
            const hash = window.location.hash;
            if (hash) {
                const triggerEl = document.querySelector(`.nav-pills button[data-bs-target="${hash}"]`);
                if (triggerEl) {
                    const tab = bootstrap.Tab.getOrCreateInstance(triggerEl);
                    tab.show();
                }
            }
        }

        // Ejecutar al cargar
        activateTabFromHash();

        // Escuchar cambios de hash (por si acaso)
        window.addEventListener('hashchange', activateTabFromHash);
        
        document.querySelectorAll('.nav-pills button').forEach(button => {
            button.addEventListener('shown.bs.tab', (e) => {
                const targetHash = e.target.getAttribute('data-bs-target');
                if (window.location.hash !== targetHash) {
                    history.replaceState(null, null, targetHash);
                }
            });
        });
    });
</script>