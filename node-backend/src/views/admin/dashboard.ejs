<nav class="col-md-2 d-md-block sidebar">
    <div class="text-center mb-4">
        <img src="/assets/img/pagina/logo.svg" alt="Logo" class="img-fluid"
            style="max-height: 60px; border-radius: 50%;">
        <h5 class="mt-2 fw-bold" style="color: var(--primary-color);">Admin Panel</h5>
    </div>
    <hr style="border-color: rgba(255,255,255,0.1);">

    <a href="/" target="_blank">
        <i class="bi bi-globe"></i> Ver mi Web
    </a>

    <a href="/admin/dashboard" class="active">
        <i class="bi bi-speedometer2"></i> Dashboard
    </a>

    <% if (role==='admin' ) { %>
        <a href="/admin/users">
            <i class="bi bi-people"></i> Usuarios
        </a>
        <% } %>

            <div class="mt-auto">
                <hr style="border-color: rgba(255,255,255,0.1);">
                <a href="/admin/logout" class="text-danger">
                    <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                </a>
                <div class="mt-3 small text-white-50 p-2">
                    <i class="bi bi-person-circle"></i>
                    <%= username %> <br>
                        <span class="badge bg-secondary mt-1">
                            <%= role %>
                        </span>
                </div>
            </div>
</nav>

<main class="col-md-10 p-4">
    <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-4 border-bottom">
        <h1 class="h2">Panel de Control</h1>
    </div>

    <!-- Tabs for Sections -->
    <ul class="nav nav-pills mb-4" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="pills-sections-tab" data-bs-toggle="pill"
                data-bs-target="#pills-sections" type="button" role="tab">📜 Secciones</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pills-services-tab" data-bs-toggle="pill" data-bs-target="#pills-services"
                type="button" role="tab">📖 Parashot</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pills-portfolio-tab" data-bs-toggle="pill" data-bs-target="#pills-portfolio"
                type="button" role="tab">🖼️ Eventos</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pills-team-tab" data-bs-toggle="pill" data-bs-target="#pills-team"
                type="button" role="tab">👥 Equipo</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pills-testimonials-tab" data-bs-toggle="pill"
                data-bs-target="#pills-testimonials" type="button" role="tab">⭐ Testimonios</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pills-pricing-tab" data-bs-toggle="pill" data-bs-target="#pills-pricing"
                type="button" role="tab">💳 Precios</button>
        </li>
    </ul>

    <div class="tab-content" id="pills-tabContent">
        <!-- SECCIONES PRINCIPALES -->
        <div class="tab-pane fade show active" id="pills-sections" role="tabpanel">
            <div class="row">
                <% sections.forEach(section=> { %>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm border-0"
                            style="background: rgba(255,255,255,0.05); color: white;">
                            <div class="card-body">
                                <h5 class="card-title fw-bold text-primary">
                                    <%= section.section_name %>
                                </h5>
                                <p class="card-text small text-white-50">
                                    <%= section.title %>
                                </p>
                                <a href="/admin/edit/<%= section.section_name %>"
                                    class="btn btn-sm btn-primary w-100">Editar Sección</a>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </div>

        <!-- PARASHOT -->
        <div class="tab-pane fade" id="pills-services" role="tabpanel">
            <div class="card bg-dark text-white border-secondary mb-4">
                <div class="card-header border-secondary">Añadir Nueva Parasha</div>
                <div class="card-body">
                    <form action="/admin/parashot/create" method="POST" class="row g-3">
                        <div class="col-md-4">
                            <input type="text" name="title" class="form-control bg-secondary text-white border-0"
                                placeholder="Título (ej: Bereshit)">
                        </div>
                        <div class="col-md-6">
                            <input type="text" name="description" class="form-control bg-secondary text-white border-0"
                                placeholder="Descripción breve">
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-success w-100">Añadir</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Descripción</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% parashot.forEach(p=> { %>
                            <tr>
                                <td>
                                    <%= p.title %>
                                </td>
                                <td>
                                    <%= p.description %>
                                </td>
                                <td><a href="/admin/parashot/delete/<%= p.id %>" class="btn btn-sm btn-danger"
                                        onclick="return confirm('¿Eliminar?')">Eliminar</a></td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- PORTFOLIO -->
        <div class="tab-pane fade" id="pills-portfolio" role="tabpanel">
            <div class="card bg-dark text-white border-secondary mb-4">
                <div class="card-header border-secondary">Añadir Nuevo Evento</div>
                <div class="card-body">
                    <form action="/admin/portfolio/create" method="POST" class="row g-3">
                        <div class="col-md-3"><input type="text" name="title" class="form-control" placeholder="Título"
                                required></div>
                        <div class="col-md-3">
                            <select name="category" class="form-select">
                                <option value="filter-app">App</option>
                                <option value="filter-product">Producto</option>
                                <option value="filter-branding">Marca</option>
                            </select>
                        </div>
                        <div class="col-md-3"><input type="text" name="img" class="form-control"
                                placeholder="URL Imagen" required></div>
                        <div class="col-md-3"><button type="submit" class="btn btn-success w-100">Añadir Evento</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="row">
                <% portfolio.forEach(item=> { %>
                    <div class="col-md-3 mb-3">
                        <div class="card bg-dark text-white border-secondary h-100">
                            <img src="<%= item.img %>" class="card-img-top" alt="..."
                                style="height: 150px; object-fit: cover;">
                            <div class="card-body p-2 d-flex flex-column">
                                <p class="mb-1 small">
                                    <%= item.title %>
                                </p>
                                <a href="/admin/portfolio/delete/<%= item.id %>"
                                    class="btn btn-sm btn-outline-danger mt-auto">Eliminar</a>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </div>

        <!-- TEAM -->
        <div class="tab-pane fade" id="pills-team" role="tabpanel">
            <div class="card bg-dark text-white border-secondary mb-4">
                <div class="card-header border-secondary">Añadir Miembro del Equipo</div>
                <div class="card-body">
                    <form action="/admin/team/create" method="POST" class="row g-3">
                        <div class="col-md-3"><input type="text" name="name" class="form-control" placeholder="Nombre"
                                required></div>
                        <div class="col-md-3"><input type="text" name="role" class="form-control" placeholder="Rol"
                                required></div>
                        <div class="col-md-3"><input type="text" name="img" class="form-control" placeholder="URL Foto"
                                required></div>
                        <div class="col-md-3"><button type="submit" class="btn btn-success w-100">Añadir
                                Miembro</button></div>
                    </form>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Rol</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% team.forEach(member=> { %>
                            <tr>
                                <td>
                                    <%= member.name %>
                                </td>
                                <td>
                                    <%= member.role %>
                                </td>
                                <td><a href="/admin/team/delete/<%= member.id %>"
                                        class="btn btn-sm btn-danger">Eliminar</a></td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TESTIMONIALS -->
        <div class="tab-pane fade" id="pills-testimonials" role="tabpanel">
            <div class="card bg-dark text-white border-secondary mb-4">
                <div class="card-header border-secondary">Añadir Testimonio</div>
                <div class="card-body">
                    <form action="/admin/testimonials/create" method="POST" class="row g-3">
                        <div class="col-md-4"><input type="text" name="name" class="form-control" placeholder="Nombre"
                                required></div>
                        <div class="col-md-4"><input type="text" name="role" class="form-control" placeholder="Rol"
                                required></div>
                        <div class="col-md-4"><input type="text" name="img" class="form-control"
                                placeholder="URL Avatar" required></div>
                        <div class="col-md-10"><textarea name="text" class="form-control" placeholder="Testimonio"
                                rows="2" required></textarea></div>
                        <div class="col-md-2"><button type="submit" class="btn btn-success w-100 h-100">Añadir</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="row">
                <% testimonials.forEach(t=> { %>
                    <div class="col-md-4 mb-3">
                        <div class="card bg-dark text-white border-primary p-3 h-100">
                            <div class="d-flex align-items-center mb-2">
                                <img src="<%= t.img %>" style="width: 40px; height: 40px; border-radius: 50%;"
                                    class="me-2">
                                <div>
                                    <h6 class="mb-0">
                                        <%= t.name %>
                                    </h6><small>
                                        <%= t.role %>
                                    </small>
                                </div>
                            </div>
                            <p class="small text-white-50 flex-grow-1">
                                <%= t.text %>
                            </p>
                            <a href="/admin/testimonials/delete/<%= t.id %>"
                                class="btn btn-sm btn-danger mt-2">Eliminar</a>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </div>

        <!-- PRICING -->
        <div class="tab-pane fade" id="pills-pricing" role="tabpanel">
            <div class="row">
                <% pricing.forEach(plan=> { %>
                    <div class="col-md-6 mb-4">
                        <form action="/admin/pricing/update" method="POST"
                            class="card bg-dark text-white border-secondary p-4 h-100">
                            <input type="hidden" name="id" value="<%= plan.id %>">
                            <h5 class="mb-3 text-primary">Editar Plan: <%= plan.name %>
                            </h5>
                            <div class="mb-3">
                                <label class="form-label">Nombre del Plan</label>
                                <input type="text" name="name" class="form-control bg-secondary text-white border-0"
                                    value="<%= plan.name %>">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Precio ($)</label>
                                <input type="text" name="price" class="form-control bg-secondary text-white border-0"
                                    value="<%= plan.price %>">
                            </div>
                            <div class="mb-3 form-check">
                                <input type="checkbox" name="featured" class="form-check-input" <%=plan.featured
                                    ? 'checked' : '' %>>
                                <label class="form-check-label">Destacar este plan</label>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Características Incluidas (separadas por coma)</label>
                                <textarea name="features" class="form-control bg-secondary text-white border-0"
                                    rows="2"><%= plan.features %></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Características NO Incluidas (separadas por coma)</label>
                                <textarea name="na_features" class="form-control bg-secondary text-white border-0"
                                    rows="2"><%= plan.na_features %></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary mt-auto">Actualizar Plan</button>
                        </form>
                    </div>
                    <% }) %>
            </div>
        </div>
    </div>
</main>