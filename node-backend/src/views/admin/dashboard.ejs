                            <input type="text" name="role" class="form-control bg-secondary text-white border-0" required placeholder="Director, Maestro, etc.">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small text-white-50">Descripción / Bio</label>
                            <textarea name="description" class="form-control bg-secondary text-white border-0" rows="3" placeholder="Breve biografía..."></textarea>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small text-white-50">Subir Foto</label>
                            <input type="file" id="team_image_file" name="image_file" class="form-control bg-secondary text-white border-0">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-white-50">O URL de Foto</label>
                            <input type="text" id="team_image_url" name="img" class="form-control bg-secondary text-white border-0" placeholder="https://...">
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="border border-secondary rounded overflow-hidden d-flex align-items-center justify-content-center" style="height: 120px; width: 120px; border-radius: 50%; margin: 0 auto; background: rgba(0,0,0,0.2);">
                                <img id="teamImgPreview" src="/assets/img/team/team-1.jpg" style="width: 100%; height: 100%; object-fit: cover;">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
