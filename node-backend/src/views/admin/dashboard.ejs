<main class="col-md-10 p-4">
    <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-4 border-bottom">
        <h1 class="h2">Panel de Control</h1>
    </div>

    <!-- Tabs for Sections -->
    <ul class="nav nav-pills mb-4" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="pills-services-tab" data-bs-toggle="pill"
                data-bs-target="#pills-services" type="button" role="tab">📖 Parashot</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pills-portfolio-tab" data-bs-toggle="pill" data-bs-target="#pills-portfolio"
                type="button" role="tab">🖼️ Eventos</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pills-team-tab" data-bs-toggle="pill" data-bs-target="#pills-team"
                type="button" role="tab">👥 Equipo</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pills-testimonials-tab" data-bs-toggle="pill"
                data-bs-target="#pills-testimonials" type="button" role="tab">⭐ Testimonios</button>
        </li>

    </ul>

    <div class="tab-content" id="pills-tabContent">
        <!-- PARASHOT -->
        <div class="tab-pane fade show active" id="pills-services" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0">Gestión de Parashot</h4>
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createParashaModal">
                    <i class="bi bi-plus-circle"></i> Nueva Parasha
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-dark table-hover">
                    <thead>
                        <tr>
                            <th>Nº</th>
                            <th>Título</th>
                            <th>Descripción</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% parashot.forEach(p=> { %>
                            <tr>
                                <td>
                                    <%= p.parasha_number || '-' %>
                                </td>
                                <td>
                                    <%= p.title %>
                                </td>
                                <td>
                                    <%= p.description %>
                                </td>
                                <td>
                                    <a href="/admin/parashot/edit/<%= p.id %>" class="btn btn-sm btn-primary me-2">Editar</a>
                                    <a href="/admin/parashot/delete/<%= p.id %>" class="btn btn-sm btn-danger"
                                        onclick="return confirm('¿Estás seguro de que deseas eliminar definitivamente esta Parashá de la base de datos?')">Eliminar</a>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- PORTFOLIO (EVENTOS) -->
        <div class="tab-pane fade" id="pills-portfolio" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0">Gestión de Eventos</h4>
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createPortfolioModal">
                    <i class="bi bi-plus-circle"></i> Nuevo Evento
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-dark table-hover">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Categoría</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% portfolio.forEach(item=> { %>
                            <tr>
                                <td><%= item.title %></td>
                                <td><%= item.category %></td>
                                <td><%= item.event_date ? new Date(item.event_date).toLocaleDateString() : '-' %></td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary me-2 edit-portfolio-btn" 
                                        data-id="<%= item.id %>"
                                        data-title="<%= item.title %>"
                                        data-category="<%= item.category %>"
                                        data-date="<%= item.event_date ? new Date(item.event_date).toISOString().split('T')[0] : '' %>"
                                        data-subtitle="<%= item.subtitle %>"
                                        data-description="<%= item.description %>"
                                        data-image="<%= item.image_url || item.img %>"
                                        data-content='<%= item.content ? item.content.replace(/'/g, "&#39;") : "" %>'>
                                        Editar
                                    </button>
                                    <a href="/admin/portfolio/delete/<%= item.id %>" class="btn btn-sm btn-danger" onclick="return confirm('¿Estás seguro de que deseas eliminar definitivamente este Evento de la base de datos?')">Eliminar</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TEAM (EQUIPO) -->
        <div class="tab-pane fade" id="pills-team" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0">Gestión de Equipo</h4>
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createTeamModal">
                    <i class="bi bi-plus-circle"></i> Nuevo Miembro
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-dark table-hover">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Rol / Cargo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% team.forEach(member=> { %>
                            <tr>
                                <td><%= member.name %></td>
                                <td><%= member.role %></td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary me-2 edit-team-btn"
                                        data-id="<%= member.id %>"
                                        data-name="<%= member.name %>"
                                        data-role="<%= member.role %>"
                                        data-description="<%= member.description %>"
                                        data-img="<%= member.img %>">
                                        Editar
                                    </button>
                                    <a href="/admin/team/delete/<%= member.id %>" class="btn btn-sm btn-danger" onclick="return confirm('¿Estás seguro de que deseas eliminar definitivamente este Miembro del equipo de la base de datos?')">Eliminar</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TESTIMONIALS -->
        <div class="tab-pane fade" id="pills-testimonials" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0">Gestión de Testimonios</h4>
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createTestimonialModal">
                    <i class="bi bi-plus-circle"></i> Nuevo Testimonio
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-dark table-hover">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Rol</th>
                            <th>Testimonio</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% testimonials.forEach(t=> { %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="<%= t.img %>" style="width: 30px; height: 30px; border-radius: 50%;" class="me-2">
                                        <%= t.name %>
                                    </div>
                                </td>
                                <td><%= t.role %></td>
                                <td><span class="text-truncate d-inline-block" style="max-width: 300px;"><%= t.text %></span></td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary me-2 edit-testimonial-btn"
                                        data-id="<%= t.id %>"
                                        data-name="<%= t.name %>"
                                        data-role="<%= t.role %>"
                                        data-text="<%= t.text %>"
                                        data-img="<%= t.img %>">
                                        Editar
                                    </button>
                                    <a href="/admin/testimonials/delete/<%= t.id %>" class="btn btn-sm btn-danger" onclick="return confirm('¿Estás seguro de que deseas eliminar definitivamente este Testimonio de la base de datos?')">Eliminar</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

<!-- MODAL: NUEVA PARASHA -->
<div class="modal fade" id="createParashaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Añadir Nueva Parasha</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/parashot/create" method="POST" enctype="multipart/form-data" id="createParashaForm">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-2">
                            <label class="form-label small text-white-50">Nº</label>
                            <input type="number" name="parasha_number" class="form-control bg-secondary text-white border-0" placeholder="#" min="1">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-white-50">Título</label>
                            <input type="text" name="title" class="form-control bg-secondary text-white border-0" required placeholder="Ej: Bereshit">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-white-50">Subtítulo / Versículo</label>
                            <input type="text" name="subtitle" class="form-control bg-secondary text-white border-0" placeholder="Ej: Génesis 1:1">
                        </div>
                        
                        <div class="col-md-12">
                            <label class="form-label small text-white-50">Resumen Breve</label>
                            <input type="text" name="description" class="form-control bg-secondary text-white border-0" placeholder="Introducción corta...">
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small text-white-50">Link de YouTube</label>
                            <div class="input-group">
                                <span class="input-group-text bg-secondary text-white border-0"><i class="bi bi-youtube"></i></span>
                                <input type="text" name="youtube_link" class="form-control bg-secondary text-white border-0" placeholder="https://www.youtube.com/watch?v=...">
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small text-white-50">Subir Imagen</label>
                            <input type="file" id="create_image_file" name="image_file" class="form-control bg-secondary text-white border-0">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-white-50">O URL de Imagen</label>
                            <input type="text" id="create_image_url" name="image_url" class="form-control bg-secondary text-white border-0" placeholder="https://...">
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="border border-secondary rounded overflow-hidden d-flex align-items-center justify-content-center" style="height: 100px; background: rgba(0,0,0,0.2);">
                                <img id="createImgPreview" src="/assets/img/blog/blog-1.jpg" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label small text-white-50">Contenido Completo (Enseñanza)</label>
                            <div id="create-editor-container" style="height: 300px; background: white; color: black; border-radius: 5px;"></div>
                            <input type="hidden" name="content" id="createContentInput">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success px-4">Crear Parasha</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="createPortfolioModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Añadir Nuevo Evento</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
