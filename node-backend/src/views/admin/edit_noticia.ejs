<!-- Sidebar -->
<%- include('partials/_sidebar') %>

<main class="col-md-10 main-content">
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-globe-americas me-2" style="color: var(--primary-color);"></i>Editar Noticia / Acontecimiento</h1>
            <p class="text-white-50 mb-0">Editando: <strong><%= item.title %></strong></p>
        </div>
        <a href="/admin/dashboard#pills-noticias" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver al Dashboard</a>
    </div>

    <form action="/admin/noticias/update" method="POST" enctype="multipart/form-data" id="editNoticiaPageForm">
        <input type="hidden" name="id" value="<%= item.id %>">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small text-white-50">Título de la Noticia</label>
                <input type="text" name="title" class="form-control" required value="<%= item.title %>">
            </div>
            <div class="col-md-3">
                <label class="form-label small text-white-50">Categoría</label>
                <select name="category" class="form-select" id="edit_page_noticia_category" onchange="if(this.value==='__custom__'){this.style.display='none';document.getElementById('edit_page_noticia_cat_wrap').style.display='flex';}">
                    <option value="Mundial" <%= item.category === 'Mundial' ? 'selected' : '' %>>Mundial</option>
                    <option value="Israel & Medio Oriente" <%= item.category === 'Israel & Medio Oriente' ? 'selected' : '' %>>Israel & Medio Oriente</option>
                    <option value="Profecía & Actualidad" <%= item.category === 'Profecía & Actualidad' ? 'selected' : '' %>>Profecía & Actualidad</option>
                    <option value="Arqueología Bíblica" <%= item.category === 'Arqueología Bíblica' ? 'selected' : '' %>>Arqueología Bíblica</option>
                    <option value="Comunidad" <%= item.category === 'Comunidad' ? 'selected' : '' %>>Comunidad</option>
                    <% if (typeof noticiasCategories !== 'undefined' && noticiasCategories.length > 0) { %>
                        <% noticiasCategories.forEach(cat => { %>
                            <% if (!['Mundial','Israel & Medio Oriente','Profecía & Actualidad','Arqueología Bíblica','Comunidad'].includes(cat.category)) { %>
                                <option value="<%= cat.category %>" <%= item.category === cat.category ? 'selected' : '' %>><%= cat.category %></option>
                            <% } %>
                        <% }) %>
                    <% } %>
                    <option value="__custom__">+ Nueva categoría...</option>
                </select>
                <div id="edit_page_noticia_cat_wrap" style="display:none;" class="input-group mt-1">
                    <input type="text" id="edit_page_noticia_cat_custom" class="form-control" placeholder="Nombre de categoría">
                    <button type="button" class="btn btn-outline-light btn-sm" onclick="var inp=document.getElementById('edit_page_noticia_cat_custom');var sel=document.getElementById('edit_page_noticia_category');if(inp.value.trim()){var opt=document.createElement('option');opt.value=inp.value.trim();opt.textContent=inp.value.trim();sel.insertBefore(opt,sel.querySelector('[value=__custom__]'));sel.value=inp.value.trim();inp.value='';this.parentNode.style.display='none';sel.style.display='';}">✓</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="this.parentNode.style.display='none';document.getElementById('edit_page_noticia_category').style.display='';">✕</button>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-white-50">Autor / Redacción</label>
                <input type="text" name="author" class="form-control" value="<%= item.author || 'Redacción YHWH' %>">
            </div>

            <div class="col-md-6">
                <label class="form-label small text-white-50">Subtítulo / Bajada informativa</label>
                <input type="text" name="subtitle" class="form-control" value="<%= item.subtitle || '' %>">
            </div>
            <div class="col-md-3">
                <label class="form-label small text-white-50">Enlace a Fuente / Noticia Original (Opcional)</label>
                <input type="text" name="source_url" class="form-control" value="<%= item.source_url || '' %>" placeholder="https://... o dominio">
            </div>
            <div class="col-md-3">
                <label class="form-label small text-white-50">Etiquetas / Tags</label>
                <input type="text" name="tags" class="form-control" value="<%= item.tags || '' %>" placeholder="Ej: Israel, Geopolítica, Profecía">
            </div>

            <div class="col-md-12">
                <label class="form-label small text-white-50">Resumen Breve (Noticia corta para tarjeta principal)</label>
                <textarea name="summary" class="form-control" rows="3" placeholder="Síntesis concisa del acontecimiento..."><%= item.summary || '' %></textarea>
            </div>

            <div class="col-md-4">
                <label class="form-label small text-white-50">Subir Nueva Imagen</label>
                <input type="file" name="image_file" id="edit_page_noticia_image_file" class="form-control" accept="image/*">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-white-50">O URL de Imagen</label>
                <input type="text" name="image_url" id="edit_page_noticia_image_url" class="form-control" value="<%= item.image_url || '' %>">
            </div>
            <div class="col-md-4 text-center">
                <div class="border border-secondary rounded overflow-hidden" style="height:120px;background:rgba(0,0,0,0.2);display:flex;align-items:center;justify-content:center;">
                    <img id="editPageNoticiaImgPreview" src="<%= item.image_url || '/assets/img/blog/blog-1.jpg' %>" style="max-width:100%;max-height:100%;object-fit:contain;">
                </div>
            </div>

            <div class="col-12">
                <label class="form-label small text-white-50">Contenido Extendido / Análisis Completo (Opcional si es artículo breve)</label>
                <div id="edit-noticia-editor" style="height:400px;background:white;color:black;border-radius:5px;"></div>
                <input type="hidden" name="content" id="editNoticiaPageContent">
            </div>

            <div class="col-md-6">
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" name="is_breaking" value="1" id="edit_breaking" <%= item.is_breaking ? 'checked' : '' %>>
                    <label class="form-check-label text-warning fw-bold" for="edit_breaking"><i class="bi bi-lightning-fill me-1"></i> Noticia Urgente / Último Momento</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" name="is_published" value="1" id="edit_published" <%= item.is_published ? 'checked' : '' %>>
                    <label class="form-check-label text-white" for="edit_published">Publicada en la web</label>
                </div>
            </div>
        </div>

        <div class="mt-4 pt-3 border-top border-secondary d-flex justify-content-end gap-2">
            <a href="/admin/dashboard#pills-noticias" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-primary px-5 fw-bold"><i class="bi bi-save me-2"></i>Guardar Cambios</button>
        </div>
    </form>
</main>

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var quill = new Quill('#edit-noticia-editor', {
            theme: 'snow',
            placeholder: 'Escribe el análisis detallado del acontecimiento...',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'color': [] }, { 'background': [] }],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    ['blockquote', 'code-block'],
                    ['link', 'image', 'video'],
                    ['clean']
                ]
            }
        });

        // Contenido existente
        var initialContent = `<%- (item.content || '').replace(/\\/g, '\\\\').replace(/`/g, '\\`').replace(/\$/g, '\\$') %>`;
        if (initialContent) {
            quill.root.innerHTML = initialContent;
        }

        // Preview de imagen
        const fileInput = document.getElementById('edit_page_noticia_image_file');
        const urlInput = document.getElementById('edit_page_noticia_image_url');
        const preview = document.getElementById('editPageNoticiaImgPreview');

        fileInput.addEventListener('change', function() {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) { preview.src = e.target.result; }
                reader.readAsDataURL(this.files[0]);
            }
        });

        urlInput.addEventListener('input', function() {
            if (this.value.trim() !== '') {
                preview.src = this.value.trim();
            }
        });

        // Guardar antes de enviar
        document.getElementById('editNoticiaPageForm').addEventListener('submit', function() {
            document.getElementById('editNoticiaPageContent').value = quill.root.innerHTML;
        });
    });
</script>
