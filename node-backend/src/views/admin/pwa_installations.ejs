<%- include('partials/_sidebar', { activePage: 'pwa-installations' }) %>

<div class="main-content">
    <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="mb-1"><i class="bi bi-phone text-info me-2"></i>Instalaciones del Calendario Offline</h1>
            <p class="text-white-50 mb-0">Dispositivos que instalaron o utilizan la aplicación sin conexión.</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <% const releaseCfg = dashboard.releaseConfig || { version: dashboard.currentVersion, alertActive: false, alertMessage: 'Hay una versión nueva. Actualizá ahora para descargarla y seguir usándola sin conexión.', publishedAt: null }; %>
            <span class="badge <%= releaseCfg.alertActive ? 'bg-success' : 'bg-secondary' %> px-3 py-2">
                <i class="bi <%= releaseCfg.alertActive ? 'bi-bell-fill' : 'bi-bell-slash' %> me-1"></i>
                Alerta: <%= releaseCfg.alertActive ? 'ACTIVA' : 'DESACTIVADA (Manual)' %>
            </span>
            <span class="badge bg-dark border border-warning text-warning px-3 py-2">Versión: <%= dashboard.currentVersion %></span>
        </div>
    </div>

    <% if (typeof msg !== 'undefined' && msg) { %>
        <div class="alert alert-success border border-success d-flex align-items-center justify-content-between mb-4">
            <div><i class="bi bi-check-circle-fill me-2"></i><%= msg %></div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger border border-danger d-flex align-items-center justify-content-between mb-4">
            <div><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %></div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Panel de Control Manual de Alerta de Actualización -->
    <div class="card bg-dark border-warning mb-4 shadow-sm" style="background: linear-gradient(145deg, rgba(212,168,83,0.08), rgba(15,15,20,0.95));">
        <div class="card-header border-warning border-opacity-50 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="fw-bold text-warning">
                <i class="bi bi-broadcast-pin me-2"></i>Control Manual de Alerta de Actualización (Solo Dispositivos Instalados)
            </div>
            <% if (releaseCfg.publishedAt) { %>
                <small class="text-white-50">Último envío: <%= new Date(releaseCfg.publishedAt).toLocaleString('es-AR') %></small>
            <% } %>
        </div>
        <div class="card-body">
            <p class="text-white-50 small mb-3">
                La alerta de actualización <strong>nunca aparece sola en el navegador común</strong>. Cuando realices cambios en el Calendario y quieras avisarles a los usuarios que ya tienen la App instalada en su celular o PC, presioná <strong>"Enviar Alerta de Actualización"</strong>.
            </p>
            <div class="row g-3 align-items-end">
                <div class="col-lg-8">
                    <form action="/admin/pwa-installations/trigger-update" method="POST" class="row g-2 align-items-end">
                        <input type="hidden" name="returnTo" value="pwa-installations">
                        <div class="col-md-8">
                            <label class="form-label small text-white-50 mb-1">Mensaje del aviso para los dispositivos instalados:</label>
                            <input type="text" name="alertMessage" class="form-control bg-black text-white border-secondary"
                                value="<%= releaseCfg.alertMessage || 'Hay una versión nueva. Actualizá ahora para descargarla y seguir usándola sin conexión.' %>"
                                maxlength="240">
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-warning w-100 fw-bold text-dark">
                                <i class="bi bi-bell-fill me-1"></i> Enviar Alerta Ahora
                            </button>
                        </div>
                    </form>
                </div>
                <div class="col-lg-4 d-flex justify-content-lg-end">
                    <% if (releaseCfg.alertActive) { %>
                        <form action="/admin/pwa-installations/stop-update" method="POST" class="w-100">
                            <input type="hidden" name="returnTo" value="pwa-installations">
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="bi bi-bell-slash me-1"></i> Desactivar Alerta Activa
                            </button>
                        </form>
                    <% } else { %>
                        <div class="text-white-50 small border border-secondary rounded px-3 py-2 w-100 text-center">
                            <i class="bi bi-shield-check text-success me-1"></i> Sin alertas activas en este momento
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3"><div class="card-stat h-100"><div class="d-flex align-items-center gap-3"><div class="stat-icon"><i class="bi bi-download"></i></div><div><div class="text-white-50 small">Instalaciones</div><div class="fs-3 fw-bold"><%= dashboard.totals.total || 0 %></div></div></div></div></div>
        <div class="col-6 col-xl-3"><div class="card-stat h-100"><div class="d-flex align-items-center gap-3"><div class="stat-icon text-success"><i class="bi bi-activity"></i></div><div><div class="text-white-50 small">Activas 30 días</div><div class="fs-3 fw-bold"><%= dashboard.totals.active_30 || 0 %></div></div></div></div></div>
        <div class="col-6 col-xl-3"><div class="card-stat h-100"><div class="d-flex align-items-center gap-3"><div class="stat-icon text-info"><i class="bi bi-phone-fill"></i></div><div><div class="text-white-50 small">Modo aplicación</div><div class="fs-3 fw-bold"><%= dashboard.totals.standalone || 0 %></div></div></div></div></div>
        <div class="col-6 col-xl-3"><div class="card-stat h-100"><div class="d-flex align-items-center gap-3"><div class="stat-icon text-warning"><i class="bi bi-calendar-check"></i></div><div><div class="text-white-50 small">Últimos 30 días</div><div class="fs-3 fw-bold"><%= dashboard.daily.reduce((sum, d) => sum + Number(d.total || 0), 0) %></div></div></div></div></div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card bg-dark border-secondary h-100"><div class="card-header border-secondary fw-bold">Plataformas</div><div class="card-body">
                <% if (!dashboard.platforms.length) { %><p class="text-white-50 mb-0">Todavía no hay instalaciones registradas.</p><% } %>
                <% dashboard.platforms.forEach(item => { const pct = dashboard.totals.total ? Math.round(Number(item.total) * 100 / Number(dashboard.totals.total)) : 0; %>
                    <div class="mb-3"><div class="d-flex justify-content-between small mb-1"><span><%= item.platform %></span><span><%= item.total %> · <%= pct %>%</span></div><div class="progress bg-black" style="height:8px"><div class="progress-bar bg-info" style="width:<%= pct %>%"></div></div></div>
                <% }) %>
            </div></div>
        </div>
        <div class="col-lg-6">
            <div class="card bg-dark border-secondary h-100"><div class="card-header border-secondary fw-bold">Versiones instaladas</div><div class="card-body">
                <% if (!dashboard.versions.length) { %><p class="text-white-50 mb-0">Sin datos de versiones todavía.</p><% } %>
                <% dashboard.versions.forEach(item => { %><div class="d-flex justify-content-between border-bottom border-secondary py-2"><code class="text-warning"><%= item.app_version %></code><span class="badge bg-secondary"><%= item.total %></span></div><% }) %>
            </div></div>
        </div>
    </div>

    <div class="card bg-dark border-secondary">
        <div class="card-header border-secondary d-flex justify-content-between"><strong>Dispositivos recientes</strong><span class="text-white-50 small">Máximo 100</span></div>
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0" data-mobile-cards>
                <thead><tr><th>Instalación</th><th>Plataforma</th><th>Modo</th><th>Versión</th><th>Instalada</th><th>Última actividad</th><th>Aperturas</th></tr></thead>
                <tbody>
                <% dashboard.recent.forEach(item => { %>
                    <tr><td data-label="Instalación"><code class="text-info"><%= String(item.installation_id).slice(0, 8) %>…</code></td><td data-label="Plataforma"><%= item.platform %></td><td data-label="Modo"><span class="badge <%= item.display_mode === 'standalone' ? 'bg-success' : 'bg-secondary' %>"><%= item.display_mode %></span></td><td data-label="Versión"><small><%= item.app_version %></small></td><td data-label="Instalada"><%= item.installed_at ? new Date(item.installed_at).toLocaleString('es-AR') : '-' %></td><td data-label="Última actividad"><%= item.last_seen_at ? new Date(item.last_seen_at).toLocaleString('es-AR') : '-' %></td><td data-label="Aperturas"><%= item.launch_count || 0 %></td></tr>
                <% }) %>
                <% if (!dashboard.recent.length) { %><tr><td colspan="7" class="text-center text-white-50 py-5">Las instalaciones aparecerán aquí cuando los usuarios instalen o abran la aplicación offline.</td></tr><% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
