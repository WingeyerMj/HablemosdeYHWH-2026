<!-- Sidebar -->
<%- include('partials/_sidebar') %>

<main class="col-md-10 main-content">
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-pencil-square me-2" style="color: var(--primary-color);"></i>Editar Artículo de Blog</h1>
            <p class="text-white-50 mb-0">Editando: <strong><%= post.title %></strong></p>
        </div>
        <a href="/admin/dashboard#pills-blog" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver al Dashboard</a>
    </div>

    <form action="/admin/blog/update" method="POST" enctype="multipart/form-data" id="editBlogPageForm">
        <input type="hidden" name="id" value="<%= post.id %>">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small text-white-50">Título del Artículo</label>
                <input type="text" name="title" class="form-control" required value="<%= post.title %>">
            </div>
            <div class="col-md-3">
                <label class="form-label small text-white-50">Categoría</label>
                <select name="category" class="form-select" id="edit_page_category" onchange="if(this.value==='__custom__'){this.style.display='none';document.getElementById('edit_page_cat_wrap').style.display='flex';}">
                    <option value="Reflexiones" <%= post.category === 'Reflexiones' ? 'selected' : '' %>>Reflexiones</option>
                    <option value="Estudios" <%= post.category === 'Estudios' ? 'selected' : '' %>>Estudios</option>
                    <option value="Noticias" <%= post.category === 'Noticias' ? 'selected' : '' %>>Noticias</option>
                    <option value="Comunidad" <%= post.category === 'Comunidad' ? 'selected' : '' %>>Comunidad</option>
                    <% if (typeof blogCategories !== 'undefined' && blogCategories.length > 0) { %>
                        <% blogCategories.forEach(cat => { %>
                            <% if (!['Reflexiones','Estudios','Noticias','Comunidad'].includes(cat.category)) { %>
                                <option value="<%= cat.category %>" <%= post.category === cat.category ? 'selected' : '' %>><%= cat.category %></option>
                            <% } %>
                        <% }) %>
                    <% } %>
                    <option value="__custom__">+ Nueva categoría...</option>
                </select>
                <div id="edit_page_cat_wrap" style="display:none;" class="input-group mt-1">
                    <input type="text" id="edit_page_cat_custom" class="form-control" placeholder="Nombre de la categoría">
                    <button type="button" class="btn btn-outline-light btn-sm" onclick="var inp=document.getElementById('edit_page_cat_custom');var sel=document.getElementById('edit_page_category');if(inp.value.trim()){var opt=document.createElement('option');opt.value=inp.value.trim();opt.textContent=inp.value.trim();sel.insertBefore(opt,sel.querySelector('[value=__custom__]'));sel.value=inp.value.trim();inp.value='';this.parentNode.style.display='none';sel.style.display='';}">✓</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="this.parentNode.style.display='none';document.getElementById('edit_page_category').style.display='';">✕</button>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-white-50">Autor</label>
                <input type="text" name="author" class="form-control" value="<%= post.author || 'Hablemos de YHWH' %>">
            </div>

            <div class="col-md-6">
                <label class="form-label small text-white-50">Subtítulo / Bajada</label>
                <input type="text" name="subtitle" class="form-control" value="<%= post.subtitle || '' %>">
            </div>
            <div class="col-md-6">
                <label class="form-label small text-white-50">Etiquetas / Tags (separadas por coma)</label>
                <input type="text" name="tags" class="form-control" value="<%= post.tags || '' %>" placeholder="Ej: Fe, Torah, Shabat">
            </div>

            <div class="col-md-12">
                <label class="form-label small text-white-50">Resumen Breve (para tarjetas y listados)</label>
                <textarea name="summary" class="form-control" rows="2"><%= post.summary || '' %></textarea>
            </div>

            <div class="col-md-4">
                <label class="form-label small text-white-50">Subir Nueva Imagen</label>
                <input type="file" name="image_file" id="edit_page_blog_image_file" class="form-control" accept="image/*">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-white-50">O URL de Imagen</label>
                <input type="text" name="image_url" id="edit_page_blog_image_url" class="form-control" value="<%= post.image_url || '' %>">
            </div>
            <div class="col-md-4 text-center">
                <div class="border border-secondary rounded overflow-hidden" style="height:120px;background:rgba(0,0,0,0.2);display:flex;align-items:center;justify-content:center;">
                    <img id="editPageBlogImgPreview" src="<%= post.image_url || '/assets/img/blog/blog-1.jpg' %>" style="max-width:100%;max-height:100%;object-fit:contain;">
                </div>
            </div>

            <div class="col-12">
                <label class="form-label small text-white-50">Contenido Detallado del Artículo</label>
                <div id="edit-blog-editor" style="height:450px;background:white;color:black;border-radius:5px;"></div>
                <input type="hidden" name="content" id="editBlogPageContent">
            </div>
        </div>

        <!-- Panel de Difusión en Redes Sociales -->
        <div class="card bg-dark border-secondary mt-4 mb-4 shadow-sm" style="border-color: #d4a853 !important; background: linear-gradient(135deg, rgba(212,168,83,0.08), rgba(0,0,0,0.3)) !important;">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3 pb-3 border-bottom border-secondary">
                    <div>
                        <h5 class="fw-bold mb-1 text-white d-flex align-items-center gap-2">
                            <i class="bi bi-share-fill" style="color: #d4a853;"></i> Difundir y Publicar en Redes Sociales
                        </h5>
                        <p class="text-white-50 mb-0 small">Comparte este artículo con un solo clic en las redes oficiales o envía el enlace directo a tu comunidad.</p>
                    </div>
                    <a href="/blog/<%= post.id %>" target="_blank" class="btn btn-sm btn-outline-warning rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1">
                        <i class="bi bi-box-arrow-up-right"></i> Ver en la Web
                    </a>
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <!-- WhatsApp -->
                    <button type="button" class="btn btn-sm text-white fw-bold px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2 shadow-sm" 
                            style="background-color: #25D366; border: none;"
                            onclick="shareOnSocial('whatsapp', '<%= post.title.replace(/'/g, "\\'") %>', '<%= (post.summary || '').replace(/'/g, "\\'") %>', '<%= post.id %>')">
                        <i class="bi bi-whatsapp" style="font-size: 1.1rem;"></i> WhatsApp
                    </button>

                    <!-- Facebook -->
                    <button type="button" class="btn btn-sm text-white fw-bold px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2 shadow-sm" 
                            style="background-color: #1877F2; border: none;"
                            onclick="shareOnSocial('facebook', '<%= post.title.replace(/'/g, "\\'") %>', '', '<%= post.id %>')">
                        <i class="bi bi-facebook" style="font-size: 1.1rem;"></i> Facebook
                    </button>

                    <!-- Instagram -->
                    <button type="button" class="btn btn-sm text-white fw-bold px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2 shadow-sm" 
                            style="background: linear-gradient(45deg, #f09433 0%,#e6683c 25%,#dc2743 50%,#cc2366 75%,#bc1888 100%); border: none;"
                            onclick="shareOnSocial('instagram', '<%= post.title.replace(/'/g, "\\'") %>', '', '<%= post.id %>')">
                        <i class="bi bi-instagram" style="font-size: 1.1rem;"></i> Instagram
                    </button>

                    <!-- Telegram -->
                    <button type="button" class="btn btn-sm text-white fw-bold px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2 shadow-sm" 
                            style="background-color: #229ED9; border: none;"
                            onclick="shareOnSocial('telegram', '<%= post.title.replace(/'/g, "\\'") %>', '', '<%= post.id %>')">
                        <i class="bi bi-telegram" style="font-size: 1.1rem;"></i> Telegram
                    </button>

                    <!-- X / Twitter -->
                    <button type="button" class="btn btn-sm text-white fw-bold px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2 shadow-sm" 
                            style="background-color: #000000; border: 1px solid #444;"
                            onclick="shareOnSocial('twitter', '<%= post.title.replace(/'/g, "\\'") %>', '', '<%= post.id %>')">
                        <i class="bi bi-twitter-x" style="font-size: 1.1rem;"></i> X (Twitter)
                    </button>

                    <!-- LinkedIn -->
                    <button type="button" class="btn btn-sm text-white fw-bold px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2 shadow-sm" 
                            style="background-color: #0A66C2; border: none;"
                            onclick="shareOnSocial('linkedin', '<%= post.title.replace(/'/g, "\\'") %>', '', '<%= post.id %>')">
                        <i class="bi bi-linkedin" style="font-size: 1.1rem;"></i> LinkedIn
                    </button>

                    <!-- Copiar Enlace -->
                    <button type="button" id="btnCopyLink" class="btn btn-sm btn-outline-light fw-bold px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2"
                            onclick="copyPostLink('<%= post.id %>')">
                        <i class="bi bi-link-45deg" style="font-size: 1.2rem;"></i> <span id="copyText">Copiar Enlace</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4 mb-5 gap-3">
            <a href="/admin/dashboard#pills-blog" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-primary px-5"><i class="bi bi-check-lg me-2"></i>Guardar Cambios</button>
        </div>
    </form>
</main>

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const quill = new Quill('#edit-blog-editor', {
        theme: 'snow',
        modules: { toolbar: [[{'header':[1,2,3,false]}],['bold','italic','underline','strike'],[{'color':[]},{'background':[]}],['link','blockquote','code-block','image'],[{'list':'ordered'},{'list':'bullet'}],[{'align':[]}],['clean']] }
    });
    quill.root.innerHTML = `<%- (post.content || post.summary || '').replace(/`/g, '\\`').replace(/\\/g, '\\\\') %>`;
    
    // Image previews
    const urlInput = document.getElementById('edit_page_blog_image_url');
    const fileInput = document.getElementById('edit_page_blog_image_file');
    const previewImg = document.getElementById('editPageBlogImgPreview');

    if (urlInput) {
        urlInput.addEventListener('input', e => {
            if (e.target.value) previewImg.src = e.target.value;
        });
    }

    if (fileInput) {
        fileInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = e => {
                    previewImg.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    }

    document.getElementById('editBlogPageForm').onsubmit = function() {
        document.getElementById('editBlogPageContent').value = quill.root.innerHTML;
        return true;
    };
});

function getFullPostUrl(id) {
    const origin = window.location.origin.includes('localhost') ? 'https://hablemosdeyhwh.com' : window.location.origin;
    return origin + '/blog/' + id;
}

function shareOnSocial(platform, title, summary, id) {
    const url = getFullPostUrl(id);
    let shareUrl = '';
    const textMsg = title + (summary ? '\n\n' + summary : '');

    switch (platform) {
        case 'whatsapp':
            shareUrl = 'https://api.whatsapp.com/send?text=' + encodeURIComponent(textMsg + '\n\nLee más aquí: ' + url);
            break;
        case 'facebook':
            shareUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url);
            break;
        case 'instagram':
            navigator.clipboard.writeText(url).then(() => {
                alert('¡Enlace copiado al portapapeles! Ahora puedes pegarlo en una historia o publicación de Instagram.');
                window.open('https://www.instagram.com/', '_blank');
            }).catch(() => {
                window.open('https://www.instagram.com/', '_blank');
            });
            return;
        case 'telegram':
            shareUrl = 'https://t.me/share/url?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent(title);
            break;
        case 'twitter':
            shareUrl = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(url);
            break;
        case 'linkedin':
            shareUrl = 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(url);
            break;
    }

    if (shareUrl) {
        window.open(shareUrl, '_blank', 'width=650,height=550,menubar=no,toolbar=no,resizable=yes,scrollbars=yes');
    }
}

function copyPostLink(id) {
    const url = getFullPostUrl(id);
    navigator.clipboard.writeText(url).then(() => {
        const copyText = document.getElementById('copyText');
        const btn = document.getElementById('btnCopyLink');
        if (copyText && btn) {
            const original = copyText.textContent;
            copyText.textContent = '¡Enlace Copiado! ✓';
            btn.classList.remove('btn-outline-light');
            btn.classList.add('btn-success');
            setTimeout(() => {
                copyText.textContent = original;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-light');
            }, 2500);
        }
    }).catch(err => {
        prompt('Copia este enlace:', url);
    });
}
</script>
