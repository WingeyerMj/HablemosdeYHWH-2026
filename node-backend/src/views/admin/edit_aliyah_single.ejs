<%- include('partials/_sidebar', { activePage: 'aliyot' }) %>

<style>
select option, select optgroup {
    background-color: #212529 !important;
    color: #ffffff !important;
    padding: 8px 12px;
}
select option:checked, select option:hover {
    background-color: #0d6efd !important;
    color: #ffffff !important;
}
</style>

<main class="col-md-10 main-content p-4">
    <div class="page-header d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge" style="background: var(--primary-color, #d4b895); color: #000; font-weight: 700;">
                    <%= aliyah.aliyah_number %>ª Aliyá
                </span>
                <h1 class="h2 text-white mb-0"><%= aliyah.title %></h1>
            </div>
            <p class="text-white-50 mb-0">Parashá: <strong><%= aliyah.parasha_title %></strong> <%= aliyah.parasha_subtitle ? `(${aliyah.parasha_subtitle})` : '' %></p>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin/aliyot" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> Volver al Listado
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Formulario de Edición -->
        <div class="col-lg-8">
            <div class="card bg-dark text-white border-secondary shadow-sm" style="border-radius: 14px;">
                <div class="card-header border-secondary bg-black bg-opacity-25 py-3">
                    <h5 class="mb-0 text-white"><i class="bi bi-pencil-square me-2" style="color: var(--primary-color, #d4b895);"></i>Editar Lectura Diaria</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/admin/aliyot/update-item" method="POST" enctype="multipart/form-data" id="editAliyahSingleForm">
                        <input type="hidden" name="id" value="<%= aliyah.id %>">
                        <input type="hidden" name="existing_audio_url" value="<%= aliyah.audio_url || '' %>">

                        <div class="row g-3">
                            <!-- Parashá asociada -->
                            <div class="col-md-6">
                                <label class="form-label small text-white-50 fw-bold">Parashá Asociada</label>
                                <select name="parasha_id" class="form-select bg-black bg-opacity-50 text-white border-secondary">
                                    <option value="" <%= (!aliyah.parasha_id) ? 'selected' : '' %>>-- Sin vincular aún (Asignar después) --</option>
                                    <% parashot.forEach(p => { %>
                                        <option value="<%= p.id %>" <%= (aliyah.parasha_id == p.id) ? 'selected' : '' %>>
                                            <%= p.parasha_number ? `Nº ${p.parasha_number} - ` : '' %><%= p.title %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>

                            <!-- Número de Aliyá / Día -->
                            <div class="col-md-6">
                                <label class="form-label small text-white-50 fw-bold">Día / Número de Aliyá</label>
                                <select name="aliyah_number" class="form-select bg-black bg-opacity-50 text-white border-secondary" required>
                                    <option value="1" <%= aliyah.aliyah_number == 1 ? 'selected' : '' %>>1ª Aliyá (Domingo - Día 1)</option>
                                    <option value="2" <%= aliyah.aliyah_number == 2 ? 'selected' : '' %>>2ª Aliyá (Lunes - Día 2)</option>
                                    <option value="3" <%= aliyah.aliyah_number == 3 ? 'selected' : '' %>>3ª Aliyá (Martes - Día 3)</option>
                                    <option value="4" <%= aliyah.aliyah_number == 4 ? 'selected' : '' %>>4ª Aliyá (Miércoles - Día 4)</option>
                                    <option value="5" <%= aliyah.aliyah_number == 5 ? 'selected' : '' %>>5ª Aliyá (Jueves - Día 5)</option>
                                    <option value="6" <%= aliyah.aliyah_number == 6 ? 'selected' : '' %>>6ª Aliyá (Viernes - Día 6)</option>
                                    <option value="7" <%= aliyah.aliyah_number == 7 ? 'selected' : '' %>>7ª Aliyá (Shabat - Día 7)</option>
                                </select>
                            </div>

                            <!-- Título -->
                            <div class="col-md-6">
                                <label class="form-label small text-white-50 fw-bold">Título</label>
                                <input type="text" name="title" class="form-control bg-black bg-opacity-50 text-white border-secondary" value="<%= aliyah.title %>" required>
                            </div>

                            <!-- Referencia de versículos -->
                            <div class="col-md-6">
                                <label class="form-label small text-white-50 fw-bold mb-1">Referencia de Versículos</label>
                                <input type="text" name="verses_reference" id="editVersesRefInput" class="form-control bg-black bg-opacity-50 text-white border-secondary fw-bold" value="<%= aliyah.verses_reference || '' %>" placeholder="Ej: DEUTERONOMIO 26:1-11">
                            </div>

                            <!-- SECCIÓN DE AUDIOS (Soporta múltiples archivos) -->
                            <div class="col-12">
                                <div class="p-3 rounded border border-secondary" style="background: rgba(255, 255, 255, 0.03);">
                                    <label class="form-label fw-bold text-white d-flex align-items-center justify-content-between mb-2">
                                        <span class="d-flex align-items-center gap-2">
                                            <i class="bi bi-soundwave" style="color: var(--primary-color, #d4b895); font-size: 1.2rem;"></i>
                                            Audios de la Lectura (<%= (aliyah.audios && aliyah.audios.length) || 0 %> cargados)
                                        </span>
                                        <small class="text-white-50">Puedes subir varios archivos de audio para esta misma Aliyá</small>
                                    </label>

                                    <!-- Lista de audios existentes -->
                                    <% if (aliyah.audios && aliyah.audios.length > 0) { %>
                                        <div class="d-flex flex-column gap-2 mb-3">
                                            <% aliyah.audios.forEach((audio, idx) => { %>
                                                <div class="p-2 px-3 rounded bg-black bg-opacity-50 border border-secondary d-flex flex-wrap align-items-center justify-content-between gap-2">
                                                    <div class="d-flex align-items-center gap-3">
                                                        <span class="badge bg-secondary">#<%= idx + 1 %></span>
                                                        <div>
                                                            <div class="text-white small fw-bold">Audio <%= idx + 1 %></div>
                                                            <audio controls class="mt-1" style="height: 30px; max-width: 250px;">
                                                                <source src="<%= audio.url %>" type="audio/mpeg">
                                                            </audio>
                                                        </div>
                                                    </div>
                                                    <div class="d-flex gap-2">
                                                        <a href="<%= audio.url %>" target="_blank" download class="btn btn-sm btn-outline-light" title="Descargar">
                                                            <i class="bi bi-download"></i>
                                                        </a>
                                                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove-audio-item" data-audio-idx="<%= idx %>" title="Eliminar este audio">
                                                            <i class="bi bi-trash"></i> Eliminar
                                                        </button>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        </div>
                                    <% } %>

                                    <input type="hidden" name="existing_audios_json" id="existingAudiosJson" value='<%- JSON.stringify(aliyah.audios || []) %>'>
                                    <input type="hidden" name="remove_audio_idx" id="removeAudioIdx" value="">

                                    <!-- Subir nuevos audios -->
                                    <div class="pt-2 border-top border-secondary">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <span class="small text-white-50 fw-bold">Agregar Nuevos Archivos de Audio</span>
                                            <span class="badge bg-primary bg-opacity-25 text-primary">WhatsApp, MP3, OGG, M4A, WAV</span>
                                        </div>

                                        <div id="editAudioRowsContainer" class="d-flex flex-column gap-2 mb-2">
                                            <div class="audio-input-row p-2 rounded bg-black bg-opacity-50 border border-secondary">
                                                <div class="row g-2 align-items-center">
                                                    <div class="col-md-6">
                                                        <label class="form-label small text-white-50 mb-1">Archivo de Audio</label>
                                                        <input type="file" name="audio_files" class="form-control form-control-sm bg-dark text-white border-secondary edit-aliyah-file-input" accept="audio/*,.mp3,.ogg,.oga,.opus,.m4a,.wav,.aac" multiple>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <label class="form-label small text-white-50 mb-1">Título / Nombre (opcional)</label>
                                                        <input type="text" name="audio_titles[]" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Ej: Audio <%= ((aliyah.audios && aliyah.audios.length) || 0) + 1 %>">
                                                    </div>
                                                    <div class="col-md-1 text-center pt-3">
                                                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove-edit-row d-none" title="Eliminar fila">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top border-secondary">
                                            <button type="button" id="btnAddEditAudioRow" class="btn btn-sm btn-outline-warning d-flex align-items-center gap-1">
                                                <i class="bi bi-plus-circle-fill"></i> + Agregar otro archivo de audio
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Audio externo opcional -->
                                    <div class="mt-3 pt-2 border-top border-secondary">
                                        <label class="form-label small text-white-50 fw-semibold">O agregar enlace de audio externo</label>
                                        <div class="input-group input-group-sm">
                                            <input type="text" name="custom_audio_title" class="form-control bg-black bg-opacity-50 text-white border-secondary" placeholder="Nombre (Ej: Reflexión)" style="max-width: 140px;">
                                            <input type="text" name="custom_audio_url" class="form-control bg-black bg-opacity-50 text-white border-secondary" placeholder="https://.../audio.mp3">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- EDITOR DE VERSÍCULOS EN 3 VERSIONES (Español, Hebreo, Fonética) -->
                            <div class="col-12">
                                <div class="p-3 rounded border border-secondary" style="background: rgba(255, 255, 255, 0.02);">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                        <label class="form-label small text-white fw-bold mb-0">
                                            <i class="bi bi-book me-1" style="color: var(--primary-color, #d4b895);"></i>
                                            Lectura en 3 Versiones: Español, Hebreo y Fonética
                                        </label>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button type="button" id="btnTranslateSpanishEdit" class="btn btn-sm btn-success d-flex align-items-center gap-1 shadow-sm" title="Traduce automáticamente el texto pegado en Español a Hebreo y genera la Fonética">
                                                <i class="bi bi-translate"></i> <strong>✨ Traducir Español ➔ Hebreo + Fonética</strong>
                                            </button>
                                            <button type="button" id="btnAutoTransliterateEdit" class="btn btn-sm btn-outline-warning d-flex align-items-center gap-1" title="Convertir automáticamente el texto hebreo a fonética en español">
                                                <i class="bi bi-magic"></i> Hebreo ➔ Fonética
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Pestañas de las 3 versiones -->
                                    <ul class="nav nav-pills nav-fill mb-3 bg-black bg-opacity-50 p-1 rounded border border-secondary" id="editLangTabs" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link active py-1 small fw-bold" id="edit-tab-es" data-bs-toggle="pill" data-bs-target="#edit-pane-es" type="button" role="tab">
                                                🇪🇸 1. Español (Traducción)
                                            </button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link py-1 small fw-bold" id="edit-tab-he" data-bs-toggle="pill" data-bs-target="#edit-pane-he" type="button" role="tab">
                                                🇮🇱 2. Hebreo (עברית)
                                            </button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link py-1 small fw-bold" id="edit-tab-fo" data-bs-toggle="pill" data-bs-target="#edit-pane-fo" type="button" role="tab">
                                                🗣️ 3. Fonética en Español
                                            </button>
                                        </li>
                                    </ul>

                                    <div class="tab-content" id="editLangTabContent">
                                        <!-- Panel Español -->
                                        <div class="tab-pane fade show active" id="edit-pane-es" role="tabpanel">
                                            <label class="form-label small text-white-50">Texto o versículos en Español:</label>
                                            <div id="single-quill-editor" style="height: 320px; background: #ffffff; color: #111; border-radius: 6px;"></div>
                                            <input type="hidden" name="content" id="singleAliyahContent">
                                        </div>

                                        <!-- Panel Hebreo -->
                                        <div class="tab-pane fade" id="edit-pane-he" role="tabpanel">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <label class="form-label small text-white-50 mb-0">Texto bíblico en Hebreo (con o sin vocales):</label>
                                                <small class="text-warning">Dirección automática Derecha a Izquierda (RTL)</small>
                                            </div>
                                            <textarea name="content_hebrew" id="editHebrewContent" class="form-control bg-black bg-opacity-50 text-white border-secondary" 
                                                      dir="rtl" style="height: 320px; font-size: 1.35rem; font-family: 'David Libre', 'Frank Ruhl Libre', 'Times New Roman', serif; line-height: 1.8;" 
                                                      placeholder="בְּרֵאשִׁית בָּרָא אֱלֹהִים אֵת הַשָּׁמַיִם וְאֵת הָאָרֶץ..."><%= aliyah.content_hebrew || '' %></textarea>
                                        </div>

                                        <!-- Panel Fonética -->
                                        <div class="tab-pane fade" id="edit-pane-fo" role="tabpanel">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <label class="form-label small text-white-50 mb-0">Pronunciación / Transliteración Fonética en Español:</label>
                                                <small class="text-info">Puedes editarlo manualmente o pulsar "Hebreo ➔ Fonética"</small>
                                            </div>
                                            <textarea name="content_phonetic" id="editPhoneticContent" class="form-control bg-black bg-opacity-50 text-white border-secondary" 
                                                      style="height: 320px; font-size: 1.1rem; font-family: 'Segoe UI', sans-serif; font-style: italic; line-height: 1.7;" 
                                                      placeholder="Bereshit bará Elohim et hashamayim ve'et ha'aretz..."><%= aliyah.content_phonetic || '' %></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- FECHA Y ESTADO -->
                            <div class="col-md-6">
                                <label class="form-label small text-white-50">Fecha de lectura (opcional):</label>
                                <input type="date" name="reading_date" class="form-control bg-black bg-opacity-50 text-white border-secondary" 
                                       value="<%= aliyah.reading_date ? new Date(aliyah.reading_date).toISOString().split('T')[0] : '' %>">
                            </div>
                            <div class="col-md-6 d-flex align-items-center mt-md-4 pt-md-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="is_published" value="1" id="publishSingle" 
                                           <%= (aliyah.is_published === undefined || aliyah.is_published || aliyah.is_published === 1) ? 'checked' : '' %>>
                                    <label class="form-check-label text-white small fw-bold" for="publishSingle">
                                        Publicar en la web inmediatamente
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end align-items-center gap-3 mt-4 pt-3 border-top border-secondary">
                            <a href="/admin/aliyot" class="btn btn-outline-secondary px-4">Cancelar</a>
                            <button type="submit" class="btn px-5 fw-bold d-flex align-items-center gap-2" style="background: var(--primary-color, #d4b895); color: #1a1a1a;">
                                <i class="bi bi-check-lg fs-5"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Panel Lateral: Herramientas de Compartir en Redes -->
        <div class="col-lg-4">
            <div class="card bg-dark text-white border-secondary shadow-sm mb-4" style="border-radius: 14px;">
                <div class="card-header border-secondary bg-black bg-opacity-25 py-3">
                    <h5 class="mb-0 text-white"><i class="bi bi-share me-2" style="color: #25D366;"></i>Compartir en Redes Sociales</h5>
                </div>
                <div class="card-body p-3">
                    <p class="text-white-50 small mb-3">Comparte esta lectura diaria directamente a través de tus canales y redes vinculadas:</p>

                    <% 
                        const shareTitle = `Lectura de Toráh: ${aliyah.parasha_title} - ${aliyah.title}`;
                        const shareRef = aliyah.verses_reference ? `\n📖 Versículos: ${aliyah.verses_reference}` : '';
                        const shareUrl = `https://www.hablemosdeyhwh.com/aliyot?parasha=${aliyah.parasha_id}`;
                        const waText = encodeURIComponent(`*${shareTitle}*${shareRef}\n\nEscucha el audio y lee la porción aquí:\n${shareUrl}`);
                        const tgText = encodeURIComponent(`${shareTitle}${shareRef}`);
                        const xText = encodeURIComponent(`${shareTitle} ${aliyah.verses_reference || ''}`);
                    %>

                    <div class="d-grid gap-2">
                        <!-- WhatsApp -->
                        <a href="https://api.whatsapp.com/send?text=<%= waText %>" target="_blank" rel="noopener noreferrer" 
                           class="btn btn-success d-flex align-items-center justify-content-center gap-2 py-2 fw-bold" style="background-color: #25D366; border: none;">
                            <i class="bi bi-whatsapp fs-5"></i> Compartir en WhatsApp
                        </a>

                        <!-- Telegram -->
                        <a href="https://t.me/share/url?url=<%= encodeURIComponent(shareUrl) %>&text=<%= tgText %>" target="_blank" rel="noopener noreferrer" 
                           class="btn btn-info d-flex align-items-center justify-content-center gap-2 py-2 fw-bold text-white" style="background-color: #0088cc; border: none;">
                            <i class="bi bi-telegram fs-5"></i> Compartir en Telegram
                        </a>

                        <!-- Facebook -->
                        <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(shareUrl) %>" target="_blank" rel="noopener noreferrer" 
                           class="btn btn-primary d-flex align-items-center justify-content-center gap-2 py-2 fw-bold" style="background-color: #1877F2; border: none;">
                            <i class="bi bi-facebook fs-5"></i> Compartir en Facebook
                        </a>

                        <!-- Twitter / X -->
                        <a href="https://twitter.com/intent/tweet?text=<%= xText %>&url=<%= encodeURIComponent(shareUrl) %>" target="_blank" rel="noopener noreferrer" 
                           class="btn btn-dark d-flex align-items-center justify-content-center gap-2 py-2 fw-bold border border-secondary">
                            <i class="bi bi-twitter-x fs-5"></i> Compartir en X (Twitter)
                        </a>

                        <hr class="border-secondary my-2">

                        <!-- Copiar Enlace -->
                        <button type="button" class="btn btn-outline-light d-flex align-items-center justify-content-center gap-2 py-2" id="copyLinkBtn" data-url="<%= shareUrl %>">
                            <i class="bi bi-link-45deg fs-5"></i> Copiar Enlace Directo
                        </button>

                        <!-- Copiar Mensaje Completo -->
                        <button type="button" class="btn btn-outline-warning d-flex align-items-center justify-content-center gap-2 py-2" id="copyFullMessageBtn" 
                                data-msg="*<%= shareTitle %>*<%= shareRef %>&#10;&#10;Escucha el audio y lee la porción aquí:&#10;<%= shareUrl %>">
                            <i class="bi bi-clipboard-check fs-5"></i> Copiar Mensaje Completo
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const quill = new Quill('#single-quill-editor', {
        theme: 'snow',
        modules: { 
            toolbar: [
                [{ 'header': [1, 2, 3, false] }],
                ['bold', 'italic', 'underline', 'strike'],
                [{ 'color': [] }, { 'background': [] }],
                ['link', 'blockquote', 'code-block'],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                [{ 'align': [] }],
                ['clean']
            ] 
        }
    });

    quill.root.innerHTML = `<%- (aliyah.content || '').replace(/`/g, '\\`').replace(/\\/g, '\\\\') %>`;

    document.getElementById('editAliyahSingleForm').onsubmit = function() {
        document.getElementById('singleAliyahContent').value = quill.root.innerHTML;
        return true;
    };

    // Botón eliminar un audio específico
    document.querySelectorAll('.btn-remove-audio-item').forEach(btn => {
        btn.addEventListener('click', function() {
            if (confirm('¿Deseas eliminar este audio? Los cambios se aplicarán al guardar.')) {
                const idx = this.getAttribute('data-audio-idx');
                document.getElementById('removeAudioIdx').value = idx;
                document.getElementById('editAliyahSingleForm').submit();
            }
        });
    });

    // Agregar más filas de archivos de audio en edición
    const btnAddEditAudioRow = document.getElementById('btnAddEditAudioRow');
    const editAudioContainer = document.getElementById('editAudioRowsContainer');

    if (btnAddEditAudioRow && editAudioContainer) {
        btnAddEditAudioRow.addEventListener('click', function() {
            const rowsCount = editAudioContainer.querySelectorAll('.audio-input-row').length + 1;
            const newRow = document.createElement('div');
            newRow.className = 'audio-input-row p-2 rounded bg-black bg-opacity-50 border border-secondary';
            newRow.innerHTML = `
                <div class="row g-2 align-items-center">
                    <div class="col-md-6">
                        <label class="form-label small text-white-50 mb-1">Archivo de Audio ${rowsCount}</label>
                        <input type="file" name="audio_files" class="form-control form-control-sm bg-dark text-white border-secondary edit-aliyah-file-input" accept="audio/*,.mp3,.ogg,.oga,.opus,.m4a,.wav,.aac" multiple>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small text-white-50 mb-1">Título / Nombre (opcional)</label>
                        <input type="text" name="audio_titles[]" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Ej: Audio nuevo">
                    </div>
                    <div class="col-md-1 text-center pt-3">
                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove-edit-row" title="Eliminar fila">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            `;
            editAudioContainer.appendChild(newRow);

            newRow.querySelector('.btn-remove-edit-row').addEventListener('click', function() {
                newRow.remove();
            });

            const fileInput = newRow.querySelector('.edit-aliyah-file-input');
            const titleInput = newRow.querySelector('input[type="text"]');
            fileInput.addEventListener('change', function() {
                if (this.files && this.files[0] && !titleInput.value) {
                    titleInput.value = this.files[0].name.replace(/\.[^/.]+$/, '');
                }
            });
        });

        const initialFileInput = editAudioContainer.querySelector('.edit-aliyah-file-input');
        const initialTitleInput = editAudioContainer.querySelector('input[name="audio_titles[]"]');
        if (initialFileInput && initialTitleInput) {
            initialFileInput.addEventListener('change', function() {
                if (this.files && this.files[0] && !initialTitleInput.value) {
                    initialTitleInput.value = this.files[0].name.replace(/\.[^/.]+$/, '');
                }
            });
        }
    }

    // Traducir automáticamente de Español a Hebreo y Fonética (Edición)
    const btnTranslateEdit = document.getElementById('btnTranslateSpanishEdit');
    if (btnTranslateEdit) {
        btnTranslateEdit.addEventListener('click', async function() {
            const spanishText = quill ? (quill.root.innerHTML || quill.getText()).trim() : '';

            if (!spanishText || spanishText === '<p><br></p>') {
                alert('Por favor escribe o pega primero el texto en la pestaña Español (Traducción).');
                document.getElementById('edit-tab-es').click();
                return;
            }

            const originalBtnText = this.innerHTML;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Traduciendo...';
            this.disabled = true;

            try {
                const res = await fetch('/admin/aliyot/api/translate-spanish', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ text: spanishText })
                });

                if (res.status === 401) {
                    alert('Tu sesión ha expirado por inactividad. Por favor abre otra pestaña, inicia sesión en el panel y vuelve a presionar Traducir sin perder tus cambios.');
                    return;
                }

                const contentType = res.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) {
                    throw new Error('La sesión ha expirado o el servidor respondió de forma inesperada. Por favor recarga e inicia sesión.');
                }

                const data = await res.json();
                if (data.success && data.hebrew) {
                    document.getElementById('editHebrewContent').value = data.hebrew;
                    document.getElementById('editPhoneticContent').value = data.phonetic || '';
                    alert('¡Traducción completada con éxito! El texto en Hebreo y la Fonética se han generado automáticamente.');
                    document.getElementById('edit-tab-he').click();
                } else {
                    alert(data.error || 'No se pudo realizar la traducción automática.');
                }
            } catch(e) {
                alert('Error al traducir: ' + e.message);
            } finally {
                this.innerHTML = originalBtnText;
                this.disabled = false;
            }
        });
    }

    // Auto-Transliterar Hebreo a Fonética en Edición
    const btnAutoTransEdit = document.getElementById('btnAutoTransliterateEdit');
    if (btnAutoTransEdit) {
        btnAutoTransEdit.addEventListener('click', async function() {
            const hebrewText = document.getElementById('editHebrewContent').value.trim();
            if (!hebrewText) {
                alert('Por favor escribe o pega primero el texto en la pestaña Hebreo (עברית).');
                document.getElementById('edit-tab-he').click();
                return;
            }
            const originalBtnText = this.innerHTML;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Convirtiendo...';
            this.disabled = true;

            try {
                const res = await fetch('/admin/aliyot/api/transliterate', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ text: hebrewText })
                });

                if (res.status === 401) {
                    alert('Tu sesión ha expirado por inactividad. Inicia sesión nuevamente en otra pestaña.');
                    return;
                }

                const contentType = res.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) {
                    throw new Error('Sesión expirada o respuesta inválida.');
                }

                const data = await res.json();
                if (data.success && data.phonetic) {
                    document.getElementById('editPhoneticContent').value = data.phonetic;
                    document.getElementById('edit-tab-fo').click();
                } else {
                    alert('No se pudo generar la fonética.');
                }
            } catch(e) {
                alert('Error al convertir fonética: ' + e.message);
            } finally {
                this.innerHTML = originalBtnText;
                this.disabled = false;
            }
        });
    }

    // Función común para auto-obtener versículos por referencia en Edición
    async function loadVersesFromRefEdit(triggerBtn) {
        const refInput = document.getElementById('editVersesRefInput') || document.querySelector('#editAliyahSingleForm input[name="verses_reference"]');
        const ref = refInput ? refInput.value.trim() : '';

        if (!ref) {
            alert('Por favor ingresa primero la Referencia de Versículos (Ej: DEUTERONOMIO 26:1-11).');
            if (refInput) refInput.focus();
            return;
        }

        const originalBtnText = triggerBtn.innerHTML;
        triggerBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Cargando versículos...';
        triggerBtn.disabled = true;

        try {
            const res = await fetch('/admin/aliyot/api/fetch-verses', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ ref })
            });

            if (res.status === 401) {
                alert('Tu sesión ha expirado por inactividad. Inicia sesión en otra pestaña.');
                return;
            }

            const contentType = res.headers.get('content-type') || '';
            if (!contentType.includes('application/json')) {
                throw new Error('Sesión expirada o respuesta inválida del servidor.');
            }

            const data = await res.json();
            if (data.success) {
                if (data.hebrew) document.getElementById('editHebrewContent').value = data.hebrew.replace(/<[^>]*>/g, '');
                if (data.phonetic) document.getElementById('editPhoneticContent').value = data.phonetic;
                if (data.englishOrSpanish && quill) quill.root.innerHTML = data.englishOrSpanish;
                alert('¡Versículos cargados con éxito en Español, Hebreo y Fonética! Puedes verlos y editarlos en las 3 pestañas.');
            } else {
                alert(data.message || 'No se pudieron obtener los versículos automáticamente para la referencia indicada.');
            }
        } catch(e) {
            alert('Error al obtener versículos: ' + e.message);
        } finally {
            triggerBtn.innerHTML = originalBtnText;
            triggerBtn.disabled = false;
        }
    }

    const btnAutoFetchEdit = document.getElementById('btnAutoFetchVersesEdit');
    if (btnAutoFetchEdit) {
        btnAutoFetchEdit.addEventListener('click', function() { loadVersesFromRefEdit(this); });
    }

    const btnAutoFetchFromRefEdit = document.getElementById('btnAutoFetchFromRefEdit');
    if (btnAutoFetchFromRefEdit) {
        btnAutoFetchFromRefEdit.addEventListener('click', function() { loadVersesFromRefEdit(this); });
    }
});
</script>
