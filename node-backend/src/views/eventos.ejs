<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

    <body class="eventos-page">

        <%- include('partials/header') %>

            <main class="main">

                <!-- Page Title -->
                <div class="page-title accent-background">
                    <div class="container d-lg-flex justify-content-between align-items-center">
                        <h1 class="mb-2 mb-lg-0">Eventos</h1>
                        <nav class="breadcrumbs">
                            <ol>
                                <li><a href="/">Inicio</a></li>
                                <li class="current">Eventos</li>
                            </ol>
                        </nav>
                    </div>
                </div><!-- End Page Title -->

                <section class="section">
                    <div class="container">
                        <% if (typeof eventos !== 'undefined' && eventos && eventos.length > 0) { %>
                            <div class="table-responsive" data-aos="fade-up">
                                <table class="table table-hover align-middle" style="background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
                                    <thead style="background: linear-gradient(135deg, #2c2c2c, #1a1a1a); color: #d4a853;">
                                        <tr>
                                            <th style="padding: 16px 20px; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Imagen</th>
                                            <th style="padding: 16px 20px; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Título</th>
                                            <th style="padding: 16px 20px; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;" class="d-none d-md-table-cell">Categoría</th>
                                            <th style="padding: 16px 20px; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;" class="d-none d-md-table-cell">Fecha</th>
                                            <th style="padding: 16px 20px; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;" class="d-none d-lg-table-cell">Descripción</th>
                                            <th style="padding: 16px 20px; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; text-align: center;">Detalle</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% eventos.forEach((evento, index) => { %>
                                            <tr style="border-bottom: 1px solid #f0f0f0; transition: background 0.2s ease;" class="evento-row">
                                                <td style="padding: 12px 20px;">
                                                    <% if (evento.img || evento.image_url) { %>
                                                        <div style="width: 80px; height: 55px; border-radius: 8px; overflow: hidden; background: #1a1a1a; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                                            <img src="<%= evento.img || evento.image_url %>" alt="<%= evento.title %>"
                                                                 style="width: 100%; height: 100%; object-fit: cover;">
                                                        </div>
                                                    <% } else { %>
                                                        <div style="width: 80px; height: 55px; border-radius: 8px; background: linear-gradient(135deg, #f8f9fa, #e9ecef); display: flex; align-items: center; justify-content: center;">
                                                            <i class="bi bi-calendar-event text-muted"></i>
                                                        </div>
                                                    <% } %>
                                                </td>
                                                <td style="padding: 12px 20px;">
                                                    <a href="/eventos/<%= evento.id %>" style="font-weight: 600; color: #222; text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">
                                                        <%= evento.title %>
                                                    </a>
                                                </td>
                                                <td style="padding: 12px 20px;" class="d-none d-md-table-cell">
                                                    <% if (evento.category) { %>
                                                        <span style="background: #f0ebe3; color: #8a7356; padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 500;"><%= evento.category %></span>
                                                    <% } else { %>
                                                        <span style="color: #ccc;">—</span>
                                                    <% } %>
                                                </td>
                                                <td style="padding: 12px 20px; white-space: nowrap;" class="d-none d-md-table-cell">
                                                    <% if (evento.event_date) { %>
                                                        <span style="font-size: 0.85rem; color: #d4a853; font-weight: 600;">
                                                            <i class="bi bi-calendar3 me-1"></i>
                                                            <%= new Date(evento.event_date).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                                        </span>
                                                    <% } else { %>
                                                        <span style="color: #ccc;">Sin fecha</span>
                                                    <% } %>
                                                </td>
                                                <td style="padding: 12px 20px;" class="d-none d-lg-table-cell">
                                                    <p style="font-size: 0.85rem; color: #888; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; max-width: 300px;">
                                                        <%= evento.description || '—' %>
                                                    </p>
                                                </td>
                                                <td style="padding: 12px 20px; text-align: center;">
                                                    <a href="/eventos/<%= evento.id %>" class="btn btn-sm" style="background: linear-gradient(135deg, #d4a853, #c49545); color: #fff; border: none; border-radius: 20px; padding: 6px 18px; font-size: 0.8rem; font-weight: 600; transition: all 0.3s ease;">
                                                        <i class="bi bi-eye me-1"></i>Ver
                                                    </a>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>

                            <div class="text-center mt-3 text-muted" data-aos="fade-up">
                                <small><%= eventos.length %> evento<%= eventos.length !== 1 ? 's' : '' %> registrado<%= eventos.length !== 1 ? 's' : '' %></small>
                            </div>
                        <% } else { %>
                            <div class="text-center py-5">
                                <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
                                <p class="text-muted mt-3">No hay eventos disponibles en este momento.</p>
                            </div>
                        <% } %>
                    </div>
                </section>

            </main>

            <%- include('partials/footer') %>

    <style>
        .evento-row:hover {
            background-color: #fdf9f3 !important;
        }
        .evento-row:hover a {
            color: #d4a853 !important;
        }
    </style>

    </body>

</html>
