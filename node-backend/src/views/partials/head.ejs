<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-W1TPC79ZG3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-W1TPC79ZG3');
    </script>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>
        <%= title %>
    </title>
    <%
        // ===== Metadatos para compartir en redes sociales (Open Graph) =====
        const _og = (function() {
            const pick = (...vals) => vals.find(v => typeof v === 'string' && v.trim() !== '') || '';
            const strip = (s) => String(s || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
            const L = locals || {};
            const pg = L.page || '';
            const ent = L.item || L.post || L.ensenanza || L.evento ||
                        (pg === 'haftara' ? L.haftara : null) ||
                        (pg === 'parashot' ? L.parasha : null) || null;
            const origin = L.siteOrigin || 'https://www.hablemosdeyhwh.com';
            const abs = (u) => !u ? '' : (/^https?:\/\//i.test(u) ? u : origin + (u.startsWith('/') ? '' : '/') + u);
            const t = ent ? pick(ent.title) : '';
            let d = ent ? strip(pick(ent.summary, ent.key_verse, ent.description, ent.subtitle, ent.biblical_reference, ent.content)) : '';
            if (d.length > 200) d = d.substring(0, 197) + '...';
            const img = ent ? pick(ent.image_url, ent.main_image, ent.thumbnail_url, ent.cover_image, ent.image) : '';
            return {
                title: t || (typeof title !== 'undefined' ? strip(title) : 'Hablemos de YHWH'),
                description: d || 'Estudios de la Torá, Parashot, Haftarot, noticias y enseñanzas bíblicas - Hablemos de YHWH',
                image: abs(img) || (origin + '/assets/img/pagina/og-share.jpg'),
                url: L.currentFullUrl || origin,
                type: ent ? 'article' : 'website'
            };
        })();
    %>
    <meta name="description" content="<%= _og.description %>">
    <meta name="keywords" content="">
    <link rel="canonical" href="<%= _og.url %>">

    <!-- Open Graph (Facebook, WhatsApp, Instagram, Telegram) -->
    <meta property="og:site_name" content="Hablemos de YHWH">
    <meta property="og:locale" content="es_ES">
    <meta property="og:type" content="<%= _og.type %>">
    <meta property="og:title" content="<%= _og.title %>">
    <meta property="og:description" content="<%= _og.description %>">
    <meta property="og:url" content="<%= _og.url %>">
    <meta property="og:image" content="<%= _og.image %>">
    <meta property="og:image:alt" content="<%= _og.title %>">
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= _og.title %>">
    <meta name="twitter:description" content="<%= _og.description %>">
    <meta name="twitter:image" content="<%= _og.image %>">

    <!-- Favicons -->
    <link href="/assets/img/pagina/logo1.svg" rel="icon" type="image/svg+xml">
    <link href="/assets/img/pagina/logo1.svg" rel="apple-touch-icon">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
    <link href="/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">

    <!-- Main CSS File -->
    <link href="/assets/css/main.css" rel="stylesheet">

    <% if (typeof page !=='undefined' && page==='calendar' ) { %>
        <link href="/assets/calendar/css/style.css" rel="stylesheet">
        <% } %>
</head>