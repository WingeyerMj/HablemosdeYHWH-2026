<footer id="footer" class="footer dark-background">

    <div class="footer-newsletter">
        <div class="container">
            <div class="row justify-content-center text-center">
                <div class="col-lg-6">
                    <h4>Suscríbete a Nuestro Boletín</h4>
                    <p>¡Recibe las últimas noticias y novedades sobre nuestros estudios y eventos!</p>
                    <form id="newsletterForm">
                        <!-- Honeypot invisible para atrapar bots de spam automáticos -->
                        <input type="text" name="b_company_url" style="position: absolute; left: -9999px; opacity: 0; height: 0; width: 0; pointer-events: none;" tabindex="-1" autocomplete="off">
                        <div class="newsletter-form"><input type="email" name="email" style="min-width: 0; min-height: 32px;" placeholder="Ingresa tu email" aria-label="Correo electrónico para gestionar tu suscripción" aria-describedby="newsletterHelp" autocomplete="email" required><input type="submit"
                                value="Suscribirse"></div>
                        <p id="newsletterHelp" style="font-size: 0.85rem; margin: 12px 0 8px;">¿Ya no quieres recibir novedades? Ingresa tu correo y suspende la suscripción.</p>
                        <button type="submit" name="newsletterAction" value="unsubscribe" style="min-height: 44px; max-width: 100%; padding: 10px 22px; border: 1px solid #d4b895; border-radius: 24px; background: transparent; color: #d4b895; cursor: pointer;">Dejar de recibir el boletín</button>
                        <div id="newsletterMsg" role="status" aria-live="polite" aria-atomic="true" style="display:none; margin-top: 10px; padding: 8px; border-radius: 8px; font-size: 0.9rem;"></div>
                    </form>
                    <script>
                    document.getElementById('newsletterForm').addEventListener('submit', async function(e) {
                        e.preventDefault();
                        const form = this;
                        if (form.dataset.busy === 'true') return;
                        const unsubscribe = e.submitter?.value === 'unsubscribe';
                        const msg = document.getElementById('newsletterMsg');
                        const input = form.querySelector('input[type="email"]');
                        const controls = Array.from(form.querySelectorAll('input[type="submit"], button[type="submit"]'));
                        const hp = form.querySelector('input[name="b_company_url"]')?.value || '';
                        form.dataset.busy = 'true';
                        controls.forEach(control => control.disabled = true);
                        form.setAttribute('aria-busy', 'true');
                        msg.style.display = 'block';
                        msg.style.background = 'transparent';
                        msg.style.color = 'inherit';
                        msg.style.border = 'none';
                        msg.textContent = unsubscribe ? 'Suspendiendo la suscripción...' : 'Enviando...';
                        try {
                            const res = await fetch(unsubscribe ? '/api/newsletter/unsubscribe' : '/api/newsletter', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ email: input.value.trim(), b_company_url: hp })
                            });
                            const result = await res.json();
                            const success = res.ok && result.ok;
                            msg.style.background = success ? '#d4edda' : '#f8d7da';
                            msg.style.color = success ? '#155724' : '#721c24';
                            msg.style.border = success ? '1px solid #c3e6cb' : '1px solid #f5c6cb';
                            msg.textContent = success
                                ? (result.message || (unsubscribe ? 'La suscripción quedó suspendida.' : '¡Te has suscrito correctamente al boletín!'))
                                : (result.error || 'No se pudo completar la solicitud. Intenta nuevamente.');
                            if (success) input.value = '';
                        } catch (err) {
                            msg.style.background = '#f8d7da';
                            msg.style.color = '#721c24';
                            msg.style.border = '1px solid #f5c6cb';
                            msg.textContent = 'Error de conexión. Intenta nuevamente.';
                        } finally {
                            controls.forEach(control => control.disabled = false);
                            form.dataset.busy = 'false';
                            form.removeAttribute('aria-busy');
                        }
                    });
                    </script>
                </div>
            </div>
        </div>
    </div>

    <div class="container footer-top">
        <div class="row gy-4">
            <div class="col-lg-4 col-md-6 footer-about">
                <a href="/" class="d-flex align-items-center">
                    <img src="/assets/img/pagina/logo.svg" alt="YHWH Footer Logo"
                        style="max-height: 40px; border-radius: 50%; object-fit: cover; aspect-ratio: 1/1;">
                </a>
                <div class="footer-contact pt-3">
                    <h4 class="mb-2"><%= (typeof footerConfig !== 'undefined' && footerConfig && footerConfig.title) || 'Hablemos de YHWH' %></h4>
                    <p><%= (typeof footerConfig !== 'undefined' && footerConfig && footerConfig.subtitle) || '' %></p>
                    <p><%= (typeof footerConfig !== 'undefined' && footerConfig && footerConfig.content) || '' %></p>
                </div>
            </div>

            <% if (typeof footerLinks !== 'undefined' && footerLinks) { %>
                <% Object.keys(footerLinks).forEach(category => { %>
                    <div class="col-lg-2 col-md-3 footer-links">
                        <h4><%= category %></h4>
                        <ul>
                            <% footerLinks[category].forEach(link => { %>
                                <li><i class="bi bi-chevron-right"></i> <a href="<%= link.url %>"><%= link.title %></a></li>
                            <% }) %>
                        </ul>
                    </div>
                <% }) %>
            <% } %>

            <div class="col-lg-2 col-md-12">
                <h4>Síganos</h4>
                <div class="social-links d-flex">
                    <% const ssf = typeof siteSettings !== 'undefined' ? siteSettings : {}; %>
                    <% if (ssf.social_youtube) { %>
                        <a href="<%= ssf.social_youtube %>" target="_blank" rel="noopener noreferrer" title="YouTube"><i class="bi bi-youtube"></i></a>
                    <% } %>
                    <% if (ssf.social_facebook) { %>
                        <a href="<%= ssf.social_facebook %>" target="_blank" rel="noopener noreferrer" title="Facebook"><i class="bi bi-facebook"></i></a>
                    <% } %>
                    <% if (ssf.social_instagram) { %>
                        <a href="<%= ssf.social_instagram %>" target="_blank" rel="noopener noreferrer" title="Instagram"><i class="bi bi-instagram"></i></a>
                    <% } %>
                    <% if (ssf.social_whatsapp) { %>
                        <a href="<%= ssf.social_whatsapp %>" target="_blank" rel="noopener noreferrer" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                    <% } %>
                </div>
            </div>

        </div>
    </div>

    <div class="container copyright text-center mt-4">
        <p>© <span>Copyright</span> <strong class="px-1 sitename">Hablemos de YHWH</strong> <span>All Rights
                Reserved</span></p>
        <div class="credits">
            Designed by mjwproduccion
        </div>
    </div>

</footer>

<!-- Scroll Top -->
<a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i
        class="bi bi-arrow-up-short"></i></a>

<!-- Preloader -->
<div id="preloader"></div>

<!-- Vendor JS Files -->
