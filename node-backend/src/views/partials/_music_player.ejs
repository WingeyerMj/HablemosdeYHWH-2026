<!-- Reproductor Flotante de Música de Adoración (Hablemos de YHWH) -->
<%
    const _tracksFromDb = (typeof globalMusicTracks !== 'undefined' && Array.isArray(globalMusicTracks) && globalMusicTracks.length > 0)
        ? globalMusicTracks.map(t => ({
            id: t.id,
            title: t.title,
            subtitle: (t.category || 'Alabanza') + ' • ' + (t.artist || 'Hablemos de YHWH'),
            src: t.audio_url
        }))
        : [
            { id: 1, title: 'El Redil', subtitle: 'Alabanza • Hablemos de YHWH', src: '/assets/audio/musica/el-redil.mp3' },
            { id: 2, title: 'Shabat', subtitle: 'Shabat • Hablemos de YHWH', src: '/assets/audio/musica/shabat.mp3' },
            { id: 3, title: 'El Ruido', subtitle: 'Reflexión • Hablemos de YHWH', src: '/assets/audio/musica/el-ruido.mp3' }
        ];
%>
<div id="yhwhMusicWidget" class="yhwh-music-widget" aria-label="Reproductor de Música">
    <div id="yhwhMusicPanel" class="yhwh-music-panel" hidden>
        <div class="yhwh-music-panel-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-music-note-beamed" style="color: #d4b895;"></i>
                <span class="fw-bold" style="font-size: 0.86rem; color: #f5e6cc;">Música • Hablemos de YHWH</span>
            </div>
            <div class="d-flex align-items-center gap-1">
                <a href="/musica" class="yhwh-music-icon-btn text-decoration-none" title="Ir a la sección de Música" aria-label="Abrir sección de Música">
                    <i class="bi bi-box-arrow-up-right" style="font-size: 0.78rem;"></i>
                </a>
                <button type="button" id="yhwhMusicCloseBtn" class="yhwh-music-icon-btn" title="Minimizar reproductor" aria-label="Minimizar reproductor">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>
        </div>

        <div class="yhwh-music-now-playing">
            <div class="yhwh-music-track-title" id="yhwhMusicTitle"><%= _tracksFromDb[0] ? _tracksFromDb[0].title : 'El Redil' %></div>
            <div class="yhwh-music-track-sub" id="yhwhMusicSub">Pista 1 de <%= _tracksFromDb.length %></div>
        </div>

        <div class="yhwh-music-progress-wrap">
            <span id="yhwhMusicCurrentTime" class="yhwh-music-time">0:00</span>
            <input type="range" id="yhwhMusicSeek" class="yhwh-music-seek" min="0" max="100" value="0" aria-label="Progreso de canción">
            <span id="yhwhMusicDuration" class="yhwh-music-time">0:00</span>
        </div>

        <div class="yhwh-music-controls">
            <button type="button" id="yhwhMusicPrevBtn" class="yhwh-music-icon-btn" title="Anterior" aria-label="Canción anterior">
                <i class="bi bi-skip-backward-fill"></i>
            </button>
            <button type="button" id="yhwhMusicPlayMainBtn" class="yhwh-music-play-main" title="Reproducir o pausar" aria-label="Reproducir o pausar">
                <i class="bi bi-play-fill" id="yhwhMusicPlayMainIcon"></i>
            </button>
            <button type="button" id="yhwhMusicNextBtn" class="yhwh-music-icon-btn" title="Siguiente" aria-label="Siguiente canción">
                <i class="bi bi-skip-forward-fill"></i>
            </button>
            <div class="yhwh-music-volume-wrap" title="Volumen suave">
                <i class="bi bi-volume-down-fill" style="color: #d4b895; font-size: 0.95rem;"></i>
                <input type="range" id="yhwhMusicVolume" min="0" max="1" step="0.02" value="0.20" aria-label="Volumen">
            </div>
        </div>

        <div class="yhwh-music-playlist" id="yhwhMusicPlaylist"></div>
    </div>

    <div class="yhwh-music-pill" id="yhwhMusicPill">
        <button type="button" id="yhwhMusicPillPlayBtn" class="yhwh-music-pill-play" title="Reproducir / Pausar música" aria-label="Reproducir o pausar música">
            <i class="bi bi-play-fill" id="yhwhMusicPillPlayIcon"></i>
        </button>
        <button type="button" id="yhwhMusicPillToggle" class="yhwh-music-pill-info" title="Abrir lista de canciones" aria-label="Abrir lista de canciones">
            <span class="yhwh-music-bars" id="yhwhMusicBars" aria-hidden="true">
                <span></span><span></span><span></span>
            </span>
            <span class="yhwh-music-pill-text">
                <strong id="yhwhMusicPillTitle"><%= _tracksFromDb[0] ? _tracksFromDb[0].title : 'El Redil' %></strong>
                <small id="yhwhMusicPillHint">Música (<%= _tracksFromDb.length %>)</small>
            </span>
            <i class="bi bi-chevron-up ms-1" style="font-size: 0.78rem; color: #d4b895;"></i>
        </button>
    </div>

    <audio id="yhwhGlobalMusicAudio" preload="metadata"></audio>
</div>

<style>
.yhwh-music-widget {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 995;
    font-family: 'Montserrat', 'Roboto', sans-serif;
    max-width: calc(100vw - 88px);
}

.yhwh-music-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 6px;
    border-radius: 999px;
    background: rgba(20, 17, 14, 0.92);
    border: 1px solid rgba(212, 184, 149, 0.5);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(10px);
    color: #fff;
}

.yhwh-music-pill-play {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(135deg, #d4b895, #b48a54);
    color: #16130f;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    flex-shrink: 0;
    cursor: pointer;
    transition: transform 0.2s ease;
}

.yhwh-music-pill-play:hover {
    transform: scale(1.07);
}

.yhwh-music-pill-info {
    background: transparent;
    border: none;
    color: #fff;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 2px 4px;
    cursor: pointer;
    text-align: left;
}

.yhwh-music-pill-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
}

.yhwh-music-pill-text strong {
    font-size: 0.78rem;
    color: #f5e6cc;
    max-width: 135px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.yhwh-music-pill-text small {
    font-size: 0.66rem;
    color: rgba(255, 255, 255, 0.65);
}

.yhwh-music-bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
    width: 14px;
}

.yhwh-music-bars span {
    display: block;
    width: 3px;
    height: 4px;
    border-radius: 2px;
    background: #d4b895;
    transition: height 0.2s ease;
}

.yhwh-music-widget.is-playing .yhwh-music-bars span:nth-child(1) { animation: yhwhBar 0.7s ease-in-out infinite alternate; }
.yhwh-music-widget.is-playing .yhwh-music-bars span:nth-child(2) { animation: yhwhBar 0.55s ease-in-out 0.15s infinite alternate; }
.yhwh-music-widget.is-playing .yhwh-music-bars span:nth-child(3) { animation: yhwhBar 0.8s ease-in-out 0.3s infinite alternate; }

@keyframes yhwhBar {
    0% { height: 4px; }
    100% { height: 14px; }
}

.yhwh-music-panel {
    width: 300px;
    max-width: calc(100vw - 32px);
    margin-bottom: 10px;
    padding: 14px;
    border-radius: 18px;
    background: rgba(18, 15, 12, 0.96);
    border: 1px solid rgba(212, 184, 149, 0.45);
    box-shadow: 0 16px 38px rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(12px);
    color: #ffffff;
}

.yhwh-music-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 8px;
    margin-bottom: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.yhwh-music-now-playing {
    margin-bottom: 8px;
}

.yhwh-music-track-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
}

.yhwh-music-track-sub {
    font-size: 0.72rem;
    color: rgba(212, 184, 149, 0.85);
}

.yhwh-music-progress-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
}

.yhwh-music-time {
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.65);
    min-width: 30px;
    text-align: center;
}

.yhwh-music-seek {
    flex: 1;
    accent-color: #d4b895;
    cursor: pointer;
    height: 4px;
}

.yhwh-music-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 10px;
}

.yhwh-music-icon-btn {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #f5e6cc;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease;
}

.yhwh-music-icon-btn:hover {
    background: rgba(212, 184, 149, 0.22);
}

.yhwh-music-play-main {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(135deg, #d4b895, #b48a54);
    color: #16130f;
    font-size: 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.yhwh-music-volume-wrap {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-left: auto;
}

.yhwh-music-volume-wrap input {
    width: 62px;
    accent-color: #d4b895;
    cursor: pointer;
    height: 4px;
}

.yhwh-music-playlist {
    display: flex;
    flex-direction: column;
    gap: 5px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 8px;
    max-height: 165px;
    overflow-y: auto;
}

.yhwh-music-item {
    width: 100%;
    border: 1px solid transparent;
    background: rgba(255, 255, 255, 0.04);
    color: #e2e8f0;
    border-radius: 10px;
    padding: 7px 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
}

.yhwh-music-item:hover {
    background: rgba(212, 184, 149, 0.14);
}

.yhwh-music-item.active {
    background: rgba(212, 184, 149, 0.22);
    border-color: rgba(212, 184, 149, 0.5);
    color: #fff;
    font-weight: 600;
}

@media print {
    .yhwh-music-widget {
        display: none !important;
    }
}

@media (prefers-reduced-motion: reduce) {
    .yhwh-music-widget.is-playing .yhwh-music-bars span {
        animation: none !important;
        height: 10px;
    }
}
</style>

<script>
(function() {
    const widget = document.getElementById('yhwhMusicWidget');
    const audio = document.getElementById('yhwhGlobalMusicAudio');
    if (!widget || !audio) return;

    const tracks = <%- JSON.stringify(_tracksFromDb) %>;
    if (!tracks.length) return;

    const panel = document.getElementById('yhwhMusicPanel');
    const playlistEl = document.getElementById('yhwhMusicPlaylist');
    const pillToggle = document.getElementById('yhwhMusicPillToggle');
    const closeBtn = document.getElementById('yhwhMusicCloseBtn');
    const pillPlayBtn = document.getElementById('yhwhMusicPillPlayBtn');
    const mainPlayBtn = document.getElementById('yhwhMusicPlayMainBtn');
    const prevBtn = document.getElementById('yhwhMusicPrevBtn');
    const nextBtn = document.getElementById('yhwhMusicNextBtn');
    const seekEl = document.getElementById('yhwhMusicSeek');
    const volumeEl = document.getElementById('yhwhMusicVolume');
    const titleEl = document.getElementById('yhwhMusicTitle');
    const subEl = document.getElementById('yhwhMusicSub');
    const pillTitleEl = document.getElementById('yhwhMusicPillTitle');
    const pillHintEl = document.getElementById('yhwhMusicPillHint');
    const curTimeEl = document.getElementById('yhwhMusicCurrentTime');
    const durTimeEl = document.getElementById('yhwhMusicDuration');
    const pillPlayIcon = document.getElementById('yhwhMusicPillPlayIcon');
    const mainPlayIcon = document.getElementById('yhwhMusicPlayMainIcon');

    const DEFAULT_SOFT_VOLUME = 0.20;
    let currentIndex = 0;
    let userPaused = false;
    let resumeTime = 0;
    let recordedPlayId = null;

    try {
        const savedIdx = parseInt(localStorage.getItem('yhwh_music_idx') || '0', 10);
        if (!Number.isNaN(savedIdx) && savedIdx >= 0 && savedIdx < tracks.length) currentIndex = savedIdx;

        const savedVolRaw = localStorage.getItem('yhwh_music_vol_v3');
        const initialVol = savedVolRaw !== null ? parseFloat(savedVolRaw) : DEFAULT_SOFT_VOLUME;
        audio.volume = Number.isFinite(initialVol) ? Math.min(1, Math.max(0, initialVol)) : DEFAULT_SOFT_VOLUME;
        if (volumeEl) volumeEl.value = String(audio.volume);

        userPaused = localStorage.getItem('yhwh_music_paused') === '1';
        const savedTime = parseFloat(sessionStorage.getItem('yhwh_music_time') || '0');
        if (Number.isFinite(savedTime) && savedTime > 0) resumeTime = savedTime;
    } catch (_) {
        audio.volume = DEFAULT_SOFT_VOLUME;
    }

    function fmtTime(sec) {
        if (!Number.isFinite(sec) || sec < 0) return '0:00';
        const m = Math.floor(sec / 60);
        const s = Math.floor(sec % 60);
        return m + ':' + (s < 10 ? '0' : '') + s;
    }

    function syncPlayIcons(playing) {
        widget.classList.toggle('is-playing', playing);
        const cls = playing ? 'bi bi-pause-fill' : 'bi bi-play-fill';
        if (pillPlayIcon) pillPlayIcon.className = cls;
        if (mainPlayIcon) mainPlayIcon.className = cls;
        if (pillHintEl) pillHintEl.textContent = playing ? 'Reproduciendo' : 'Música (' + tracks.length + ')';
    }

    function reportPlay(track) {
        if (!track || !track.id || recordedPlayId === track.id) return;
        recordedPlayId = track.id;
        fetch('/api/musica/' + encodeURIComponent(track.id) + '/play', { method: 'POST' }).catch(() => {});
    }

    function renderPlaylist() {
        if (!playlistEl) return;
        playlistEl.innerHTML = '';
        tracks.forEach((t, idx) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'yhwh-music-item' + (idx === currentIndex ? ' active' : '');
            const labelSpan = document.createElement('span');
            const ico = document.createElement('i');
            ico.className = 'bi ' + (idx === currentIndex ? 'bi-disc-fill text-warning' : 'bi-music-note') + ' me-2';
            labelSpan.appendChild(ico);
            labelSpan.appendChild(document.createTextNode(t.title));
            const numSmall = document.createElement('small');
            numSmall.style.opacity = '0.7';
            numSmall.textContent = String(idx + 1);
            btn.appendChild(labelSpan);
            btn.appendChild(numSmall);
            btn.addEventListener('click', () => {
                userPaused = false;
                try { localStorage.setItem('yhwh_music_paused', '0'); } catch (_) {}
                loadTrack(idx, true);
            });
            playlistEl.appendChild(btn);
        });
    }

    function loadTrack(idx, autoPlay) {
        currentIndex = (idx + tracks.length) % tracks.length;
        const t = tracks[currentIndex];
        audio.src = t.src;
        if (titleEl) titleEl.textContent = t.title;
        if (subEl) subEl.textContent = 'Pista ' + (currentIndex + 1) + ' de ' + tracks.length + ' • ' + t.subtitle;
        if (pillTitleEl) pillTitleEl.textContent = t.title;
        if (seekEl) seekEl.value = '0';
        if (curTimeEl) curTimeEl.textContent = '0:00';
        if (durTimeEl) durTimeEl.textContent = '0:00';
        recordedPlayId = null;
        try { localStorage.setItem('yhwh_music_idx', String(currentIndex)); } catch (_) {}
        renderPlaylist();
        if (autoPlay) {
            audio.play().catch(() => {});
        }
    }

    function togglePlay() {
        if (!audio.src) loadTrack(currentIndex, false);
        if (audio.paused) {
            userPaused = false;
            try { localStorage.setItem('yhwh_music_paused', '0'); } catch (_) {}
            audio.play().catch(() => {});
        } else {
            userPaused = true;
            try { localStorage.setItem('yhwh_music_paused', '1'); } catch (_) {}
            audio.pause();
        }
    }

    if (pillToggle && panel) {
        pillToggle.addEventListener('click', () => {
            panel.hidden = !panel.hidden;
        });
    }
    if (closeBtn && panel) {
        closeBtn.addEventListener('click', () => {
            panel.hidden = true;
        });
    }
    if (pillPlayBtn) pillPlayBtn.addEventListener('click', togglePlay);
    if (mainPlayBtn) mainPlayBtn.addEventListener('click', togglePlay);
    if (prevBtn) prevBtn.addEventListener('click', () => {
        userPaused = false;
        try { localStorage.setItem('yhwh_music_paused', '0'); } catch (_) {}
        loadTrack(currentIndex - 1, true);
    });
    if (nextBtn) nextBtn.addEventListener('click', () => {
        userPaused = false;
        try { localStorage.setItem('yhwh_music_paused', '0'); } catch (_) {}
        loadTrack(currentIndex + 1, true);
    });

    if (volumeEl) {
        volumeEl.addEventListener('input', () => {
            const v = parseFloat(volumeEl.value);
            if (!Number.isNaN(v)) {
                audio.volume = v;
                try { localStorage.setItem('yhwh_music_vol_v3', String(v)); } catch (_) {}
            }
        });
    }

    if (seekEl) {
        seekEl.addEventListener('input', () => {
            if (Number.isFinite(audio.duration) && audio.duration > 0) {
                audio.currentTime = (parseFloat(seekEl.value) / 100) * audio.duration;
            }
        });
    }

    audio.addEventListener('play', () => {
        syncPlayIcons(true);
        reportPlay(tracks[currentIndex]);
    });
    audio.addEventListener('pause', () => syncPlayIcons(false));
    audio.addEventListener('ended', () => {
        resumeTime = 0;
        try { sessionStorage.removeItem('yhwh_music_time'); } catch (_) {}
        loadTrack(currentIndex + 1, true);
    });
    audio.addEventListener('loadedmetadata', () => {
        if (durTimeEl) durTimeEl.textContent = fmtTime(audio.duration);
        if (resumeTime > 0 && resumeTime < (audio.duration || 0) - 2) {
            audio.currentTime = resumeTime;
            resumeTime = 0;
        }
    });
    audio.addEventListener('timeupdate', () => {
        if (curTimeEl) curTimeEl.textContent = fmtTime(audio.currentTime);
        if (seekEl && Number.isFinite(audio.duration) && audio.duration > 0) {
            seekEl.value = String((audio.currentTime / audio.duration) * 100);
        }
        try { sessionStorage.setItem('yhwh_music_time', String(Math.floor(audio.currentTime))); } catch (_) {}
    });

    // Pausar la música ambiental si el usuario reproduce otro audio/video en la página (Aliyot, Alef-Bet, sección Música, etc.)
    document.addEventListener('play', (e) => {
        if (e.target && e.target !== audio && (e.target.tagName === 'AUDIO' || e.target.tagName === 'VIDEO')) {
            if (!audio.paused) audio.pause();
        }
    }, true);

    window.yhwhMusicPlayer = {
        pause: () => { if (!audio.paused) audio.pause(); }
    };

    loadTrack(currentIndex, false);

    // Reproducción automática suave al abrir la web (no interfiere en /musica donde el usuario elige pista principal)
    const isDedicatedMusicPage = window.location.pathname === '/musica';
    if (!userPaused && !isDedicatedMusicPage) {
        const tryAutoplay = () => {
            if (userPaused || !audio.paused) return Promise.resolve();
            return audio.play();
        };

        tryAutoplay().catch(() => {
            // Si el navegador bloquea autoplay sin interacción previa, iniciar suavemente en el primer toque/clic
            const unlockEvents = ['pointerdown', 'keydown', 'touchstart'];
            const onFirstInteraction = (ev) => {
                if (ev.target && ev.target.closest && ev.target.closest('#yhwhMusicPillPlayBtn, #yhwhMusicPlayMainBtn')) {
                    cleanupUnlock();
                    return;
                }
                cleanupUnlock();
                if (!userPaused && audio.paused) {
                    const anyOtherPlaying = Array.from(document.querySelectorAll('audio, video')).some(el => el !== audio && !el.paused);
                    if (!anyOtherPlaying) {
                        audio.play().catch(() => {});
                    }
                }
            };
            function cleanupUnlock() {
                unlockEvents.forEach(evt => document.removeEventListener(evt, onFirstInteraction, true));
            }
            unlockEvents.forEach(evt => document.addEventListener(evt, onFirstInteraction, { capture: true, passive: true }));
        });
    }
})();
</script>
