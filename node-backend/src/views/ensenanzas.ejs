<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

    <body class="ensenanzas-page">

        <%- include('partials/header') %>

            <main class="main">

                <!-- Page Title -->
                <div class="page-title accent-background">
                    <div class="container d-lg-flex justify-content-between align-items-center">
                        <h1 class="mb-2 mb-lg-0">Enseñanzas</h1>
                        <nav class="breadcrumbs">
                            <ol>
                                <li><a href="/">Inicio</a></li>
                                <li class="current">Enseñanzas</li>
                            </ol>
                        </nav>
                    </div>
                </div><!-- End Page Title -->

                <section class="section py-5" style="background-color: #faf9f6;">
                    <div class="container">
                        
                        <!-- Buscador / Contador -->
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5 pb-3 border-bottom" data-aos="fade-up">
                            <div>
                                <h3 class="fw-bold mb-1" style="color: #2b231d;">Todas las Enseñanzas</h3>
                                <p class="text-muted mb-0">Estudios, reflexiones y conferencias en video y texto</p>
                            </div>
                            <div class="mt-3 mt-md-0 d-flex align-items-center gap-3">
                                <span class="badge px-3 py-2" style="background-color: #d4a853; font-size: 0.9rem; font-weight: 600; border-radius: 20px;">
                                    <%= (typeof ensenanzas !== 'undefined' && ensenanzas) ? ensenanzas.length : 0 %> Enseñanzas disponibles
                                </span>
                            </div>
                        </div>

                        <div class="row gy-4">
                            <% if (typeof ensenanzas !== 'undefined' && ensenanzas && ensenanzas.length > 0) { %>
                                <% ensenanzas.forEach((item, index) => { %>
                                    <div class="col-lg-6 col-12" data-aos="fade-up" data-aos-delay="<%= (index % 4 + 1) * 100 %>">
                                        <div class="card h-100 shadow-sm border-0 ensenanza-item-card" style="border-radius: 20px; overflow: hidden; background: #ffffff; transition: transform 0.3s ease, box-shadow 0.3s ease;">
                                            <div class="row g-0 h-100 flex-column flex-sm-row">
                                                
                                                <!-- Columna Imagen -->
                                                <div class="col-sm-5 position-relative" style="min-height: 220px; background: #1a1a1a;">
                                                    <% if (item.image_url && item.image_url.trim() !== '') { %>
                                                        <img src="<%= item.image_url %>" alt="<%= item.title %>" style="width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0;">
                                                    <% } else { %>
                                                        <div class="d-flex align-items-center justify-content-center h-100 w-100 position-absolute" style="background: linear-gradient(135deg, #f0ebd8, #e2d9c2);">
                                                            <i class="bi bi-book-half" style="font-size: 3.5rem; color: #d4a853;"></i>
                                                        </div>
                                                    <% } %>

                                                    <% if (item.youtube_link) { %>
                                                        <a href="<%= item.youtube_link %>" target="_blank" rel="noopener noreferrer" class="youtube-badge position-absolute top-0 start-0 m-3 px-2 py-1 rounded text-white d-flex align-items-center gap-1 shadow-sm" style="background: rgba(230, 33, 23, 0.9); font-size: 0.75rem; font-weight: 700; text-decoration: none; backdrop-filter: blur(4px);">
                                                            <i class="bi bi-youtube"></i> Video
                                                        </a>
                                                    <% } %>
                                                </div>

                                                <!-- Columna Contenido -->
                                                <div class="col-sm-7 d-flex flex-column p-4">
                                                    <div>
                                                        <%
                                                            let dateFormatted = '';
                                                            if (item.teaching_date) {
                                                                const dObj = new Date(item.teaching_date);
                                                                dateFormatted = dObj.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
                                                            } else if (item.created_at) {
                                                                const dObj = new Date(item.created_at);
                                                                dateFormatted = dObj.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
                                                            }
                                                        %>
                                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                                            <% if (item.subtitle) { %>
                                                                <span class="badge-sub text-uppercase" style="color: #b8860b; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.5px;">
                                                                    <%= item.subtitle %>
                                                                </span>
                                                            <% } else { %>
                                                                <span></span>
                                                            <% } %>
                                                            <% if (dateFormatted) { %>
                                                                <span class="badge rounded-pill px-2 py-1" style="background: #fdf6e7; color: #8c6a2d; border: 1px solid #ebdccb; font-size: 0.75rem; font-weight: 600;">
                                                                    <i class="bi bi-calendar3 me-1 text-warning"></i> <%= dateFormatted %>
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                        <h4 class="card-title fw-bold mb-2" style="font-size: 1.25rem; color: #222; line-height: 1.35;">
                                                            <a href="/ensenanzas/<%= item.id %>" class="text-decoration-none text-dark hover-gold">
                                                                <%= item.title %>
                                                            </a>
                                                        </h4>
                                                        <% if (item.description) { %>
                                                            <p class="card-text text-muted mb-3" style="font-size: 0.9rem; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                                                <%= item.description %>
                                                            </p>
                                                        <% } %>

                                                        <!-- Expositor / Servidor -->
                                                        <% if (item.authors_list && item.authors_list.length > 1) { %>
                                                            <div class="d-flex align-items-center gap-2 mb-3 pt-2 border-top">
                                                                <div class="d-flex" style="margin-left: 4px;">
                                                                    <% item.authors_list.forEach((auth, aIdx) => { %>
                                                                        <img src="<%= auth.img || '/assets/img/team/kaleb.jpg' %>" alt="<%= auth.name %>" title="<%= auth.name %> (<%= auth.role %>)" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid #d4a853; margin-left: <%= aIdx === 0 ? '0' : '-12px' %>; position: relative; z-index: <%= 10 - aIdx %>;" onerror="this.src='/assets/img/team/kaleb.jpg'">
                                                                    <% }) %>
                                                                </div>
                                                                <div class="min-width-0">
                                                                    <div class="fw-bold text-truncate" style="font-size: 0.88rem; color: #222; line-height: 1.2;"><%= item.authors_display %></div>
                                                                    <small class="badge bg-warning text-dark px-1 py-0" style="font-size: 0.7rem;"><%= item.authors_list.length %> expositores</small>
                                                                </div>
                                                            </div>
                                                        <% } else { %>
                                                            <div class="d-flex align-items-center gap-2 mb-3 pt-2 border-top">
                                                                <img src="<%= item.author_img || '/assets/img/team/kaleb.jpg' %>" alt="<%= item.author || 'Moréh Kaleb' %>" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid #d4a853;" onerror="this.src='/assets/img/team/kaleb.jpg'">
                                                                <div class="min-width-0">
                                                                    <div class="fw-bold text-truncate" style="font-size: 0.88rem; color: #222; line-height: 1.2;"><%= item.author || 'Moréh Kaleb' %></div>
                                                                    <small class="text-muted" style="font-size: 0.75rem;"><%= item.author_role || 'Moréh' %></small>
                                                                </div>
                                                            </div>
                                                        <% } %>
                                                    </div>

                                                    <!-- Botones de Acción -->
                                                    <div class="mt-auto pt-2 border-top d-flex flex-wrap align-items-center gap-2">
                                                        <a href="/ensenanzas/<%= item.id %>" class="btn btn-sm btn-outline-dark rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1">
                                                            <i class="bi bi-file-text"></i> Ver Detalle
                                                        </a>

                                                        <% if (item.youtube_link && item.youtube_link.trim() !== '') { %>
                                                            <a href="<%= item.youtube_link %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-danger rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm" style="background-color: #ff0000; border-color: #ff0000;">
                                                                <i class="bi bi-youtube"></i> Ver Video
                                                            </a>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="col-12 text-center py-5">
                                    <div class="p-5 bg-white rounded-4 shadow-sm d-inline-block">
                                        <i class="bi bi-journal-x text-muted" style="font-size: 3rem; color: #d4a853 !important;"></i>
                                        <h4 class="mt-3 fw-bold">No hay enseñanzas publicadas aún</h4>
                                        <p class="text-muted mb-0">Pronto subiremos nuevo contenido de estudio.</p>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </section>

                <style>
                    .ensenanza-item-card:hover {
                        transform: translateY(-6px);
                        box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
                    }
                    .hover-gold:hover {
                        color: #d4a853 !important;
                    }
                </style>

            </main>

            <%- include('partials/footer') %>

    </body>

</html>
