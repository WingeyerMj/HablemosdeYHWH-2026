<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

    <body class="seder-page">

        <%- include('partials/header') %>

            <main class="main">

                <!-- Page Title -->
                <div class="page-title" style="background: linear-gradient(135deg, #1a0f2e 0%, #2d1b4e 40%, #1a1a2e 100%); padding: 60px 0 40px; position: relative; overflow: hidden;">
                    <!-- Decorative Stars -->
                    <div style="position: absolute; inset: 0; overflow: hidden; pointer-events: none;">
                        <div style="position: absolute; top: 15%; left: 10%; width: 3px; height: 3px; background: #ffd700; border-radius: 50%; box-shadow: 0 0 6px #ffd700; animation: twinkle 2s infinite;"></div>
                        <div style="position: absolute; top: 25%; right: 15%; width: 2px; height: 2px; background: #fff8dc; border-radius: 50%; box-shadow: 0 0 4px #fff8dc; animation: twinkle 3s infinite 0.5s;"></div>
                        <div style="position: absolute; top: 45%; left: 30%; width: 2px; height: 2px; background: #ffd700; border-radius: 50%; box-shadow: 0 0 5px #ffd700; animation: twinkle 2.5s infinite 1s;"></div>
                        <div style="position: absolute; top: 60%; right: 25%; width: 3px; height: 3px; background: #fff8dc; border-radius: 50%; box-shadow: 0 0 6px #fff8dc; animation: twinkle 2s infinite 1.5s;"></div>
                        <div style="position: absolute; top: 35%; left: 60%; width: 2px; height: 2px; background: #ffd700; border-radius: 50%; box-shadow: 0 0 4px #ffd700; animation: twinkle 3s infinite 0.8s;"></div>
                    </div>
                    <div class="container d-lg-flex justify-content-between align-items-center position-relative" style="z-index: 2;">
                        <div>
                            <h1 class="mb-2 mb-lg-0" style="color: #ffd700; font-weight: 800; font-size: 2.5rem; text-shadow: 0 2px 10px rgba(255,215,0,0.3);">
                                <i class="bi bi-lamp" style="margin-right: 10px;"></i>Seder de las Fiestas
                            </h1>
                            <p class="mb-0 mt-2" style="color: rgba(255,255,255,0.7); font-size: 1.1rem; max-width: 600px;">
                                Orden y guías para las fiestas bíblicas de YHWH · Comparte y descarga en PDF y PNG
                            </p>
                        </div>
                        <nav class="breadcrumbs mt-3 mt-lg-0">
                            <ol>
                                <li><a href="/" style="color: #d4b895;">Inicio</a></li>
                                <li class="current" style="color: #ffd700;">Seder</li>
                            </ol>
                        </nav>
                    </div>
                </div><!-- End Page Title -->

                <!-- Festival Filter -->
                <section class="py-4" style="background: linear-gradient(to bottom, #1a0f2e, #faf9f6);">
                    <div class="container">
                        <div class="d-flex flex-wrap justify-content-center gap-2" data-aos="fade-up">
                            <button class="seder-filter-btn active" data-filter="all">
                                <i class="bi bi-grid-3x3-gap me-1"></i> Todas las Fiestas
                            </button>
                            <% if (typeof festivals !== 'undefined' && festivals && festivals.length > 0) { %>
                                <% festivals.forEach(f => { %>
                                    <button class="seder-filter-btn" data-filter="<%= f %>">
                                        <i class="bi bi-star me-1"></i> <%= f %>
                                    </button>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                </section>

                <!-- Seder Cards -->
                <section class="section py-5" style="background-color: #faf9f6;">
                    <div class="container">
                        
                        <!-- Contador -->
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5 pb-3 border-bottom" data-aos="fade-up">
                            <div>
                                <h3 class="fw-bold mb-1" style="color: #2b231d;">Guías del Seder</h3>
                                <p class="text-muted mb-0">Documentos, oraciones y el orden de las fiestas bíblicas</p>
                            </div>
                            <div class="mt-3 mt-md-0 d-flex align-items-center gap-3">
                                <span class="badge px-3 py-2" style="background: linear-gradient(135deg, #7c3aed, #a855f7); font-size: 0.9rem; font-weight: 600; border-radius: 20px; color: #fff;">
                                    <%= (typeof sederList !== 'undefined' && sederList) ? sederList.length : 0 %> Seder disponibles
                                </span>
                            </div>
                        </div>

                        <div class="row gy-4" id="seder-grid">
                            <% if (typeof sederList !== 'undefined' && sederList && sederList.length > 0) { %>
                                <% sederList.forEach((item, index) => { %>
                                    <div class="col-lg-6 col-12 seder-card-wrapper" data-festival="<%= item.festival || '' %>" data-aos="fade-up" data-aos-delay="<%= (index % 4 + 1) * 100 %>">
                                        <div class="card h-100 shadow-sm border-0 seder-item-card" style="border-radius: 20px; overflow: hidden; background: #ffffff; transition: transform 0.3s ease, box-shadow 0.3s ease;">
                                            <div class="row g-0 h-100 flex-column flex-sm-row">
                                                
                                                <!-- Columna Imagen -->
                                                <div class="col-sm-5 position-relative" style="min-height: 250px; background: #1a1a2e;">
                                                    <% if (item.image_url && item.image_url.trim() !== '') { %>
                                                        <img src="<%= item.image_url %>" alt="<%= item.title %>" style="width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0;">
                                                    <% } else { %>
                                                        <div class="d-flex align-items-center justify-content-center h-100 w-100 position-absolute" style="background: linear-gradient(135deg, #2d1b4e, #1a0f2e);">
                                                            <div class="text-center">
                                                                <i class="bi bi-lamp" style="font-size: 3.5rem; color: #ffd700; display: block;"></i>
                                                                <span style="color: #d4b895; font-size: 0.85rem; margin-top: 8px; display: block;">סדר</span>
                                                            </div>
                                                        </div>
                                                    <% } %>

                                                    <% if (item.festival) { %>
                                                        <span class="position-absolute top-0 start-0 m-3 px-3 py-1 rounded-pill shadow-sm" style="background: linear-gradient(135deg, #7c3aed, #a855f7); color: white; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.5px;">
                                                            <i class="bi bi-star-fill me-1"></i><%= item.festival %>
                                                        </span>
                                                    <% } %>

                                                    <% if (item.is_featured) { %>
                                                        <span class="position-absolute top-0 end-0 m-3 px-2 py-1 rounded-pill" style="background: rgba(255,215,0,0.9); color: #1a0f2e; font-size: 0.7rem; font-weight: 700;">
                                                            <i class="bi bi-award-fill me-1"></i>Destacado
                                                        </span>
                                                    <% } %>
                                                </div>

                                                <!-- Columna Contenido -->
                                                <div class="col-sm-7 d-flex flex-column p-4">
                                                    <div>
                                                        <%
                                                            let dateFormatted = '';
                                                            if (item.festival_date) {
                                                                const dObj = new Date(item.festival_date);
                                                                dateFormatted = dObj.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
                                                            } else if (item.created_at) {
                                                                const dObj = new Date(item.created_at);
                                                                dateFormatted = dObj.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
                                                            }
                                                        %>
                                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                                            <% if (item.subtitle) { %>
                                                                <span class="text-uppercase" style="color: #7c3aed; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.5px;">
                                                                    <%= item.subtitle %>
                                                                </span>
                                                            <% } %>
                                                            <% if (dateFormatted) { %>
                                                                <span class="badge rounded-pill px-2 py-1" style="background: #f3f0ff; color: #5b21b6; border: 1px solid #ddd6fe; font-size: 0.75rem; font-weight: 600;">
                                                                    <i class="bi bi-calendar3 me-1"></i> <%= dateFormatted %>
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                        <h4 class="card-title fw-bold mb-2" style="font-size: 1.25rem; color: #222; line-height: 1.35;">
                                                            <a href="/seder/<%= item.id %>" class="text-decoration-none text-dark seder-title-link">
                                                                <%= item.title %>
                                                            </a>
                                                        </h4>
                                                        <% if (item.description) { %>
                                                            <p class="card-text text-muted mb-3" style="font-size: 0.9rem; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                                                <%= item.description %>
                                                            </p>
                                                        <% } %>

                                                        <!-- Autor -->
                                                        <div class="d-flex align-items-center gap-2 mb-3 pt-2 border-top">
                                                            <img src="<%= item.author_img || '/assets/img/team/kaleb.jpg' %>" alt="<%= item.author || 'Moréh Kaleb' %>" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid #7c3aed;" onerror="this.src='/assets/img/team/kaleb.jpg'">
                                                            <div class="min-width-0">
                                                                <div class="fw-bold text-truncate" style="font-size: 0.88rem; color: #222; line-height: 1.2;"><%= item.author || 'Moréh Kaleb' %></div>
                                                                <small class="text-muted" style="font-size: 0.75rem;"><%= item.author_role || 'Moréh' %></small>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Botones de Acción -->
                                                    <div class="mt-auto pt-2 border-top d-flex flex-wrap align-items-center justify-content-between gap-2">
                                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                                            <a href="/seder/<%= item.id %>" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1" style="background: linear-gradient(135deg, #7c3aed, #a855f7); color: white; border: none;">
                                                                <i class="bi bi-eye"></i> Ver Seder
                                                            </a>

                                                            <% if (item.pdf_file && item.pdf_file.trim() !== '') { %>
                                                                <a href="<%= item.pdf_file %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1">
                                                                    <i class="bi bi-file-pdf"></i> PDF
                                                                </a>
                                                            <% } %>

                                                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1 btn-share-seder" data-id="<%= item.id %>" data-title="<%= item.title %>" title="Compartir">
                                                                <i class="bi bi-share"></i>
                                                            </button>
                                                        </div>
                                                        <span class="text-muted small d-inline-flex align-items-center gap-1">
                                                            <i class="bi bi-eye"></i> <%= item.views || 0 %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="col-12 text-center py-5">
                                    <div class="p-5 bg-white rounded-4 shadow-sm d-inline-block">
                                        <i class="bi bi-lamp" style="font-size: 3rem; color: #7c3aed;"></i>
                                        <h4 class="mt-3 fw-bold">No hay seder publicados aún</h4>
                                        <p class="text-muted mb-0">Pronto subiremos guías para las fiestas bíblicas.</p>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </section>

                <style>
                    @keyframes twinkle {
                        0%, 100% { opacity: 0.3; }
                        50% { opacity: 1; }
                    }
                    .seder-item-card:hover {
                        transform: translateY(-6px);
                        box-shadow: 0 15px 35px rgba(124,58,237,0.15) !important;
                    }
                    .seder-title-link:hover {
                        color: #7c3aed !important;
                    }
                    .seder-filter-btn {
                        background: rgba(255,255,255,0.9);
                        border: 2px solid #e5e7eb;
                        border-radius: 25px;
                        padding: 8px 20px;
                        font-size: 0.88rem;
                        font-weight: 600;
                        color: #374151;
                        cursor: pointer;
                        transition: all 0.3s ease;
                    }
                    .seder-filter-btn:hover {
                        border-color: #7c3aed;
                        color: #7c3aed;
                        background: #f5f3ff;
                    }
                    .seder-filter-btn.active {
                        background: linear-gradient(135deg, #7c3aed, #a855f7);
                        color: white;
                        border-color: transparent;
                        box-shadow: 0 4px 15px rgba(124,58,237,0.3);
                    }
                </style>

                <script>
                    // Festival filter
                    document.querySelectorAll('.seder-filter-btn').forEach(btn => {
                        btn.addEventListener('click', function() {
                            document.querySelectorAll('.seder-filter-btn').forEach(b => b.classList.remove('active'));
                            this.classList.add('active');
                            const filter = this.dataset.filter;
                            document.querySelectorAll('.seder-card-wrapper').forEach(card => {
                                if (filter === 'all' || card.dataset.festival === filter) {
                                    card.style.display = '';
                                    card.style.animation = 'fadeIn 0.4s ease';
                                } else {
                                    card.style.display = 'none';
                                }
                            });
                        });
                    });

                    // Share functionality
                    document.querySelectorAll('.btn-share-seder').forEach(btn => {
                        btn.addEventListener('click', function() {
                            const title = this.dataset.title;
                            const url = window.location.origin + '/seder/' + this.dataset.id;
                            if (navigator.share) {
                                navigator.share({ title: title + ' - Seder - Hablemos de YHWH', url: url });
                            } else {
                                navigator.clipboard.writeText(url).then(() => {
                                    const original = this.innerHTML;
                                    this.innerHTML = '<i class="bi bi-check2"></i> Copiado';
                                    this.classList.add('btn-success');
                                    this.classList.remove('btn-outline-secondary');
                                    setTimeout(() => {
                                        this.innerHTML = original;
                                        this.classList.remove('btn-success');
                                        this.classList.add('btn-outline-secondary');
                                    }, 2000);
                                });
                            }
                        });
                    });
                </script>

            </main>

            <%- include('partials/footer') %>

    </body>

</html>
