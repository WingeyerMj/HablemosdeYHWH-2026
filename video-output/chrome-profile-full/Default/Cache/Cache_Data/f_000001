                            const eventCards = document.querySelectorAll('#portfolio .portfolio-item');
                            const emptyMsg = document.getElementById('no-events-category-msg');

                            filterBtns.forEach(btn => {
                                btn.addEventListener('click', function(e) {
                                    filterBtns.forEach(b => b.classList.remove('filter-active'));
