                                    const targetFilter = this.getAttribute('data-filter');
                                    let matchCount = 0;

                                    eventCards.forEach(card => {
                                        if (targetFilter === '*' || card.matches(targetFilter)) {
                                            card.style.display = '';
                                            matchCount++;
                                        } else {
                                            card.style.display = 'none';
                                        }
                                    });

